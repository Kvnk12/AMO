<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net" />
  </configSections>
  <log4net>
    <root>
      <level value="WARN"></level>
      <appender-ref ref="RollingLogFileAppender"></appender-ref>
    </root>
    <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="C:\AMO\SVC\Log\JobCreatorlogfile.txt" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <datePattern value="yyyyMMdd" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="1MB" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern
        value="%date [%thread] %-5level %logger [%property{NDC}] - %message%newline" />
      </layout>
    </appender>
  </log4net>
  <connectionStrings>
    <add name="Db" providerName="System.Data.SqlClient" connectionString="Data Source=10.100.100.12;Initial Catalog=AMO_PORTAL_NextGenProduction;User ID=amo_dev;Password=Nttamo@dev;Timeout=180" />
  </connectionStrings>
  <appSettings>
    <add key="LogfilePath" value = "D:\ReportSchedulingServices\Logfiles\" />
    <add key="SupportMail1" value = "AMSsupport@nttdata.com" />
    <add key="SupportMail2" value =  "Nextgentool.alerts@nttdata.com" />
    <add key="EmailTemplatePath" value = "D:\\Geetha\\ReportSchedulingServices\\Templates\\ReportSchedulled_EmailBody.html" />
    <add key="EmailTemplateLocalPath" value = "C:\\AMO\Source\\UI_SourceCode\\AMOReportsJOBProcessorSVC\\Templates\\ReportSchedulled_EmailBody.html" />
    <!--<add key="reportServerUrl" value="https://localhost/TelerikReportSever_PROD/"/>-->
    <!--<add key="reportServerApiUrl" value="https://localhost/TelerikReportSever_PROD/api/reportserver/"/>-->
    <add key="reportServerUrl" value="https://dynamoportal.net/TelerikReportSever_PROD/"/>
    <add key="reportServerApiUrl" value="https://dynamoportal.net/TelerikReportSever_PROD/api/reportserver/"/>
    <add key="username" value="amo_dev"/>
    <add key="password" value="Nttamo@dev"/>

    <add key="SleepTime" value="10000" />
    <add key="smtpHost" value="10.0.201.7" />
    <add key="smtpPort" value="25" />
    <add key="smtpUserPwd" value="" />
    <add key="smtpUserId" value="" />
    <add key="EmailFrom" value="no-reply-RptScheduler@dynamoportal.net" />
    <add key="EmailFromA3MM" value="no-reply-AssessmentManager@dynamoportal.net" />
    <add key="EmailFromA3MMDisplayName" value="AssessmentManager" />
    <add key="EmailBcc" value="Geetha.Bommalata@nttdata.com" />
    <add key="smtpTLS" value="No" />
    <add key="body" value="Please find the schedule Report on AMS Tool "/>



  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>