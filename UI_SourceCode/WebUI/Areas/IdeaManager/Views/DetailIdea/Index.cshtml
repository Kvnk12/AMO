    //    document.body.innerHTML = originalContents;


    //}
    function DetailIdeaPrint(ideadetail) {
        var curURL = window.location.href;
        $("#printidea").hide();
        $("#action").hide();
        $("#PageTitle").show();

        $(".menuBorder").hide();
        $("#breadcrumb").hide();
        $("#footer").hide();
        history.replaceState(history.state, '', '/');
        window.print();
        history.replaceState(history.state, '', curURL);
        $("#printidea").show();
        $("#action").show();
        $("#PageTitle").hide();
        $(".menuBorder").show();
        $("#breadcrumb").show();
        $("#footer").show();
