                }
            }

        }

        function SaveTeams(e) {

            var CID = $('#drpSelClient').val();
            var Team = e.model.Team.toUpperCase();
            var Id = e.model.Id;
            e.model.ClientId = CID;
            //var ClientId = CID;
            //alert(ClientId);
            var data = this.dataSource.data();

            for (var i = 0; i < data.length; i++) {
                if (data[i].Team.toUpperCase() === Team && data[i].Id != Id) {
                    e.preventDefault();
                    alert("Team Already Exists. Please Select Unique Team!");
                }
            }

        }

        function SaveApprover() {
            var id = $('#IMAutoApproval:checked').val() ? true : false;
            var grid = $("#ApproverGrid").getKendoGrid();
                    var selValues = grid.selectedKeyNames().join(", ");
                    if(selValues!=""||selValues!=",")
                    {
                        var mod = {
                        IMAutoApproval:id,
                        ApproverIds: selValues
                        };
                        var data = JSON.stringify(mod);
                    baseurl = '@Url.Content("~/IdeaManager/Config/AddSelectedAdmins")';
                    $.ajax(
                    {
                        url: baseurl,
                        type: 'post',
                        data: data,
                        async: false,
                        contentType: 'application/json; charset=utf-8',
                            success: function (data) {


                        }
                    })
                }
                else{
                }
                return false;
        }
        $('#IMAutoApproval').click(function (e) {
            var id = $('#IMAutoApproval:checked').val() ? true : false;
            if (id) {
                if ($(".approver-grid").hasClass("k-state-disabled")) {
                    $(".approver-grid").removeClass("k-state-disabled");
                }
            }
            else {
                if ($(".approver-grid").hasClass("k-state-disabled")) {
                   }
                else {
                    $(".approver-grid").addClass("k-state-disabled");
                }

            }
        });


</script>




