<script id="CatGridTemplate" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<IMCategoryModel>()
            .Name("CatGrid#=CalId#")
            .Columns(columns =>
            {
                columns.Bound(e => e.CaId).Hidden();
                columns.Bound(e => e.Category).Title("Category");
                columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);
            })
    .Sortable()
    .Editable(editable => editable.Mode(GridEditMode.InLine).ConfirmDelete("test").DisplayDeleteConfirmation("Are you sure you want to delete?"))
    //.HtmlAttributes(new { style = "height:450px;" })
   // .Pageable()
    .ToolBar(
   tools =>
   {
       tools.Create().Text("Add New Category");
   })
    .Scrollable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Model(model =>
        {
            model.Id(o => o.CaId);
        })
        //.PageSize(10)
        .Read(read => read.Action("GetCategory", "Config", new { CattId = "#=CalId#" }))
        .Create(create => create.Action("AddCategory", "Config", new { Id = "#=CalId#" }))
        .Update(update => update.Action("EditCategory", "Config"))
        .Destroy(delete => delete.Action("DeleteCategory", "Config"))
    )
    .Events(events => events.Save("SaveCategory"))
    .ToClientTemplate())
</script>
