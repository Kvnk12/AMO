<script>
        $(document).ready(function () {
            var grid = $('#ApproverGrid').data('kendoGrid');
            grid.bind('dataBound', function (e) {
                $.each(grid.tbody.find('tr'), function () {
                    var model = grid.dataItem(this);
                    //var cells = this;
                    if (model.IdeaApproverId != '' && model.IdeaApproverId != null) {
                        $('[data-uid=' + model.uid + ']').addClass('k-state-selected')
                            .find('[type=checkbox]')
                            .attr("checked", "checked");
                        grid.select("tr[data-uid='" + model.uid + "']");
                    }
                });
            });
        });

        $(window).on('load', function () {
            if ('@Model.IMAutoApproval'.toLowerCase() == 'true') {
                if ($(".approver-grid").hasClass("k-state-disabled")) {
                    $(".approver-grid").removeClass("k-state-disabled");
                }
            }
        });
        function SaveClassification(e) {
            var Classification = e.model.Classification.toUpperCase();
            var CalId = e.model.CalId;
            var data = this.dataSource.data();

            for (var i = 0; i < data.length; i++) {
                if (data[i].Classification.toUpperCase() === Classification && data[i].CalId != CalId) {
                    e.preventDefault();
                    alert("Classification Already Exists. Please Enter Unique Name!");
                }
            }

        }

        function SaveCategory(e) {
            var Category = e.model.Category.toUpperCase();
            var CaId = e.model.CaId;
            var data = this.dataSource.data();

            for (var i = 0; i < data.length; i++) {
                if (data[i].Category.toUpperCase() === Category && data[i].CaId != CaId) {
                    e.preventDefault();
                    alert('Category ' + '"' + Category + '"' + 'Already Exists. Please Enter Unique Name!');
                }
            }

        }

        function SaveComplexity(e) {
            var Complexity = e.model.Complexity.toUpperCase();
            var Id = e.model.Id;
            var data = this.dataSource.data();

            for (var i = 0; i < data.length; i++) {
                if (data[i].Complexity.toUpperCase() === Complexity && data[i].Id != Id) {
                    e.preventDefault();
                    alert('Complexity ' + '"' + Complexity + '"' + 'Already Exists. Please Enter Unique Name!');
                }
            }

        }

        function SaveSystemImpactedService(e) {
            var IdeaType = e.model.SystemImpactedService.toUpperCase();
            var Id = e.model.Id;
            var data = this.dataSource.data();

            for (var i = 0; i < data.length; i++) {
                if (data[i].SystemImpactedService.toUpperCase() === IdeaType && data[i].Id != Id) {
                    e.preventDefault();
                    alert('System Impacted Service ' + '"' + IdeaType + '"' + 'Already Exists. Please Enter Unique Name!');
                }
            }

        }
        function SaveIdeaType(e) {
            var IdeaType = e.model.IdeaType.toUpperCase();
            var Id = e.model.Id;
            var data = this.dataSource.data();

            for (var i = 0; i < data.length; i++) {
                if (data[i].IdeaType.toUpperCase() === IdeaType && data[i].Id != Id) {
                    e.preventDefault();
                    alert('Idea Type ' + '"' + IdeaType + '"' + 'Already Exists. Please Enter Unique Name!');
                }
            }

        }
    function setVisible(dataItem) {
        console.log(dataItem);
        if (dataItem.isDefault == false) {
            return true;
        } else {
            return false;
        }
    }

        function SaveLOB(e) {
            var LOB = e.model.LOB.toUpperCase();
            var Id = e.model.Id;
            var data = this.dataSource.data();

            for (var i = 0; i < data.length; i++) {
                if (data[i].LOB.toUpperCase() === LOB && data[i].Id != Id) {
                    e.preventDefault();
                    alert('LOB' + '"' + LOB + '"' + ' Already Exists. Please Enter Unique Name!');
                }
            }

        }

    function SaveIdeaSource(e) {
        var IdeaSource = e.model.IdeaSource.toUpperCase();
            var Id = e.model.Id;
            var data = this.dataSource.data();

            for (var i = 0; i < data.length; i++) {
