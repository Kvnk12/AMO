        <div>
            <label><strong style="font-size:medium; align-content:center;">WBS Template</strong></label>
            @(Html.Kendo().TreeList<WBSTemplateModel>()
                .Name("WBSTemplate")
    .Toolbar(toolbar => toolbar.Create().Text("Add New WBS Template"))
    .Columns(columns =>
    {
        columns.Add().Field(e => e.Name).Title("Phase/Progress");
        columns.Add().Title("Edit").Width(350).Command(c =>
        {
            c.Edit().Text("");
            c.Destroy().Text("");
            c.CreateChild().Text("Add Sub-Task");
        })
        .HtmlAttributes(new
        {
            // style = "text-align: center;"
        });
    })
    .Editable(e => e.Mode("inline"))
    .DataSource(dataSource => dataSource
        .Create(create => create.Action("Create", "Config"))
        .Read(read => read.Action("GetAllTemplates", "Config"))
        .Update(update => update.Action("Update", "Config"))
        .Destroy(delete => delete.Action("Destroy", "Config"))
        .Model(m =>
        {
            m.Id(f => f.TaskId);
            m.ParentId(f => f.TParentId);
            m.Expanded(true);
            m.Field(f => f.Name);
        })
    )
    .Height(600)
            )

        </div>

    </div>
</div>

