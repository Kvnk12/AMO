    function ItemNameExists(ItemName) {

    var res;
        var href = window.location.href.split('/');
        //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
        var baseurl = '';
        if (href[3].toLowerCase() == 'ideamanager') {
            var baseurl = href[0] + '//' + href[2] + '/' + 'IdeaManager/PostIdea/CheckItemName';
        }
        else {
            var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'IdeaManager/PostIdea/CheckItemName';
        }

        {
            $.ajax({
                url: baseurl,
                type: 'POST',
                async: false,
                data: { ItemName: ItemName, ItemId: '@Model.IdeaId'},
                success: function (data) {
                    document.getElementById("IdeaNameExists_alert").style.display = "none";
                   // $("#IdeaNameExists_alert").hide();
                    if (data == true) {
                        document.getElementById("IdeaNameExists_alert").style.display = "inline-block";
                       // $("#IdeaNameExists_alert").show();
                        res= true;
                    }
                    else{
                        res= false;
                    }
                }

            })
        }
        return res;

    }



