    function ReviseIdea() {
        var mod = {
            IdeaId: '@Model.IdeaId'
        };
        var data = JSON.stringify(mod);
        var indexurl = '@Url.Content("~/IdeaManager/PostIdea")';
        var ReviseIdeaURl = '@Url.Content("~/IdeaManager/PostIdea/ReviseIdea")';
        $.ajax(
            {
                url: ReviseIdeaURl,
                type: 'post',
                data: data,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    window.location.href = indexurl +'?IdeaId='+@Model.IdeaId;
                }
            })
    }


    function DetailIdea() {

        var indexurl = '@Url.Content("~/IdeaManager/DetailIdea")';
        if(@Model.IdeaId==0){
            alert("No idea is selected");
        }else
        window.location.href = indexurl +'?ideaId='+@Model.IdeaId;

    }







    //check Metric is there for an Idea or Not
    function CheckOneMetric() {
        var result;
        var mod = {
            IdeaId: '@Model.IdeaId'
        };
        var data = JSON.stringify(mod);
        var ChkMetricURl = '@Url.Content("~/IdeaManager/PostIdea/CheckMetric")';
        $.ajax(
            {
                url: ChkMetricURl,
                type: 'post',
                data: data,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                       // $('#MetricRequired_alert').hide();

                        if (data == false) {
                            //$('#MetricRequired_alert').show();
                            result = false;
                        }
                        else {
                            result = true;
                        }
                }
            })
        return result;
    }


    //check Comment is there for an Idea or Not
    function CheckOneComment() {
        var result;
        var mod = {
            IdeaId: '@Model.IdeaId'
        };
        var data = JSON.stringify(mod);
        var ChkCommentURl = '@Url.Content("~/IdeaManager/PostIdea/CheckComment")';
        $.ajax(
            {
                url: ChkCommentURl,
                type: 'post',
                data: data,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                       // $('#MetricRequired_alert').hide();

                        if (data == false) {
                            //$('#MetricRequired_alert').show();
                            result = false;
                        }
                        else {
                            result = true;
                        }
                }
            })
        return result;
    }



    //Implementation Tab Validations

    $('input[type=radio][name=ImpIdeaStatusID]').change(function (e) {
        if ('@Model.ImpIdeaStatusID' == '@((int)IMStatus.SubmitForPlanning)'||'@Model.ImpIdeaStatusID' == '@((int)IMStatus.Planned)'||'@Model.ImpIdeaStatusID' == '@((int)IMStatus.Initiated)'||'@Model.IdeaStatusID' == '@((int)IMStatus.Approved)')
        {
            $('#ImplementationSave').removeAttr('disabled');
        }
        var IdeaStat = $('input[name=ImpIdeaStatusID]:checked').val();

        document.getElementById("id-impPriority").style.display = "none";
        document.getElementById("id-impManager").style.display = "none";
        document.getElementById("id-startplandate").style.display = "none";
        document.getElementById("id-endplandate").style.display = "none";
        document.getElementById("id-actualstartdate").style.display = "none";
        document.getElementById("id-actualenddate").style.display = "none";
        document.getElementById("id-actualProgress").style.display = "none";
        if (IdeaStat == '@((int)IMStatus.Planned)') {

            document.getElementById("id-impPriority").style.display = "inline-block";
            document.getElementById("id-impManager").style.display = "inline-block";
            document.getElementById("id-startplandate").style.display = "inline-block";
            document.getElementById("id-endplandate").style.display = "inline-block";
        }
        else if (IdeaStat == '@((int)IMStatus.Initiated)') {
            document.getElementById("id-impPriority").style.display = "inline-block";
            document.getElementById("id-impManager").style.display = "inline-block";
            document.getElementById("id-startplandate").style.display = "inline-block";
            document.getElementById("id-endplandate").style.display = "inline-block";
            document.getElementById("id-actualstartdate").style.display = "inline-block";
            document.getElementById("id-actualProgress").style.display = "inline-block";
        }
        else if (IdeaStat == '@((int)IMStatus.Implemented)') {
            document.getElementById("id-impPriority").style.display = "inline-block";
            document.getElementById("id-impManager").style.display = "inline-block";
            document.getElementById("id-startplandate").style.display = "inline-block";
            document.getElementById("id-endplandate").style.display = "inline-block";
            document.getElementById("id-actualstartdate").style.display = "inline-block";
            document.getElementById("id-actualenddate").style.display = "inline-block";
        }
    });



