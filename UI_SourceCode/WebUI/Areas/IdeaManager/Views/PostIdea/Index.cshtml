    //}


    $('#ImplementationSave').click(function (e) {
        //Radio Button -- Status Check
        var IdeaStat = $('input[name=ImpIdeaStatusID]:checked').val();

        if (IdeaStat) {

            //alert('inside');
            var psdt = $("#PlannedStartDt").data("kendoDatePicker");
            var pedt = $("#PlannedEndDt").data("kendoDatePicker");
            var asdt = $("#ActualStartDt").data("kendoDatePicker");
            var aedt = $("#ActualEndDt").data("kendoDatePicker");
            var actualProg = $("#ActualProgress").val();//--When Initiated
            var impPriority = $("#ImpPriority").data("kendoDropDownList");
            var impManager = $("#ImpManager").data("kendoDropDownList");
            $('#PlannedStartDt_alert').hide();
            $('#PlannedEndDt_alert').hide();
            $('#ActualStartDt_alert').hide();
            $('#ActualEndDt_alert').hide();
            $('#MetricRequired_alert').hide();
            $('#CommentRequired_alert').hide();
            $('#MetricAndCommentRequired_alert').hide();
            $("#P_EndDate_Alert").hide();
            $("#A_EndDate_Alert").hide();
            $("#ImpPriority_alert").hide();
            $("#ActualProgress_alert").hide();
            $('#ImpManager_alert').hide();
            //check metric is there or not..
            var oneMetric = CheckOneMetric();
            var oneComment = CheckOneComment();
            // alert(oneMetric);
            if (IdeaStat == '@((int)IMStatus.Planned)') {
                var dat_psdt = new Date(psdt.value());
                var dat_pedt = new Date(pedt.value());
                if (impPriority.value() == '' || psdt.value() == null || pedt.value() == null || oneMetric === false || oneComment === false || dat_pedt < dat_psdt || impManager.value()=='') {
                    if (psdt.value() == null) {
                        document.getElementById("PlannedStartDt_alert").style.display = "inline-block";
                       // $('#PlannedStartDt_alert').show();
                    }
                    if (impManager.value() == '') {
                        document.getElementById("ImpManager_alert").style.display = "inline-block";
                       // $('#ImpManager_alert').show();
