<style>
    /*----------------Tabs-------------------*/
    .tab {
        /*overflow: hidden;*/
        width: 100%;
        /*height:250px;*/
        display: inline-flex;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }
        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            /*float: left;*/
            border: none;
            outline: none;
            cursor: pointer;
            padding: 12px 14px;
            transition: 0.3s;
            font-size: 17px;
            width: auto;
            /*display:inline-flex;*/
            text-overflow: ellipsis;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
            }
            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
                text-decoration: underline;
            }
    /* Style the tab content */
    .tabcontent {
        display: none;
        padding: 6px 12px;
        border: 1px solid #ccc;
        border-top: none;
        /*height: 200px;*/
        padding-top: 1%;
    }

    .tablinks {
        width: auto;
        margin: auto;
        /*text-overflow:ellipsis;*/
    }


    /*Tree View Disabling class*/
    .treedivDisable {
        pointer-events: none;
        cursor: no-drop;
        color: #c2c2c2 !important;
        background-color: #f5f5f5;
        border-radius: 3px;
    }
</style>

<div class="content-main dark-bg idea-manager-postidea">
    <div>
        <!--start of breadcrumb-->
        <ol class="breadcrumb">
            <li>Idea Manager</li>
            <li>View Idea</li>
            <li class="active">Post Idea</li>
        </ol>
    </div>

    <div class="im-postidea-tabhead">
        <div class="im-postidea-header">
            <h5>Idea Name :<label class="custom-white-label">@Model.IdeaName</label> </h5>
            @if (Model.IsDeleted == false)
            {


                if (Model.PostNewIdea == false && ((Model.IdeaStatusID != null) && (Model.IsIdeaMine == true || Model.IsSysAdmin == true)))
                {

                    //<div style="width:100%;height:3%">
                    <button type="submit" onclick="DetailIdea()" class="im-custom-button im-btn-print">Print View</button>
                    // </div>

                }
            }
        </div>

        <div class="im-postidea-header">
            <h5>Idea Number:<label class="custom-white-label"> @Model.IdeaNumber</label></h5>
            <h5>Idea Status:<label class="custom-white-label">@Model.IdeaStatus</label> </h5>
            <div class="im-postidea-button">
                @if (sysadmin ||MenuItemsInput.UserRole.ToLower()== "superuser")
                {
                    if (Model.PostNewIdea == false)
                    {
                        <button id="EditIdea" class="btn btn-primary im-button" onclick="SysAdminEditClick()">Edit</button>
                    }

                    if (Model.IdeaStatusID == (int)IMStatus.SubmitForRevision)
                    {
                        <button type="submit" class="btn btn-primary im-button" title="Click here If Idea has been Revised!" onclick="ReviseIdea()">Revised</button>
                    }
                    if ((Model.IdeaStatusID == (int)IMStatus.SubmitForReview || Model.IdeaStatusID == (int)IMStatus.SubmitForApproval) && Model.IsSysAdmin == true)
                    {
                        <button class="btn btn-primary im-button" onclick="location.href='@Url.Action("","IdeaApproval")';return false;" title="Go to Approval Page to perform action on the Ideas submitted for Review to you.">Next Steps</button>
                    }
                }
                else
                {
                    if (Model.IsDeleted == false)
                    {
                        if (Model.PostNewIdea == false)
                        {
                            //if () { }
                            <!--Read Only Mode :  Edit Button Visible only to [CreatedUser] and [Admin/SysAdmin]-->
                            if ((Model.IdeaStatusID == (int)IMStatus.SubmitForReview || Model.IdeaStatusID == (int)IMStatus.SubmitForApproval || Model.IdeaStatusID == (int)IMStatus.Declined || Model.IdeaStatusID == (int)IMStatus.Cancelled || Model.ImpIdeaStatusID == (int)IMStatus.Implemented) && (Model.IsIdeaMine == true || Model.IsSysAdmin == true))
                            {
                                <!--Button will be visible but not Enabled [Id Admin or CreatedUser] -->

                                @*@(Html.Kendo().Button()
                                    .Name("EditIdea")
                                    .Content("Edit")
                                    .HtmlAttributes(new { @class = "btn btn-primary", style = "width:150px;" })
                                    .Enable(false)
                                    )*@

                                <button id="EditIdea" class="btn btn-default im-custom-btndisabled" title="Idea cannot be edited in this Status.">Edit</button>

                                if ((Model.IdeaStatusID == (int)IMStatus.SubmitForReview || Model.IdeaStatusID == (int)IMStatus.SubmitForApproval) && Model.IsSysAdmin == true)
                                {
                                    <button class="btn btn-primary im-button" onclick="location.href='@Url.Action("Index","IdeaApproval")';return false;" title="Go to Approval Page to perform action on the Ideas submitted for Review to you.">Next Steps</button>
                                }

                            }

                            else
                            { <!--If idea is not in the Statuses above mentioned.-->
                                <!--   -->
                                if ((Model.IdeaStatusID != (int)IMStatus.SubmitForReview || Model.IdeaStatusID != (int)IMStatus.SubmitForApproval || Model.IdeaStatusID != (int)IMStatus.Declined || Model.IdeaStatusID != (int)IMStatus.Cancelled || Model.ImpIdeaStatusID != (int)IMStatus.Implemented) && (Model.IsIdeaMine == true || Model.IsSysAdmin == true || Model.IsImplementationManager == true))
                                {
                                    //If Status is Approved--- [Pre-Approval details cannot be edited]
                                    if ((Model.IdeaStatusID == (int)IMStatus.Approved || Model.ImpIdeaStatusID == (int)IMStatus.SubmitForPlanning || Model.ImpIdeaStatusID == (int)IMStatus.Planned || Model.ImpIdeaStatusID == (int)IMStatus.Initiated))
                                    {
                                        if ((Model.IsImplementationManager == true || Model.IsSysAdmin == true) && (Model.IdeaStatusID != (int)IMStatus.Cancelled || Model.ImpIdeaStatusID != (int)IMStatus.Implemented))
                                        {
                                            //Editing Details Post Approval -- [Only for Admins/Sysadmin, Implementation Manager]


                                            @*@(Html.Kendo().Button()
                                                .Name("EditIdea")
                                                .Content("Edit")
                                                .Events(eve => eve.Click("AdminEditClick"))
                                                .HtmlAttributes(new { @class = "btn btn-primary", style = "width:150px;" })
                                                .Enable(true))*@


                                            <button id="EditIdea" class="btn btn-primary im-button" onclick="AdminEditClick()">Edit</button>


                                        }
                                    }
                                    //Edit Idea Completely
                                    if ((Model.IdeaStatusID == (int)IMStatus.Created || Model.IdeaStatusID == (int)IMStatus.SubmitForRevision || Model.IdeaStatusID == (int)IMStatus.Revised) && Model.IsIdeaMine == true)
                                    {

                                        @*@(Html.Kendo().Button()
                                            .Name("EditIdea")
                                            .Content("Edit")
                                            .Events(eve => eve.Click("UserEditClick"))
                                            .HtmlAttributes(new { @class = "btn btn-primary", style = "width:150px;" })
                                            .Enable(true))*@


                                        <button id="EditIdea" class="btn btn-primary im-button" onclick="UserEditClick()">Edit</button>
                                        if (Model.IdeaStatusID == (int)IMStatus.SubmitForRevision)
                                        {
                                            <button type="submit" class="btn btn-primary im-button" title="Click here If Idea has been Revised!" onclick="ReviseIdea()">Revised</button>
                                        }
                                    }
                                }
                                else if (Model.IsIdeaMine == false || Model.IsSysAdmin == false)
                                {
                                    //Do not display..
                                }
                            }
                        }
                        else
                        {
                            <!--If it is PostNewIdea-->
                            <!--Do Not display any Button-->
                        }
                    }
                }
                <button type="submit" class="btn btn-primary im-button" onclick="location.href='@Url.Action("Index","ViewIdea")';return false;">Return to View Idea</button>
            </div>

        </div>
    </div>
    <div class="tab-container im-postidea-tab custom-kendo-tabstrip">
        <!--Kendo Tab-->
        @(Html.Kendo().TabStrip()
                                         .Name("tabstrip")
                                         .Items(tabstrip =>
                                         {
                                             tabstrip.Add().Text("Home")
                                                 .Selected(true)

                                                 .Content(m => Html.Partial("_Home", Model));
                                             //tabstrip.Add().Text("Approver(s)")
                                             tabstrip.Add().Text("Submit For Review")
                                                            .Enabled(false)
                                                             .Content(m => Html.Partial("_Approvers", Model));

                                             tabstrip.Add().Text("Classification")
                                                 .Enabled(false)
                                                 .Content(m => Html.Partial("_ClassificationAndCategory", Model));

                                             tabstrip.Add().Text("Business Benefits")
                                                 .Enabled(false)
                                                 .Content(m => Html.Partial("_BusinessBenefits", Model));

                                             tabstrip.Add().Text("IT Savings")
                                                 .Enabled(false)
                                                 .Content(m => Html.Partial("_ITSavings", Model));

                                             tabstrip.Add().Text("Config Items")
                                                 .Enabled(false)
                                                 .Content(m => Html.Partial("_ConfigItems", Model));

                                             tabstrip.Add().Text("Analysis/ Root Cause")
                                                 .Enabled(false)
                                                 .Content(m => Html.Partial("_Analysis", Model));

                                             tabstrip.Add().Text("Solution")
                                               .Enabled(false)
                                               .Content(m => Html.Partial("_Solution", Model));

                                             tabstrip.Add().Text("Risk Mitigation")
                                                 .Enabled(false)

                                                 .Content(m => Html.Partial("_RiskMitigation", Model));

                                             tabstrip.Add().Text("Metrics")
                                                 .Enabled(false)

                                                 .Content(m => Html.Partial("_Metrics", Model));



                                             tabstrip.Add().Text("Comments")
                                                 .Enabled(false)

                                                 .Content(m => Html.Partial("_Comments", Model));



                                             tabstrip.Add().Text("Implementation").HtmlAttributes(new { @title = "Only Implementation Managers can edit this section after Ideas gets Approved/Submitted for Planning." })
                                                 .Enabled(false)
                                                 .Content(m => Html.Partial("_Implementation", Model));

                                             //tabstrip.Add().Text("Offline Approval")
                                             //    .Enabled(false)
                                             //    .Content(m => Html.Partial("_OfflineApprover", Model));

                                             tabstrip.Add().Text("Log")
                                                 .Enabled(false)

                                                 .Content(m => Html.Partial("_Log", Model));
                                         })

    )
    </div>

    @Html.HiddenFor(m => m.IdeaId)
    @Html.HiddenFor(m => m.ClientId)
    @Html.HiddenFor(m => m.ViewIdea)
    @Html.HiddenFor(m => m.PostNewIdea)
