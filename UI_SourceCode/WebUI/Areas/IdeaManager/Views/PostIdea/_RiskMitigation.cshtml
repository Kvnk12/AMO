@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI
@using WebUI.Areas.IdeaManager.Controllers
@using WebUI.Areas.IdeaManager.Models
@using WebUI.Areas.IdeaManager.Dto
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data;
@using System.Collections;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Infrastructure;
@using Kendo.Mvc.Resources
@using Kendo.Mvc.Extensions;
@model  IdeaViewModel
<div class="im-postidea-benefitsgrid" id="im-rm-grid">
    <div class="custom-kendo-grid">
        @(Html.Kendo().Grid<IMRiskAndMitigationModel>()
                     .Name("IMRiskAndMitigationGrid")
                     .Columns(columns =>
                     {
                         columns.Bound(e => e.Id).Hidden();
                         columns.Bound(e => e.IdeaId).Hidden();
                         columns.Bound(e => e.CreatedDt).Title("Date").Format("{0:MM/dd/yyyy}");
                         columns.Bound(e => e.Risk).Title("Risk");
                         columns.Bound(e => e.MitigationPlan).Title("Mitigation Plan");
                         columns.Bound(e => e.Comments).Title("Comments");
                         columns.Command(command => { command.Edit().UpdateText(" ").CancelText(" ").Text(" "); command.Destroy().Text(" "); }).Width(200);
                     })
                  .Sortable()
                  .Scrollable()
                  .Editable(editable => editable.Mode(GridEditMode.InLine).ConfirmDelete("test").DisplayDeleteConfirmation("Are you sure you want to delete?"))
                  .ToolBar(toolbar => toolbar.Create().Text("Add New Risk And Mitigation"))
                  .DataSource(dataSource => dataSource
                  .Ajax()
                  .Model(model => {
                      model.Id(f => f.Id);
                      model.Field(f => f.CreatedDt).Editable(false);
                  })
                      .Read(read => read.Action("GetRiskAndMitigation", "PostIdea",new{ IId = Model.IdeaId}))
                      .Create(create => create.Action("AddRiskAndMitigation", "PostIdea", new { IId = Model.IdeaId }))
                      .Update(update => update.Action("EditRiskAndMitigation", "PostIdea"))
                      .Destroy(destroy => destroy.Action("DeleteRiskAndMitigation", "PostIdea"))

                          )

        )
    </div>
    </div>
