@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI
@using WebUI.Areas.IdeaManager.Controllers
@using WebUI.Areas.IdeaManager.Models
@using WebUI.Areas.IdeaManager.Dto
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data;
@using System.Collections;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Infrastructure;
@using Kendo.Mvc.Resources
@using Kendo.Mvc.Extensions;
@model  IdeaViewModel

<div class="im-postidea-analysis">
    <div class="im-postidea-editor" id="Analysis_div">
        @(Html.Kendo().EditorFor(e => e.Analysis)
        .Name("AnalysisEditor")
        .HtmlAttributes(new { style = "height:250px; width:100%;", aria_label = "editors" })
        .Resizable(resizable => resizable.Content(true).Toolbar(true))
        )
    </div>
    <div class="im-post-approver-bottom">
        <button class="im-custom-button im-btn-save" id="AnalysisSave" onclick="saveAnalysis()">Save</button>
    </div>
</div>

