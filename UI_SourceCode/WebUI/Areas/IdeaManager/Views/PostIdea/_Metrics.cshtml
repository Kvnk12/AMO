@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI
@using WebUI.Areas.IdeaManager.Controllers
@using WebUI.Areas.IdeaManager.Models
@using WebUI.Areas.IdeaManager.Dto
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data;
@using System.Collections;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Infrastructure;
@using Kendo.Mvc.Resources
@using Kendo.Mvc.Extensions;
@model  IdeaViewModel
<div class="im-postidea-benefitsgrid" id="im-metric-grid">
    <div class="custom-kendo-grid">
        @(Html.Kendo().Grid<MetricTargetModel>()
                             .Name("MetricTargetGrid")
                             .Columns(columns =>
                             {
                                 columns.Bound(e => e.Id).Hidden();
                                 columns.Bound(e => e.ItemId).Hidden();
                                 columns.Bound(e => e.MetricTarget).Title("Metrics");
                                 columns.Command(command => { command.Edit().UpdateText(" ").CancelText(" ").Text(" "); command.Destroy().Text(" "); }).Width(200);
                             })
                          .Sortable()
                          .Scrollable()
                          //.Pageable()
                          .Editable(editable => editable.Mode(GridEditMode.InLine).ConfirmDelete("test").DisplayDeleteConfirmation("Are you sure you want to delete?"))
                          .ToolBar(toolbar => toolbar.Create().Text("Add New Metric Target"))
                          .DataSource(dataSource => dataSource
                          .Ajax()
                          //.PageSize(10)
                          .Model(model => model.Id(f => f.Id))
                          .Read(read => read.Action("GetMetricTarget", "PostIdea").Data("GetIdeaId"))
                          .Create(create => create.Action("AddMetricTarget", "PostIdea").Data("GetIdeaId"))
                          .Update(update => update.Action("EditMetricTarget", "PostIdea"))
                          .Destroy(destroy => destroy.Action("DeleteMetricTarget", "PostIdea"))

                              )

    )
    </div>
    </div>
