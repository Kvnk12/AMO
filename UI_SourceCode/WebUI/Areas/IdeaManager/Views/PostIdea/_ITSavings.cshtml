@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI
@using WebUI.Areas.IdeaManager.Controllers
@using WebUI.Areas.IdeaManager.Models
@using WebUI.Areas.IdeaManager.Dto
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data;
@using System.Collections;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Infrastructure;
@using Kendo.Mvc.Resources
@using Kendo.Mvc.Extensions;
@model  IdeaViewModel
<div class="im-postidea-benefitsgrid" id="im-it-grid">
    <div class="custom-kendo-grid">
        @(Html.Kendo().Grid<IMItemITBenefitsInput>()
                         .Name("IMITBenefitsGrid")
                         .Columns(columns =>
                         {
                             columns.Bound(e => e.Id).Hidden();
                             columns.Bound(e => e.Name).Title("Name");
                             columns.Bound(e => e.Detail).Title("Detail");
                             columns.Bound(e => e.BenefitType).EditorTemplateName("BenefitTypeDropDownList").Title("Saving Type").ClientTemplate("#:BenefitType#");
                             columns.Bound(e => e.IncidentCount).Title("Volumetric").ClientFooterTemplate("Total Count: #=sum#").Width(150);
                             columns.Bound(e => e.Value).Title("Value").ClientFooterTemplate("Total: $#=sum#");
                             columns.Bound(e => e.FTEHours).Title("FTE Hours").ClientFooterTemplate("Total: #=sum# Hours");

                             columns.Command(command => { command.Edit().UpdateText(" ").CancelText(" ").Text(" "); command.Destroy().Text(" "); }).Width(200);
                         })
                      .Sortable()
                      .Scrollable()
                      //.Pageable()
                      .Editable(editable => editable.Mode(GridEditMode.InLine).ConfirmDelete("test").DisplayDeleteConfirmation("Are you sure you want to delete?"))
                      .ToolBar(toolbar => toolbar.Create().Text("Add New IT Savings"))
                      .DataSource(dataSource => dataSource
                      .Ajax()
                      //.PageSize(10)
                      .Model(model => model.Id(f => f.Id))
                      .Aggregates(agg=>
                      {
                          agg.Add(p => p.Value).Sum();
                          agg.Add(p => p.FTEHours).Sum();
                          agg.Add(p => p.IncidentCount).Sum();
                      }
                      )
                      .Read(read => read.Action("GetITSavings", "PostIdea").Data("GetIdeaId"))
                      .Create(create => create.Action("AddITSavings", "PostIdea").Data("GetIdeaId"))
                      .Update(update => update.Action("EditITSavings", "PostIdea"))
                      .Destroy(destroy => destroy.Action("DeleteITSavings", "PostIdea"))

                          )

        )
    </div>
</div>