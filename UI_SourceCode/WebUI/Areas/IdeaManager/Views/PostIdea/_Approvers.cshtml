            var uploadfile = $("#RefFiles").data("kendoUpload");
            uploadfile.upload();
        }

    }
        function onUpload(e) {
            var apprid = document.getElementById("Id").value;
            console.log(apprid)
       e.data = {
           apprid: apprid,
       };

    }

   function onSelect(e) {
       var fileid = e.response;
       console.log("e.response fileid", fileid);
       var filename = "";
       $.map(e.files, function (file) {
           filename = file.name;
       }).join(", ");
       console.log("e.response filename", filename);
       $("<div class='fileAttachment' id='attach_" + fileid + "'>" + filename + "<span aria-hidden='true' class='fileAtt-delbtn' onclick='removeFile(" + fileid + ")'>&times;</span></div>").appendTo($("#fileAttach"));

   }

   function onSuccess(e) {
       console.log("e.response onSuccess", e.response);

       var fileid = e.response;
       $("#refId").text(fileid);
       var filename = "";
       $.map(e.files, function (file) {
           filename = file.name;
       }).join(", ");

       var inp = document.getElementById('attach_undefined');

       inp.id = "attach_"+fileid;

       console.log("new inp id", inp.id);

       //$("<div class='fileAttachment' id='attach_" + fileid + "'>" + filename + "<span aria-hidden='true' class='fileAtt-delbtn' onclick='removeFile(" + fileid + ")'>&times;</span></div>").appendTo($("#fileAttach"));

   }
   function removeFile(Id) {
       if (Id != null) {
           $("#refId").text(Id);
       }  
}

function deleteFileRef() {
    var Id = $("#refId").text();
    console.log("ref id", Id);
    var mod = {
			fileId: Id,
    };
		var data1 = JSON.stringify(mod);
		baseurl1 = '@Url.Content("~/IdeaManager/PostIdea/RemoveFile")';

		$.ajax(
			{
				url: baseurl1,
				type: 'post',
				data: data1,
				async: false,
				contentType: 'application/json; charset=utf-8',
				success: function (data) {
                    $('#deleteDraftModal').modal('hide');
                    $("#attach_" + Id).css("display", "none");
				}
            })
   }


        function Downloaduploadedfile(fid) {

        var mod = {
            fileId: fid
        };

        var data1 = JSON.stringify(mod);
        baseurl1 = '@Url.Content("~/IdeaManager/PostIdea/DownloaduploadedfileAction")';

        $.ajax(
            {
                url: baseurl1,
                type: 'post',
                data: data1,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                     x = fid;
                    window.location = '@Html.Raw(@Url.Action("DownloaduploadedfileAction", "PostIdea"))' + '?fileId=' + x;
                },
                error: function (err, response) {
                }
            })
    }
</script>