@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@model NTTData.AMOPortal.WebUI.Dto.IMPostIdeaInput


<div id="IdeaTypes" style="width:100%"></div>


<script type="text/javascript">
    $(document).ready(function () {
        var ItemId = "@Model.Id";

        var href = window.location.href.split('/');
        //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
        var baseurl = '';


        if (ItemId != null) {
            $('#IdeaTypes').jtable({
                title: 'Idea Types',
                actions: {
                    listAction: "@Url.Action("GetIdeaTypeDetails")",
                    createAction: "@Url.Action("AddIdeaTypeDetails")",
                    updateAction: "@Url.Action("UpdateIdeaTypeDetails")"
                    
                    
                },
                fields: {
                    Id: {
                        key: true,
                        list: false
                    },
                    IdeaType: {
                        title: 'Idea Type:',
                        width: '50%'
                    }
                },
                formCreated: function (event, data) {
                    data.form.find('input[name="IdeaType"]').addClass(
                      'validate[required]');

                    data.form.validationEngine();
                },
                formSubmitting: function (event, data) {
                    return data.form.validationEngine('validate');
                },
                formClosed: function (event, data) {
                    data.form.validationEngine('hide');
                    data.form.validationEngine('detach');
                }


            });
            $('#IdeaTypes').jtable('load');


        }
    });

</script>
