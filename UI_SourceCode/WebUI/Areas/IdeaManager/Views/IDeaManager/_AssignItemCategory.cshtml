@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@model NTTData.AMOPortal.WebUI.Dto.IMPostIdeaInput

 <div id="classaction">
    <button class="btn btn-primary" id="btnCatSave" name="command" value="savecategory">Assign Category</button>
    <button class="btn btn-default">Cancel</button>
</div>

<div>
    @{
        if (Model.ClientId > 0 && Model.PostIdeaInput.Id > 0)
            {
        <label for="ideaclassifcation" class="col-sm-5 control-label" id="">Classification</label>
        <select id="ideaclassifcation" multiple="multiple" name="ideaclassifcation">
            @foreach (IMClassification classItem in Model.PostIdeaInput.GetClassification)
                {
                <optgroup label="@classItem.Classification">

                    @foreach (vwIMclasswithcat item in Model.PostIdeaInput.GetCatAndClassification.Where(c => c.classificationid == classItem.Id))
                        {

                        if (Model.PostIdeaInput.GetMapItems.Where(c => c.ItemId == Model.PostIdeaInput.Id && c.CategoryId == item.Id).Count() > 0)
                            {
                        <option value="@item.Id.ToString()" selected="selected">@item.category</option>
                                       }
                                   else
                                       {
                        <option value="@item.Id.ToString()" >@item.category</option>
                                       }
                                   }
                </optgroup>
                                    
                           }
        </select>

            }
    }



</div>


<script>
    $(document).ready(function () {
        $("#ideaclassifcation").multipleSelect({
            multiple: true,
            multipleWidth: 250,
            width: '100%',
            height: '1500px',
            isOpen: true,
            keepOpen: true

        });
    });

</script>

