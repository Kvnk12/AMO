              </div>
          </div>


          <div id="action">
              <button class="btn btn-primary" id="btnSave" name="command" value="savechallenge"  style="margin-left: 40%">Post Challenge</button>
              <button class="btn btn-default" id="cancelChallenge">Cancel</button>
              <button class="btn btn-primary" id="homepage">Home</button>
          </div>
          <!--/.form-horizontal-->
      </div>

     

  </div>
  <div class="tab-pane" id="classification">
