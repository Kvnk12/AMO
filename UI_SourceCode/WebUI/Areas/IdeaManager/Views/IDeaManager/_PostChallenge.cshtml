              <label id="lblChallengeName" class="col-sm-5 control-label" for="accname"><span class="mandate">*</span>Challenge Name</label>
              <div class="col-sm-5">
                  @Html.TextBoxFor(m => m.postChallengeInput.ItemName, new { @class = "form-control", placeholder = "", tabindex = "1", id = "txtchallange" })
              </div>
          </div>
          <div class="form-group">
              <label class="col-sm-5 control-label" for="qtfyIdea">Value (Quantify  your Idea)</label>
