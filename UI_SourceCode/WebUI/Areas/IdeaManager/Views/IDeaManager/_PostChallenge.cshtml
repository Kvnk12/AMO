                  @*<input type="text"  value="@Model.postChallengeInput.QtyFication.ToString()" class = "form-control" style="width:150px;margin-left:27%"  tabindex="2", id="txtqtfyidea" name="txtqtfyidea" onkeypress = "return isNumberKey(this)" maxlength="5"  />*@
              </div>
          </div>
          <div class="form-group">
