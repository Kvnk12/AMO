        @(Html.Kendo().Grid<IMIdeaReassignModel>()
.Name("IdeaAssignment")
.Columns(columns =>
{
    columns.Bound(e => e.Id).Hidden();
    columns.Bound(e => e.IdeaNumber).Title("Idea No.").Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains))).Width(100);
    columns.Bound(e => e.ItemName).Title("Idea Name").Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains))).Width(300);
    columns.Bound(p => p.CreatedByName).Title("Created By/ Proposed By").Width(160).Filterable(ftb => ftb.Multi(true));
    columns.Bound(p => p.AssignedByUser).Hidden();
    columns.Bound(e => e.Status).Title("Status").Filterable(ftb => ftb.Cell(cell => cell.Operator("contains").SuggestionOperator(FilterType.Contains))).Width(300);

    columns.ForeignKey(e => e.ImpManagers, impList, "Value", "Text").Width(300).Title("Assign").EditorTemplateName("ImplementationMgdropdown");

})
.ToolBar(toolbar =>
{
    toolbar.Save();
})
.Editable(editable => editable.Mode(GridEditMode.InCell))
.Pageable()
.Navigatable()
.Sortable()
.Scrollable()
.DataSource(dataSource => dataSource
  .Ajax()
  .Batch(true)
  .PageSize(20)
  .ServerOperation(false)

  .Model(model =>
  {
      model.Id(p => p.Id);
      model.Field(f => f.IdeaNumber).Editable(false);
      model.Field(f => f.ItemName).Editable(false);
      model.Field(f => f.CreatedByName).Editable(false);
  })
  .Read(read =>
  {
      read.Action("ReadAssignIdea", "ViewIdea");

  })
    .Update("UpdatePersonnelRole", "APRAjaxService")
)
        )

