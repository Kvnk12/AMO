<style>
    .k-state-active .k-icon:before {
        background-color: #fff !important;
        color: #000 !important;
        margin: 2px !important;
    }

    .k-state-selected a {
        color: #ffffff;
    }

    /*Status Change Buttons Inside Tabs*/
    .StatusChangeButton {
        text-overflow: ellipsis;
        width: 150px;
        line-height: 1.75em;
        border-radius: 5px;
        background-color: #2196F3;
        border: solid;
        border-color: #357ebd;
        color: white;
        padding: 0px 0px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 14px;
        margin: auto;
        margin-right: 17px;
        -webkit-transition-duration: 0.4s; /* Safari */
        transition-duration: 0.4s;
        cursor: pointer;
        background-color: #2196F3;
    }

    /* Kendo Modifications*/
    .k-grid-header th.k-header {
        font-weight: bold;
        font-size: 13px;
        text-overflow: ellipsis;
        border: thin 1px #ccc;
    }
    /*Column Header- FullName*/
    .k-filter-row th, .k-grid-header th.k-header {
        white-space: normal;
        border: thin 1px #ccc;
    }
</style>

<div id="wrap">
    <div class="content-main dark-bg idea-manager">
        <!--start of breadcrumb-->
        <ol class="breadcrumb">
            <li>Idea Manager</li>
            <li class="active">View/Post Idea</li>
        </ol>
        <div id="MainDivforA" class="idea-manager-content">
