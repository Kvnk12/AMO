<script type="text/javascript">

    //Data for Kendo Grid..
    function MyIdeasOrAllIdeas() {
        //Still Values are Hard Coded..
        ////var val = $('.view-ideas-toggle span.active').attr('id');
        ////return {
        ////    AllIdeas: val
        ////}
        var val = $('.view-ideas-toggle span.active').attr('id');
        if (val == 'myIdeas') {
            return {
                AllIdeas: 1
            }
        } else {
            return {
                AllIdeas: 2
            }
        }

    }

    //Button Functions
    //---Tab -1------
    function NewIdeaClick() {
        //var dat = {
        //    ViewIdea: false,
        //    IdeaId: '0',
        //    tab:''
        //}
        //var datas = JSON.stringify(dat);
        //var burl = '@Url.Content("~/IdeaManager/PostIdea/Index")';
        var indexurl = '@Url.Content("~/IdeaManager/PostIdea/Index")';
        window.location.href = indexurl


    }

    function DeleteClick() {
        var grid = $("#PreApprovalGrid").getKendoGrid()
        var selectedIDs = grid.selectedKeyNames().join(", ");
        var mod = {
            IdeaIDs: selectedIDs
        };
        var data = JSON.stringify(mod);
        var baseurl = '@Url.Content("~/PostIdea/DeleteIdeas")';
        $.ajax(
        {
        url: baseurl,
        type: 'post',
        data: data,
        async: false,
        contentType: 'application/json; charset=utf-8',
        success: function (data) {
            $('#PreApprovalGrid').data('kendoGrid').dataSource.read();
            $('#SubmitForReviewGrid').data('kendoGrid').dataSource.read();
            //alert("Participants Successfully Added");
            }
        })

    }

    function SubmitForReviewClick() {
        var grid = $("#PreApprovalGrid").getKendoGrid()
        var selectedIDs = grid.selectedKeyNames().join(", ");
        var mod = {
            IdeaIDs: selectedIDs
        };
        var data = JSON.stringify(mod);
        var baseurl = '@Url.Content("~/PostIdea/SubmitforReview")';
        $.ajax(
        {
        url: baseurl,
        type: 'post',
        data: data,
        async: false,
        contentType: 'application/json; charset=utf-8',
        success: function (data) {
            $('#PreApprovalGrid').data('kendoGrid').dataSource.read();
            $('#SubmitForReviewGrid').data('kendoGrid').dataSource.read();
            //alert("Participants Successfully Added");
            }
        })

    }

    //---Tab - 2 --------
    function SubmitForApprovalClick() {

        var grid = $("#SubmitForReviewGrid").getKendoGrid()
        var selectedIDs = grid.selectedKeyNames().join(", ");
        var mod = {
            IdeaIDs: selectedIDs
