                    <span id="ReviewOpen" class="tab-link" onclick="openTab(event, 'Review')">Submitted for Review/ Approval</span>
                    <span id="ApprovedOpen" class="tab-link" onclick="openTab(event, 'Approved')">Approved/ Declined/ Cancelled</span>
                    <span id="ImplementationOpen" class="tab-link" onclick="openTab(event, 'Implementation')">Implementation</span>
