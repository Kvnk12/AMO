    function ItemNameExists(ItemName, ItemId) {


        var href = window.location.href.split('/');
        //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
        var baseurl = '';



        if (href[3].toLowerCase() == 'ideamanager') {
            var baseurl = href[0] + '//' + href[2] + '/' + 'IdeaManager/Challengemanager/CheckItemName';
        }
        else {
            var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'IdeaManager/Challengemanager/CheckItemName';
        }
        //var localToServer = "/";
        //var sPageURL = window.location.search.substring(1);
        //var sURLVariables = sPageURL.split('&');

        //if (window.location.pathname.split("/")[1].toLocaleLowerCase() != "ideamanager") {
        //    localToServer = "/" + window.location.pathname.split("/")[1] + "/";
        //}

        //var strUrl = window.Location.constructor("http://" + window.location.host + localToServer + "IdeaManager/IdeaManager/CheckItemName");

        {
            $.ajax({
                url: baseurl,
                type: 'POST',
                data: { ItemName: ItemName, ItemId: ItemId },
                success: checkItemSuccess,
                failure: errorItem,
                async: false

            })
        }

    }

    function checkItemSuccess(status) {


        blnItemNameExists = status;



    }

    function errorItem() {
        alert('An error occurred. Please contact administrator');
