@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.IdeaManager.Controllers
@using WebUI.Areas.IdeaManager.Dto;
@using System.Data;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions
@using PagedList.Mvc;
@using PagedList;
@model IPagedList<ChallengeModel>

@*@model IList<ChallengeModel>*@
<link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
<link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
<link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />
<script src="~/Scripts/JScript/jquery.min.js"></script>
<script src="~/Scripts/JScript/kendo.all.min.js"></script>
<script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>
@{
    ViewBag.Title = "Idea Manager";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/IMlogo.png");
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
@using (Html.BeginForm("testingUpdate", "ChallengeManager", FormMethod.Post))
{

    <div id="wrap">       
            <div style="height:1000px">
                <ol class="breadcrumb">
                    <li><a href="#">Idea Manager</a></li>
                    <li class="active"><a href="#">Approve Challenges</a></li>
                </ol>
                <div><label><strong>Challenge Approval : </strong></label></div>

                @if (!ViewData.ModelState.IsValid)
                {
                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
                }
                @if (TempData["ValidationSuccessMsg"] != null)
                {
                    <p class="alert alert-success"><strong>Success:</strong>@Html.Raw(@TempData["ValidationSuccessMsg"].ToString())</p>
                }

                <div class="form-group">
                    <div class="grid_4">
                        <table class="table" cellpadding="0">
                            <thead>
                                <tr>
                                    <th scope="col">Select</th>
                                    <th scope="col">
                                        <u>@Html.ActionLink("Status", "ChallengesApproval", new { sortOrder = ViewBag.Status }, new { @style = "color:white;" })</u>
                                    </th>
                                    <th scope="col">
                                        <u> @Html.ActionLink("Challenge", "ChallengesApproval", new { sortOrder = ViewBag.Challenges }, new { @style = "color:white;" })</u>
                                    </th>
                                    <th scope="col" class="l_column">
                                        <u> @Html.ActionLink("Description", "ChallengesApproval", new { sortOrder = ViewBag.Description }, new { @style = "color:white;" })</u>
                                    </th>
                                    <th scope="col" class="m_column">
                                        <u> @Html.ActionLink("Created by", "ChallengesApproval", new { sortOrder = ViewBag.Createdby }, new { @style = "color:white;" })</u>
                                    </th>
                                    <th scope="col">
                                        <u> @Html.ActionLink("LOB", "ChallengesApproval", new { sortOrder = ViewBag.LOB }, new { @style = "color:white;" })</u>
                                    </th>
                                    @*<th scope="col">Business Benefits</th>
                                <th scope="col">ITSavings</th>*@
                                    <th scope="col" class="m_column">
                                        <u> @Html.ActionLink("Config Item", "ChallengesApproval", new { sortOrder = ViewBag.configitem }, new { @style = "color:white;" })</u>
                                    </th>
                                    <th scope="col">Priority</th>
                                    <th scope="col">Status Comments</th>

                                </tr>
                            </thead>
                            <tbody>
                                @{

                                    for (int i = 0; i < Model.Count; i++)
                                    {
                                        var Statusname = (IMStatus)Model[i].StatusId;
                                        var commentId = "Comment" + "-" + Model[i].ChallengeId.ToString();
                                        var checkId = "Check" + "-" + Model[i].ChallengeId.ToString();
                                        <tr>
                                            @*<td><span class="mandate">@reqString</span> @Html.HiddenFor(model => Model.templateMapping[i].IsMandatory)</td>*@
                                            <td>
                                                <div> @Html.HiddenFor(model => Model[i].ClientId)</div>
                                                <div> @Html.HiddenFor(model => Model[i].StatusId)</div>
                                                <div>
                                                    @Html.HiddenFor(model => Model[i].ChallengeId)
                                                </div>
                                                <div>
                                                    @Html.HiddenFor(model => Model[i].ChallengeName)
                                                </div>


                                                @if (Model[i].StatusId == (int)IMStatus.Posted || Model[i].StatusId == (int)IMStatus.Submitted)
                                                {
                                                    @Html.CheckBoxFor(m => Model[i].IsChecked, new { @class = "form-control", @style = "width:50px;", tabindex = "", id = checkId })
                                                }
                                                else
                                                {
                                                    <div data-toggle="tooltip" data-placement="right" title="@Model[i].Status Ideas cannot be modified" style="overflow: hidden; text-overflow: ellipsis;">
                                                        @Html.CheckBoxFor(m => Model[i].IsChecked, new { @class = "form-control", tabindex = "", id = "status", disabled = "disabled" })
                                                    </div>
                                                }


                                            </td>
                                            <td>
                                                @Statusname.ToString()
                                                @Html.HiddenFor(model => Model[i].StatusId)
                                            </td>
                                            <td>
                                                @Model[i].ChallengeName
                                                @Html.HiddenFor(model => Model[i].ChallengeName)
                                            </td>
                                            <td>

                                                @*<div data-toggle="tooltip" data-placement="right" title="@Model[i].Description" style="overflow: hidden;width:100px; height:50px; text-overflow: ellipsis;">
                                                    @Model[i].Description
                                                    @Html.HiddenFor(model => Model[i].Description)
                                                </div>*@
                                                @Html.Raw(Model[i].Description)
                                            </td>
                                            <td>
                                                @Model[i].CreatedByUser
                                                @Html.HiddenFor(model => Model[i].CreatedByUser)
                                            </td>
                                            <td>
                                                @Model[i].LOB
                                                @Html.HiddenFor(model => Model[i].LOB)
                                            </td>
                                            @*<td>
                                        @Model[i].BusinessBenefits
                                        @Html.HiddenFor(model => Model[i].BusinessBenefits)
                                        </td>
                                        <td>
                                        @Model[i].ITSavings
                                        @Html.HiddenFor(model => Model[i].ITSavings)
                                        </td>*@
                                            <td>
                                                @Model[i].ConfigItemName
                                                @Html.HiddenFor(model => Model[i].ConfigItemName)
                                            </td>

                                            <td>
                                                @Html.DropDownListFor(m => Model[i].PriorityId, new SelectList(new List<SelectListItem>
                                         {
                                   new SelectListItem{ Text="Select", Value = "0" },
                                             new SelectListItem{ Text="1", Value = "1" },
                                             new SelectListItem{ Text="2", Value = "2" },
                                             new SelectListItem{ Text="3", Value = "3" },
                                             new SelectListItem{ Text="4", Value = "4" },
                                             new SelectListItem{ Text="5", Value = "5" }
                                         }, "value", "text", Model[i].PriorityId), new { @class = "selectpicker", @id = "priority" })
                                            </td>

                                            <td>@Html.TextAreaFor(m => Model[i].StatusComments, new { @class = "form-control", id = commentId})</td>

                                        </tr>
                                    }
                                }

                            </tbody>


                        </table>
                        <div class="pagination">
                            @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
                            @Html.PagedListPager(Model, page => Url.Action("ChallengesApproval", new { page = page, sortOrder = Request["sortOrder"] }))
                        </div>
                    </div>
                </div>

                <div>
                    <button class="btn btn-primary" type="submit" name="btnSubmit" id="btnSubmit" value="Submit" style="margin-left:15px">Submit</button>
                    <button class="btn btn-primary" type="submit" name="btnSubmit" id="btnApprove" value="Approve" style="margin-left:15px">Approve</button>
                    <button class="btn btn-primary" type="submit" name="btnSubmit" id="btnDecline" value="Decline" style="margin-left:15px" onclick="Decline(this)">Decline</button>
                    <button class="btn btn-primary" type="submit" name="btnSubmit" id="btnClose" value="Close" style="margin-left:15px" onclick="Closed(this)">Closed</button>
                </div>

            </div>
            </div>
 }
        

   