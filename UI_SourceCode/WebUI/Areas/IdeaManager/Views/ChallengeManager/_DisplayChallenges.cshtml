<div>
    <!--valchainContent-->
    @{

        //if(Model.ClientId > 0)
        //    {

        //var Client = (Client)Session["Client"];
        //var ClientID = Client.Id;

        <div style="height:1000px">
            <div class="row">
                <div class="col-sm-2">
                    <button tabindex="30" class="btn btn-primary" id="btnAdd" style="margin-bottom:10px">Post New Challenge</button>
                </div>
            </div>
            <div>
                <div>
                    <div>
                        @*<div class="grid_4 height400">*@
                        <table class="table" id="pp38Home" cellpadding="0" cellspacing="0" style="width:100%">
                            <thead>
                                <tr>
                                    @*<th width="45%" scope="col">Challenges</th>
                            <th width="45%" scope="col">Status</th>*@
                                    <th><u>@Html.ActionLink("Last Modified Date", "DisplayChallenges", new { Page = Model.PageNumber, sortOrder = ViewBag.LastModifiedDate }, new { @style = "color:white;" })</u></th>
                                    <th><u>@Html.ActionLink("Challenges", "DisplayChallenges", new { Page = Model.PageNumber, sortOrder = ViewBag.Challenges }, new { @style = "color:white;" })</u></th>
                                    <th><u>@Html.ActionLink("Posted by", "DisplayChallenges", new { Page = Model.PageNumber, sortOrder = ViewBag.Postedby }, new { @style = "color:white;" })</u></th>
                                    <th><u>@Html.ActionLink("Status", "DisplayChallenges", new { Page = Model.PageNumber, sortOrder = ViewBag.Status }, new { @style = "color:white;" })</u></th>
                                    <th><u>@Html.ActionLink("Status Comments", "DisplayChallenges", new { Page = Model.PageNumber, sortOrder = ViewBag.StatusComments }, new { @style = "color:white;" })</u></th>
                                    <th><u>@Html.ActionLink("Created Date", "DisplayChallenges", new { Page = Model.PageNumber, sortOrder = ViewBag.CreatedDate }, new { @style = "color:white;" })</u></th>
                                </tr>
                            </thead>

                            @{
                                //if (Model.ClientId > 0)
                                //    {
                                var uid = (int)Session["UserId"];

                                //IList<IMPostChallenge> postItems = Model.GetChallengeItems;
                                foreach (var vwItem in Model)
                                {

                                    //IdeaManagerHelper XC = new IdeaManagerHelper();
                                    var name = (IMStatus)vwItem.StatusId;

                                    <tr>

                                        <td> @vwItem.LastUpdatedDate </td>
                                        <td>
                                            @if ((vwItem.StatusId == (int)IMStatus.Created || vwItem.StatusId == (int)IMStatus.Declined) && (vwItem.CreatedBy == uid))
                                            {
                                                @Html.ActionLink(vwItem.ItemName, "DisplayHomePage", "ChallengeManager", new { ClientId = vwItem.ClientId, ItemId = vwItem.Id, SaveData = "", TabName = "home" }, null)
                                            }
                                            else
                                            {
                                                @vwItem.ItemName
                                            }
                                        </td>

                                        <td> @vwItem.CreatedByUser </td>

                                        <td>
                                            @if (vwItem.StatusId == (int)IMStatus.Approved && (vwItem.CreatedBy == uid))
                                            {
                                                <div data-toggle="tooltip" data-placement="right" title="Click here if Challenge is Implemented" style="overflow: hidden; text-overflow: ellipsis;">
                                                    @name <br /> (@Html.ActionLink("Mark as Implemented", "implementedStatus", "ChallengeManager", new { idid = vwItem.Id }, null))
                                                </div>
                                            }
                                            else
                                            {
                                                @name
                                            }
                                        </td>

                                        <td> @vwItem.StatusComments </td>
                                        <td> @vwItem.CreateDateString </td>

                                        @*<td>@Model.PostIdeaInput.StatusName </td>*@
                                        @*<td>@vwItem.StatusId</td>*@
                                    </tr>



                                }

                                //}


                            }


                        </table>
                        <div class="pagination">
                            @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
                            @Html.PagedListPager(Model, page => Url.Action("DisplayChallenges", new { page = page, sortOrder = Request["sortOrder"] }))
                        </div>
                    </div>
                </div>
            </div>
        </div>
                                //}
    }
</div>

                <!--.valchainContent-->
