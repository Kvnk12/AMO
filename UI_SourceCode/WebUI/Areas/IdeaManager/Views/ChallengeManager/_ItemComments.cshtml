                                return ("<textarea rows='15'  cols='100' id='Comments' Name='Comments'>" + data.record.Comments + "</textarea>");
                                //return '<input type="textarea" id="detail" name="detail" style="width:200px" value="' + data.record.Detail + '" />';
                            } else {
