    $('.graph-view').on('click', function () {
        if ($(this).hasClass('graph-view')) {
            $(this).addClass('table-view');
            $(this).removeClass('graph-view');
        }
        else {
            $(this).addClass('graph-view');
            $(this).removeClass('table-view');
        }
        $(this).parents('.top-content-heading').siblings('.chart-content').toggleClass('hide');
        $(this).parents('.top-content-heading').siblings('.table-content').toggleClass('hide');
    });
    $('#btnPreview').on("click", function (e) {
