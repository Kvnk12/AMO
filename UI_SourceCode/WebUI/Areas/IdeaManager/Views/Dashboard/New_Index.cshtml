<script type="text/javascript">
    function DrpValTrendChange() {
        var chart1 = $("#chartTrend").data("kendoChart");
        chart1.dataSource.read();
        var grid1 = $("#TrendTable").data("kendoGrid");
        grid1.dataSource.read();
    }
    function Chart4DrpChange() {
        var chart6 = $("#Chart4").data("kendoChart");
        chart6.dataSource.read();
        var gridpriority = $("#Chart4Grid").data("kendoGrid");
        gridpriority.dataSource.read();
    }
    //Maximise Dashboard Chart
    function maximiseChartTrend() {
        var ChartTrend = $("#winChartTrend").data("kendoChart");
        ChartTrend.dataSource.read();
        var popup = $("#chartTrendWindow").data("kendoWindow");
        popup.open();
        popup.center();
    }
    function maximiseChartStatus() {
        var chartStatus = $("#winStatusChart").data("kendoChart");
        chartStatus.dataSource.read();

        var popup = $("#ChartStatusWindow").data("kendoWindow");

        popup.open();
        popup.center();
    }
    function maximiseChartPriority() {

        var chartpriority = $("#winChartPriority").data("kendoChart");
        chartpriority.dataSource.read();
        var popup = $("#ChartPriortyWindow").data("kendoWindow");

        popup.open();
        popup.center();
    }
    function maximiseChart4() {

        var chartpriority = $("#winChart4").data("kendoChart");
        chartpriority.dataSource.read();
        var popup = $("#Chart4Window").data("kendoWindow");

        popup.open();
        popup.center();
    }
    function maximiseChartDistributionbyYear() {
        var chartStatus = $("#winDistributionbyYearChart").data("kendoChart");
        chartStatus.dataSource.read();

        var popup = $("#DistributionbyYearChartWindow").data("kendoWindow");

        popup.open();
        popup.center();
    }
    function maximiseChartDistributionbyMonth() {
        var chartStatus = $("#winDistributionbyMonthChart").data("kendoChart");
        chartStatus.dataSource.read();

        var popup = $("#DistributionbyMonthChartWindow").data("kendoWindow");

        popup.open();
        popup.center();
    }
    $("#d1c1").click(function () {
        var grid = $("#TrendTable").data("kendoGrid");
        grid.dataSource.read();
    });
    $("#d1c2").click(function () {
        var grid = $("#PriorityTable").data("kendoGrid");
        grid.dataSource.read();
    });
    $("#d1c3").click(function () {
        var grid = $("#StatusGrid").data("kendoGrid");
        grid.dataSource.read();
    });
    $("#d1c4").click(function () {
        var gridStatus = $("#Chart4Grid").data("kendoGrid");
        gridStatus.dataSource.read();
    });
    $("#d1c5").click(function () {
        var grid = $("#Chart5Grid").data("kendoGrid");
        grid.dataSource.read();
    });
    $("#d1c6").click(function () {
        var grid = $("#Chart6Grid").data("kendoGrid");
        grid.dataSource.read();
    });
    function ParameterDataTrend(e) {
        console.log($("#DrpValTrend").val());
        return {
            ChartType: $("#DrpValTrend").val(),
            StartDate: $("#start").val(),
            EndDate: $("#end").val(),
            IdeaSource: $("#IdeaSourceId").data("kendoDropDownList").value()
        };
    }
    function GetStatusParameter(e) {
        return {
            drpval: "Status",
            StartDate: $("#start").val(),
            EndDate: $("#end").val(),
            IdeaSource: $("#IdeaSourceId").data("kendoDropDownList").value()
        };
    }
    function GetPriorityParameter(e) {
        return {
            drpval: "PriorityId",
            StartDate: $("#start").val(),
            EndDate: $("#end").val(),
            IdeaSource: $("#IdeaSourceId").data("kendoDropDownList").value()
        };
    }
