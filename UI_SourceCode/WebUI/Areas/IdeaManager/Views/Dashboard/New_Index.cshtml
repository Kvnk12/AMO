    function RotateChart3() {
        var chart6 = $("#StatusChart").data("kendoChart");
        if (chart6.dataSource._data.length > 0) {
            if (chart6._sourceSeries[0].startAngle >= 340)
                chart6._sourceSeries[0].startAngle = 0;
            else
                chart6._sourceSeries[0].startAngle += 20;

            chart6.dataSource.read();
        }

    }

    $('#approveImpl').click(function (e) {
        var chartStatus = $("#chartTrend").data("kendoChart");
        var chart1 = $("#winChartTrend").data("kendoChart");
        if ($(this).is(':checked')) {
            chartStatus.options.series[1].visible = true;
            chartStatus.options.series[3].visible = true;
            chart1.options.series[1].visible = true;
            chart1.options.series[3].visible = true;
            chartStatus.redraw();
            chart1.redraw();
        } else {
            chartStatus.options.series[1].visible = false;
            chartStatus.options.series[3].visible = false;
            chart1.options.series[1].visible = false;
            chart1.options.series[3].visible = false;
            chartStatus.redraw();
            chart1.redraw();
        }
    });




