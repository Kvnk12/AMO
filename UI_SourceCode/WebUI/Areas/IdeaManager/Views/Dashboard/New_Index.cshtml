@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.IncidentNavigator.Controllers;
@using WebUI.Areas.IncidentNavigator.Dto;
@using WebUI.Areas.IncidentNavigator.Models;
@using Kendo.Mvc.UI;
@using System.Data;
@using WebUI.Dto;
@using WebUI.Areas.IdeaManager.Dto;

@{
    ViewBag.Title = "Idea Manager";


    <link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />



    <link rel="stylesheet" href="~/Content/css/bootstrap-3.3.2.min.css" />
    <link rel="stylesheet" href="~/Content/css/bootstrap-multiselect.css" />
    <link rel="stylesheet" href="~/Content/css/custom-styles.css" />
    <script src="~/Content/js/bootstrap.js"></script>
    <script src="~/Scripts/jquery-3.6.0.js"></script>



    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/JScript/kendo.all.min.js"></script>
    <script src="~/Content/js/bootstrap-multiselect.js"></script>
    <script src="~/Scripts/JScript/jszip.min.js"></script>
    <script src="~/Content/js/bootstrap.min.js"></script>
    <script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>

    ViewBag.ImagePathOne = Url.Content("~/Content/images/idea_manager.png");
    Layout = "~/Views/Shared//GenericIdeaManagerLayout.cshtml";
    ClientDetail client = (ClientDetail)Session["SessionClient"];
    var ClientId = client.ClientName;


}
<style>
    .forTooltips {
        width: 90%;
        height: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        /*padding: .929em 1.286em;*/
    }

    .incident-dashboard-container .dashboard-content .top-content-heading .top-content-head {
        justify-content: unset;
    }

    @@media only screen and (min-width: 1750px) and (max-width: 1920px) {
        .head-div {
            width: 561.5px !important;
        }
    }
</style>
<div class="content-main custom-grid dark-bg">
    <div>

        <div>
            <!--start of breadcrumb-->
            <ol class="breadcrumb ">
                <li>Idea Manager</li>
                <li class="active">Dashboard</li>
            </ol>
        </div>
        <!-- Wrap all page content here -->


    </div>
    <input type="hidden" id="category" name="category">
    <input type="hidden" id="InflowOutFlowType" name="InflowOutFlowType">
    <input type="hidden" id="DateField" name="DateField">
    <input type="hidden" id="categoryseries" name="categoryseries">
    <input type="hidden" id="D2StartDate" name="D2StartDate">
    <input type="hidden" id="D2EndDate" name="D2EndDate">

    <div class="content-wrapper incident-dashboard-container">

        <div class="parameter-slider-overlay"></div>
        <div class="parameter-section">
            <div class="action-items">
                <span class="parameter-filter-icon"></span>
            </div>
            <div class="parameter-slider">
                <span class="close-parameters"></span>
                <div class="parameter-list-main">

                    <ul>
                        <li>
                            Start Date :
                            @(Html.Kendo().DatePicker()
                                                                                .Name("start")
                                                .Value(DateTime.Today.AddMonths(-1))
                                                .Format("MM/dd/yyyy")
                            )
                        </li>
                        <li>
                            End Date :
                            @(Html.Kendo().DatePicker()
                                                                                .Name("end")
                                                .Value(DateTime.Today)
                                                .Format("MM/dd/yyyy")
                            )


                        </li>
                        <li>
                            Idea Source :
                            @(Html.Kendo().DropDownList()
                                    .Name("IdeaSourceId")
                                    .DataTextField("Text")
                                    .Enable(true)
                                    //.Value("NTT Data")
                                    .DataValueField("Value")

                                    .DataSource(d => d.Read(r => r.Action("IdeaSourceList", "PostIdea")))
                                    .AutoBind(true)
                              )

                        </li>

                        <li>
                            @(Html.Kendo().Button()
                                   .Name("btnPreview")
                                   .Content("Apply")
                                   .HtmlAttributes(new { type = "button", @class = "k-primary" })
                            )
                        </li>
                    </ul>
                </div>
            </div>

            <div class="dashboard1 dashboard-content active" id="dashboardtab1">
                <div class="top-content">

                    @Html.Partial("_IMDashboardTrend")
                    @Html.Partial("_IMDashboardPriority")
                    @Html.Partial("_IMDashboardStatus")

                </div>
                <div class="bottom-content">

                    @Html.Partial("_IMDashboardChart4")
                    @Html.Partial("_IMDashboardByYear")
                    @Html.Partial("_IMDashboardByMonth")



                </div>
            </div>

        </div>

        <!--#region windows-->
        @Html.Partial("_IMPopupDashboard1")

        <!--#endRegion Windows-->
        @*<input type="text" onkeypress="onKey(event)" onkeydown="offKey(event)">*@

    </div>
    <div id="chartseriesModal" class="custom-popup-grid modal fade" role="dialog" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-popup-title">
                    <label class="custom-white-label" id="gridlabel1"></label>
                    <button type="button" class="close" title="Close" data-bs-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="custom-kendo-grid">
                        @(Html.Kendo().Grid<IdeaDashboardModel>()
                                                    .Name("GridIdeas")
                                                     .Columns(columns =>
                                                    {
                                                        columns.Bound(p => p.Id).Hidden();
                                                        columns.Bound(p => p.IdeaNumber).Title("Idea Number").Width(120);
                                                        columns.Bound(p => p.ItemName).Title("Idea Name").Width(120);
                                                        columns.Bound(p => p.Problem).Title("Description").Width(225).HtmlAttributes(new { @style = "overflow: hidden;text-overflow: ellipsis;white-space: nowrap;" })
                                                        .ClientTemplate("<div class=\"forTooltips\">#=Problem#</div>");
                                                        columns.Bound(p => p.Priority).Title("Priority").Width(120).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.ImplementationPriority).Title("Implementation Priority").Width(120).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.Team).Width(120).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.Goal).Title("Goal/Opportunity").Width(120);
                                                        columns.Bound(p => p.PlannedStartDate).Title("Planned Start Date").Format("{0:MM/dd/yyyy}").Width(120);
                                                        columns.Bound(p => p.ActualStartDate).Title("Actual Start Date").Format("{0:MM/dd/yyyy}").Width(120);
                                                        columns.Bound(p => p.PlannedEndDate).Title("Planned End Date").Format("{0:MM/dd/yyyy}").Width(120);
                                                        columns.Bound(p => p.ActualEndDate).Title("Actual End Date").Format("{0:MM/dd/yyyy}").Width(120);
                                                        columns.Bound(p => p.ImplementationStatus).Title("Implementation Status").Width(120).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.Status).Title("Idea Status").Width(120).Filterable(ftb => ftb.Multi(true));
                                                        //columns.Bound(p => p.TargetProgress).Title("Target Progress").Width(120);
                                                        columns.Bound(p => p.ImplementationProgress).Title("Actual Progress").Width(120);
                                                        columns.Bound(p => p.LastUpdatedDate).Title("Last Updated Date").Format("{0:MM/dd/yyyy}").Width(120);
                                                        columns.Bound(p => p.CreatedDate).Title("Created Date").Format("{0:MM/dd/yyyy}").Width(120);
                                                        columns.Bound(p => p.CompletedDt).Title("Completed Date").Format("{0:MM/dd/yyyy}").Width(120);
                                                        columns.Bound(p => p.IdeaType).Title("Idea Type").Width(120).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.IdeaSource).Title("Idea Source").Width(120).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.InternalInitiative).Title("Internal Initiative").Width(120).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.Complexity).Width(120).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.CreatedBy).Title("Created By/ Proposed By").Width(160).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.ApprovedDate).Title("Approved Date").Format("{0:MM/dd/yyyy}").Width(120);
                                                        columns.Bound(p => p.ApprovedBy).Title("Approved By").Width(120).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.ImplementationManager).Title("Implementation Manager").Width(120).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.LOBDepartment).Title("LOB Department").Width(120).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.Quantification).Title("Quantification").Width(120);
                                                        columns.Bound(p => p.SystemImpactedService).Title("SystemImpactedService").Width(120);
                                                        columns.Bound(p => p.ProposedBy).Title("ProposedBy");
                                                    })
                                                    .ToolBar(tools =>
                                                    {
                                                        tools.Excel().Text("Export - ");
                                                    })
                                                    .Scrollable(e => e.Endless(true))
                                                    .Filterable()
                                                    .Sortable()
                                                    .Pageable()
                                                    .AutoBind(false)
                                                    .Groupable()
                                                    .Excel(excel => excel.FileName("Dashboard_DrillDown_Report.xlsx")
                                                    .Filterable(true)
                                                    .AllPages(true)
                                                    .ProxyURL(Url.Action("Export_Ideas_Save", "ConfigureReport"))
                                                    )
                                                    .Resizable(r => r.Columns(true))
                                                    .DataSource(dataSource => dataSource
                                                    .Ajax()
                                                    .Model(model =>
                                                    {
                                                        model.Id(p => p.Id);

                                                    })
                                                    .PageSize(100)
                                                    //.Batch(true)
                                                    .Read(read => read.Action("GetIdeasdrilldown", "Dashboard").Data("GetdrilldownTrendParameter"))
                                                    )
        )
                    </div>
                </div>
            </div>
        </div>
    </div>
