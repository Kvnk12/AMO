@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.IdeaManager.Controllers;
@using WebUI.Areas.IdeaManager.Dto;
@using WebUI.Areas.IdeaManager.Models;
@using Kendo.Mvc.UI;
@using System.Data;
@using WebUI.Dto;


@(Html.Kendo().Window()
                .Name("chartTrendWindow")
                .Title("Idea Trend by Year/Month")
                .Content(@<text>
                    @(Html.Kendo().Chart<IMChartDashboardModel>
                                                ()
                                                .Name("winChartTrend")
                                                .Legend(legend => legend
                                                    .Visible(true)
                                                    .Align(ChartLegendAlign.Start)
                                                    .Position(ChartLegendPosition.Bottom)
                                                    )
                                                      .ChartArea(chartArea => chartArea
                                                .Background("transparent")
                                                .Height(400)
                                                )
                                                .DataSource(ds => ds.Read(read => read.Action("GetDashboardTrend", "Dashboard").Data("ParameterDataTrend")))
                                                 .AutoBind(false)
                                                .Series(series =>
                                                {
                                                    series.Line(model => model.IdeaCount).Name("No. of Approved Ideas").Axis("TktCnt").Labels(labels => labels.Format("{0:N0}").Background("transparent").Color("#19BDFF").Visible(true)).Color("#19BDFF").Visible(true)
                                                                                                                                                                                                           .Color("#19BDFF");
                                                    series.Line(model => model.ResolvedCount).Name("No. of Implemented Ideas").Axis("TktCnt").Labels(labels => labels.Format("{0:N0}").Background("transparent").Color("#2FB447").Padding(0, 0, -45, 0).Visible(true))
                                                                                                                                                                                            .Color("#2FB447").Visible(false);
                                                    series.Line(model => model.TrendVal).Style(ChartLineStyle.Smooth).DashType(ChartDashType.Dot).Markers(markers => markers.Visible(false)).Axis("TktCnt").Labels(labels => labels.Visible(false)).Color("#616A6B").Visible(true);
                                                    series.Line(model => model.ResolvedTrend).Name("ImplementedTrend").Style(ChartLineStyle.Smooth).DashType(ChartDashType.Dot).Markers(markers => markers.Visible(false)).Axis("TktCnt").Labels(labels => labels.Visible(false)).Color("#616A6B").Visible(false);



                                                })
                                                .CategoryAxis(axis => axis
                                                .Min(0)
                                                .Max(13)
                                                .Categories(model => model.DrpCategory)
                                                .MajorGridLines(lines => lines.Visible(false))
                                                .Labels(labels => labels.Rotation("auto"))
                                                .AxisCrossingValue(0, 1000)
                                                .Crosshair(c => c.Visible(true).DashType(ChartDashType.Dot))
                                                //.Title(title => title.Text("Year/Month").Font("12px Arial,Helvetica,sans-serif"))
                                                )

                                                .ValueAxis(axis => axis.Numeric("TktCnt")
                                                .Labels(labels => labels.Format("{0:N0}"))
                                                //.Visible(true)
                                                 .MajorGridLines(1, "#D7DBDD", ChartDashType.Dot)
                                                //.MajorGridLines(lines => lines.Visible(true))
                                                //.MajorUnit(100)
                                                )
                                                .Tooltip(tooltip => tooltip
                                                .Visible(true)
                                                .Template("#= series.name #: #= value #"))
                                                .Pannable(pannable => pannable
                                                .Lock(ChartAxisLock.Y)
                                                )
                                                .Zoomable(zoomable => zoomable
                                                .Mousewheel(mousewheel => mousewheel.Lock(ChartAxisLock.Y))
                                                .Selection(selection => selection.Lock(ChartAxisLock.Y))
                                                )
                                                 .Events(events => events

            .DataBound("winInflow_onDataBound")
           // .Render("onRender")
        )

                    )
                </text>)
                                                .Visible(false)
                                                .Draggable()
                                                .Resizable()
                                                .Width(1000)
                                                .Height(500)
                                                .AutoFocus(false)
                                                .Modal(true)

                                                .Actions(actions => actions.Close())

)
@(Html.Kendo().Window()
                .Name("ChartPriortyWindow")
                .Title("Distribution By Priority")
                .Content(@<text>

                    @(Html.Kendo().Chart<IMChartDashboardModel>()
                                                .Name("winChartPriority")
                                               .Legend(legend => legend
                                .Visible(true)
                                .Align(ChartLegendAlign.Start)
                                .Position(ChartLegendPosition.Bottom)
                                //.Offset(1, 1)
                                )
                                                .ChartArea(chartArea => chartArea
                                                .Background("transparent")
                                                //.Height(280)
                                                )
                                                .DataSource(ds => ds.Read(read => read.Action("GetDashboardTower", "Dashboard").Data("GetPriorityParameter")))
                                                .AutoBind(false)
                                                .Series(series =>
                                                {
                                                    series.Bar(model => model.IdeaCount).Name("Ideas Count").Spacing(0).CategoryField("DrpCategory").Labels(labels => labels.Background("transparent").Template("#= value# #= kendo.format('{0:P}', percentage)#").Visible(true)).Color("#19BDFF");
                                                    series.Bar(model => model.Percent).Name("Percentage").Axis("%").CategoryField("DrpCategory").Labels(labels => labels.Background("transparent").Template("#= value# %").Visible(true)).Tooltip(tooltip => tooltip.Visible(true).Color("#000000").Template("#= series.name #: #= value # %")).Color("LightGray");


                                                })
                                                .CategoryAxis(axis => axis
                                                //.Categories(model =>model.)
                                                 .Labels(labels => labels.Visible(true).Template("P:#= value# ")/*.Mirror(true)*/)
                                                .Line(line => line.Visible(false))
                                               // .Labels(labels => labels.Rotation("auto"))
                                                .MajorGridLines(1, "#D7DBDD", ChartDashType.Dot)
                                                //.MajorGridLines(lines => lines.Visible(true))
                                                //.Title(title => title.Text("Priority").Font("12px Arial,Helvetica,sans-serif"))
                                                )
                                                .ValueAxis(axis => axis
                                                .Numeric()
                                                //.Max(10)
                                                .Line(line => line.Visible(false))
                                                .Labels(labels => labels.Rotation("auto"))
                                                .MajorGridLines(lines => lines.Visible(false))

                                                )
                                                     .ValueAxis(axis => axis
            .Numeric("%")
             .Min(0).Max(100)
             .Labels(labels => labels.Format("{0}%").Visible(false))
            .Line(line => line.Visible(false))
             .MajorGridLines(lines => lines.Visible(false))
        // .AxisCrossingValue(-10)
        )
                                                .Tooltip(tooltip => tooltip
                                                //.Background("transparent")
                                                .Visible(true)
                                                .Color("#000000")
                                                .Template("#= series.name #: #= value #  #= kendo.format('{0:P}', percentage)#")

                                                )
                    )

                </text>)
                                                .Visible(false)
                                                .Draggable()
                                                .Resizable()
                                                .Width(1100)
                                                .Height(500)
                                                .AutoFocus(true)
                                                .Modal(true)

                                                .Actions(actions => actions.Close())

)
@(Html.Kendo().Window()
                .Name("ChartStatusWindow")
                .Title("Distribution By Status")
                .Content(@<text>

                    @(Html.Kendo().Chart<IMChartDashboardModel>()
