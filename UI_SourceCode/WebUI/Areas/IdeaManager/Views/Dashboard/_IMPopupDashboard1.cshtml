                                                .Height(500)
                                                .AutoFocus(true)
                                                .Modal(true)

                                                .Actions(actions => actions.Close())

)
@(Html.Kendo().Window()
                .Name("Chart4Window")
                .Title("Idea Distribution")
                .Content(@<text>

                    @(Html.Kendo().Chart<IMChartDashboardModel>()
                                                .Name("winChart4")
                                                .Legend(legend => legend
                                                .Visible(false)
                                                )

                                                .ChartArea(chartArea => chartArea
                                                .Background("transparent")
                                                //.Height(480)
                                                )
    .DataSource(ds => ds.Read(read => read.Action("GetDashboardTower", "Dashboard").Data("ParameterDatanew4")))
    .AutoBind(false)
    .Series(series =>
    {
        series.Column(model => model.Percent).Name("Percentage").Axis("%").CategoryField("LongCategory").Spacing(-1).Labels(labels => labels.Background("transparent").Template("#= value# %").Visible(true).Position(ChartBarLabelsPosition.InsideBase)).Visible(true).Color("transparent");
        series.Column(model => model.IdeaCount).Name("Idea Count").CategoryField("LongCategory").Labels(labels => labels.Position(ChartBarLabelsPosition.OutsideEnd).Background("transparent").Visible(true)).Color("#19BDFF");

    })
    .CategoryAxis(axis => axis
    .Min(0)
    .Max(8)
    //.Categories(model =>model.)
    .MajorGridLines(lines => lines.Visible(false))
    .Labels(labels => labels.Rotation(-90))
    .AxisCrossingValue(0, 1000)
    .Title(title => title.Text("Idea Type"))
    )

    .ValueAxis(axis => axis
    .Numeric()
    //.Max(10)
    .Line(line => line.Visible(true))
    //.Labels(labels => labels.Rotation(-90))
    //.MajorGridLines(lines => lines.Visible(true))
    .MajorGridLines(1, "#D7DBDD", ChartDashType.Dot).Visible(true)
    .Title(title => title.Text("Total Ideas"))
    // .Title(title => title.Text("drpval"))
    )
    .ValueAxis(axis => axis
            .Numeric("%")
             .Min(0).Max(100)
             .Labels(labels => labels.Format("{0}%").Visible(true))
            .Line(line => line.Visible(false))
              .MajorGridLines(lines => lines.Visible(false))
        )


                                                .Tooltip(tooltip => tooltip
                                                //.Background("transparent")
                                                .Visible(true)
                                                .Color("#000000")
                                                .Template("#= series.name #: #= value #")

                                                )
                                                .Pannable(pannable => pannable
                                                .Lock(ChartAxisLock.Y)
                                                )
                                                .Zoomable(zoomable => zoomable
                                                .Mousewheel(mousewheel => mousewheel.Lock(ChartAxisLock.Y))
                                                .Selection(selection => selection.Lock(ChartAxisLock.Y))
                                                )
                                                   .Events(events => events
            .DataBound("onChangeWinTitle_onDataBound")
        )
                    )
                </text>)
                                                .Visible(false)
                                                .Draggable()
                                                .Resizable()
                                                .Width(1000)
                                                .Height(500)
                                                .AutoFocus(true)
                                                .Modal(true)
                                                .Actions(actions => actions.Close())
)
