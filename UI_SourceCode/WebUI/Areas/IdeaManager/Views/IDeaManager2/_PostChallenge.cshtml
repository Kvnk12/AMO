    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;


        //if (charCode != 46 && charCode > 31
        //&& (charCode < 48 || charCode > 57))
        //    return false;

        if ((charCode < 48 || charCode > 57))
            if (charCode != 46 && charCode != 44 && charCode > 31
              && (charCode < 48 || charCode > 57))
                return false;

        return true;
    }


    $('#btnSave').click(function () {
        
        var SelectedclientId = $('#ClientId :selected').val();
        if (SelectedclientId == "" || SelectedclientId == "0") {
            alert('Please Select Client name from the list');
            return false;
        }

        if ($('#txtidea').val() == "") {
            alert('Please enter name');
            $('#txtidea').focus();
            return false;
        }
        else {
            
            var ideaName = $('#txtidea').val();
            var ideaId = $('#IdeaId')[0].value;

            IdeaNameExists(ideaName, ideaId);
            if (blnIdeaNameExists) {
                alert('Idea name already exists, please change');
                $('#txtidea').focus();
                return false;

            }
        }



       
    });        


    function IdeaNameExists(IdeaName, IdeaId) {

            var localToServer = "/";
            var sPageURL = window.location.search.substring(1);
            var sURLVariables = sPageURL.split('&');

            if (window.location.pathname.split("/")[1].toLocaleLowerCase() != "ideamanager") {
                localToServer = "/" + window.location.pathname.split("/")[1] + "/";
            }

            var strUrl = window.Location.constructor("http://" + window.location.host + localToServer + "IdeaManager/IdeaManager2/CheckIdeaName");
            
             {
                $.ajax({
                    url: strUrl,
                    type: 'POST',
                    data: { IdeaName: IdeaName, IdeaId: IdeaId},
                    success: checkItemSuccess,
                    failure: errorItem,
                    async: false

                })
            }
            
        }

    function checkItemSuccess(status) {


        blnIdeaNameExists = status;
            
            
            
        }

    function errorItem() {
            alert('An error occurred. Please contact administrator');
        }


        

        $('.tab-pane a').click(function (e) {
            $("#success").hide();
            $("#danger").hide();
            
        })
    
</script>
         