@using NTTData.AMOPortal.Domain.Entities
@using WebUI.Areas.AlignmentManager.Models
@using WebUI.Areas.AlignmentManager.Objects
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@model NTTData.AMOPortal.WebUI.Dto.IMPostIdeaInput


    @{ 
        if (Model.ClientId > 0 && Model.postIdeaInput.Id > 0)
            {
            <div class="cptblacc">
        <table width="75%" border="1" cellspacing="10" cellpadding="10" class="table table-striped ">
            <tr>
                <th width="100%" scope="col">Idea & Category</th>

            </tr>





            @{
            foreach (IMIdea ideaItem in Model.postIdeaInput.GetIdea)
                {
                <tr>
                    <td>
                        <div class="col-sm-0">
                            @Html.Label(ideaItem.Idea, new { @class= "", id = "" })
                        </div>
                    </td>
                </tr>
                foreach (vwIMaccountwithcat idea in Model.postIdeaInput.GetCatAndIdea.Where(c => c.IdeaId == ideaItem.Id))
                    {  
                <tr>
                    <td>
                        <div class="col-sm-0">
                            @if (Model.postIdeaInput.GetMapIdeas.Where(c => c.IdeaId == Model.postIdeaInput.Id && c.CategoryId == idea.Id).Count() > 0)
                                {
                                @Html.CheckBox(idea.Id.ToString() + "Category2", new { @class = "metricchk", placeholder = "", id = idea.Id.ToString() + "Category2", @checked = "checked" })
                                }
                            else
                                {
                                @Html.CheckBox(idea.Id.ToString() + "Category2", new { @class = "metricchk", placeholder = "", id = idea.Id.ToString() + "Category2", })
                                }
                            @Html.Label(idea.Category2, new { @class = "", id = "" })
                        </div>
                    </td>
                </tr>
                    }
                }
            }
        </table>
                 <div id="idea">
                <button class="btn btn-primary" id="btnCatSave" name="command" value="savecategory" style="margin-left: 40%">Assign Category</button>
                <button class="btn btn-default">Cancel</button>
            </div>
                </div>
            }
            
    }


