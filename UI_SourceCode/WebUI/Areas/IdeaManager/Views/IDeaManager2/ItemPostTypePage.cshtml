<script>
    $(document).ready(function () {
        
        
        $('select#ClientId').change(function () {
            var SelectedclientId = $('#ClientId :selected').val();
            
            if (SelectedclientId != 0) {
                var localToServer = "/";
                var sPageURL = window.location.search.substring(1);
                var sURLVariables = sPageURL.split('&');
                //debugger;
                if (window.location.pathname.split("/")[1].toLocaleLowerCase() != "ideamanager") {
                    localToServer = "/" + window.location.pathname.split("/")[1] + "/";
                }

                var strUrl = window.Location.constructor("http://" + window.location.host + localToServer + "IdeaManager/IdeaManager2/DisplayHomePage/?clientId={clientId}");

                //window.location = strUrl;

                strUrl = strUrl.replace("{clientId}", SelectedclientId);
                window.location = strUrl;
            }

        });

    });


    $('#cancelChallenge').click(function () {


        var confirm = window.confirm('Do you want cancel the changes?');
        if (confirm) {

            var localToServer = "/";
            var sPageURL = window.location.search.substring(1);
            var sURLVariables = sPageURL.split('&');

            if (window.location.pathname.split("/")[1].toLocaleLowerCase() != "ideamanager") {
                localToServer = "/" + window.location.pathname.split("/")[1] + "/";
            }

            

            var strUrl = window.Location.constructor("http://" + window.location.host + localToServer + "ideamanager/ideamanager2/DisplayIdeas/?clientId={clientId}");

            strUrl = strUrl.replace("{clientId}", "@Model.ClientId");
                window.location = strUrl;
                return false;
            }
            else { return false; }

            });

    $('#homepage').click(function () {

        var localToServer = "/";
        var sPageURL = window.location.search.substring(1);
        var sURLVariables = sPageURL.split('&');

        if (window.location.pathname.split("/")[1].toLocaleLowerCase() != "ideamanager") {
            localToServer = "/" + window.location.pathname.split("/")[1] + "/";
        }
        var strUrl = window.Location.constructor("http://" + window.location.host + localToServer + "ideamanager/ideamanager2/DisplayIdeas/?clientId={clientId}");

        strUrl = strUrl.replace("{clientId}", "@Model.ClientId");
                    window.location = strUrl;
                    return false;


    });

</script>






