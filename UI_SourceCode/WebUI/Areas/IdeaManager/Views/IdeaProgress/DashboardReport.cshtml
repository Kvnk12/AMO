        <br />
        <div>
            @(Html.Kendo().Grid<TasksDetails>()
            .Name("TaskDetails")
            .Columns(column =>
            {
                column.Bound(e => e.T_Phase).Title("Phase");
                column.Bound(e => e.T_Status).Title("Status");
                column.Bound(e => e.T_ActualStart).Title("Actual Start Date").Format("{0:MM/dd/yyyy}");
                column.Bound(e => e.T_ActualEnd).Title("Actual End Date").Format("{0:MM/dd/yyyy}");
                column.Bound(e => e.T_PlannedStart).Title("Planned Start Date").Format("{0:MM/dd/yyyy}");
                column.Bound(e => e.T_PlannedEnd).Title("Planned End Date").Format("{0:MM/dd/yyyy}");
                column.Bound(e => e.T_PercentCompleted).Title("Percentage Completed").Format("{0:p}");
            })
            .Pageable()
            //.HtmlAttributes(new { style = "width:850px" })
            .Sortable()

            .DataSource(datasource => datasource
            .Ajax()
            .PageSize(7)
            .Read(read => read.Action("ReadTaskDetails", "IdeaProgress").Data("getIdeaId"))
                    )
