<script>
    var resoucesdEdited = false;

    function onEdit(e) {
        var gantt = e.sender;
        resoucesdEdited = false;

        if (e.task) {
            e.container.on('click', 'div[data-container-for="resources"] > a', function (event) {
                event.preventDefault();
                resoucesdEdited = true;
                gantt._createResourceEditor(e.container.find('div.k-gantt-resources'), e.task);
            });
        }
    }
    function onSave(e) {
        if (e.task && resoucesdEdited) {
            this._updateAssignments(e.task.get("id"), e.task.get(this.resources.field));
        }
    }
    function onUpdateCreate(e) {
        e.End = e.End.toISOString();
        e.Start = e.Start.toISOString();
        var ticketType = $("#IdeaItem").data("kendoDropDownList");
        if (ticketType == null || ticketType == '') {

            e.IdeaPostId = 0;
        }
        else {

            e.IdeaPostId = ticketType.value();

        }
    }
    function getPppIdeaId() {
        var ticketType123 = $("#IdeaItem").data("kendoDropDownList");
        //alert(ticketType123.value());
        if (ticketType123 == null || ticketType123 == '') {
            //alert(ticketType.value());
            return {
                PppIdeaId: 0
            };
        }
        else {
            return {

                PppIdeaId: ticketType123.value()
            };
        }
    }
    function getIdeaId() {
        //alert('here');
        var ticketType = $("#IdeaItem").data("kendoDropDownList");
        if (ticketType == null || ticketType == '') {
            //alert(ticketType.value());
            return {
                PIdeaId: 0
            };
        }
        else {
            return {

                PIdeaId: ticketType.value()
            };
        }
    }
    function onChangeIdea(e)
    {
        var taskGrid = $("#TaskDetails").data("kendoGrid");
        taskGrid.dataSource.read();

        //var gantt = $("#TaskGantt").data("kendoGantt");
        //gantt.dataSource.read();
        //gantt.resize();
        //gantt.refresh();

        var PostIdea = $("#IdeaItem").data("kendoDropDownList");
            var PostIdeaId = PostIdea.value();

            var modu = {
                IdeaId: PostIdeaId
            };
           // alert(JSON.stringify(modu));
            //var data1 = JSON.stringify(modu);
            var baseurl = '@Url.Content("~/IdeaProgress/ReportIdeaDetails")';
            $.ajax({
                url: baseurl,
                type: "POST",
                async: false,
                data: modu,
                error: function (response) {
                   // alert(JSON.stringify(response));
                },
                success: function (response) {

                    $("#IdeaName").empty();
                    $("#LOBManager").empty();
                    $("#IdeaDate").empty();
                    $("#ProgressStatus").empty();

                    $("#ActualStart").empty();
                    $("#ActualEnd").empty();
                    $("#PlannedStart").empty();
                    $("#PlannedEnd").empty();

                    $("#Complexity").empty();
                    $("#Responsible").empty();
                    $("#Risk").empty();
                    $("#RiskMitigation").empty();

                    $("#CurrentPriority").empty();
                    $("#LastUpdatedPriority").empty();
                    $("#ProgressStatusColor").css('background-color', "white");

                    //assigning
                    $("#IdeaName").append(document.createTextNode(response.IdeaName));
                    $("#LOBManager").append(document.createTextNode(response.LOBManager));
                    var respideaDate = kendo.toString(response.IdeaDate, 'MM/dd/yyyy HH:mm:ss');
                    //alert(respideaDate);
                    $("#IdeaDate").append(document.createTextNode(response.IdeaDate));
                    $("#ProgressStatus").append(document.createTextNode(response.ProgressStatus));

                    var resActStart = kendo.toString(response.ActualStart, 'MM/dd/yyyy HH:mm:ss');
                    //$("#ActualStart").append(document.createTextNode(resActStart));
                    $("#ActualStart").append(document.createTextNode(response.ActualStart));
                    var resActEnd = kendo.toString(response.ActualEnd, 'MM/dd/yyyy HH:mm:ss');
                    $("#ActualEnd").append(document.createTextNode(response.ActualEnd));
                    var resPlanStart = kendo.toString(response.PlannedStart, 'MM/dd/yyyy HH:mm:ss');
                    $("#PlannedStart").append(document.createTextNode(response.PlannedStart));
                    var resPlanEnd = kendo.toString(response.PlannedEnd, 'MM/dd/yyyy HH:mm:ss');
                    $("#PlannedEnd").append(document.createTextNode(response.PlannedEnd));

                    $("#Complexity").append(document.createTextNode(response.Complexity));
                    $("#Responsible").append(document.createTextNode(response.Responsible));
                    $("#Risk").append(document.createTextNode(response.Risk));
                    $("#RiskMitigation").append(document.createTextNode(response.RiskMitigation));

                    $("#CurrentPriority").append(document.createTextNode(response.CurrentPriority));
                    $("#LastUpdatedPriority").append(document.createTextNode(response.LastUpdatedPriority));
                    $(".dot").css('background-color', response.ProgressStatusColor);
                    //alert("asd");
                    var gantt11 = $("#gantt").data("kendoGantt");
                    gantt11.dataSource.read();
                }
            });


    }

    function GetIdeaId() {
        //alert('here');
        var ticketType = $("#IdeaItem").data("kendoDropDownList");
        if (ticketType == null || ticketType == '') {
            //alert(ticketType.value());
            return {
                PostIdeaId: 0
            };
        }
        else {
            return {

                PostIdeaId: ticketType.value()
            };
        }
    }
</script>
<div id="wrap" style="height:1100px">
    <div class="" style="padding: 0;">
        <div>
