<script type="text/javascript">
    $(document).ready(function () {


        $('select#ClientId').change(function () {
            //var SelectedclientId = $('#ClientId :selected').val();
            var SelectedclientId = @ClientID;
            if (SelectedclientId != 0) {


                var href = window.location.href.split('/');
                //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
                var baseurl = '';



                if (href[3].toLowerCase() == 'ideamanager') {
                    var baseurl = href[0] + '//' + href[2] + '/' + 'IdeaManager/ChallengeHistoryManager/DisplayHomePage/?clientId={clientId}';
                }
                else {
                    var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'IdeaManager/ChallengeHistoryManager/DisplayHomePage/?clientId={clientId}';
                }

                baseurl = baseurl.replace("{clientId}", SelectedclientId);
                window.location = baseurl;
                return false;

            }

        });

    });


    $('#cancelidea').click(function () {


        var confirm = window.confirm('Do you want cancel the changes?');
        if (confirm) {


            var href = window.location.href.split('/');
            //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
            var baseurl = '';



            if (href[3].toLowerCase() == 'ideamanager') {
                var baseurl = href[0] + '//' + href[2] + '/' + 'ideamanager/ChallengeHistoryManager/DisplayChallenges/?clientId={clientId}';
            }
            else {
                var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'ideamanager/ChallengeHistoryManager/DisplayChallenges/?clientId={clientId}';
            }

            baseurl = baseurl.replace("{clientId}", "@Model.ClientId");
            window.location = baseurl;
            return false;
            }
            else { return false; }

            });

    $('#homepage').click(function () {


        var href = window.location.href.split('/');

        var baseurl = '';



        if (href[3].toLowerCase() == 'ideamanager') {
            var baseurl = href[0] + '//' + href[2] + '/' + 'ideamanager/ChallengeHistoryManager/DisplayChallenges/?clientId={clientId}';
        }
        else {
            var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'ideamanager/ChallengeHistoryManager/DisplayChallenges/?clientId={clientId}';
        }
        baseurl = baseurl.replace("{clientId}", "@Model.ClientId");
        window.location = baseurl;
        return false;


    });

</script>






