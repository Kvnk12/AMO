@using NTTData.AMOPortal.Domain.Entities
@using WebUI.Areas.AlignmentManager.Models
@using WebUI.Areas.AlignmentManager.Objects
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@using WebUI.Areas.IdeaManager.Dto;
@using PagedList.Mvc;
@using PagedList;
@*@model NTTData.AMOPortal.WebUI.Dto.IMPostChallengeInput*@
@model IPagedList<NTTData.AMOPortal.WebUI.Dto.IMPostChallengeModel>
    <style>
        table.table thead tr th {
            background: #47A3DA none repeat scroll 0% 0%;
            color: #FFF;
            padding: 12px;
        }
    </style>
    @{
        ViewBag.Title = "Idea Manager";
        ViewBag.ImagePathOne = Url.Content("~/Content/images/IMlogo.png");
        Layout = "~/Views/Shared/_AppLayout.cshtml";
        var Client = (Client)Session["Client"];
        var ClientID = Client.Id;
    }

    @section IMTOPMenu {
        @Html.Partial("_IMTopMenu")
    }

    <div>
        <ol class="breadcrumb">
            <li><a href="#">Idea Manager</a></li>
            <li class="active"><a href="#">View Challenges</a></li>
        </ol>
    </div>
    <div style="padding:0;height:1000px">
        <div class="">

            @{




                <div>

                    <div>
                        <div>
                            <table class="table table-striped" id="pp38Home" cellpadding="0" cellspacing="0" style="width: 100%">
                                <thead>
                                    <tr>
                                        @*<th width="45%" scope="col">Challenges</th>*@
                                    <tr>
                                        <th colspan="6"><u>@Html.ActionLink("Last Modified Date", "DisplayChallenges", new { Page = Model.PageNumber, sortOrder = ViewBag.LastModifiedDate }, new { @style = "color:white;" })</u></th>
                                        <th colspan="6"><u>@Html.ActionLink("Challenges", "DisplayChallenges", new { Page = Model.PageNumber, sortOrder = ViewBag.Challenges }, new { @style = "color:white;" }) </u></th>
                                        <th colspan="6"><u>@Html.ActionLink("Posted by", "DisplayChallenges", new { Page = Model.PageNumber, sortOrder = ViewBag.Postedby }, new { @style = "color:white;" })</u></th>
                                        <th colspan="6"><u>@Html.ActionLink("Status", "DisplayChallenges", new { Page = Model.PageNumber, sortOrder = ViewBag.Status }, new { @style = "color:white;" })</u></th>
                                        <th colspan="6"><u>@Html.ActionLink("Status Comments", "DisplayChallenges", new { Page = Model.PageNumber, sortOrder = ViewBag.StatusComments }, new { @style = "color:white;" })</u></th>
                                        <th colspan="6"><u>@Html.ActionLink("Created Date", "DisplayChallenges", new { Page = Model.PageNumber, sortOrder = ViewBag.CreatedDate }, new { @style = "color:white;" })</u></th>
                                    </tr>

                                    </tr>
                                </thead>
                                @{
                                    //if (Model.ClientId > 0)
                                    //    {

                                    var uid = (int)Session["UserId"];
                                    //IList<IMPostChallenge> postItems = Model.GetChallengeItems;
                                    foreach (var vwItem in Model)
                                    {
                                        var name = (IMStatus)vwItem.StatusId;
                                        <tr>
                                            <td colspan="6">@vwItem.LastUpdatedDate</td>
                                            <td colspan="6">@Html.ActionLink(vwItem.ItemName, "DislayChallengeHistory", "ChallengeHistoryManager", new { ClientId = vwItem.ClientId, ItemId = vwItem.Id }, null)</td>
                                            <td colspan="6">@vwItem.CreatedByUser</td>
                                            <td colspan="6">
                                                @if (vwItem.StatusId == 3 && (vwItem.CreatedBy == uid))
                                                {
                                                    <div data-toggle="tooltip" data-placement="right" title="Click here if Idea is Implemented" style="overflow: hidden; text-overflow: ellipsis;">
                                                        @name <br /> (@Html.ActionLink("Mark as Implemented", "implementedStatus", "IdeaManager", new { idid = vwItem.Id }, null))
                                                    </div>
                                                }
                                                else
                                                {
                                                    @name
                                                }
                                            </td>
                                            <td colspan="6">@vwItem.StatusComments</td>
                                            <td colspan="6">@vwItem.CreatedDate</td>
                                        </tr>

                                    }

                                    // }


                                }

                            </table>
                            <div class="pagination">
                                @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
                                @Html.PagedListPager(Model, page => Url.Action("DisplayChallenges", new { page = page, sortOrder = Request["sortOrder"] }))
                            </div>
                        </div>
                    </div>
                </div>
                                    //}
            }

        </div>

    </div>
