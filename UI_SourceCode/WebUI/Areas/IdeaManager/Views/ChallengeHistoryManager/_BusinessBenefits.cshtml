@using NTTData.AMOPortal.Domain.Entities
@using WebUI.Areas.AlignmentManager.Models
@using WebUI.Areas.AlignmentManager.Objects
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@model NTTData.AMOPortal.WebUI.Dto.IMPostChallengeInput
<style>
    #BusinessBenefits td:nth-child(3), #BusinessBenefits td:nth-child(4) {
        text-align: right;
    }
    #BusinessBenefits td:nth-child(3)::before
    {
        content:'$';
    }
</style>

<div id="BusinessBenefits" style="width:100%"></div>


<script type="text/javascript">
    $(document).ready(function () {
        var ItemId = "@Model.Id";

        var href = window.location.href.split('/');
        //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
        var baseurl = '';


        if (ItemId != null) {
            $('#BusinessBenefits').jtable({
                title: 'Business Benefits',
                actions: {
                    listAction: "@Url.Action("GetBusinessBenefitDetails")"+ "?ItemId="+ItemId
                },
                fields: {
                    Id: {
                        key: true,
                        list: false
                    },
                    ItemId:
                        {
                            key: true,
                            list: false
                        },
                    Name: {
                        title: 'Name',
                        width: '30%'
                    },


                    Detail: {
                        title: 'Details',
                        width: '30%'
                    },

                    Value: {
                        title: 'Value',
                        width: '20%'
                    },
                    FTEHours: {
                        title: 'FTE Hours',
                        width: '20%'
                    }
                },
                formCreated: function (event, data) {
                    data.form.find('input[name="Name"]').addClass(
                      'validate[required]');
                    data.form.find('input[name="Detail"]').addClass(
                      'validate[required]');
                    data.form.find('input[name="Name"]').addClass(
                      'validate[required]');
                    data.form.find('input[name="Detail"]').addClass(
                      'validate[required]');
                    data.form.find('input[name="FTEHours"]').addClass(
                      'validate[required,custom[number]]');
                    data.form.find('input[name="Value"]').addClass(
                      'validate[required,custom[number]]');

                    data.form.validationEngine();
                },
                formSubmitting: function (event, data) {
                    return data.form.validationEngine('validate');
                },
                formClosed: function (event, data) {
                    data.form.validationEngine('hide');
                    data.form.validationEngine('detach');
                }



            });
            $('#BusinessBenefits').jtable('load');

        }
    });

</script>
