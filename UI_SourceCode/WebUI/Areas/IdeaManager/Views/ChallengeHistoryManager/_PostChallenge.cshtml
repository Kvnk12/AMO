    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;


        //if (charCode != 46 && charCode > 31
        //&& (charCode < 48 || charCode > 57))
        //    return false;

        if ((charCode < 48 || charCode > 57))
            if (charCode != 46 && charCode != 44 && charCode > 31
              && (charCode < 48 || charCode > 57))
                return false;

        return true;
    }


    $('#btnSave').click(function () {

        var SelectedclientId = $('#ClientId :selected').val();
        if (SelectedclientId == "" || SelectedclientId == "0") {
            alert('Please Select Client name from the list');
            return false;
        }

        if ($('#txtchallange').val() == "") {
            alert('Please enter name');
            $('#txtchallange').focus();
            return false;
        }
        else {

            var itemName = $('#txtchallange').val();
            var itemId = $('#ItemId')[0].value;

            ItemNameExists(itemName, itemId);
            if (blnItemNameExists) {
                alert('Item name already exists, please change');
                $('#txtchallange').focus();
                return false;

            }
        }




    });


    function ItemNameExists(ItemName, ItemId) {


        var href = window.location.href.split('/');
        //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
        var baseurl = '';



        if (href[3].toLowerCase() == 'ideamanager')
        {
            var baseurl = href[0] + '//' + href[2] + '/' + 'IdeaManager/ChallengeHistoryManager/CheckItemName';
        }
        else
        {
            var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'IdeaManager/ChallengeHistoryManager/CheckItemName';
        }
        //var localToServer = "/";
        //var sPageURL = window.location.search.substring(1);
        //var sURLVariables = sPageURL.split('&');

        //if (window.location.pathname.split("/")[1].toLocaleLowerCase() != "ideamanager") {
        //    localToServer = "/" + window.location.pathname.split("/")[1] + "/";
        //}

        //var strUrl = window.Location.constructor("http://" + window.location.host + localToServer + "IdeaManager/IdeaManager/CheckItemName");

        {
            $.ajax({
                url: baseurl,
                type: 'POST',
                data: { ItemName: ItemName, ItemId: ItemId },
                success: checkItemSuccess,
                failure: errorItem,
                async: false

            })
        }

    }

    function checkItemSuccess(status) {


        blnItemNameExists = status;



    }

    function errorItem() {
        alert('An error occurred. Please contact administrator');
    }




    $('.tab-pane a').click(function (e) {
        $("#success").hide();
        $("#danger").hide();

