@model IMPostChallengeInput

<div id="ApproversList" style="width:100%;margin:auto"></div>

<script type="text/javascript">
    $(document).ready(function () {
        var ItemId = "@Model.Id";
        var href = window.location.href.split('/');

        //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';

        var baseurl = '';
        if (ItemId != null) {

            $('#ApproversList').jtable({
                title: 'Approvers List',
                actions: {
                    listAction: "@Url.Action("GetApproversList")" + "?ChallengeId=" + ItemId
                },

                fields: {
                    Name: {
                        title: 'Approver Name',
                        width: '50%'
                    },

                    ApprovedDate: {
                        title: 'Approved Date',
                        width:'50%'
                    }

                }

            });

            $('#ApproversList').jtable('load');



        }

    });

</script>

