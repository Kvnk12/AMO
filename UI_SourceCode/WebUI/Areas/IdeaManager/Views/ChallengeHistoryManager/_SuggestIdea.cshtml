    function SaveSelectedIdeas()
    {
        var ClientId = "@Model.ClientId";
        var ItemId = "@Model.Id";
        var IdeaIds = "";
        var href = "@Url.Action("AddSelectedIdeas")" + "?ClientId=" + ClientId;

        var $selectedRows = $('#SuggestIdeas').jtable('selectedRows');

        if ($selectedRows.length > 0) {
            //Show selected rows
            $selectedRows.each(function () {
                var record = $(this).data('record');
                IdeaIds += "," + record.Id;
            });
        } else {
            //No rows selected
            $('#SelectedRowList').append('No row selected! Select rows to see here...');
        }


            {
                $.ajax({
                    url: href,
                    type: 'POST',
                    data: {ItemId:ItemId, ClientId:ClientId,  IdeaIds:IdeaIds},
                    success: checkLinkIdeaSuccess,
                    failure: errorLinkIdeaFailure,
                    async: false

                })
            }

            return true;
    }

    function checkLinkIdeaSuccess(data)
    {
        if (data == "Success")
        {
            alert('Selected Ideas linked successfully');
            recordadd();
        }

    }


