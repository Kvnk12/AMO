@using NTTData.AMOPortal.Domain.Entities
@using System.Web.Configuration;
@using NTTData.AMOPortal.WebUI.Dto
@using Telerik.Reporting
@using Telerik.ReportViewer.Mvc
@using WebUI.Areas.TransformationAccelerator.Controllers;
@using WebUI.Areas.TransformationAccelerator.Model;
@using Kendo.Mvc.UI;
@using System.Data;
@using WebUI.Dto;
@model TAReportObservationModel

@{
    ViewBag.Title = "Transformation Accelerator";

    <link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />

    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />
    <link rel="stylesheet" href="~/Content/css/bootstrap-3.3.2.min.css" />
    /*new*/
    <link rel="stylesheet" href="~/Content/css/bootstrap-multiselect.css" />
    /*new*/


    <link rel="stylesheet" href="~/Content/css/custom-styles.css" />


    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/JScript/kendo.all.min.js"></script>
    <script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/jszip/2.4.0/jszip.min.js"></script>
    ViewBag.ImagePathOne = Url.Content("~/Content/images/home/transformation_accelerator_white.svg");
    //Layout = "~/Areas/IncidentNavigator/Views/Shared/_INLayout.cshtml";
    Layout = "~/Views/Shared/GenericLayoutWithoutFooter.cshtml";

    var area = HttpContext.Current.Request.Url.AbsoluteUri;
    var Patharray = area.Contains("AMOPortalAPIPTest");
    var ReportUrl = "IncidentNavigator/TAReports_DetailedProgress";
    if (Patharray)
    {
        ReportUrl = "IncidentNavigator_Test/TAReports_DetailedProgress";
    }
    var repSiteLink = WebConfigurationManager.AppSettings["TelerikReportServer"];
    var repSiteUserName = WebConfigurationManager.AppSettings["TelerikReportServerUser"];
    var repSitePassword = WebConfigurationManager.AppSettings["TelerikReportServerPass"];
    var RepJsResources = repSiteLink + "api/reports/resources/js/telerikReportViewer";

    ClientDetail client = (ClientDetail)Session["SessionClient"];
    var clientId = client.ClientId;
    var clientName = client.ClientName;
}

<meta http-equiv="X-UA-Compatible" content="IE=edge">

<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />

<script src="https://code.jquery.com/jquery-3.5.0.min.js"></script>

<link href="https://kendo.cdn.telerik.com/2018.2.620/styles/kendo.common.min.css" rel="stylesheet" />

<script src="@RepJsResources"></script>
<style>

    #reportViewerTAReports_DetailedProgress {
        position: relative;
        /*width: 1400px;*/
        height: 900px;
        font-family: Verdana, Arial;
    }

    #wrap {
        min-height: 100%;
        height: auto;
        padding: 0 0 0 0 !important;
    }

    .k-button#btnPreview {
        background: #fff;
        color: rgb(91,121,171);
        text-transform: uppercase;
        font-size: 10px;
        padding: 3px 12px;
        border: none;
    }

    .k-button#btnSubscribe {
        background: #fff;
        color: rgb(91,121,171);
        text-transform: uppercase;
        font-size: 10px;
        padding: 3px 12px;
        border: none;
    }


    .k-button#btnRptSub {
        text-transform: uppercase;
        font-size: 10px;
        padding: 3px 12px;
        border: none;
        margin-top: 1em;
        background-image: url('../../Content/images/report_subscriptions.svg');
        background-repeat: no-repeat;
        height: 2.5em;
        background-color: transparent;
        padding-left: 2.2em;
    }

    .k-button#btnRptSch {
        text-transform: uppercase;
        font-size: 10px;
        padding: 3px 12px;
        border: none;
        margin-top: 10px;
        background-image: url('../../Content/images/view_download_scheduled_report.svg');
        background-repeat: no-repeat;
        height: 2.4em;
        background-color: transparent;
        padding-left: 2.5em;
    }
</style>
<div class="content-main dark-bg service-plan-container">
    <div>
        <ol class="breadcrumb container">
            <li>Transformation Accelerator</li>
            <li>Reports</li>
            <li class="active">Detailed Progress</li>
        </ol>

    </div>
    @*Report Specific Subscriptions*@
    @(Html.Kendo().Button()
                        .Name("btnRptSub")
                        .Content("    Report Subscriptions")
                        .HtmlAttributes(new { type = "button", @class = "k-primary" })

     )
    @*Report Specific Downloads*@
    @(Html.Kendo().Button()
                        .Name("btnRptSch")
                        .Content("View/Download Scheduled Reports")
                        .HtmlAttributes(new { type = "button", @class = "k-primary" })

     )
    <div id="wrap" style="margin:20px; position: relative; overflow: hidden;">
        @Html.HiddenFor(m => m.ClusterPath)
        <div class="parameter-slider-overlay"></div>
        <div class="parameter-section">
            <div class="action-items">

                <span class="parameter-filter-icon"></span>
            </div>
            <div class="parameter-slider">
                <span class="close-parameters"></span>
                <div class="parameter-list-main">

                    <ul>


                        <li>
                            Quarter:

                            @(Html.Kendo().DropDownList()
                                    .OptionLabel("Select")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .Name("Quarter")
                                    .HtmlAttributes(new { style = "width: 100px" })
                                    .SelectedIndex(1)
                                    .BindTo(new List<SelectListItem>() {
                                          new SelectListItem() { Text = "1",    Value = "1" },
                                          new SelectListItem() { Text = "2",    Value = "2" },
                                          new SelectListItem() { Text = "3",    Value = "3" },
                                          new SelectListItem() { Text = "4",    Value = "4" },
                                        }))

                        </li>
                        <li>
                            Year :
                            @(Html.Kendo().DropDownList()
                                    .OptionLabel("Select")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .Name("Year")
                                    .HtmlAttributes(new { style = "width: 100px" })
                                    .SelectedIndex(3)
                                    .BindTo(Model.YearsList)
                                    .Value("2021")
                            )
                        </li>

                        <li>
                            @(Html.Kendo().Button()

                        .Name("btnPreview")
                        .Content("Apply")
                        .HtmlAttributes(new { type = "button", @class = "k-primary" })

                            )
                        </li>
                        <li>
                            @(Html.Kendo().Button()
                        .Name("btnSubscribe")
                        .Content("Subscribe")
                        .HtmlAttributes(new { type = "button", @class = "k-primary" })

                            )
                        </li>
                    </ul>
                </div>
            </div>


            <div style="padding:0;padding-top: 15px;width:100%;" id="reportPartialID">
                <div>




                    @(Html.TelerikReporting().ReportViewer()
                                                    // Each report viewer must have an id - it will be used by the initialization script
                                                    // to find the element and initialize the report viewer.
                                                    .Id("reportViewerTAReports_DetailedProgress")
                                                    .ViewMode(ViewMode.Interactive)
                                                    // The settings of the report server that hosts the reports - URL, username and password.
                                                    // If username and password are not provided or are set to null, the server's Guest account will be used.
                                                    // The report server should have its Guest account enabled along with configured permissions for accessing the report.
                                                    // For more information see http://www.telerik.com/help/reporting/html5-report-viewer-howto-use-it-with-reportserver.html.
                                                    .ReportServer(new ReportServer()
                                                    {
                                                        Url = repSiteLink,
                                                        Username = repSiteUserName,
                                                        Password = repSitePassword
                                                    })
                                                    // The URL for the report viewer template. The template can be edited -
                                                    // new functionalities can be added and unneeded ones can be removed.
                                                    // For more information please check http://www.telerik.com/help/reporting/html5-report-viewer-templates.html.
                                                    //
                                                    // The report source value contains Category and ReportName in the following format: {Category/ReportName}.
                                                    .ReportSource(ReportUrl
                                                            , new Dictionary<string, object>() {
                                                        { "IncidentClientid", Model.ClientId },
                                                        { "ClientName", Model.ClientName },
                                                        { "ReportYear", Model.ReportYear },
                                                        { "ReportQtr", Model.ReportQtr },
                                                        {"DateTimeNow",Model.CreatedDt }
                                                        })
                                                    // Specifies whether the viewer is in interactive or print preview mode.
                                                    // PrintPreview - Displays the paginated report as if it is printed on paper. Interactivity is not enabled.
                                                    // Interactive - Displays the report in its original width and height with no paging. Additionally interactivity is enabled.
                                                    .ViewMode(ViewMode.Interactive)
                                                    // Sets the scale mode of the viewer.
                                                    // Three modes exist currently:
                                                    // FitPage - The whole report will fit on the page (will zoom in or out), regardless of its width and height.
                                                    // FitPageWidth - The report will be zoomed in or out so that the width of the screen and the width of the report match.
                                                    // Specific - Uses the scale to zoom in and out the report.
                                                    .ScaleMode(ScaleMode.Specific)
                                                    // Zoom in and out the report using the scale
                                                    // 1.0 is equal to 100%, i.e. the original size of the report
                                                    .Scale(1.0)
                                                    // Sets whether the viewer’s client session to be persisted between the page’s refreshes(ex. postback).
                                                    // The session is stored in the browser’s sessionStorage and is available for the duration of the page session.
                                                    .PersistSession(false)

                                                    // Sets the print mode of the viewer.
                                                    .PrintMode(PrintMode.AutoSelect)
                                                    //If set to true shows the Send Mail Message toolbar button
                                                    .SendEmail(new SendEmail { Enabled = false })
                                                    //Switches accessibility mode ON or OFF.
                                                    .EnableAccessibility(true)

                //----------------------//
                //Added to remove the parameter specifying area
                //                                                  .ParametersAreaVisible(true)
                //                                                  .Parameters(new Parameters { Editors = new Editors { SingleSelect = EditorTypes.ComboBox, MultiSelect = EditorTypes.ComboBox } })
                )


                </div>
            </div>
            <div id="addSubcriptionAlertModal" class="modal fade add-subcription-alert" role="dialog">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                        </div>
                        <div class="modal-body">
                            <p style="font-size: inherit; color: green; opacity: 70%;">Report subcription has been addded successfully"</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
    @Html.Partial("~/Areas/ClientProfileManager/Views/ReportSubscription/_RPTSubscriptionPartial.cshtml", " New Subscription for 'TA Detailed Progress Report' ")

</div>

<script src="~/Content/js/bootstrap-multiselect.js"></script>
<script src="~/Scripts/JScript/kendo.all.min.js"></script>
<script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>
<script src="~/Content/js/bootstrap.js"></script>
<script src="~/Content/js/bootstrap.min.js"></script>
<script>
    $('.custom-multiselect-dropdown').multiselect({
        maxHeight: 200,
        numberDisplayed: 1,
        includeSelectAllOption: true,
        includeResetOption: true
    });
    $(".custom-multiselect-dropdown").multiselect('selectAll', false);
    $(".custom-multiselect-dropdown").multiselect('updateButtonText');

    $('#btnPreview').on("click", function (e) {

            var viewer = $("#reportViewerTAReports_DetailedProgress").data("telerik_ReportViewer");
        viewer.reportSource({
            report: viewer.reportSource().report,
            parameters: {
                IncidentClientid: @Model.ClientId,
                ReportYear: $("#Year").data("kendoDropDownList").text() ,
                ReportQtr: $("#Quarter").data("kendoDropDownList").text(),
				ClientName: '@Model.ClientName',
                UserName: '@Model.UserName',
                DateTimeNow:'@Model.CreatedDt'

    }        });
        //setting the HTML5 Viewer's reportSource, causes a refresh automatically
        //if you need to force a refresh for other case, use:
        viewer.refreshReport();
    });
    $('.parameter-filter-icon').on('click', function(){
        $(this).addClass('open');
        $('.parameter-slider').addClass('open');
        $('.parameter-slider-overlay').addClass('open');
    });  
    $('.close-parameters').on('click', function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');
    });
    $('.parameter-slider-overlay').click(function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');
    });

    $('#btnSubscribe').click(function () {

         var year = $("#Year").data("kendoDropDownList").text();
         var quarter = $("#Quarter").data("kendoDropDownList").text();
         var stringTxtArea = " ReportYear  : " + year + "; " + "ReportQtr : " + quarter + "; "
         var stringJsonText = "{ClientName:" + "\"@clientName\"" + ", IncidentClientid:" +  @clientId + ", ReportYear :" + year + ",ReportQtr:" + quarter + "}";
         console.log("stringJsonText kedbsolstatus " + stringJsonText);
         document.getElementById('edit_Description').innerHTML = stringTxtArea;
         document.getElementById('Reportnameindex').innerHTML = "TA Report Detailed Progress";
        document.getElementById('TelerikReportnameindex').innerHTML = "TAReports_DetailedProgress";
         document.getElementById('stringJsonText').innerHTML = stringJsonText;

         $('#updateForsub').hide();
         var rptpopup = $("#RPTSubspopUp").data("kendoWindow");
         rptpopup.open();
    });

     $('#btnRptSub').click(function () {
        //alert("success");
        var reportSubUrl = '@Url.Content("~/ClientProfileManager/ReportSubscription/RptSubscriptionList")?reportname=TA Report Detailed Progress';

        window.location.href = reportSubUrl;
    });

    $('#btnRptSch').click(function () {

        //alert("success");
        var reportSubUrl1 = '@Url.Content("~/ClientProfileManager/ReportSubscription/RPTJobDetailList")?reportname1=TA Report Detailed Progress';
        window.location.href = reportSubUrl1;
    });

</script>