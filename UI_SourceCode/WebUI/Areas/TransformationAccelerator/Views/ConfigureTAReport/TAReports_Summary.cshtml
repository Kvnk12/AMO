         console.log("stringJsonText kedbsolstatus " + stringJsonText);
         document.getElementById('edit_Description').innerHTML = stringTxtArea;
         document.getElementById('Reportnameindex').innerHTML = "TA Report Summary";
         document.getElementById('TelerikReportnameindex').innerHTML = "TAReports_summary";
         document.getElementById('stringJsonText').innerHTML = stringJsonText;

         $('#updateForsub').hide();
         var rptpopup = $("#RPTSubspopUp").data("kendoWindow");
         rptpopup.open();
    });

     $('#btnRptSub').click(function () {
        //alert("success");
         var reportSubUrl = '@Url.Content("~/ClientProfileManager/ReportSubscription/RptSubscriptionList")?reportname=TA Report Summary';

        window.location.href = reportSubUrl;
    });

    $('#btnRptSch').click(function () {

        //alert("success");
        var reportSubUrl1 = '@Url.Content("~/ClientProfileManager/ReportSubscription/RPTJobDetailList")?reportname1=TA Report Summary';

        window.location.href = reportSubUrl1;
    });

</script>