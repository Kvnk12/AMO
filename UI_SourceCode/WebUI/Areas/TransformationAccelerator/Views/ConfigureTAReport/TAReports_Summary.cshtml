            <div id="example" class="k-content">
                <div id="gauge-container" style="margin-left:60px;">
                    <div id="gauge"></div>
                    <div id="val" class="gaugeVal"></div>

                </div>
                <script>
                    function createGauge(labelPosition) {
                        $("#gauge").kendoRadialGauge({

                            pointer: {
                                value: @Model.ProgressVal
                                },

                            scale: {
                                minorUnit: 5,
                                startAngle: -30,
                                endAngle: 210,
                                max: 100,
                                labels: {
                                    position: labelPosition || "inside"
                                },
                                ranges: [
                                    {
                                        from: 0,
                                        to: 25,
                                        color: "#ff0000"
                                    }, {
                                        from: 25,
                                        to: 75,
                                        color: "#ffff00"
                                    }, {
                                        from: 75,
                                        to: 100,
                                        color: "#00ff00"
                                    }
                                ]
                            }
                        });
                        $("#val").text(@Model.ProgressVal.ToString()+"%") ;

                    }

                    $(document).ready(function () {
                        createGauge();

                        $(".box-col").bind("change", refresh);

                        $(document).bind("kendo:skinChange", function (e) {
                            createGauge();
                        });

                        window.configuredRanges = $("#gauge").data("kendoRadialGauge").options.scale.ranges;
                    });


                    function GetProgress() {
                        $.ajax({
                            url: 'GetProgressVal',
                            type: "GET",
                            async: false,
                            data: {
                                Clientid:@Model.ClientId,
                                Year:$("#Year").data("kendoDropDownList").text() ,
                                Qtr: $("#Quarter").data("kendoDropDownList").text()  ,
                            },
                            error: function (response) {
                                alert('Could not update the  detail.');
                            },
                            success: function (response) {
                                var Gval = new Array([0]);
                                Gval[0]= response;
                                $("#val").text(response.toString()+"%") ;
                                var gauge = $("#gauge").data("kendoRadialGauge");
                                gauge.allValues(Gval);
                            }

                        });


                    }
                </script>

                <style>
                    #gauge-container {
                        /*background: transparent url("../content/dataviz/gauge/gauge-container.png") no-repeat 50% 50%;*/
                        /*width: 404px;*/
                        height: 404px;
                        text-align: left;
