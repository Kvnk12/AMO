<script>
    $('.custom-multiselect-dropdown').multiselect({
        maxHeight: 200,
        numberDisplayed: 1,
        includeSelectAllOption: true,
        includeResetOption: true
    });
    $(".custom-multiselect-dropdown").multiselect('selectAll', false);
    $(".custom-multiselect-dropdown").multiselect('updateButtonText');

    $('#SaveSummary1').on("click", function (e) {
        SaveSummary();
    });
    function SaveSummary() {
        var curURL = window.location.href;
        $("#SaveSummary").hide();
        $("#action").hide();
        $("#PageTitle").show();
        if(document.getElementsByClassName('trv-nav').length>0)
        {
            document.getElementsByClassName('trv-nav')[0].style.visibility= 'hidden';
        }
        $(".menuBorder").hide();
        $("#breadcrumb").hide();
        $("#footer").hide();
        history.replaceState(history.state, '', '/');
        window.print();
        history.replaceState(history.state, '', curURL);
        $("#SaveSummary").show();
        $("#action").show();
        $("#PageTitle").hide();
        $(".menuBorder").show();
        $("#breadcrumb").show();
        $("#footer").show();
        if(document.getElementsByClassName('trv-nav').length>0)
        {
            document.getElementsByClassName('trv-nav')[0].style.visibility= 'visible';
        }

    }

    $('#btnPreview').on("click", function (e) {
            // function onClick(e) {
            GetProgress();
            var st =$("#Quarter").data("kendoDropDownList").text() +  $("#Year").data("kendoDropDownList").text();
            //var Gval = new Array([0]);
            //Gval[0]= ($("#Year").data("kendoDropDownList").text() %2000 ) *($("#Quarter").data("kendoDropDownList").text() );
            //var gauge = $("#gauge").data("kendoRadialGauge");
            //gauge.allValues(Gval);
            var viewer = $("#reportViewerTAReports_summary").data("telerik_ReportViewer");
            if(viewer !== undefined)
            {

                viewer.reportSource({
                    report: viewer.reportSource().report,
                    parameters: {
                        IncidentClientid: @Model.ClientId,
                        ReportYear: $("#Year").data("kendoDropDownList").text() ,
                        ReportQtr: $("#Quarter").data("kendoDropDownList").text(),
                        ClientName: '@Model.ClientName',
                        DateTimeNow:'@Model.CreatedDt'

                    }        });
                //setting the HTML5 Viewer's reportSource, causes a refresh automatically
                //if you need to force a refresh for other case, use:
                viewer.refreshReport();
            }
            var gauge = $("#gauge").data("kendoRadialGauge");
            gauge.redraw();

    });
    $('.parameter-filter-icon').on('click', function(){
        $(this).addClass('open');
        $('.parameter-slider').addClass('open');
        $('.parameter-slider-overlay').addClass('open');
    });
    $('.close-parameters').on('click', function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');
    });
    $('.parameter-slider-overlay').click(function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');
    });

    function refresh() {
        var gauge = $("#gauge").data("kendoRadialGauge"),
            options = gauge.options;

        options.transitions = false;
        options.scale.labels.visible = true;
        options.pointer.value = $("#ProgressVal").val();
        //       options.scale.ranges = showRanges ? window.configuredRanges : [];


        gauge.redraw();
    }


     $('#btnSubscribe').click(function () {

         var year = $("#Year").data("kendoDropDownList").text();
         var quarter = $("#Quarter").data("kendoDropDownList").text();
         var stringTxtArea = " ReportYear  : " + year + "; " + "ReportQtr : " + quarter + "; "
