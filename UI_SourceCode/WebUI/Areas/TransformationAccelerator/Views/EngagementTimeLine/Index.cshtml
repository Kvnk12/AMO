@model  BaseLineDataModel

@{

    <link rel="stylesheet" href="~/Content/css/bootstrap-multiselect.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />
    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/JScript/kendo.all.min.js"></script>
    <script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>
    <script src="~/Content/js/bootstrap-multiselect.js"></script>
    <script src="~/Scripts/JScript/jszip.min.js"></script>

    ViewBag.Title = "Client Engagement Timeline";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/home/transformation_accelerator_white.svg");
    // Layout = "~/Views/Shared/_AppLayout.cshtml";
    Layout = "~/Views/Shared//GenericLayoutWithoutFooter.cshtml";
    ClientDetail client = (ClientDetail)Session["SessionClient"];
    var ClientName = client.ClientName;

}
<style>
    #live {
        right: -30px;
    }
</style>
<div class="content-main dark-bg engagement-timeleine-container">
    <ol class="breadcrumb">
        <li>Transformation Accelerator</li>
        <li class="active">Engagement TimeLine</li>
    </ol>
    <h4 style="color:white">
        Engagement TimeLine   &nbsp;
        &nbsp;
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span id="errorlabel" style='position:center;color:red'></span>
    </h4>

    <div class="custom-kendo-grid ">
        @(Html.Kendo().Grid<EngagementType>()
                     .Name("ClientEngagemenetTimeline")
                     .Columns(columns =>
                     {
                         columns.Bound(e => e.Id).Hidden();
                         columns.Bound(e => e.EngagementTypes).Title("Phase");
                         columns.Bound(e => e.StartDate).Title("Start Date").Format("{0:MM/dd/yyyy}");
                         columns.Bound(e => e.EndDate).Title("End Date").Format("{0:MM/dd/yyyy}");
                         columns.Bound(e => e.ModifiedBy).Title("Modified By");
                         columns.Bound(e => e.ModifiedDate).Title("Modified On").Format("{0:MM/dd/yyyy}");
                         columns.Command(command => { command.Edit().Text(" ") ; /*command.Destroy().Text(" ")*//*.Visible("deleteVisible")*/; }).Title("Action");

                     })
                    .Scrollable()
                    .HtmlAttributes(new { style = ""})
                    .ToolBar(toolbar =>
                    {
                        toolbar.Create().Text("Add New Renewal");

                    })
                    .Editable(editable => editable.Mode(GridEditMode.PopUp).CreateAt(GridInsertRowPosition.Bottom)/*.ConfirmDelete("test").DisplayDeleteConfirmation("Are you sure you want to delete?")*/)
                    .DataSource(dataSource => dataSource
                        .Ajax()

                        .Model(model =>
                        {
                            model.Id(p => p.Id);
                        })
                          .Read(read => read.Action("getTimeLine", "EngagementTimeLine"))
                          .Create(create => create.Action("ClientEngagementCreate", "EngagementTimeLine"))
                          .Update(update => update.Action("ClientEngagementUpdate", "EngagementTimeLine"))
                     // .Destroy(destroy => destroy.Action("ClientEngagementDelete", "EngagementTimeLine"))
                     .Events(events => events.Error("errorFunct"))
                     )
                    .Events(e => e.Edit("onEdit"))

                   )
    </div>
    <div class="tab-container">
        <div >
            <div class="export-link" id="Export">
                <button id="live" type="button" onclick="LiveINCount();" style="border-radius: 50%;transition-duration: 0.4s;padding: 5px;" class="btn btn-primary button">Live Data</button>
                &nbsp;&nbsp;Export -
                <span class="export-icon" onclick="fnExcelReport();"></span>
            </div>
        </div>
       

        @(Html.Kendo().TabStrip()
                                         .Name("tabstrip")
                                         .Items(tabstrip =>
                                         {
                                             tabstrip.Add().Text("BaseLine Data")
                                                 .Selected(true)
                                                 .Content(m => Html.Partial("_BaseLine",Model));

                                             tabstrip.Add().Text("Resource Details")
                                                 .Enabled(false)
                                                 .Content(m =>Html.Action("ResourceDetails", "EngagementTimeLine"));
                                           //  .Content(m => Html.Partial("_ResourceDetails", Model.resDetails));

                                         })

    )
    </div>

</div>



<script type="text/javascript">
