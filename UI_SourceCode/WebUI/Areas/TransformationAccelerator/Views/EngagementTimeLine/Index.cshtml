    function onEdit(e) {
        $('[name="Id"]').attr("readonly", true);
        $('[name="EngagementTypes"]').attr("readonly", true);
        $('[name="ModifiedBy"]').attr("readonly", true);
        $('[name="ModifiedDate"]').attr("readonly", true);
        document.getElementById("errorlabel").innerHTML = "";
    }

    function errorFunct(e) {
        console.log(e.errors["EndDate"].errors);
        document.getElementById("errorlabel").innerHTML = "<span style='top:16px;color:red' class='alert alert-danger'>" + e.errors["EndDate"].errors + " </span>";

    }

    function LiveINCount() {
        var actionurl ='@Url.Content("~/EngagementTimeLine/getBaseLineINData")';
       $.ajax({
           url: actionurl,
           type: "post",  
           contentType: 'application/json; charset=utf-8',
           success: function (data) {
               if (data != null) {
                   //console.log($('#BaseLinePeriod').val());
                   //console.log($('#IncMonth').val());
                   //console.log($('#EveMonth').val());
                   //console.log($('#SRMonth').val());
                   //console.log(data);
                   //console.log(data.BaseLinePeriod);
                   //console.log(data.IncMonth);
                   //console.log(data.EveMonth);
                   //console.log(data.SerReqMonth);
                   $('#BaseLinePeriod').html(data.BaseLinePeriod);
                  // $('#BaseLinePeriod').val(data.BaseLinePeriod);
                   $('#IncMonth').val(data.IncMonth);
                   $('#EveMonth').val(data.EveMonth);
                   $('#SRMonth').val(data.SerReqMonth);
               } else {
                   console.log(data);
               }
           },
        });
    }

    function fnExcelReport() {

        var selectedTab = $("#tabstrip >ul").find(".k-item.k-state-active").index();
        console.log(selectedTab);

        var tab_text = "<table border='2px'><tr bgcolor='#87AFC6'>";
        var textRange; var j = 0;
        if (selectedTab == 0) {
            tab = document.getElementById('BaseTable'); // id of table
        }
        else if (selectedTab == 1) {
            tab = document.getElementById('tb1'); // id of table
        }

        for (j = 0; j < tab.rows.length; j++) {
            tab_text = tab_text + tab.rows[j].innerHTML + "</tr>";

        }

        tab_text = tab_text + "</table>";
        tab_text = tab_text.replace(/<A[^>]*>|<\/A>/g, "");//remove if u want links in your table
        tab_text = tab_text.replace(/<img[^>]*>/gi, ""); // remove if u want images in your table
        tab_text = tab_text.replace(/<input[^>]*>|<\/input>/gi, ""); // reomves input params

        var ua = window.navigator.userAgent;
        var msie = ua.indexOf("MSIE ");

        if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./))      // If Internet Explorer
        {
            txtArea1.document.open("txt/html", "replace");
            txtArea1.document.write(tab_text);
            txtArea1.document.close();
            txtArea1.focus();
            sa = txtArea1.document.execCommand("SaveAs", true, "Say Thanks to Sumit.xlsx");
        }
        else                 //other browser not tested on IE 11
            sa = window.open('data:application/vnd.ms-excel,' + encodeURIComponent(tab_text));

        return (sa);
    }

</script>

