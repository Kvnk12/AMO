<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
        <customErrors defaultRedirect="Error.html"
                  mode="On">
        </customErrors>
    <pages>
     
      <controls>
        <add tagPrefix="ajaxToolkit" assembly="AjaxControlToolkit" namespace="AjaxControlToolkit" />
      </controls>
    </pages>
  </system.web>
</configuration>
