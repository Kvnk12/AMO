    function SaveReportParameters(typarr, Staarr, Priarr, Groarr, Towarr, WaiveOption)
    {

              //Ajax call begin

        var model = {
            FromYear: $("#start").val(),
            ToYear: $("#end").val(),
            DateTimeGroup: $("#DateGroup").data("kendoDropDownList").selectedIndex,
            TypeDropDown: typarr,
            StatusDropDown: Staarr,
            PriorityDropDown: Priarr,
            GroupDropDown: Groarr,
            TowerDropDown: Towarr,
            WaivedindicatorOption: $("#WaivedFilterList").data("kendoDropDownList").selectedIndex,
        };
        var data = JSON.stringify(model);

        $.ajax(
       {
           type: 'post',

                url:  'SaveReportDetails',
           data: data,
           async: true,
           contentType: 'application/json; charset=utf-8',
                success: function (data) {
//                    alert('Success');
           },
                error: function (err, data) {
                    console.log(arguments);
//                    alert('Ajax Error');
           }

       });
        //Ajax end

    }
