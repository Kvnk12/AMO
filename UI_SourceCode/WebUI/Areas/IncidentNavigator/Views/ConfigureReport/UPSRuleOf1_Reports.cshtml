<div class="custom-popup-grid modal fade" id="resolutionPopUp" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-popup-title">
            <label class="custom-white-label" id="resolutionLabel"></label>
            <button type="button" class="close" title="Close" data-bs-dismiss="modal">&times;</button>
        </div>
        <div class="modal-content">
            <div class="modal-body">
                @*<label>Welcome to popup</label>*@
                <div class="custom-kendo-grid report-drilldowm">
                    @(Html.Kendo().Grid<SLAMaintenenceModel>()
                                                                .Name("GridResolutionTickets")
                                                                .AutoBind(false)
                                                                .Columns(columns =>
                                                                {

                                                                    columns.Bound(p => p.TicketID).Title("Ticket ID").Width(100);
                                                                    columns.Bound(p => p.Type).Title("Ticket Type").Width(100).Filterable(ftb => ftb.Multi(true));
                                                                    columns.Bound(p => p.Description).Title("Description").Width(225).HtmlAttributes(new { @style = "overflow: hidden;text-overflow: ellipsis;white-space: nowrap;" })
                                                                    .ClientTemplate("<div class=\"forTooltips\">#=Description#</div>");
                                                                    columns.Bound(p => p.Priority).Title("Priority").Width(100).Filterable(ftb => ftb.Multi(true));
                                                                    columns.Bound(p => p.Status).Title("Status").Width(100).Filterable(ftb => ftb.Multi(true));
                                                                    columns.Bound(p => p.AssignedToSupportGroup).Title("Assigned Group").Width(100).Filterable(ftb => ftb.Multi(true));
                                                                    columns.Bound(p => p.CreatedDateTime).Title("Created").Format("{0:MM/dd/yyyy HH:mm:ss}").Width(100);
                                                                    columns.Bound(p => p.ResolutionDateTime).Title("Resolved").Format("{0:MM/dd/yyyy HH:mm:ss}").Width(100);
                                                                    columns.Bound(p => p.Resolutiontime1).Title("Resolution Time").Width(100);
                                                                    columns.Bound(p => p.ResolutionTimeMetSLA).Title("Met Sla").Width(100);
                                                                    columns.Bound(p => p.ResolutionExceptionIndicator).Title("Waive Indicator").Width(100);
                                                                    columns.Bound(p => p.ResolutionExceptionReason).Title("Waive reason").Width(100);
                                                                    columns.Bound(p => p.ClosedDateTime).Title("Closed").Format("{0:MM/dd/yyyy HH:mm:ss}").Width(100);
                                                                    columns.Bound(p => p.LastUpdatedDateTime).Title("Last Updated").Format("{0:MM/dd/yyyy HH:mm:ss}").Width(100);
                                                                    columns.Bound(p => p.Resolutiontype).Title("Resolution type").Width(100);
                                                                    columns.Bound(p => p.Track).Title("Tower/Track").Width(100).Filterable(ftb => ftb.Multi(true));

                                                                })
                                                                .ToolBar(tools =>
                                                                {
                                                                    tools.Excel().Text("Export -");
                                                                })
                                                                .Scrollable(e => e.Endless(true))
                                                                .Filterable()
                                                                .Sortable()
                                                                .Pageable()
                                                                .Groupable()
                                                                .Excel(excel => excel.FileName("Resolution_DrillDown_Report.xlsx")
                                                                .Filterable(true)
                                                                .AllPages(true)
                                                                .ProxyURL(Url.Action("Export_Tickets_Save", "ConfigureReport"))
                                                                )
                                                                .Resizable(r => r.Columns(true))
                                                                .DataSource(dataSource => dataSource
                                                                .Ajax()
                                                                .PageSize(100)
                                                                .Model(model =>
                                                                {
                                                                    model.Id(p => p.Id);

                                                                })
                                                                .Read(read => read.Action("GetResolutionTickets", "ConfigureReport").Data("GetdrilldownResolutionParameter"))
                                                                )
                    )

                </div>
            </div>
        </div>
        <div id="addSubcriptionAlertModal" class="modal fade add-subcription-alert" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                    </div>
                    <div class="modal-body">
                        <p style="font-size: inherit; color: green; opacity: 70%;">Report subcription has been addded successfully"</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
