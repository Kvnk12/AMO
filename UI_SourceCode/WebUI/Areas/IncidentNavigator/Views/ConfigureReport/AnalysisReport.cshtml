                        </li>
                        <li>
                            End Date :
                            @(Html.Kendo().DatePicker()
                .Name("end")
                .Value(String.Format("{0:d}", Model.ToYear))
                            )


                        </li>
                        <li>
                            Report By :
                            @(Html.Kendo().DropDownList()
                          .Name("DateGroup")
                          .DataTextField("Text")
                          .DataValueField("Value")
                          //   .HtmlAttributes(new { style = "width: 100%" })
                          //.SelectedIndex(2)
                          .SelectedIndex(Model.SelectedReportGrp)
                          .BindTo(new List<SelectListItem>()
                          {
                              new SelectListItem() {
                                Text = "Day", Value ="1"
                              },
                              new SelectListItem() {
                                Text = "Month", Value ="2"
                              },
                              new SelectListItem() {
                                Text = "Week", Value ="3"
                              },
                              new SelectListItem() {
                                Text = "Year", Value ="4"
                              }

                          })
                            )

                        </li>
                        <li class="custom-multiselect">
                            Type :
                            <select class="custom-multiselect-dropdown" id="Type" multiple="multiple">
                                @{
                                    int sel = 0;
                                    int itemindex = 0;
                                    foreach (var item in Model.TypeList)
                                    {
                                        var str = item.Text.ToLower();
                                        if (Model.SelectedTypeList == null || sel < Model.SelectedTypeList.Length && Model.SelectedTypeList[sel] == itemindex++)
                                        {
                                            <option value="@item.Value" selected>@item.Text</option>
                                            sel++;
                                        }
                                        else
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }

                                }
                            </select>

                        </li>
                        <li class="custom-multiselect">
