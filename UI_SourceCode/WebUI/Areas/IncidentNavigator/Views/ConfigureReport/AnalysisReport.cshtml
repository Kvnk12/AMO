                <span class="close-parameters"></span>
                <div class="parameter-list-main">

                    <ul>
                        <li>
                            Account Name :
                            @(   Html.Kendo().DropDownList().Name("AccountNamesList")
                   .DataTextField("Text")
                   .DataValueField("Value")
                   .SelectedIndex(0)
                   .BindTo(Model.AccountNamesList)
                   .Events(e =>
                   {
                       e.Change("onSelectAccount");
                   })

                            )
                        </li>
                        <li class="custom-multiselect">
                            Contract Id :
                            <div class="custom-kendo-multiselect trend">
                                @(Html.Kendo().MultiSelectFor(m => m.Contract)
                                    .Name("Contract")
                                    .TagMode(TagMode.Single)
                                    //.Placeholder("Select")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .DataSource(d => d
                                    .Read(read => read.Action("getContractId", "DashboardNew").Data("GetAccId"))
                                      )
                                      .Events(e =>
                                       {
                                           e.DataBound("onDataBoundContract");
                                       })
                                    .AutoBind(true)
                                                )
                            </div>
                        </li>
                        <li>
                            Date Filter :
                            @(   Html.Kendo().DropDownList().Name("DateColumnsList")
                   .DataTextField("Text")
                   .DataValueField("Value")
                   .SelectedIndex(2)
                   .BindTo(Model.DateColumnsList)
                            )
