@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.IncidentNavigator.Controllers;
@using WebUI.Areas.IncidentNavigator.Dto;
@using WebUI.Areas.IncidentNavigator.Models;
@using Kendo.Mvc.UI;
@using System.Data;
@using WebUI.Dto;
@using WebUI.Areas.IdeaManager.Dto;

@model INNewDashboardModel

@{
    ViewBag.Title = "Incident Navigator";


    <link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />



    @*<link rel="stylesheet" href="~/Content/css/bootstrap-3.3.2.min.css" />*@
    <link rel="stylesheet" href="~/Content/css/bootstrap-multiselect.css" />
    @*<link rel="stylesheet" href="~/Content/css/custom-styles.css" />*@
    @*<script src="~/Content/js/bootstrap.js"></script>*@
    @*<script src="~/Scripts/jquery-3.6.0.js"></script>*@



    @*<script src="~/Scripts/jquery-3.6.0.min.js"></script>*@
    <script src="~/Scripts/JScript/kendo.all.min.js"></script>
    <script src="~/Content/js/bootstrap-multiselect.js"></script>
    <script src="~/Scripts/JScript/jszip.min.js"></script>
    @*<script src="~/Content/js/bootstrap.min.js"></script>*@
    <script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>

    ViewBag.ImagePathOne = Url.Content("~/Content/images/home/incident_navigator_white.svg");
    Layout = "~/Views/Shared/GenericLayOut.cshtml";
    ClientDetail client = (ClientDetail)Session["SessionClient"];
    var ClientId = client.ClientName;

    var templateObject = new Integration_ReportListModel();

}
<style>
    .forTooltips {
        width: 90%;
        height: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        /*padding: .929em 1.286em;*/
    }

    
</style>
<div class="content-main custom-grid dark-bg">

    <div>
        <!--start of breadcrumb-->
        <ol class="breadcrumb ">
            <li>Incident Navigator</li>
            <li class="active">Dashboard</li>
        </ol>
    </div>
    <!-- Wrap all page content here -->

    <input type="hidden" id="ContractId" name="ContractId" value=@Model.Accid>
    <input type="hidden" id="category" name="category">
    <input type="hidden" id="InflowOutFlowType" name="InflowOutFlowType">
    <input type="hidden" id="DateField" name="DateField">
    <input type="hidden" id="categoryseries" name="categoryseries">
    <input type="hidden" id="D2StartDate" name="D2StartDate">
    <input type="hidden" id="D2EndDate" name="D2EndDate">

    @*<input type="hidden" id="category" name="category">*@
    <input type="hidden" id="TowerCategory" name="TowerCategory">
    @*<input type="hidden" id="ContractId" name="ContractId" value=@Model.Accid>*@
    @*<input type="hidden" id="categoryseries" name="categoryseries">*@

    <input type="hidden" id="TowerSelected" name="TowerSelected">
    <input type="hidden" id="LeverSelected" name="LeverSelected">
    <input type="hidden" id="CategorySelected" name="CategorySelected">
    <input type="hidden" id="TokenSelected" name="TokenSelected">

    <div class="content-wrapper incident-dashboard-container">
        <div class="change-dashboard">
            <span class="dashboard-change-icon"></span>
            <div class="dashboard-name">
                <span class="active" data-href="dashboard1">Dashboard 1</span>
                <span data-href="dashboard2">Dashboard 2</span>
                <span data-href="dashboard3">Dashboard 3</span>
                <span data-href="dashboard4">Dashboard 4</span>
                <span data-href="dashboard5">Dashboard 5</span>
            </div>
        </div>

        <div class="parameter-slider-overlay"></div>
        <div class="parameter-section">
            <div class="action-items">
                <div id="d3export" class="hide">
                    <form action="@Url.Action("ExportIRRecords", "Integration_Report")" method="POST">
                        <button type="submit" id="ExportToExcel" class="custom-button integration-report-export"></button>
                    </form>
                </div>
                <span class="parameter-filter-icon"></span>
            </div>
            <div class="parameter-slider">
                <span class="close-parameters"></span>
                <div class="parameter-list-main">

                    <ul>
                        <li>
                            Account Name :
                            @( Html.Kendo().DropDownList().Name("AccountNamesList")
                                                            .DataTextField("Text")
                                                            .DataValueField("Value")
                                                            .SelectedIndex(0)
                                                            .BindTo(Model.AccountNamesList)
                                                            .Events(e =>
                                                            {
                                                            e.Change("onSelectAccount");
                                                            })

                                                             )
                        </li>
                        <li>
                            Contract Id :
                            @( Html.Kendo().DropDownList().Name("Contract")
                                                            .DataTextField("Text")
                                                            .DataValueField("Value")
                                                            .AutoBind(true)
                                                            .SelectedIndex(0)
                                                             .DataSource(d => d
                                                              .Read(read => read.Action("getContractId", "DashboardNew").Data("GetAccId"))
                                                                                                   )
                                                           //   .BindTo(Vendorlist)
                                                             )

                        </li>
                        <li>
                            Date Filter :
                            @(Html.Kendo().ComboBox()
                                                .Name("Datefield")
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .Value("Createddatetime")
                                                .BindTo(new List<SelectListItem>() {
                                                                        new SelectListItem() {
                                                                        Text = "Created date",
                                                                        Value = "Createddatetime"
                                                                        },
                                                                        new SelectListItem() {
                                                                        Text = "Resolved date",
                                                                        Value = "Resolutiondatetime"
                                                                        },
                                                                        new SelectListItem() {
                                                                        Text = "Closed date",
                                                                        Value = "Closeddatetime"
                                                                        },
                                                                        new SelectListItem() {
                                                                        Text = "Last updated date",
                                                                        Value = "Lastupdateddatetime"
                                                                        }
                                                })

                                                .Enable(true)
                                                .AutoBind(true)
                                                //.CascadeFrom("fabric")
                                                .HtmlAttributes(new { style = "width:200px;" })
                                    //.BindTo(ConfigItemlist)
                            )
                        </li>

                        <li>
                            Start Date :
                            @(Html.Kendo().DatePicker()
                                                                                .Name("start")
                                                .Value(DateTime.Today.AddMonths(-12))
                                                .Format("MM/dd/yyyy")
                            )
                        </li>
                        <li>
                            End Date :
                            @(Html.Kendo().DatePicker()
                                                                                .Name("end")
                                                .Value(DateTime.Today)
                                                .Format("MM/dd/yyyy")
                            )


                        </li>

                        <li class="custom-multiselect">
                            Type :
                            <select class="custom-multiselect-dropdown" id="Type" multiple="multiple">
                                @{
                                    foreach (var item in Model.TypeList)
                                    {
                                        var str = item.Text.ToLower();
                                        if (str.Substring(0, 2) == "in")
                                        {
                                            <option value="@item.Value" selected>@item.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                }
                            </select>

                        </li>
                        <li class="custom-multiselect">
                            Status :
                            <select class="custom-multiselect-dropdown" id="Status" multiple="multiple">
                                @{
                                    foreach (var item in Model.StatusList)
                                    {
                                        <option value="@item.Value" selected>@item.Text</option>
                                    }
                                }
                            </select>
                        </li>
                        <li class="custom-multiselect">
                            Priority :
                            <select class="custom-multiselect-dropdown" id="Priority" multiple="multiple">
                                @{
                                    foreach (var item in Model.PriorityList)
                                    {
                                        <option value="@item.Value" selected>@item.Text</option>
                                    }
                                }
                            </select>
                        </li>

                        <li class="custom-multiselect">
                            Track :
                            <select class="custom-multiselect-dropdown" id="Tower" multiple="multiple">
                                @{
                                    foreach (var item in Model.TowerList)
                                    {
                                        <option value="@item.Value" selected>@item.Text</option>
                                    }
                                }
                            </select>
                        </li>


                        <li>
                            @(Html.Kendo().Button()

                                                                                        .Name("btnPreview")
                                                                                        .Content("Apply")
                                                                                        .HtmlAttributes(new { type = "button", @class = "k-primary" })

                            )
                        </li>
                    </ul>
                </div>
            </div>

            <div class="dashboard1 dashboard-content active" id="dashboardtab1">
                <div class="top-content">

                    @Html.Partial("_DashboardTrend", Model)
                    @Html.Partial("_DashboardPriority", Model)
                    @Html.Partial("_DashboardStatus", Model)

                </div>
                <div class="bottom-content">

                    @Html.Partial("_DashboardChart4", Model)
                    @Html.Partial("_DashboardChart5", Model)
                    @Html.Partial("_DashboardChart6", Model)



                </div>
            </div>

            <div class="dashboard2 dashboard-content " id="dashboardtab2">
                <div class="top-content">

                    @Html.Partial("_DistributionByYear", Model)
                    @Html.Partial("_DistributionByDay", Model)
                    @Html.Partial("_DistributionByHour", Model)
                </div>
                <div class="bottom-content">
                    @Html.Partial("_DistributionByMonth", Model)
                    @Html.Partial("_PriorityDistributionByDay", Model)
                    @Html.Partial("_TicketCountFlowbyHour", Model)




                </div>
            </div>
            <div id="dashboardtab3" class="dashboard3 dashboard-content">
                <div class="d3-integrated top-content">
                    <div class="d3-chart-area">
                        @Html.Partial("_IntegrationReport_ByTower", templateObject)
                        @Html.Partial("_IntegrationReport_ByCategory", templateObject)
                    </div>

                </div>
                <div class="d3-integrated bottom-content">
                    <div class="d3-chart-area">
                        @Html.Partial("_IntegrationReport_ByLever", templateObject)
                        @Html.Partial("_IntegrationReport_ByToken", templateObject)
                    </div>

                </div>
            </div>

            <div id="dashboardtab4" class="dashboard4 dashboard-content">
                <div class="d3-integrated bottom-content">
                    <div class="d3-chart-area">
                        @Html.Partial("_IssueCluster", templateObject)
                    </div>

                </div>


            </div>
            <div id="dashboardtab5" class="dashboard5 dashboard-content">
                <div class="d3-integrated bottom-content">
                    <div class="d-chart-area issuecluster">
                        @Html.Partial("_IssueClusterNew", templateObject)
                    </div>

                </div>


            </div>

        </div>
        @*<a href="~/Areas/IncidentNavigator/Views/DashboardNew/Index.cshtml">~/Areas/IncidentNavigator/Views/DashboardNew/Index.cshtml</a>*@



        <!--        @Html.Partial("_IntegrationReport_ByToken", templateObject)
              @Html.Partial("_IssueCluster", templateObject)-->
        <!--#region windows-->
        @Html.Partial("_PopupDashboard1", Model)
        @Html.Partial("_PopupIntegrationReportDashboard", templateObject)


        <!--#endRegion Windows-->
        @*<input type="text" onkeypress="onKey(event)" onkeydown="offKey(event)">*@

    </div>
    <div id="chartseriesModal" class="custom-popup-grid modal fade" role="dialog" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-popup-title">
                    <label class="custom-white-label" id="gridlabel1"></label>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">&times;</button>
                    @*<button type="button" class="close" title="Close" data-bs-dismiss="modal">&times;</button>*@
                </div>

                <div class="modal-body">
                    <div class="custom-kendo-grid">
                        @(Html.Kendo().Grid<SLAMaintenenceModel>()
                                                    .Name("GridTickets")
                                                    .Columns(columns =>
                                                    {
                                                        columns.Bound(p => p.TicketID).Title("Ticket ID").Width(100);
                                                        columns.Bound(p => p.Type).Title("Ticket Type").Width(100).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.Description).Title("Description").Width(225).HtmlAttributes(new { @style = "overflow: hidden;text-overflow: ellipsis;white-space: nowrap;" })
                                                        .ClientTemplate("<div class=\"forTooltips\">#=Description#</div>");
                                                        columns.Bound(p => p.Priority).Title("Priority").Width(100).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.Status).Title("Status").Width(100).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.AssignedToSupportGroup).Title("Assigned Group").Width(100).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.CreatedDateTime).Title("Created").Format("{0:MM/dd/yyyy }").Width(100);
                                                        columns.Bound(p => p.ResolutionDateTime).Title("Resolved").Format("{0:MM/dd/yyyy }").Width(100);
                                                        columns.Bound(p => p.ClosedDateTime).Title("Closed").Format("{0:MM/dd/yyyy }").Width(100);
                                                        columns.Bound(p => p.LastUpdatedDateTime).Title("Last Updated").Format("{0:MM/dd/yyyy }").Width(100);
                                                        columns.Bound(p => p.Resolutiontype).Title("Resolution type").Width(100).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.Track).Title("Tower/Track").Width(100).Filterable(ftb => ftb.Multi(true));
                                                    })
                                                    .ToolBar(tools =>
                                                    {
                                                        tools.Excel().Text("Export - ");
                                                    })
                                                    .Scrollable(e => e.Endless(true))
                                                    .Filterable()
                                                    .Sortable()
                                                    .Pageable()
                                                    .AutoBind(true)
                                                    .Groupable()
                                                    .Excel(excel => excel.FileName("Dashboard_DrillDown_Report.xlsx")
                                                    .Filterable(true)
                                                    .AllPages(true)
                                                    .ProxyURL(Url.Action("Export_Tickets_Save", "ConfigureReport"))
                                                    )
                                                    .Resizable(r => r.Columns(true))
                                                    .DataSource(dataSource => dataSource
                                                    .Ajax()
                                                    .Model(model =>
                                                    {
                                                        model.Id(p => p.Id);

                                                    })
                                                    .PageSize(100)
                                                    //.Batch(true)
                                                    .Read(read => read.Action("GetTicketsdrilldown", "Dashboard").Data("GetdrilldownTrendParameter"))
                                                    // .Update(update => update.Action("UpdateTickets", "ConfigureReport"))
                                                    )
        )
                    </div>
                </div>
            </div>
        </div>
    </div>
