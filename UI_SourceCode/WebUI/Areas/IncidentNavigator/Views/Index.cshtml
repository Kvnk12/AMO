    function wrapText(value) {
        var words = value.split(/[;,—_\W]+/);
        var resvalue = "";
        for (var i = 0; i < words.length; i++) {
            resvalue += words[i] + "\n";
        }
        //if (value.length > 10) {
        //    value = value.substring(0, 10) + "\n" + value.substring(10, 20) + "\n" + value.substring(20);
        //};
        return resvalue;
    };
