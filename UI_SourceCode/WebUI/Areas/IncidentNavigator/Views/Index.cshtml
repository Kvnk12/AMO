        var chartSort = 0;
        function kendoGridHeaderSort(chartname, col1) {
            console.log(chartname + " " + col1);
            var grid = $("#" + chartname).data("kendoGrid");
            if (chartSort == 0) {
                grid.dataSource.sort({ field: col1, dir: "asc" });
                chartSort = 1;
            }
            else {
                grid.dataSource.sort({ field: col1, dir: "desc" });
                chartSort = 0;
            }
        }
        function SaveReportParameters(typarr, Staarr, Priarr, Groarr, Towarr, WaiveOption) {

            //Ajax call begin

            var model = {
                FromYear: $("#start").val(),
                ToYear: $("#end").val(),
                DateTimeGroup: 0,
                TypeDropDown: typarr,
                StatusDropDown: Staarr,
                PriorityDropDown: Priarr,
                GroupDropDown: Groarr,
                TowerDropDown: Towarr,
                WaivedindicatorOption: 0,
            };
            var data = JSON.stringify(model);

            $.ajax(
                {
                    type: 'post',

                    url: 'Integration_Report/SaveReportDetails',
                    data: data,
                    async: true,
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {
                        //                    alert('Success');
                    },
                    error: function (err, data) {
                        console.log(arguments);
                        //                    alert('Ajax Error');
                    }

                });
            //Ajax end

        }

