@{

    <link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />
    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/JScript/kendo.all.min.js"></script>
    <script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>
    <script src="~/Scripts/JScript/jszip.min.js"></script>
    ViewBag.Title = "Incident Navigator";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/INlogo.png");
    Layout = "~/Areas/IncidentNavigator/Views/Shared/_INLayout.cshtml";

}
<table class="tableCssStyle">
    <tbody>
        <tr>
            <td class="auto-style1">
                @(Html.Kendo().DropDownListFor(e => e)
                      .Name("ReportName")
                      .DataTextField("Text")
                      .HtmlAttributes(new { @class = "selectpicker", style = "Width:100%" })
                      .Enable(true)
                      .OptionLabel("Select Report View")
                      .DataValueField("Value")
                      //.DataSource(d => d.Read(r => r.Action("IdeaTypeList", "PostIdea")))
                      .AutoBind(true)
                )
            </td>

            <td style="padding-left:2em;" class="auto-style2">
                Report View Name :
                @(Html.Kendo().TextBoxFor(e => e)
                    .Name("ReportNametxt")
                    .Enable(true)
                    .HtmlAttributes(new { @maxlength = "250" })
                )
            </td>
            <td style="padding-left:1em;">
                @(Html.Kendo().CheckBoxFor(e => e)
                   .Name("PublicView")
                   .Label(" Make Public ")
                )
            </td>
            <td style="padding-left:1em;">
                @(Html.Kendo().CheckBoxFor(e => e)
                           .Name("DefaultView")
                           .Label(" Is Default View ")
                )
            </td>
            <td style="padding-left:2em;">
                <button class="btn btn-primary" id="btnSave" type="button" name="command" value="Save" style="margin-left: 40px">Save</button>
            </td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            <td></td>
            <td style="padding-left:1em;">
                @*@(Html.Kendo().CheckBoxFor(e => e)
                               .Name("ClassicView")
                               .Label("Classic View ")
                    )*@
            </td>
            <td>
                <button class="btn btn-primary" id="btnSave" type="button" name="command" value="Save" style="margin-left: 40px">Export to Excel</button>
            </td>
        </tr>


    </tbody>
</table>
