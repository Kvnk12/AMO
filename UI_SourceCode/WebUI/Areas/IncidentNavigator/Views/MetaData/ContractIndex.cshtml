<script id="AppsGridTemplate" type="text/kendo-tmpl">
    <div class="custom-kendo-grid contract-inner-grid">
        @(Html.Kendo().Grid<INContractRuleModel>()
                       .Name("ContractRules#=Id#")
                       .Columns(columns =>
                       {
                        columns.Bound(e => e.Id).Hidden();
                        columns.Bound(e => e.GroupStartOperator).Title("Start Grouping").EditorTemplateName("GroupStartOperator").Width(80);
                        columns.ForeignKey(e => e.INFieldName, INColumn, "Value", "Text").Title("Column Name").EditorTemplateName("ColumnDrpdown");
                        columns.Bound(e => e.Condition).Title("Condition").EditorTemplateName("Condition");
                        columns.Bound(e => e.FieldValue).EditorTemplateName("ColumnValueDrpdown").Title("Column Value");
                        columns.Bound(e => e.ConstantValue).Title("Other Value");
                        columns.Bound(e => e.GroupEndOperator).Title("End Grouping").EditorTemplateName("GroupEndOperator").Width(80).HeaderHtmlAttributes(new { style = "overflow: visible; white-space: normal" });
                        columns.Bound(e => e.Operator).Title("Operator").EditorTemplateName("RuleOperator");

                     columns.Command(command => { command.Edit(); command.Destroy(); });
                                                    })
                                            .Editable(e => e.CreateAt(GridInsertRowPosition.Bottom))
                                            .HtmlAttributes(new { style = "height:350px;" })
                                             // .Pageable()
                                             .ToolBar(
                                                   tools =>
                                                   {
                                                       tools.Create().Text("Add Contract Rules");
                                                   })
                                            .Scrollable()
                                            .DataSource(dataSource => dataSource
                                                .Ajax()
                                                .Model(model =>
                                                {
                                                    model.Id(o => o.Id);
                                                    model.Field(f => f.GroupStartOperator);
                                                })
                                                .PageSize(100)
                                                .Read(read => read.Action("ReadAssignGroupContract", "MetaData", new { Id = "#=Id#" }))
                                                .Create(create => create.Action("CreateAssignGroupContract", "MetaData", new { CId = "#=Id#" }))
                                                .Update(update => update.Action("UpdateAssignGroupContract", "MetaData"))
                                                .Destroy(delete => delete.Action("DeleteAssignGroupContract", "MetaData"))
                                            )

                                            .ToClientTemplate())

    </div>
</script>
@*<button class="btn btn-primary" id="SaveNotes" disabled>Save</button>*@


<script>

    function applyContract() {
        baseurl = '@Url.Content("~/IncidentNavigator/MetaData/GenerateRuleContract")';
        $.ajax({
            url: baseurl,
            type: 'GET',
            async: false,
            success: function (data) {
                $('#alertModalSubmitRule').modal('show');
                $('#lblErrdel').hide();
                $('#lblSuccessdel').show();
                
            },
            error: function () {
                $('#alertModalSubmitRule').modal('show');
                $('#lblErrdel').show();
                $('#lblSuccessdel').hide();
            }
        });
        //$("#msgSuccess22").hide();
    }

    function validateRules() {
        baseurl = '@Url.Content("~/IncidentNavigator/MetaData/ValidateRuleContract")';
        $.ajax({
            url: baseurl,
            type: 'GET',
            async: false,
            success: function (data) {
               // console.log(data);
                $('#validateRulesModal').modal('show');
                document.getElementById('updatestring').innerHTML = data;
            },
            error: function () {

            }
        });

    }



    function onSelectColumn(e) {
        var app = $("#FieldValue").data("kendoComboBox");
        app.dataSource.read();
    }


    function GetColId() {
        var app = $("#INFieldName").data("kendoDropDownList");
        var app1=app.value();
        var appval = $("#FieldValue").data("kendoComboBox");

        //console.writeline(appval.text());


        if (app1 != "") {
            return {

                Columnid: app1,
                ColValue: appval.input.val()
            }
        }

       // console.writeline(appval.input.val());

        return false;
    }

</script>

