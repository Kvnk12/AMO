@using NTTData.AMOPortal.Domain.Entities
@using Domain.Entities
@using Kendo.Mvc.UI;
@using System.Data;
@using NTTData.AMOPortal.WebUI.Dto;
@using Kendo.Mvc;
@using Kendo.Mvc.Extensions;
@using Kendo.Mvc.UI.Fluent;
@using System.Web.Mvc;
@using System.Web.Mvc.Razor;
@using System.Web.Mvc.Html;
@using System.Web.Mvc.Ajax;
@using System.Web.Mvc.Async;
@using WebUI.Dto;
@using WebUI.Controllers;
@using WebUI.Areas.IncidentNavigator.Models;
@using WebUI.Areas.IncidentNavigator.Controllers;
@using WebUI.Areas.IncidentNavigator;


@{

    //  var client = (Client)Session["Client"];
    ClientDetail client = (ClientDetail)Session["SessionClient"];
    var cont = new MetaDataController();
    var INColumn = cont.GetColumnList(client.ClientId);
    <style>
        .otherClass{
            width:100px;
            height:100px;
        }
        </style>
}

@model INColumnValueRuleModel

<div class="edit-popup">
    <div class="edit-popup-item">
        <label>Start Operator : <span class="mandate">*</span></label>

        @(Html.Kendo().DropDownListFor(m => m.GroupStartOperator)
                                                    .Name("GroupStartOperator")
                                                  //.OptionLabel("Select..")
                                                    .DataTextField("Text")
                                                    .DataValueField("Value")
                                                    .ValuePrimitive(true)
                                                    .BindTo(new List<SelectListItem>() {
                                                                new SelectListItem() {
                                                           Text = "",
                                                           Value = ""
                                                           },
                                                    new SelectListItem() {
                                                    Text = "(",
                                                    Value = "("
                                                    }
                                                   })
                                                    .AutoBind(true)
                                                   )
    </div>


    <div class="edit-popup-item">
        <label>Column Name :</label>
        @(Html.Kendo().DropDownListFor(m => m.INFieldName)
                                    .Name("INFieldName")
                                    .OptionLabel("Select Column..")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .Filter("contains")
                                    .BindTo(INColumn)
                                    .Events(e =>
                                    {
                                    e.Change("onSelectColumn");
                                    })
                                    .AutoBind(true)

         )
    </div>


    <div class="edit-popup-item">
        <label>Condition :</label>
        @(Html.Kendo().DropDownListFor(m => m.Condition)
                                    .Name("Condition")
                                    //.OptionLabel("Select Condition.")
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .ValuePrimitive(true)
                                    .BindTo(new List<SelectListItem>() {
                                             new SelectListItem() {
                                                 Text = "=",
                                                 Value = "="
                                                 },
                                             new SelectListItem() {
                                                 Text = "<>",
                                                 Value = "<>"
                                                 },
                                             new SelectListItem() {
                                                 Text = "CONTAINS",
                                                 Value = "CONTAINS"
                                                 },
                                             new SelectListItem() {
                                                 Text = "NOT CONTAINS",
                                                 Value = "NOT CONTAINS"
                                                 },
                                             new SelectListItem() {
                                                 Text = "IN",
                                                 Value = "IN"
                                                 },
                                             new SelectListItem() {
                                                 Text = "NOT IN",
                                                 Value = "NOT IN"
                                                 }
                                   })
                                    .AutoBind(true)
          )
    </div>


    <div class="edit-popup-item">
        <label>Column Value :<span class="mandate">*</span></label>
        @(Html.Kendo().ComboBox()
                                .Name("FieldValue")
                                //.Placeholder("Select Value..")
                                .DataTextField("Text")
                                .DataValueField("Value")
                                .Filter(FilterType.Contains)
                                .DataSource(d =>
                                {
                                    d.Read(read => read.Action("GetColumnValueList", "MetaData").Data("GetColId"))
                                    .ServerFiltering(true);
                                } )
                                .CascadeFrom("INFieldName")
                                .AutoBind(true)

         )
    </div>

    <div class="edit-popup-item">
        <label>Other Value :</label>
        @(Html.TextAreaFor(m => m.ConstantValue, new { @class = "otherClass", placeholder = "Other Value", value = "Other Value"}))
        @* @(Html.Kendo().DatePickerFor(m => m.Created_Date).Value(DateTime.Now).Name("StartDate").Format("MM/dd/yyyy"))*@
    </div>

    <div class="edit-popup-item">
        <label>End Grouping :</label>
        @(Html.Kendo().DropDownListFor(m => m.GroupEndOperator)
                                                .Name("GroupEndOperator")
                                                .DataTextField("Text")
                                                .DataValueField("Value")
                                                .ValuePrimitive(true)
                                                .BindTo(new List<SelectListItem>() {
                                                         new SelectListItem() {
                                                             Text = "",
                                                             Value = ""
                                                             },
                                                         new SelectListItem() {
                                                             Text = ")",
                                                             Value = ")"
                                                             }
                                                })
                                                .AutoBind(true)
          )
    </div>


    <div class="edit-popup-item">
        <label>Operator:</label>
        @(Html.Kendo().DropDownListFor(m => m.Operator)
                                        .Name("Operator")
                                        //.OptionLabel("Select Operator.")
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .ValuePrimitive(true)
                                        .BindTo(new List<SelectListItem>() {
                                                 new SelectListItem() {
                                                     Text = "",
                                                     Value = ""
                                                     },
                                                 new SelectListItem() {
                                                     Text = "AND",
                                                     Value = "AND"
                                                     },
                                                 new SelectListItem() {
                                                     Text = "OR",
                                                     Value = "OR"
                                                     }
                                        })
                                        .AutoBind(true)
         )
    </div>

</div>


