<script type="text/javascript">

    $(document).ready(function () {
        var RootUrl = '@Url.Content("~/")';


        $.ajax({
            type: 'post',
            url: RootUrl + 'AjaxService/INIncidentServicehoursGet',

            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                //alert(response.HasSLAManager);
                $("#HasSLAManager").data("kendoComboBox").value(response.HasSLAManager);
                $("#P1ServiceHours").data("kendoComboBox").value(response.P1ServiceHours);
                $("#P2ServiceHours").data("kendoComboBox").value(response.P2ServiceHours);
                $("#P3ServiceHours").data("kendoComboBox").value(response.P3ServiceHours);
                $("#P4ServiceHours").data("kendoComboBox").value(response.P4ServiceHours);
                $("#P5ServiceHours").data("kendoComboBox").value(response.P5ServiceHours);
                $("#P1WeekendHours").data("kendoComboBox").value(response.P1WeekendHours);
                $("#P2WeekendHours").data("kendoComboBox").value(response.P2WeekendHours);
                $("#P3WeekendHours").data("kendoComboBox").value(response.P3WeekendHours);
                $("#P4WeekendHours").data("kendoComboBox").value(response.P4WeekendHours);
                $("#P5WeekendHours").data("kendoComboBox").value(response.P5WeekendHours);
                $("#P1Blendedrate").data("kendoNumericTextBox").value(response.P1Blendedrate);
                $("#P2Blendedrate").data("kendoNumericTextBox").value(response.P2Blendedrate);
                $("#P3Blendedrate").data("kendoNumericTextBox").value(response.P3Blendedrate);
                $("#P4Blendedrate").data("kendoNumericTextBox").value(response.P4Blendedrate);
                $("#P5Blendedrate").data("kendoNumericTextBox").value(response.P5Blendedrate);
            },
            error: function (response) {
                alert("error occured");
            }
        });
    });
    function combobox_change() {
        var RootUrl = '@Url.Content("~/")';
        var model = {
            ClientId: $("#fabric").val()
        };

        //alert(myArray[0].id + " ," + myArray[0].value);
        //var data1 = { 'listObject': myArray };
        var data = JSON.stringify(model)
        $.ajax({
            type: 'post',
            url: RootUrl + 'AjaxService/INIncidentServicehoursGet',
            data: data,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                //alert(response.HasSLAManager);
                $("#HasSLAManager").data("kendoComboBox").value(response.HasSLAManager);
                $("#P1ServiceHours").data("kendoComboBox").value(response.P1ServiceHours);
                $("#P2ServiceHours").data("kendoComboBox").value(response.P2ServiceHours);
                $("#P3ServiceHours").data("kendoComboBox").value(response.P3ServiceHours);
                $("#P4ServiceHours").data("kendoComboBox").value(response.P4ServiceHours);
                $("#P5ServiceHours").data("kendoComboBox").value(response.P5ServiceHours);
                $("#P1WeekendHours").data("kendoComboBox").value(response.P1WeekendHours);
                $("#P2WeekendHours").data("kendoComboBox").value(response.P2WeekendHours);
                $("#P3WeekendHours").data("kendoComboBox").value(response.P3WeekendHours);
                $("#P4WeekendHours").data("kendoComboBox").value(response.P4WeekendHours);
                $("#P5WeekendHours").data("kendoComboBox").value(response.P5WeekendHours);
                $("#P1Blendedrate").data("kendoNumericTextBox").value(response.P1Blendedrate);
                $("#P2Blendedrate").data("kendoNumericTextBox").value(response.P2Blendedrate);
                $("#P3Blendedrate").data("kendoNumericTextBox").value(response.P3Blendedrate);
                $("#P4Blendedrate").data("kendoNumericTextBox").value(response.P4Blendedrate);
                $("#P5Blendedrate").data("kendoNumericTextBox").value(response.P5Blendedrate);
            },
            error: function (response) {
                alert("error occured");
            }
        });

    }

    function onClickEdit(e) {


        $("#HasSLAManager").data("kendoComboBox").enable(true);
        $("#P1ServiceHours").data("kendoComboBox").enable(true);
        $("#P2ServiceHours").data("kendoComboBox").enable(true);
        $("#P3ServiceHours").data("kendoComboBox").enable(true);
        $("#P4ServiceHours").data("kendoComboBox").enable(true);
        $("#P5ServiceHours").data("kendoComboBox").enable(true);
        $("#P1WeekendHours").data("kendoComboBox").enable(true);
        $("#P2WeekendHours").data("kendoComboBox").enable(true);
        $("#P3WeekendHours").data("kendoComboBox").enable(true);
        $("#P4WeekendHours").data("kendoComboBox").enable(true);
        $("#P5WeekendHours").data("kendoComboBox").enable(true);
        $("#P1Blendedrate").data("kendoNumericTextBox").enable(true);
        $("#P2Blendedrate").data("kendoNumericTextBox").enable(true);
        $("#P3Blendedrate").data("kendoNumericTextBox").enable(true);
        $("#P4Blendedrate").data("kendoNumericTextBox").enable(true);
        $("#P5Blendedrate").data("kendoNumericTextBox").enable(true);
        $("#SaveButton").data("kendoButton").enable(true);
    }


  function onClickSave(e) {
        //$("#tblService").find("input,button,textarea,select").removeAttr("disabled");
      //alert($("#HasSLAManager").val());
      //alert($("#P1ServiceHours").val());
      //$("#P1Servicehours").data("kendoComboBox").enable(true);
      var RootUrl = '@Url.Content("~/")';
      var model = {
          P1ServiceHours: $("#P1ServiceHours").val(),
          P2ServiceHours: $("#P2ServiceHours").val(),
          P3ServiceHours: $("#P3ServiceHours").val(),
          P4ServiceHours: $("#P4ServiceHours").val(),
          P5ServiceHours: $("#P5ServiceHours").val(),
          P1Blendedrate: $("#P1Blendedrate").val(),
          P2Blendedrate: $("#P2Blendedrate").val(),
          P3Blendedrate: $("#P3Blendedrate").val(),
          P4Blendedrate: $("#P4Blendedrate").val(),
          P5Blendedrate: $("#P5Blendedrate").val(),
          P1WeekendHours: $("#P1WeekendHours").val(),
          P2WeekendHours: $("#P2WeekendHours").val(),
          P3WeekendHours: $("#P3WeekendHours").val(),
          P4WeekendHours: $("#P4WeekendHours").val(),
          P5WeekendHours: $("#P5WeekendHours").val(),
          HasSLAmanager: $("#HasSLAManager").val(),
      };

      //alert(myArray[0].id + " ," + myArray[0].value);
      //var data1 = { 'listObject': myArray };
      var data = JSON.stringify(model)
      $.ajax({
          type: 'post',
          url: RootUrl + 'AjaxService/INIncidentServicehoursInsertorUpdate',
          data: data,
          contentType: 'application/json; charset=utf-8',
          success: function (response) {

              alert("Information Saved successfully");
              $("#HasSLAManager").data("kendoComboBox").enable(false);
              $("#P1ServiceHours").data("kendoComboBox").enable(false);
              $("#P2ServiceHours").data("kendoComboBox").enable(false);
              $("#P3ServiceHours").data("kendoComboBox").enable(false);
              $("#P4ServiceHours").data("kendoComboBox").enable(false);
              $("#P5ServiceHours").data("kendoComboBox").enable(false);
              $("#P1WeekendHours").data("kendoComboBox").enable(false);
              $("#P2WeekendHours").data("kendoComboBox").enable(false);
              $("#P3WeekendHours").data("kendoComboBox").enable(false);
              $("#P4WeekendHours").data("kendoComboBox").enable(false);
              $("#P5WeekendHours").data("kendoComboBox").enable(false);
              $("#P1Blendedrate").data("kendoNumericTextBox").enable(false);
              $("#P2Blendedrate").data("kendoNumericTextBox").enable(false);
              $("#P3Blendedrate").data("kendoNumericTextBox").enable(false);
              $("#P4Blendedrate").data("kendoNumericTextBox").enable(false);
              $("#P5Blendedrate").data("kendoNumericTextBox").enable(false);
              $("#SaveButton").data("kendoButton").enable(false);
          },
          error: function (response) {
              alert("error occured");
          }
      });
    }
</script>

