@*@model IList<WebUI.Areas.IncidentNavigator.Models.IncidentListModel >*@
@using PagedList.Mvc;
@using PagedList;
@model IPagedList<WebUI.Areas.IncidentNavigator.Models.IncidentListModel>
@{
    ViewBag.Title = "_IncidentList";
    var KEDBId = 0;
}


<div>
    <h4>Incident List</h4>
    <table class="table table-striped" id="pp38Home" cellpadding="0" cellspacing="0">

         <thead>
            <tr>
                <th scope="col" width="10%">Incident ID</th>
                <th scope="col" width="10%">Title</th>
                <th scope="col" width="10%">Description</th>
                <th scope="col" width="10%"></th>
            </tr>
        </thead>



        @foreach (var item in Model)
        {


                <tr>
                   @*@Html.HiddenFor(modelItem => item.KEDBId, new { @id = "hidId" })*@

                    <td style='text-align:right;'>
                        @Html.DisplayFor(modelItem => item.IncidentID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Title)
                    </td>

                    <td>
                        <div data-toggle="tooltip" data-placement="right" title="@item.Description" style="overflow: hidden;width:100px; height:50px; text-overflow: ellipsis;">
                            @Html.DisplayFor(modelItem => item.Description)
                        </div>
                    </td>
                    <td>
                        <a data-kedbid="@item.KEDBId" data-kedbincidentId="@item.Id" href="#" class="kedbinchref">DELETE</a>  
                    </td>  
                                  
                </tr>
            KEDBId = item.KEDBId;
        }
        
            </table>

    <div id="incList" class="pagerclass">
        @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
        @Html.PagedListPager(Model, page => Url.Action("GetIncidents", new { KEDBId = KEDBId, page = page }))
    </div>

    <button  id="btnUpload"  onclick="OpenModalWindow(); return false;" class="btn btn-primary" tabindex="30">Link Incidents</button>
</div>
                                
<script>
        $(".kedbinchref").click(function () {
           // alert('delete');
            var dataToPost =
                {
                kedbId: $(this).attr("data-kedbid"),
                kedbincidentId: $(this).attr("data-kedbincidentId")

                //ClientId: $('#hidClientId').val()
            };
           // alert('here i am-' + $(this).attr("data-incidentid"));

            $.ajax(
            {
                url: '@Url.Content("~/IncidentNavigator/KnownErrorDB/DeleteKedbIncidents")',
                type: 'POST',
                async: false,
                data: JSON.stringify(dataToPost),
                contentType: 'application/json; charset=utf-8',
                success: function (data)
                {
                //alert(JSON.stringify(data));
                $("#KEDBAddEditDiv").html(data);

                },
                error: function ()
                {
                alert('error');
                }


                });

        });

    $('#incList').on('click', 'a', function () {
        //alert('here');
        $.ajax({
            url: this.href,
            type: 'GET',
            cache: false,

            success: function (result) {
                $('#IncidentDiv').html(result);
            }
        });
        return false;
    });
   
</script>