@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.IncidentNavigator.Controllers;
@using WebUI.Areas.IncidentNavigator.Dto;
@using Kendo.Mvc.UI;
@using System.Data;

@model ClusterManagementInput
@{
    ViewBag.Title = "Incident Navigator";
   
    ViewBag.ImagePathOne = Url.Content("~/Content/images/incident_navigator_icon.png");
    //Layout = "~/Areas/IncidentNavigator/Views/Shared/_INLayout.cshtml";
    Layout = "~/Views/Shared//GenericLayoutWithoutFooter.cshtml";
}

            <div id="progressIndicator" class="progressIndicatorStyle">
                <span>Please wait while the report is being loaded!</span>
                <br />
                <img style="width:50px; height:auto" src="@Url.Content("~/Content/images/reload.gif")" />
            </div>
            <iframe id="frameTrendig" onload="closeProgressIndicator()" src='@Url.Content("~/Areas/IncidentNavigator/AspxReport/BackLogAnalysis.aspx")' border="0" frameborder="0" height="800" width="100%"></iframe>
        <style>
            #export {
                margin: 0 0 10px 1px;
                float: right;
            }

            .progressIndicatorStyle {
                /*background-color:gray;*/
                /*width: 200px;*/
                height: 200px;
                /*border:solid 2px white;*/
                top: 25%;
                left: 40%;
                z-index: 99999;
                position: absolute;
                display: block;
                text-align: center;
                margin: auto;
            }
 
        </style>


<script type="text/javascript">


    function btnClick() {

        $("#configurator").toggle();

    }
    $("#export").click(function (e) {
        var pivotgrid = $("#pivotgrid").data("kendoPivotGrid");
        pivotgrid.saveAsExcel();
    });
    function ConfigItem_change() {



    }



    function additionalData(e) {
        var ddlItem = $("#fabric").data("kendoComboBox").value();
        //alert(ddlItem);
        return { ClientID: ddlItem }
    }


    function filterProducts() {
        //alert($("#fabric").val());
        return {
            ClientID: $("#fabric").val()
            //productFilter: $("#products").data("kendoComboBox").input.val()
        };
    }

    function filterTypes(e) {

        return {
            ClientID: $("#fabric").val(),
            ConfigItem: $("#ConfigItem").val()
        };
    }

    function closeProgressIndicator() {
        $("#progressIndicator").hide();
    }
</script>

