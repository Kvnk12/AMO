                margin: auto;
            }


        </style>



<script type="text/javascript">
    $(document).ready(function () {
        //$("#configurator").toggle();
        //var ClientID = $('#myHiddenVar').val();
        //var ClientID = $('#clientNameHiddenVar').val();

        @*$('#frameTrendig').attr('src', '@Url.Content("~/Areas/IncidentNavigator/AspxReport/WebForm1.aspx?ClientId=")' + ClientID );*@
    });

    function btnClick() {

        $("#configurator").toggle();

    }
    $("#export").click(function (e) {
        var pivotgrid = $("#pivotgrid").data("kendoPivotGrid");
        pivotgrid.saveAsExcel();
    });


    function TicketType_change() {
        var ClientID = $("#fabric").val();
        var ConfigItem = $("#ConfigItem").val();
        var TicketType = $("#TicketType").val();

        @*$('#frameTrendig').attr('src', '@Url.Content("~/Areas/IncidentNavigator/AspxReport/INTrendingReport.aspx?ClientId=")' + ClientID + '&ConfigItem=' + ConfigItem + '&TicketType=' + TicketType);*@

        $('#frameTrendig').attr('src', '@Url.Content("~/Areas/IncidentNavigator/AspxReport/WebForm1.aspx")');

    }

    function additionalData(e) {
        var ddlItem = $("#fabric").data("kendoComboBox").value();
        //alert(ddlItem);
        return { ClientID: ddlItem }
    }


    function filterProducts() {
        //alert($("#fabric").val());
        return {
            ClientID: $("#fabric").val()
            //productFilter: $("#products").data("kendoComboBox").input.val()
        };
    }

    function filterTypes(e) {

        return {
            ClientID: $("#fabric").val(),
            ConfigItem: $("#ConfigItem").val()
        };
    }


    function closeProgressIndicator() {
        $("#progressIndicator").hide();
    }



</script>

