        <iframe id="frameTrendig" onload="closeProgressIndicator()" src='@Url.Content("~/Areas/IncidentNavigator/AspxReport/AnalysisNew.aspx")' border="0" frameborder="0" height="1000px"  width="100%"></iframe>

        <style>
