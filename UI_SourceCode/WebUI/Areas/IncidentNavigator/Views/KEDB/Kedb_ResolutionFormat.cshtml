    function GetAccId() {

        var app = $("#AccountNamesList").data("kendoDropDownList");
        return {
            Accid: app.value()
        }
    }

    function onSelectAccount(e) {
        var app = $("#Contract").data("kendoDropDownList");
        app.dataSource.read();
    }

    $('#btnPreview').on("click", function (e) {

        RefreshReport();

    });

    function RefreshReport()    {



        var TowerctrlSel = $('#Tower').val();
        var TowerDesc="";
        for (var i = 0; i < TowerctrlSel.length; i++ )
        {
            if (i>0) {  TowerDesc +=",";  }
            TowerDesc += $('#Tower option:selected')[i].label;
        }
        var Towarr = TowerDesc.split(',');
        console.log(TowerDesc );



        var IssuectrlSel = $('#IssueType').val();
        var IssueDesc = "";
        for (var i = 0; i < IssuectrlSel.length; i++) {
            if (i > 0) { IssueDesc += ","; }
            IssueDesc += $('#IssueType option:selected')[i].label;
        }
        var Issarr = IssueDesc.split(',');
        console.log(IssueDesc);

        SaveReportParameters(TowerctrlSel, IssuectrlSel);
        var viewer = $("#reportViewerKEDBResolutionFormat").data("telerik_ReportViewer");

	    if(viewer !== undefined)
        {
            viewer.reportSource({
                report: viewer.reportSource().report,
                parameters: {
                    IncidentClientid: @Model.ClientId,
                    AccountName:$("#AccountNamesList").data("kendoDropDownList").value(),
                    ContractID: $("#Contract").data("kendoDropDownList").value(),
                    TowerDropDown: Towarr,
                    TypeDropDown : Issarr,
                    IncidentStartDate: $("#start").val(),
                    IncidentEndDate: $("#end").val(),
                    ObservationDateRange: $("#start").val() + " To " + $("#end").val(),
                    ClientName: '@Model.ClientName',
                    UserName: '@Model.UserName',
                    DateTimeNow: '@Model.CreatedDt'

                }        });
        }
        viewer.refreshReport();

    }

    function SaveReportParameters( Towarr, Issarr) {

        //Ajax call begin

        var model = {
            TowerDropDown: Towarr,
            IssueDropDown: Issarr,
        };
        var data = JSON.stringify(model);

        $.ajax(
            {
                type: 'post',

                url: 'SaveReportDetails',
                data: data,
                async: true,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    //                    alert('Success');
                    console.log("SaveReportDetails Success");

                },
                error: function (err, data) {
                    console.log(arguments);
                    //                    alert('Ajax Error');
                }

            });
        //Ajax end

    }


    function InteractiveEnter(e, args) {
        if (args.action.Type === 'customAction') {
            color = $(args.element).css("background-color");
            $(args.element).css({ 'font-weight': 'bolder', 'background-color': '#d1d1d1' });
        }
    }

    function interactiveActionKEDB(e, args) {
        if (args.action.Type === 'customAction') {

            console.log("argument" + args);


            if (args.action.Value.Parameters[0] != undefined) {
                ParamTower = args.action.Value.Parameters[0].Value;
                console.log("ParamTower is " + ParamTower);
            }
            if (args.action.Value.Parameters[1] != undefined) {
                ParamIssueType = args.action.Value.Parameters[1].Value;
                console.log("ParamIssueType is " + ParamIssueType);
            }
            if (args.action.Value.Parameters[2] != undefined) {
                Paramdoc = args.action.Value.Parameters[2].Value;
                console.log("KEDB is " + Paramdoc);

            }


            document.getElementById("tower").value = ParamTower;
            document.getElementById("IssueTypeId").value = ParamIssueType;
            document.getElementById("KADoc").value = Paramdoc;
            document.getElementById('displayLabel').innerHTML = "KEDB Resolution Format - Tower : " + ParamTower + ", Issue Type:  " + ParamIssueType + " ";



            var grid = $("#kedbGridDrill").data("kendoGrid");
            grid.dataSource.read();
            $('#KEDBResolutionFormatPopUp').modal('show');
        }
    }



    function InteractiveLeave(e, args) {
        if (args.action.Type === 'customAction') {
            $(args.element).css({ 'font-weight': 'normal', 'background-color': color });

        }
    }

    function GetdrilldownTrendParameters(e) {

        console.log("In getDrilldownParamters");


        return {

            KADoc_action: document.getElementById("KADoc").value,
            IssueType_action: document.getElementById("IssueTypeId").value,
            Tower_action: document.getElementById("tower").value,
            StartDate: $("#start").val(),
            EndDate: $("#end").val()

        };
    }


    function getDescriptionToolTip1(e) {
        var dataItem = $("#kedbGridDrill").data("kendoGrid").dataItem(e.target.closest("tr"));
        var content = dataItem.Description;
        return content;
    }
