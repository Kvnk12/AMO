<div class="content-main dark-bg support-body-container">
    <div>
        <ol class="breadcrumb container">
            <li>Incident Navigator</li>
            <li>KEDB</li>
            <li class="active">Summary</li>
        </ol>

        <input type="hidden" id="Towers" name="Towers">
        <input type="hidden" id="issueTypeID" name="issueTypeID">
        <input type="hidden" id="solCatID" name="solCatID">
        <input type="hidden" id="solStatusID" name="solStatusID">
        <input type="hidden" id="kedbNumber" name="kedbNumber">
        <input type="hidden" id="ReportnameH" name="ReportnameH">



