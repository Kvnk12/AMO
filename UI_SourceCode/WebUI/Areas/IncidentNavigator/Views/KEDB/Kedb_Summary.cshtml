    function RefreshReport()    {



        var TowerctrlSel = $('#Tower').val();
        var TowerDesc="";
        for (var i = 0; i < TowerctrlSel.length; i++ )
        {
            if (i>0) {  TowerDesc +=",";  }
            TowerDesc += $('#Tower option:selected')[i].label;
        }
        var Towarr = TowerDesc.split(',');
        console.log(TowerDesc );



        var IssuectrlSel = $('#IssueType').val();
        var IssueDesc = "";
        for (var i = 0; i < IssuectrlSel.length; i++) {
            if (i > 0) { IssueDesc += ","; }
            IssueDesc += $('#IssueType option:selected')[i].label;
        }
        var Issarr = IssueDesc.split(',');
        console.log(IssueDesc);


        var CategoryctrlSel = $('#Category').val();
        var CategoryDesc = "";
        for (var i = 0; i < CategoryctrlSel.length; i++) {
            if (i > 0) { CategoryDesc += ","; }
            CategoryDesc += $('#Category option:selected')[i].label;
        }
        var Catarr = CategoryDesc.split(',');
        console.log(CategoryDesc);


        var StatusctrlSel = $('#Status').val();
        var StatusDesc = "";
        for (var i = 0; i < StatusctrlSel.length; i++) {
            if (i > 0) { StatusDesc += ","; }
            StatusDesc += $('#Status option:selected')[i].label;
        }
        var Staarr = StatusDesc.split(',');
        console.log(StatusDesc);

        SaveReportParameters(TowerctrlSel, IssuectrlSel, CategoryctrlSel,StatusctrlSel);
        var viewer = $("#reportViewerKEDBSummary").data("telerik_ReportViewer");

	    if(viewer !== undefined)
        {
            viewer.reportSource({
                report: viewer.reportSource().report,
                parameters: {
                    IncidentClientid: @Model.ClientId,
                    AccountName:$("#AccountNamesList").data("kendoDropDownList").value(),
                    ContractID: $("#Contract").data("kendoDropDownList").value(),
                    TowerDropDown: Towarr,
                    TypeDropDown : Issarr,
                    StatusDropDown: Staarr,
                    categoryDropDown: Catarr,
                    IncidentStartDate: $("#start").val(),
                    IncidentEndDate: $("#end").val(),
                    ObservationDateRange: $("#start").val() + " To " + $("#end").val(),
                    ClientName: '@Model.ClientName',
                    UserName: '@Model.UserName',
                    DateTimeNow: '@Model.CreatedDt'

                }        });
        }
        //setting the HTML5 Viewer's reportSource, causes a refresh automatically
        //if you need to force a refresh for other case, use:
        viewer.refreshReport();

    }

    function SaveReportParameters( Towarr, Issarr,Catarr,Staarr) {

        //Ajax call begin

        var model = {
            TowerDropDown: Towarr,
            IssueDropDown: Issarr,
            CategoryDropDown: Catarr,
            StatusDropDown: Staarr,
        };
        var data = JSON.stringify(model);

        $.ajax(
            {
                type: 'post',

                url: 'SaveReportDetails',
                data: data,
                async: true,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    //                    alert('Success');
                    console.log("SaveReportDetails Success");

                },
                error: function (err, data) {
                    console.log(arguments);
                    //                    alert('Ajax Error');
                }

            });
        //Ajax end

    }

    var color = "";

    function InteractiveEnter(e, args) {
        if (args.action.Type === 'customAction') {
            color = $(args.element).css("background-color");
            $(args.element).css({ 'font-weight': 'bolder', 'background-color': '#d1d1d1' });
        }
    }


    function InteractiveActionResolution(e, args) {
        if (args.action.Type === 'customAction') {

            var Tower = '';
            var issueTypeID = '';
            var solCatID = '';
            var solStatusID = '';
            var kedbNumber = '';
            var selectCase = '';
            //Tower
            if (args.action.Value.Parameters[0] != undefined) {
                Tower = args.action.Value.Parameters[0].Value;
                console.log("Tower is " + Tower);
            }
            //Issue Type Id
            if (args.action.Value.Parameters[1] != undefined) {
                issueTypeID = args.action.Value.Parameters[1].Value;
                console.log("issueTypeID is " + issueTypeID);

            }
            //Solution Category id
            if (args.action.Value.Parameters[2] != undefined) {
                solCatID = args.action.Value.Parameters[2].Value;
                console.log("solCatID is " + solCatID);

            }
            //Solution status id
            if (args.action.Value.Parameters[3] != undefined) {
                solStatusID = args.action.Value.Parameters[3].Value;
                console.log("solStatusID is " + solStatusID);
            }
            //KEDBNumber
            if (args.action.Value.Parameters[4] != undefined) {
                kedbNumber = args.action.Value.Parameters[4].Value;
                console.log("kedbNumber is " + kedbNumber);
                //document.getElementById("KEDBNumber").value = args.action.Value.Parameters[4].Value;
            }
            if (args.action.Value.Parameters[5] != undefined) {
                selectCase = args.action.Value.Parameters[5].Value;
                console.log("selectCase is " + selectCase);

            }

            if (selectCase != "KEDBNO") {

                document.getElementById("Towers").value = Tower;
                document.getElementById("issueTypeID").value = issueTypeID;
                document.getElementById("solCatID").value = solCatID;
                document.getElementById("solStatusID").value = solStatusID;
                document.getElementById("kedbNumber").value = kedbNumber;

                //var ReportByFilter = $("#DateGroup").data("kendoDropDownList").text();
                document.getElementById('KEDBSummaryLabel').innerHTML = "KEDB Summary - " + Tower + " " + kedbNumber + " ";
                //document.getElementById("count").value = 3;

                document.getElementById("ReportnameH").innerHTML = "KEDB Summary";
                var gridpriority = $("#GridKEDBSummaryTickets").data("kendoGrid");
                gridpriority.dataSource.read();
                $('#KEDBSummaryPopUp').modal('show');
            }
            else {
                document.getElementById('displayLabel').innerHTML = "KEDB Summary - " + Tower + " "+ kedbNumber + " ";
                document.getElementById("kedbNumber").value = kedbNumber;
                document.getElementById("Towers").value = Tower;
                var gridKEDB = $("#kedbGridDrill_Summary").data("kendoGrid");
                gridKEDB.dataSource.read();
                $('#KEDBSum_KNO').modal('show');
            }
        }

    }



