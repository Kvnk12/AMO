                $("#statusname2").text(data.SolStatus);
                document.getElementById("confirmambernote").innerHTML = "On confirming, ticket will be mapped to the KEDB " + data.KEDBNumber;
                document.getElementById("confirmMultBtn").style.display = 'flex';
                document.getElementById("btnViewCancel").style.display = 'none';
                popup.open();
                popup.center();
                $("#Ticket-viewgrid").data("kendoGrid").dataSource.read();

            }
        });
    }
    function onConfirmMultClick() {
          var grid = $("#kedbGrid").getKendoGrid();
        var selectedRow = grid.select();
        var dataItem = grid.dataItem(selectedRow);
        var KEDBID = dataItem.KEDBID;
        var selectedIDs = grid.selectedKeyNames().join("-");
        var mod = {
            KEDBID: KEDBID,
            selectedIDs: selectedIDs
        };
        var data1 = JSON.stringify(mod);
        baseurl1 = '@Url.Content("~/KEDB/ConfirmMultKEDBAutoAssignment")';
        $.ajax(
            {
                url: baseurl1,
                type: 'post',
                data: data1,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    $("#kedbGrid").data("kendoGrid").dataSource.read();
                    document.getElementById("btnEdit").disabled = true;
                    document.getElementById("editbutton").style.display = 'none';
                    document.getElementById("btnAssign").style.display = 'none';
                    document.getElementById("btnAssign1").style.display = 'none';
                    document.getElementById("btnDeLink").disabled = true;
                    document.getElementById("deLinkbutton").style.display = 'none';
                    document.getElementById("btnConfirm").disabled = true;
                    document.getElementById("confirmbutton").style.display = 'none';
                    document.getElementById("btnConfirmMult").style.display = 'none';
                    document.getElementById("delinkdiv").style.display = 'block';
                    var popup = $("#viewKEDBpopUp").data("kendoWindow");
                    popup.close();
                    document.getElementById("View_KEDBID").value = null;
                    document.getElementById("Selected_TicketID").value = null;
                }

            }
        )
    }


    function getTooltipcontent1(e) {
        var dataItem = $("#kedbGrid").data("kendoGrid").dataItem(e.target.closest("tr"));
        var isassigned = dataItem.isAutoIdentifiedVal;
        var content = "";
        if (isassigned == "True") {
            content = "Item Added through Automation";
        }
        if (isassigned == "False") {
            content = "Item Mapped to KEDB";
        }
        if (dataItem.KEDBNumber == null) {
            content = "Item not Mapped to KEDB";
        }
        return content;
    }
</script>
