<link rel="stylesheet" href="~/Content/plugins/scrollbar/css/jquery.scrollbar.css" />
<script>

    var kedbForEdit = null;
    function onChange(e, args) {

        //console.log("The selected product ids are: [" + this.selectedKeyNames().join(", ") + "]");
        //var grid = $("#kedbGrid").data("kendoGrid");
        //var selectedItem = grid.dataItem(grid.select());
        //console.log(selectedItem);
        //alert("unchecked");
        var SelectedCount = 0;
        var firstKedb = "";
        var canEdit = false;
        var canAdd = false;
      var canGen = false;
        var canAssign = false;
        var confirmMult = false;
        var selectRowCount = 0;
        var isautoassigned = '';
        var selassignrow = 0;
        var selectconfirmrow = 0;
        //fetching all selected rows
        var rows = e.sender.select();
        console.log("rows" + e);
        rows.each(function (e) {
            var grid = $("#kedbGrid").data("kendoGrid");
            var dataItem = grid.dataItem(this);
            selectRowCount += 1;

            //console.log(dataItem);
            //console.log(dataItem.ConfigItemName);

        })

        //alert(selectRowCount);
        if (selectRowCount != 0) {
            rows.each(function (e) {
                var grid = $("#kedbGrid").data("kendoGrid");
                var dataItem = grid.dataItem(this);
                //alert(dataItem.KEDBNumber);
                console.log(dataItem);
                //console.log(dataItem.ConfigItemName);
                isautoassigned = dataItem.isAutoIdentifiedVal;

                if (dataItem.KEDBNumber != null) {
                    if (firstKedb == "") {
                        if (SelectedCount > 0) {
                            canAdd = true;
                            canGen = false;
                            canEdit = false;
                            canAssign = false;
                            confirmMult = false;
                            firstKedb = dataItem.KEDBNumber;
                        } else {
                            canEdit = true;
                            SelectedCount += 1;
                            selassignrow++;
                            selectconfirmrow++;
                            firstKedb = dataItem.KEDBNumber;
                        }
                    }
                    else if (dataItem.KEDBNumber != firstKedb) {
                        canEdit = false;
                        SelectedCount += 1;
                        canAdd = false;
                        canAssign = false;
                        confirmMult = false;
                    } else if (dataItem.KEDBNumber == firstKedb) {
                        canEdit = false;
                        SelectedCount += 1;
                        canAdd = false;
                        canAssign = true;
                        selassignrow++;
                        if (dataItem.isAutoIdentifiedVal == 'True') {
                            confirmMult = true;
                            selectconfirmrow++;
                        }
                        else {
                            confirmMult = false;
                        }
                    }
                }
                else if (firstKedb != "") {
                    canAdd = true;
                    canEdit = false;
                    SelectedCount += 1;
                    canAssign = false;
                    confirmMult = false;
                }
                else if (dataItem.KEDBNumber == null && selectRowCount != 0) {
                    canGen = true;
                    SelectedCount += 1;
                    canAssign = false;
                    confirmMult = false;
                }

                if (dataItem.KEDBNumber != null) {
                    kedbForEdit = dataItem.KEDBID;
                }

            })
        } else if (selectRowCount == 0) {
            //alert("Count 0 canEdit false");
            canEdit = false;
            document.getElementById("btnEdit").disabled = true;
            document.getElementById("editbutton").style.display = 'none';
            document.getElementById("btnDeLink").disabled = true;
            document.getElementById("deLinkbutton").style.display = 'none';
        }
        if (selectRowCount == 0) {
            canEdit = false;
            canAdd = false;
            canGen = false;
        }
        if (canAdd == true) {
            document.getElementById("btnAddNew").disabled = false;
            document.getElementById("addbutton").style.display = 'block';
        } else {
            document.getElementById("btnAddNew").disabled = true;
            document.getElementById("addbutton").style.display = 'none';
        }
        if (canEdit == true) {
            document.getElementById("btnEdit").disabled = false;
            document.getElementById("editbutton").style.display = 'block';
            document.getElementById("btnDeLink").disabled = false;
            document.getElementById("deLinkbutton").style.display = 'block';
            document.getElementById("btnAssign1").disabled = false;
            document.getElementById("btnAssign1").style.display = 'block';
            console.log(isautoassigned);
            console.log('@userRole');
            if (isautoassigned == 'True' && '@userRole' == 'True') {
                document.getElementById("btnConfirm").disabled = false;
                document.getElementById("confirmbutton").style.display = 'block';
            }
        } else {
            document.getElementById("btnEdit").disabled = true;
            document.getElementById("editbutton").style.display = 'none';
            document.getElementById("btnDeLink").disabled = true;
            document.getElementById("deLinkbutton").style.display = 'none';
            document.getElementById("btnAssign1").disabled = true;
            document.getElementById("btnAssign1").style.display = 'none';

            document.getElementById("btnConfirm").disabled = true;
            document.getElementById("confirmbutton").style.display = 'none';
        }
        if (canGen == true) {
            document.getElementById("btnGen").disabled = false;
            document.getElementById("genbutton").style.display = 'block';
        } else {
            document.getElementById("btnGen").disabled = true;
            document.getElementById("genbutton").style.display = 'none';
        }
        if (canAssign == true && selassignrow == selectRowCount) {
          document.getElementById("btnAssign").disabled = false;
          document.getElementById("btnAssign").style.display = 'block';
      } else {
          document.getElementById("btnAssign").disabled = true;
          document.getElementById("btnAssign").style.display = 'none';
        }
        if (confirmMult == true && '@userRole' == 'True' && selectconfirmrow == selectRowCount) {
              console.log("confirm multiple");
              document.getElementById("btnConfirmMult").disabled = false;
              document.getElementById("btnConfirmMult").style.display = 'block';
        } else {
          document.getElementById("btnConfirmMult").disabled = true;
          document.getElementById("btnConfirmMult").style.display = 'none';
        }

    };
    function buttonAdd() {
        //alert("button add /View yet to be provided");
        console.log(kedbForEdit);
        var grid = $("#kedbGrid").getKendoGrid()
        var selectedIDs = grid.selectedKeyNames().join(", ");
        console.log(selectedIDs);
        var selectedRow = grid.select();
        var kednum = "";
        for (var i = 0; i < selectedRow.length; i++) {
            var dataItem = grid.dataItem(selectedRow[i]);
            if (dataItem.KEDBNumber != null) {
                console.log(dataItem.KEDBNumber);
                kednum = dataItem.KEDBNumber;
            }
        }

        var Ids = JSON.stringify(selectedIDs);

        var mod = {
            Ids: Ids,
            kedbID: kedbForEdit
        };
        baseurl1 = '@Url.Content("~/KEDB/AddTicketsToKEDB")';
        $.ajax(
        {
            url: baseurl1,
            type: 'get',
            data: {
                Ids: Ids,
                KEDBID: kedbForEdit
            },
            async: false,
                contentType: 'application/json; charset=utf-8',
                error: function (response) {

                    alert('Error');
                },
                success: function (data) {

                    $("#kedbGrid").data("kendoGrid").dataSource.read();
                    console.log("success");
                    document.getElementById('addedkedb').innerHTML = kednum;
                    $('#addTicketAlertModal').modal('show');
                }
       })
    }
    //button.disabled = true;
    function buttonGen() {
        var grid = $("#kedbGrid").getKendoGrid()
        var selectedIDs = grid.selectedKeyNames().join("-");
        //var totalFile = document.getElementById("FileToUpload").files[0];
        //console.log(totalFile);
        console.log(selectedIDs);
        var mod = {
            Ids: selectedIDs
        };
        var data1 = JSON.stringify(mod);
        baseurl1 = '@Url.Content("~/KEDB/GenerateKedbId")';
        $.ajax(
        {
            url: baseurl1,
            type: 'post',
            data: data1,
            async: false,
            contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    $("#KEDB").data("kendoTextBox").readonly(true);
                    $("#KEDB").val(data.KEDBNumber);
                    $("#Id").val(data.Id);
                    $("#Incid").val(data.Incid);
                    console.log(data.KEDBNumber);
                    $("#IssueTypeId").data("kendoDropDownList").value("")
                    $("#BusinessFunctionId").data("kendoDropDownList").value("")
                    $("#SolutionCategoryId").data("kendoDropDownList").value("");
                    $("#KnowledgeArticle").data("kendoTextBox").value("");
                    $("#PointOfContact").data("kendoTextBox").value("");
                    $("#Description").val("");
                    $("#ResStepss").val("");
                    document.getElementById('view-ticket-detail').innerHTML = 'View Ticket ID and Issue Description';
                    document.getElementById('viewTicketdetail').style.display = 'none';
                    $("#view-icon-detail").removeClass("hide-eye-icon");
                    $('#IssueType_alert').hide();
                    $('#KnowledgeArticle_alert').hide();
                    var popup = $("#AddKEDBpopUp").data("kendoWindow");
                    $('.k-window-title').text("Add KEDB");
                    popup.open();
                    popup.center();
                    $("#viewTicketgrid").data("kendoGrid").dataSource.data(data.klist);
            }


       })
    }
    var oldsolutionStatusId = 0;
    var show = '0';
    function onEditBtnClickEntry() {
        if ('@userRole' == 'false') {
            var grid = $("#kedbGrid").getKendoGrid();
            var selectedRow = grid.select();
            var dataItem = grid.dataItem(selectedRow);
            var KEDBID = dataItem.KEDBID;
            var Status = dataItem.SolStatus;
            console.log(Status);
            if (Status != 'Draft') {
                show
                $("#editalert").text("! KEDB Manager can edit the Approved KEDB");
                $("#editalert").show();
                show = '1';
                showKedb1(KEDBID);
            } else {
                buttonEdit();
            }
        } else {
            buttonEdit();
        }

    }
    function buttonEdit() {
        var grid = $("#kedbGrid").getKendoGrid();
        var selectedRow = grid.select();
        var dataItem = grid.dataItem(selectedRow);
        var KEDBID = dataItem.KEDBID;
       // console.log(dataItem.KEDBID);
        var mod = {
            KEDBID: KEDBID
        };
        var data1 = JSON.stringify(mod);
        baseurl1 = '@Url.Content("~/KEDB/EditKedbId")';
        $.ajax(
            {
                url: baseurl1,
                type: 'post',
                data: data1,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    $("#edit_Id").val(data.Id);
                   // console.log(data.Id);
                    $("#edit_KEDB").val(data.KEDBNumber);
                    $('#edit_KEDB').prop("disabled", "disabled")
                    var Issuedropdown = $("#edit_IssueTypeId").data("kendoDropDownList");
                    Issuedropdown.value(data.IssueTypeId);
                    var Businessdropdown = $("#edit_BusinessFunctionId").data("kendoDropDownList");
                    Businessdropdown.value(data.BusinessFunctionId);
                    $('#edit_Description').val(data.Description);
                    console.log(data.Description);
                    var Solutiondropdown = $("#edit_SolutionCategoryId").data("kendoDropDownList");
                    Solutiondropdown.value(data.SolutionCategoryId);
                    $('#edit_KnowledgeArticle').val(data.KnowledgeArticle);
                    $('#ResStepss_Edit').val(data.ResolutionSteps);
                   // console.log(data.KnowledgeArticle);
                    var SolStatusdropdown = $("#edit_SolutionStatusId").data("kendoDropDownList");
                    SolStatusdropdown.value(data.SolutionStatusId);
                    SolStatusdropdown.text(data.SolStatus);
                    oldsolutionStatusId = data.SolutionStatusId;
                    //$('#edit_SolutionStatusId').val(data.SolutionStatusId).attr("selected", "selected");
                    $("#edit_PointOfContact").val(data.PointOfContact);
                    $("#edit_user").val(data.UpdatedUser);
                    $('#edit_user').prop("disabled", "disabled")
                    $("#edit_date").val(data.UpdatedDateTime);
                    $('#edit_date').prop("disabled", "disabled")
                    if (data.SolStatus != null) {
                        $("#statusname1").text(data.SolStatus);
                        $("#statusname2").text(data.SolStatus);
                    }

                    var editgrid = $("#editViewTicketgrid").data("kendoGrid");
                    editgrid.dataSource.read();
                    var editpopup = $("#EditKEDBpopUp").data("kendoWindow");
                    $('.k-window-title').text("Edit KEDB");
                    console.log(editpopup);
                    editpopup.open();
                    //win.open().center();
                }


            }
        )
    }
    function onEditSaveClick() {
         $('#editIssueType_alert').hide();
         $('#editSolutionStatus_alert').hide();
         $('#editKnowledgeArticle_alert').hide();
        var Id = $("#edit_Id").val();
         var IssueTypeId = $("#edit_IssueTypeId").data("kendoDropDownList").value();
         if (IssueTypeId == '') {
             $('#editIssueType_alert').show();
             return false;
         }
        var BusinessFunctionId = $("#edit_BusinessFunctionId").data("kendoDropDownList").value();
         var SolutionCategoryId = $("#edit_SolutionCategoryId").data("kendoDropDownList").value();
         var KEDBNum = $("#edit_KEDB").val();
         var SolutionStatusId = $("#edit_SolutionStatusId").data("kendoDropDownList").value();
        if (SolutionStatusId == '') {
            SolutionStatusId = oldsolutionStatusId;
            if (SolutionStatusId == 0) {
                $('#editSolutionStatus_alert').show();
                return false;
            }
         }
         var KnowledgeArticle = $("#edit_KnowledgeArticle").val();
        if (KnowledgeArticle.trim() == '') {
            KnowledgeArticle = " ";
             //$('#editKnowledgeArticle_alert').show();
             //return false;
         }
         var PointOfContact = $("#edit_PointOfContact").val();
         if (PointOfContact.trim() == '') {
             PointOfContact = " ";
         }
         var Description = $("#edit_Description").val();
         if (Description.trim() == '') {
             Description = " ";
        }

        var ResolutionSteps_Edit = $("#ResStepss_Edit").val();
        if (ResolutionSteps_Edit.trim() == '') {
            ResolutionSteps_Edit = " ";
