<div class="viewKedbpopUpDiv">
    @(Html.Kendo().Window()
                .Name("viewKEDBpopUp")
                .Title("")
                .Content(@<text>
    <div class="viewKedb">
          <div class="viewTicketID">
                <div class="hideTicketDetail">
                <div class="view-icon" id="view-icon-detail_view" onclick="switchGridVisible_View();">

                </div>
                <div>
                    <span class="custom-blue-label" id="view-ticket-detail_view" onclick="switchGridVisible_View();">View Ticket ID and Issue Description</span>
