                </div>
                </div>
                <div class="hidden-grid" id="viewTicketdetail_view" style="display: none;">
                        <div class="custom-kendo-grid kedb-view-grid scrollbar-rail " style="height:12em;overflow:auto">
                        @(Html.Kendo().Grid<KEDBInstanceModel>()
                                 .Name("Ticket-viewgrid")
                                 .Columns(columns =>
                                 {
                                     columns.Bound(p => p.isAutoIdentifiedVal).Hidden();
                                     columns.Bound(p => p.TicketId).Title("Tickets ID").Width(200)
                                              .ClientTemplate("# if (data.TicketId!=null) { #" + "<div style='display:flex;'>" + "# if(data.isAutoIdentifiedVal=='True') { #" + "<div class=\"forTooltips3\" style = 'background-image: url(" + @Url.Content("~/Content/images/marked_to_kedb.svg") + ");background-repeat: no-repeat; width:1.3em;height:2em;margin-top: 2px;margin-right: 7px;cursor:pointer;'> </div>" + "# } #" + "# if(data.isAutoIdentifiedVal=='False') { #" + " <div class=\"forTooltips3\" style = 'background-image: url(" + @Url.Content("~/Content/images/added_automation.svg") + ");background-repeat: no-repeat; width:1.3em;height:2em;margin-top: 2px;margin-right: 7px;cursor:pointer;'> </div>" + "# } #" + " <div>#=TicketId#</div></div>" + "# } #");
                                     columns.Bound(p => p.Description).Title("Issue Description");
                                 })
                                  .AutoBind(false)
                                  .DataSource(dataSource => dataSource
                                  .Ajax()
                                  .Model(model =>
                                  {
                                      model.Id(f => f.Id);
                                  })
                                      .Read(read => read.Action("GetKEDBIncidentDetail", "KEDB").Data("getViewKEDB"))
                                   )
                         )
                              @(Html.Kendo().Tooltip()
      .For("#Ticket-viewgrid")
      .Filter(".forTooltips3")
      .ContentHandler("getTooltipcontent3")
      .Position(TooltipPosition.Bottom)
      .AutoHide(true)
)
                    </div>
                </div>
            </div>
            <input type="hidden" id="View_KEDBID" name="View_KEDBID">
            <input type="hidden" id="Selected_TicketID" name="Selected_TicketID">

            <div class="kedbTicketDetails">
            <div class="popUpfirstrow">
                <div class="firstrowFields">
                   <span class="custom-blue-label">KEDB #:</span>
                 @(Html.Kendo().TextBoxFor(m => m.KEDBNumber).Name("Kedb_view"))
                </div>
                <div class="firstrowFields issue">
                    <span class="custom-blue-label">Symptom/Issue Type:</span>
                     @(Html.Kendo().TextBoxFor(m => m.KedbIssueType).Name("IssueType_view"))
                </div>
                <div class="firstrowFields">
                     <span class="custom-blue-label">Business Funtion:</span>
                     @(Html.Kendo().TextBoxFor(m => m.BusinessFunction).Name("BusinessFunction_view"))
                </div>
            </div>
            <div class="popUpSecondrow">
               <div class="secondrowFields" style="width:66%;">
                 <span class="custom-blue-label">KEDB Description:</span>
                    @Html.TextAreaFor(m => m.Description, new { @class = "k-textbox", id= "kedbDesc_view", rows = 3, cols = 12, style = "width:38em;resize:none; height:100%; overflow:auto;border:none;color:darkgrey;" })
               </div>
               <div class="secondrowFields " style="display:flex;flex-direction:column;width:35%">
                   <div class="category" style="display: flex; margin-bottom: 1.5em; margin-left: 1.1em;">
                       <span class="custom-blue-label" >Solution Category:</span>
                       @(Html.Kendo().TextBoxFor(m => m.SolutionCategory).Name("SolutionCategory_view"))
                   </div>
                   <div class="status" style="display:flex;margin-left:1.2em">
                    <span class="custom-blue-label">Solution Status:</span>
                       @(Html.Kendo().TextBoxFor(m => m.SolStatus).Name("Solutionstatus_view"))
                   </div>
               </div>
            </div>

             <div class="popUpThirdrow">
                 <div class="thirdrowFields article "style=" width: 63%;margin-left:0em;">
                      <div class="article-title">
                          <label class="custom-blue-label">
                            <span class="mandate" style="margin-right:0em;">*</span>
                            Resolution Details
                          </label>
                      </div>
                     <div class="row" style="display:flex;">

                            <span class="custom-blue-label" style="margin-left: 1em;">Knowledge Article:</span>

                         <div class="col-md-3" style="margin-left: 0.5em; ">
                           @(Html.Kendo().TextBoxFor(m => m.KnowledgeArticle).Name("KnowledgeArticle_view"))
                         </div>
                       <div class="search-article-icon" onclick="searchViewKnwArticle()"></div>
                     </div>

                      <p class="custom-blue-label" style="margin-left:8.5em;margin-top:-1em">or</p>


                       <div class="res-details" style="display:flex;">
                              <div class="form-group" style="margin-left: -7.5em">
                                 <div class="row" style="display: flex; margin-left: 18em;">
                                    <div class="col-md-3 browseButton" style="margin-left: -1.7em;">

                      @*@(Html.Kendo().TextBoxFor(m => m.FileName).Name("FileName_view"))*@
                      @*@Html.ActionLink("Download", "DownloadFile", "KEDB", new { KEDBId = Model.Id },null)*@
                      @*@Html.ActionLink("Download", "DownloadFile", "KEDB", new { KEDBId = Model.KEDBNumber },null)*@

                     @*@Html.ActionLink("Download", "DownloadFile", "KEDB", new { @id = "Checkuser" },null)*@


                             @*@Html.ActionLink(
                               linkText: "Download",
                               actionName: "DownloadFile",
                               controllerName: "KEDB",
                               routeValues: new {
                               KEDBId =
                               },
                               htmlAttributes: null
                              )*@
                    @*@Html.ActionLink(Model.FileName, "DownloadFile", "KEDB", new { KEDBId = 2 }, null)*@
                     <div class="row" style="display:flex;">
                        <div class="col-md-3" style="margin-left: -0.3em; ">
                          @(Html.Kendo().TextBoxFor(m => m.FileName).Name("FileName_view"))
                        </div>
                          <div class="download-button-icon" style="margin-left:26.5em" onclick="downloadViewKnwArticle()"></div>
                      </div>
                       @*<a href="@Url.Action("DownloadFile","KEDB",new{KEDBId="temp"})" id=" lnk"> Download</a>*@


                        @*@Html.ActionLink("Download", "DownloadFile", "KEDB", new { KEDBId = Model.KEDBNumber },null)*@

                                    </div>
                                 </div>
                              </div>
                         </div>

                       <div class="row" style="display:flex;">
                          <div class="col-md-3">
                               <label class="custom-blue-label"  style="margin-top:-1em" for="ResSteps">

                                  Resolution Steps:
                                </label>
                          </div>
                          <div class="col-md-3" style=" margin-left: -4.5em;">
                              @*<span class="custom-blue-label">KEDB Description:</span>*@
                        @Html.TextAreaFor(m => m.ResolutionSteps, new { @class = "k-textbox", id = "ResStep", rows = 2, cols = 10, style = "width: 33em;resize: none;height: 5em;overflow: auto;box-shadow: none;margin-left:-2em;margin-top:-1em" })     @*-------------------------11*@
                          </div>
                      </div>


                 </div>

                  <div class="thirdrowFields contact" style="margin-left: 2em;">
                    <span class="custom-blue-label">Point of Contact:</span>
                      @(Html.Kendo().TextBoxFor(m => m.PointOfContact).Name("Pointofcontact_view"))
                 </div>

            </div>
            <div class="viewkedb_User" >
                 <div class="userid">
                    <span class="custom-blue-label"><span id="statusname1">Updated</span> By:</span>
                      @(Html.Kendo().TextBoxFor(m => m.UpdatedUser).Name("view_user"))
                 </div>
                 <div class="updateddate" style="display:flex">
                    <span class="custom-blue-label"><span id="statusname2">Updated</span> On:</span>
                      @(Html.Kendo().TextBoxFor(m => m.UpdatedDate).Name("view_date"))
                     <div class="cal-icon"></div>
                 </div>
            </div>
            <div class="kedb-buttons">

                  <div>
                     <button class="custom-button" onclick="buttonViewClose()" type="button" id="btnViewCancel">CLOSE</button>
                  </div>
                <div id="confirmMultBtn" style="display:none;">
                     <div style="display: flex; margin-right: 1em; margin-top: 1em;">
                        <div class="info-icon"> </div>
                        <span class="copyPaste" style="color:#ff9100;font-size:10px;" id="confirmambernote"></span>
                     </div>
                     <div style="margin: 0 1em 0 0;">
                        <button class="custom-button" type="button" style="background-color:lightgrey;color:white"onclick="buttonViewClose()" id="cancelConfirm" >CANCEL</button>
                     </div>
                     <div style="margin: 0 1.5em 0 0;">
                        <button class="custom-button" type="button" onclick="onConfirmMultClick()" id="ConfirmMultKedb">CONFIRM</button>
                     </div>
                </div>
            </div>

        </div>

    </div>
                         </text>)
                                                .Visible(false)
                                                .Draggable()
                                                .Resizable()
                                                .Width(1050)
                                                .Height(480)
                                                .AutoFocus(false)
                                                .Modal(true)

                                                .Actions(actions => actions.Close())

)

</div>


    <script src="~/Content/plugins/scrollbar/js/jquery.scrollbar.min.js"></script>
    <script>


    var value = $("#Kedb_view").val();
    console.log("value is" + value);
    @* console.log(@Model.KEDBNumber);
    @Model.KEDBNumber = value;
    console.log(@Model.KEDBNumber);*@

        function switchGridVisible_View() {
            var temp = document.getElementById('viewTicketdetail_view');
            console.log(temp);
            if (temp.style.display == "none") {
                console.log("if");
                document.getElementById('view-ticket-detail_view').innerHTML = 'Hide Ticket ID and Issue Description';
                document.getElementById('viewTicketdetail_view').style.display = 'block';
                $("#view-icon-detail_view").addClass("hide-eye-icon");

            } else {
                console.log("else");
                document.getElementById('view-ticket-detail_view').innerHTML = 'View Ticket ID and Issue Description';
                document.getElementById('viewTicketdetail_view').style.display = 'none';
                $("#view-icon-detail_view").removeClass("hide-eye-icon");
            }
        }
        function getViewKEDB() {
            var kedbid = document.getElementById('View_KEDBID').value;
            var Selected_TicketID = document.getElementById('Selected_TicketID').value;
            console.log(kedbid);
            return {
                kedbid: kedbid,
                Selected_TicketID: Selected_TicketID
            };
        }
        function searchViewKnwArticle() {
            var searchart = $("#KnowledgeArticle_view").val();
            if (searchart.trim() != '') {
                //  window.location.href = searchart;
                window.open(searchart, "_blank");
            }
        }

        function downloadViewKnwArticle() {
            var values = $("#Kedb_view").val();
            var filename = $("#FileName_view").val();
            console.log("download value"+values);
            baseurl = '@Url.Content("~/KEDB/DownloadFile")';
            //baseurl = baseurl + '?KEDBId=' + values;
            var x = null;
            var mod1 = {
                KEDBId: values
            }
            var mod = JSON.stringify(mod1);
            if (filename != "") {
                $.ajax({

                    type: 'post',
                    url: baseurl,
                    async: false,
                    data: mod,
                    contentType: 'application/json; charset=utf-8',
                    success: function (response) {
                        //$("#kedbGrid").data("kendoGrid").dataSource.read();
                        //var popup = $("#AddKEDBpopUp").data("kendoWindow");
                        //popup.close();

                        x = $("#Kedb_view").val();
                    @*window.location = '@Url.Action("DownloadFile", "KEDB", new { KEDBId =  })';*@
                        window.location = '@Html.Raw(@Url.Action("DownloadFile", "KEDB"))' + '?KEDBId=' + x;
                        //$.ajax.load(url);
                        /* console.log(response);*/
                        /*return response;*/




                    },
                    error: function (err, response) {
                        // alert(err.responseText);
                    }
                });
            }
            else {
               $("#FileName_view").val("File not found / not uploaded");
            }
        }
        function getTooltipcontent3(e) {
            var dataItem = $("#Ticket-viewgrid").data("kendoGrid").dataItem(e.target.closest("tr"));
            var isassigned = dataItem.isAutoIdentifiedVal;
            var content = "";
            if (isassigned == "True") {
                content = "Item Added through Automation";
            }
            if (isassigned == "False") {
                content = "Item Mapped to KEDB";
            }
            return content;
        }

    </script>


    