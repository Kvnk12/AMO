<script>

    $('.parameter-filter-icon').on('click', function () {
        $(this).addClass('open');
        $('.parameter-slider').addClass('open');
        $('.parameter-slider-overlay').addClass('open');
    });
    $('.close-parameters').on('click', function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');
    });
    $('.parameter-slider-overlay').click(function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        /*$('.parameter-slider').removeClass('open');*/
    });
    $('#btnPreview').click(function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');

    });

    $('#btnSubscribe').click(function () {

        var TowerctrlSel_pop = $('#Tower').val();
        var TowerDesc_pop = "";
        for (var i = 0; i < TowerctrlSel_pop.length; i++) {
            if (i > 0) { TowerDesc_pop += ","; }
            TowerDesc_pop += $('#Tower option:selected')[i].label;
        }
        var Towarr_pop = TowerDesc_pop.split(',');
        console.log(TowerDesc_pop);
        console.log(Towarr_pop);

        var TowerctrlSel2 = $('#Tower').val();
        var TowerDesc2 = '\"';
        for (var i = 0; i < TowerctrlSel2.length; i++) {
            if (i > 0) { TowerDesc2 += ',\"'; }
            TowerDesc2 += $('#Tower option:selected')[i].label + '\"';
        }
        var Towarr2 = TowerDesc2.split(',');
        console.log(Towarr2);


        var IssuectrlSel_pop = $('#IssueType').val();
        var IssueDesc_pop = "";
        for (var i = 0; i < IssuectrlSel_pop.length; i++) {
            if (i > 0) { IssueDesc_pop += ","; }
            IssueDesc_pop += $('#IssueType option:selected')[i].label;
        }
        var Issarrr_pop = IssueDesc_pop.split(',');
        console.log(IssueDesc_pop);
        console.log(Issarrr_pop);



        var IssuectrlSel_pop1 = $('#IssueType').val();
        var IssueDesc_pop1 = '\"';
        for (var i = 0; i < IssuectrlSel_pop1.length; i++) {
            if (i > 0) { IssueDesc_pop1 += ',\"'; }
            IssueDesc_pop1 += $('#IssueType option:selected')[i].label + '\"';
        }
        var Issarrr_pop1 = IssueDesc_pop1.split(',');
        console.log(Issarrr_pop1);

        var Account = $("#AccountNamesList").data("kendoDropDownList").text();
        var Account_val = $("#AccountNamesList").data("kendoDropDownList").value();
        var Contract = $("#Contract").data("kendoDropDownList").text();
        var Contract_val = $("#Contract").data("kendoDropDownList").value();
        console.log("Account name is : " + Account);
        console.log("Contract ID is : " + Contract);
        var stringTxtArea = " Account Name : " + Account + "; " + "Contract Id : " + Contract + "; " + "Track : " + Towarr_pop +
            "; " + "IssueType : " + Issarrr_pop;
        @*var stringJsonText = "{ClientID:" +  @clientId + ", AccountName :" + Account_val + ",ContractID:" + Contract_val + ",TowerString:\"" + Towarr_pop + "\",IssueTypeString:\"" + Issarrr_pop + "\"}";*@
        var stringJsonText = "{ClientName:" + "\"@clientName\"" + ",ClientID:" +  @clientId + ", AccountName :" + Account_val + ",ContractID:" + Contract_val + "\,TowerString:\[" + Towarr2 + "]\,IssueTypeString:\[" + Issarrr_pop1 + "]\}";

        console.log("stringJsonText kedbsolstatus " + stringJsonText);
        document.getElementById('edit_Description').innerHTML = stringTxtArea;
        document.getElementById('Reportnameindex').innerHTML = "KEDB Solution Status Report";
        document.getElementById('TelerikReportnameindex').innerHTML = "KEDBSolStatusReport";
        document.getElementById('stringJsonText').innerHTML = stringJsonText;
        $('#updateForsub').hide();
        var rptpopup = $("#RPTSubspopUp").data("kendoWindow");
        rptpopup.open();
    });

    $('.custom-multiselect-dropdown').multiselect({
        maxHeight: 200,
        numberDisplayed: 1,
        includeSelectAllOption: true,
        includeResetOption: true
    });
    $(".custom-multiselect-dropdown").multiselect('selectAll', true);
    $(".custom-multiselect-dropdown").multiselect('updateButtonText');




    function GetAccId() {

        var app = $("#AccountNamesList").data("kendoDropDownList");
        return {
            Accid: app.value()
        }
    }

    function onSelectAccount(e) {
        var app = $("#Contract").data("kendoDropDownList");
        app.dataSource.read();
    }

    $('#btnPreview').on("click", function (e) {

        RefreshReport();
    });

    function RefreshReport()    {



        var TowerctrlSel = $('#Tower').val();
        var TowerDesc="";
        for (var i = 0; i < TowerctrlSel.length; i++ )
        {
            if (i>0) {  TowerDesc +=",";  }
            TowerDesc += $('#Tower option:selected')[i].label;
        }
        var Towarr = TowerDesc.split(',');
        console.log(TowerDesc );
        console.log(Towarr);




        var IssuectrlSel = $('#IssueType').val();
        var IssueDesc = "";
        for (var i = 0; i < IssuectrlSel.length; i++) {
            if (i > 0) { IssueDesc += ","; }
            IssueDesc += $('#IssueType option:selected')[i].label;
        }
        var Issarrr = IssueDesc.split(',');
        console.log(IssueDesc);
        console.log(Issarrr);
        //SaveReportParameters( TowerctrlSel, IssuectrlSel);

        var viewer = $("#reportViewerKEDBSolStatus").data("telerik_ReportViewer");

	    if(viewer !== undefined)
        {
            viewer.reportSource({
                report: viewer.reportSource().report,
                parameters: {
                    ClientID: @Model.ClientId,
                    TowerString: TowerDesc,
                    IssueTypeString: IssueDesc,
                    ClientName: '@Model.ClientName',
                    DateTimeNow: '@Model.CreatedDt'

                }        });
        }
        //setting the HTML5 Viewer's reportSource, causes a refresh automatically
        //if you need to force a refresh for other case, use:
        viewer.refreshReport();

    }

    function SaveReportParameters( Towarr, Issarr) {

        //Ajax call begin

        var model = {
            TowerDropDown: Towarr,
            IssueDropDown: Issarr,
        };
        var data = JSON.stringify(model);

        $.ajax(
            {
                type: 'post',

                url: 'SaveReportDetails',
                data: data,
                async: true,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    //                    alert('Success');
                    console.log("SaveReportDetails Success");

                },
                error: function (err, data) {
                    console.log(arguments);
                    //                    alert('Ajax Error');
                }

            });
        //Ajax end

    }


    var color = "";

    function InteractiveEnter(e, args) {
        if (args.action.Type === 'customAction') {
            color = $(args.element).css("background-color");
            $(args.element).css({ 'font-weight': 'bolder', 'background-color': '#d1d1d1' });
        }
    }

    function interactiveActionKEDB(e, args) {
        if (args.action.Type === 'customAction') {

            console.log("argument" + args);
            var ParamStatus = "";
            var ParamTower = "";
            var ParamIssueType = "";

            var count = 0;


            if (args.action.Value.Parameters[0] != undefined) {
                ParamStatus = args.action.Value.Parameters[0].Value;
                console.log("ParamStatus is " + ParamStatus);
                count++;
            }
            if (args.action.Value.Parameters[1] != undefined) {
                ParamTower = args.action.Value.Parameters[1].Value;
                console.log("ParamTower is " + ParamTower);
                count++;
            }
            if (args.action.Value.Parameters[2] != undefined) {
                ParamIssueType = args.action.Value.Parameters[2].Value;
                console.log("ParamIssueType is " + ParamIssueType);
                count++;

            }



            switch (count) {

                case 3:
                    document.getElementById("statusH").value = ParamStatus;
                    document.getElementById("TowerH").value = ParamTower;
                    document.getElementById("issueTypeH").value = ParamIssueType;
                    document.getElementById('displayLabel').innerHTML = "KEDB Solution Status - " + ParamTower + ", " + ParamStatus + ", " + ParamIssueType + " ";
                    console.log("In Case 3");
                    break;

            }



            var grid = $("#kedbGridDrill").data("kendoGrid");
            grid.dataSource.read();
            $('#KEDBSolPopUp').modal('show');
        }
    }



    function InteractiveLeave(e, args) {
        if (args.action.Type === 'customAction') {
            //$(args.element).css({ 'font-weight': 'normal', 'background-color': '#EEF4FB' });
            $(args.element).css({ 'font-weight': 'normal', 'background-color': color });

        }
    }



    function GetdrilldownTrendParameters(e) {

        console.log("In getDrilldownParamters");


        return {

            Status_action: document.getElementById("statusH").value,
            IssueType_action: document.getElementById("issueTypeH").value,
            Tower_action: document.getElementById("TowerH").value

        };
    }


    function getDescriptionToolTip1(e) {
        var dataItem = $("#kedbGridDrill").data("kendoGrid").dataItem(e.target.closest("tr"));
        var content = dataItem.Description;
        return content;
    }


     $('#btnRptSub').click(function () {
        //alert("success");
         var reportSubUrl = '@Url.Content("~/ClientProfileManager/ReportSubscription/RptSubscriptionList")?reportname=KEDB Solution Status Report';

        window.location.href = reportSubUrl;
    });

    $('#btnRptSch').click(function () {

        //alert("success");
        var reportSubUrl1 = '@Url.Content("~/ClientProfileManager/ReportSubscription/RPTJobDetailList")?reportname1=KEDB Solution Status Report';

        window.location.href = reportSubUrl1;
    });


</script>