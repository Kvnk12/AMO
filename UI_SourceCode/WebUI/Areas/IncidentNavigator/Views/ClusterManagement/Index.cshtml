<script type="text/javascript">

    function ConfigItemChange() {

        updateBody();

    }

    function TicketTypeChange() {

       updateBody();
    }
   
    function updateBody() {
        var Clusterdropdown = $("#ClusterSource").data("kendoComboBox");
        var clustername = $("#ClusterSource").val;
            Clusterdropdown.dataSource.read();
       

        var ClusterDestination = $("#ClusterDestination").data("kendoComboBox");   
        var clusterdest = $("#ClusterDestination").val;
            ClusterDestination.dataSource.read();

        var grid = $("#Grid").data("kendoGrid");
        grid.dataSource.read();

        Clusterdropdown.value(clustername);
        ClusterDestination.value(clusterdest);
    }
