    .Pageable(pageable => pageable
       .Input(true)
       .Numeric(false)
     )
    .Sortable()
    .Pageable()
    .PersistSelection()
      .ToolBar(tools => tools.Excel().HtmlAttributes(new { style = "float:right;", @class = "btn-primary" }))
 .Excel(excel => excel
        .FileName("IncidentsCluster.xlsx")
        .Filterable(true)
        .AllPages(true)
        .ProxyURL(Url.Action("Excel_Export_Save", "AjaxService"))
    )
     .Events(e => e

            .Change("gridselection_change")
        )
.Scrollable(scr => scr.Height(430))
.AutoBind(false)
.DataSource(dataSource => dataSource
    .Ajax()
    .PageSize(20)
      .Model(model => model.Id(p => p.PrimaryKeyIncidentId))
      .Read(read => read.Action("GetIncidentClustersList", "AjaxService").Data("ParameterData"))
 )
