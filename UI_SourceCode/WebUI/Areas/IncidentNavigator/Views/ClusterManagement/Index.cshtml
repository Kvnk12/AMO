        function LoadCluster() {
            var ticketType = $("#TicketType").data("kendoMultiSelect");

            return {

                ConfigItemName: $("#ConfigItem").val(),
                TicketType: encodeURIComponent(JSON.stringify(ticketType.value())),

            };
        }


        //function filterProducts() {
          
        //    return {
        //        ClientID: $("#fabric").val()
                   
        //        };
        //}

        //function filterTypes(e) {

        //    return {
        //        ClientID: $("#fabric").val(),
        //    ConfigItem: $("#ConfigItem").val()
        //    };
        //}

        function ClusterSource_change() {
            var grid = $("#Grid").data("kendoGrid");
          
            if ($("#Grid .k-state-selected").length > 0) {
                grid.clearSelection();
            }
            grid.dataSource.read();

        }

        function ParameterData(e) {
            var ticketType = $("#TicketType").data("kendoMultiSelect");
            return {
                ClientId: $("#fabric").val(),
                ConfigItemName: $("#ConfigItem").val(),
                TicketType: encodeURIComponent(JSON.stringify(ticketType.value())),
                ClusterId: $("#ClusterSource").val()
            }
        }
        //function ConfigItemDestination_change() {
        //    var ClusterDestination = $("#ClusterDestination").data("kendoComboBox");
        //    ClusterDestination.dataSource.read();
           
        //}

        function LoadDestinationCluster() {
            var ticketType = $("#TicketType").data("kendoMultiSelect");

            return {

                ConfigItemName: $("#ConfigItem").val(),
                TicketType: encodeURIComponent(JSON.stringify(ticketType.value())),

            };
        }

        function onClick(e) {
            var DestinationCluster = $("#ClusterDestination").val();
            var myArray = Array();
            var grid = $('#Grid').data('kendoGrid');
            var rows = grid.select();
            var RootUrl = '@Url.Content("~/IncidentNavigator/ClusterManagement/INIncidentClusteredUpdate")';
            rows.each(
                function () {
                    var dataItem = grid.dataItem($(this));
                    id = dataItem.PrimaryKeyIncidentId;
                    //IncidentID = dataItem.Incidentid;
                    //alert('Selected : ' + IncidentID);
                    myArray.push({ id: id, value: DestinationCluster});
                }
            )
            //alert(myArray[0].id + " ," + myArray[0].value);
            var data1 = { 'listObject': myArray };
            var data = JSON.stringify(data1)
            $.ajax({
                type: 'post',
                url: RootUrl,
                data: data,
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                    var grid = $("#Grid").data("kendoGrid");

                    if ($("#Grid .k-state-selected").length > 0) {
                        grid.clearSelection();
                    }
                    grid.dataSource.read();
                    alert("Ticket(s) moved successfully");
                },
                error: function (response) {
                   // alert("error occured");
                }
            });
        }
</script>

