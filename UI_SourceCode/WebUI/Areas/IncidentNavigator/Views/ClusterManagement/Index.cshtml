            <div class="custom-kendo-grid">
                @(Html.Kendo().Grid<IncidentsClusterlistModel>()
        @*@(Html.Kendo().Grid(Model.ClusterReportlist)*@
    .Name("Grid")

    .Columns(columns =>
    {
        columns.Select().Width(50);
        columns.Bound(p => p.Incidentid).Title("Incident ID");
        columns.Bound(p => p.ClosureCategory).Title("Cause");
        columns.Bound(p => p.Severity).Title("Severity");
        columns.Bound(p => p.DescriptionfromIncident).Title("Description");
        columns.Bound(p => p.AffectedItemName).Title("Affected Item Name");
    })
