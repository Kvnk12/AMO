    .Name("Grid")

    .Columns(columns =>
    {
        columns.Bound(p => p.Configitemname).Title("Config Name").Filterable(ftb => ftb.Multi(true));
        columns.Bound(p => p.TotalIncidents).Title("Total Tickets").Width(150);
        columns.Bound(p => p.Type).Title("Type").Filterable(ftb => ftb.Multi(true)).Width(150);
        columns.Bound(p => p.ClusterLabel).Title("Cluster Name");
        columns.Bound(p => p.AvgResolutionTime).Title("Avg.Resolution Time in hours").Width(230).HtmlAttributes(new { style = "text-align:right;" });
        columns.Bound(p => p.AvgCostPerTicket).Title("Avg. Cost of Resolving Tickets").Width(230).HtmlAttributes(new { style = "text-align:right;" });
    })
    .HtmlAttributes(new { style = "height: 450px;width:100%" })
    .Pageable(pageable => pageable
       .Input(true)
       .Numeric(false)
     )
    .Sortable()
    .Pageable()
     .Groupable()
.Scrollable(scr => scr.Height(430))
.Resizable(resize => resize.Columns(true))
.Filterable()
.AutoBind(true)
.ToolBar(tools => tools.Excel().HtmlAttributes(new { style = "float:right;" ,@class= "btn-primary" }))
 .Excel(excel => excel
        .FileName("ClusterReport.xlsx")
        .Filterable(true)
        .AllPages(true)
        .ProxyURL(Url.Action("Excel_Export_Save", "AjaxService"))
    )

.DataSource(dataSource => dataSource
    .Ajax()
    .PageSize(20)
