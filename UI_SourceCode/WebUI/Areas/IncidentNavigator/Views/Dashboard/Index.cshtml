<script type="text/javascript">
    function displayLoading(target) {
        var element = $(target);
        kendo.ui.progress(element, true);
        setTimeout(function () {
            kendo.ui.progress(element, false);
        }, 1000);
    }
    function ConfigItemChange() {

        updateDashboard();

    }
    function TicketTypeOnOpen()
    {
        var TicketType = $("#TicketType").data("kendoMultiSelect");
        TicketType.dataSource.read();
        TicketType.enable(true);
    }
    function updateDashboard() {
        Contarr = $("#Contract").data("kendoDropDownList").value();
        var TypectrlSel = $('#Type').val();
