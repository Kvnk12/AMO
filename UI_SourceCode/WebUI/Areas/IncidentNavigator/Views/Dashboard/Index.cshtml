            //var gridchart6 = $("#Chart6Grid").data("kendoGrid");
            //gridchart6.dataSource.read();
        }
        else {
            var chartTrend = $("#YearlyDistribution").data("kendoChart");
            chartTrend.dataSource.read();
            var chartStatus = $("#MonthlyDistribution").data("kendoChart");
            chartStatus.dataSource.read();
            var chartpriority = $("#DailyDistribution").data("kendoChart");
            chartpriority.dataSource.read();
            var chart4 = $("#HourlyDistributionChart").data("kendoChart");
            chart4.dataSource.read();
            var chart5 = $("#PriorityDistributionbyDayChart").data("kendoChart");
