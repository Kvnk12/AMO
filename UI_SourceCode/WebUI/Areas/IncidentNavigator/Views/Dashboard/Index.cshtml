            if (i > 0) { TypeDesc += "#"; }
            TypeDesc += $('#Type option:selected')[i].label;
        }
        typarr = TypeDesc;//.split(',');
        console.log(TypeDesc);
        var StatusctrlSel = $('#Status').val();
        var StatusDesc = "";
        for (var i = 0; i < StatusctrlSel.length; i++) {
