            chartStatus.dataSource.read();
            var chartpriority = $("#ChartPriority").data("kendoChart");
            chartpriority.dataSource.read();
            var chart4 = $("#Chart4").data("kendoChart");
            chart4.dataSource.read();
            var chart5 = $("#Chart5").data("kendoChart");
            chart5.dataSource.read();
            var chart6 = $("#pieChart6").data("kendoChart");
            chart6.dataSource.read();

            //var gridStatus = $("#StatusGrid").data("kendoGrid");
