@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.IncidentNavigator.Controllers;
@using WebUI.Areas.IncidentNavigator.Dto;
@using WebUI.Areas.IncidentNavigator.Models;
@using Kendo.Mvc.UI;
@using System.Data;
@using WebUI.Dto;
@model INNewDashboardModel
<div class="graph-3">
    <div class="top-content-heading">
        <h6>Distribution by Status</h6>
        <div class="top-content-right">            
            <p class="view-type graph-view" id="d1c3">Table/Graph</p>
            <span class="expand-view" title="Maximise the chart" onclick="maximiseChartStatus()"></span>
        </div>
    </div>
    <div class="chart-content" style="color: #000;padding: 0 18px;">
        <div class="rotate-icon">
            <span class="rotate-view" title="Rotate the Chart" onclick="RotateChart3()"></span>
        </div>
        <div class="chart-area">
            @(Html.Kendo().Chart<INChartDashboardModel>()
                                        .Name("StatusChart")
                                        .Legend(legend => legend.Position(ChartLegendPosition.Bottom).Visible(false)
                                )
                                        .ChartArea(chartArea => chartArea
                                        .Background("transparent")
                                        )
                                        .DataSource(ds => ds.Read(read => read.Action("GetDashboardTower", "Dashboard").Data("GetStatusParameter")))
                                            .SeriesColors(new string[] {  "#60B4F9" , "#1AE5E5", "#F9EF55", "#89EA97","#F2B1B1", "#D7DBDD", "#FFC639","#BA91CD", "#B997FF", "#FCA1C1",
                                                                       "#3BA3F8", "#18C6BD", "#EAD900","#4BD161", "#EF8B8B", "#BDC3C7","#FFA100","#9F66BC", "#9B67FF", "#FF64A3",
                                                                       "#1086E8", "#0FA896", "#DBB700", "#2FB447", "#D15D5D", "#909497", "#FF7F00","#8D48AB", "#7C33FF", "#FC3F9E",
                                                                      "#0E75C9", "#0A937F", "#B58602", "#258B39", "#AF3E3E", "#727D7E", "#E06300",  "#7B409B", "#6500FF", "#D60578",
                                                                      "#0B61AF", "#04755F", "#8E6902", "#15602E", "#842523", "#616A6B", "#BF4F02", "#6B3782", "#4D20BC", "#AA026E",
                                                                })

                                        .Series(series =>
                                        {
                                            series.Donut(model => model.IncidentCount, model => model.DrpCategory, null)
                                            .Labels(labels => labels
                                            .Template("#= category #: \n #= value#, #= kendo.format('{0:P}', percentage)#")
                                            .Background("transparent")
                                            .Visible(true)
                                            .Position(ChartPieLabelsPosition.OutsideEnd)
                                            )//SharpBevel
                                            .Overlay(ChartPieSeriesOverlay.None)
                                            .StartAngle(150);
                                        })

                                    .Tooltip(tooltip => tooltip
                                        .Visible(true)
                                        .Template("#= category #: \n #= value#,  #= kendo.format('{0:P}', percentage)#")
                                    )
                                     .Events(events => events
                                               .SeriesClick("onStatusSeriesClick"))
        )

        </div>      
    </div>
        <div class="table-content hide" style="color: #000;padding: 0 18px;">
            @(Html.Kendo().Grid<INChartDashboardModel>
                                        ()
                                        .Name("StatusGrid")
                                        .Columns(columns =>
                                        {

                                            columns.Bound(e => e.LongCategory).Title("Status").ClientFooterTemplate("Total");
                                            columns.Bound(e => e.IncidentCount).Title("Ticket Count").ClientFooterTemplate("#=sum#");
                                            columns.Bound(e => e.Percent).Title("in %").ClientFooterTemplate("100");
                                        })
                                        // .Scrollable()
                                        .AutoBind(false)
                                        .Sortable()
                                        .HtmlAttributes(new { style = "height:235px;" })
                                        .DataSource(dataSource => dataSource
                                        .Ajax()
                                         .Aggregates(agg =>
                                                {
                                                    agg.Add(p => p.IncidentCount).Sum();
                                                    agg.Add(p => p.Percent).Sum();
                                                })
                                        .Read(read => read.Action("GetINDashboardDataDynamicGrid", "Dashboard").Data("GetStatusParameter"))
                                        )
        )

        </div>
    </div>