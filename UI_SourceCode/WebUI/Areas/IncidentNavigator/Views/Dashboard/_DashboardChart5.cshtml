@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.IncidentNavigator.Controllers;
@using WebUI.Areas.IncidentNavigator.Dto;
@using WebUI.Areas.IncidentNavigator.Models;
@using Kendo.Mvc.UI;
@using System.Data;
@using WebUI.Dto;
@model INNewDashboardModel
<div>
    <div class="top-content-heading">
        <div class="top-content-head">
            <h6>Total Incidents by </h6>
            <div class="chart-type">

                @(Html.Kendo().DropDownListFor(m => m)
                                        .Name("DrpValChart5")
                                        .OptionLabel("")
                                        .DataTextField("Text")
                                        .DataValueField("Value")
                                        .Value("Configitemname")
                                        .Events(e => e
                                                .Change("Chart5DrpChange")
                                                )
                                           //.BindTo(Model.INMappedColumn)
                                           .BindTo(new List<SelectListItem>() {
                                                                                                        new SelectListItem() {
                                                                                                        Text = "Assigned Group",
                                                                                                        Value = "Assignedtosupportgroup"
                                                                                                        },
                                                                                                        new SelectListItem() {
                                                                                                        Text = "Config Item Name",
                                                                                                        Value = "Configitemname"
                                                                                                        },
                                                                                                        new SelectListItem() {
                                                                                                        Text = "Category",

                                                                                                        Value = "Servicecategory"
                                                                                                        },
                                                                                                        new SelectListItem() {
                                                                                                        Text = "Sub Category",
                                                                                                        Value = "Servicesubcategory"
                                                                                                        },
                                                                                                        new SelectListItem() {
                                                                                                        Text = "Data Source",
                                                                                                        Value = "Datasource"
                                                                                                        },
                                                                                                        new SelectListItem() {
                                                                                                        Text = "Ticket Type",
                                                                                                        Value = "Type"
                                                                                                        },
                                                                                                        new SelectListItem() {
                                                                                                        Text = "Resolved Group",
                                                                                                        Value = "Resolvedbygroup"
                                                                                                        },
                                                                                                        new SelectListItem() {
                                                                                                        Text = "Tower/Track",
                                                                                                        Value = "Tower"
                                                                                                        }
                                            })
                                            .AutoBind(true)
                )


            </div>
        </div>
        <div class="top-content-right">
            <p class="view-type graph-view" id="d1c5">Table/Graph</p>
            <span class="expand-view" title="Maximise the chart" onclick="maximiseChart5()"></span>
        </div>
    </div>
    <div class="chart-content">
        <div class="chart-area">
            @(Html.Kendo().Chart<INChartDashboardModel>
    ()
    .Name("Chart5")
    //.Title(title => title.Text("UnResolved Tickets with highest Hold Time").Font("bold 14px Arial,Helvetica,sans-serif").Color("Black"))
    .Legend(legend => legend
    .Visible(false)
    )

    .ChartArea(chartArea => chartArea
    .Background("transparent")
    .Height(280)
    )
    .DataSource(ds => ds.Read(read => read.Action("GetDashboardTower", "Dashboard").Data("ParameterDatanew5")))
    .Series(series =>
    {
        series.Column(model => model.Percent).Name("Percentage").Axis("%").CategoryField("DrpCategory").Spacing(-1).Labels(labels => labels.Background("transparent").Template("#= value# %").Visible(true).Position(ChartBarLabelsPosition.InsideBase)).Visible(true).Tooltip(tooltip => tooltip.Visible(true).Color("#000000").Background("#19BDFF").Template("#= series.name #: #= value # %")).Color("transparent");
        series.Column(model => model.IncidentCount).Name("Ticket Count").CategoryField("DrpCategory").Labels(labels => labels.Position(ChartBarLabelsPosition.OutsideEnd).Background("transparent").Visible(true)).Color("#19BDFF");

    })
    .CategoryAxis(axis => axis
    .Min(0)
    .Max(8)
    //.Categories(model =>model.)
    .MajorGridLines(lines => lines.Visible(false))
    .Labels(labels => labels.Rotation(-90))
    .AxisCrossingValue(0, 1000)
    .Title(title => title.Text("Config Item Name"))
    )

    .ValueAxis(axis => axis
    .Numeric()
    //.Max(10)
    .Line(line => line.Visible(true))
    //.Labels(labels => labels.Rotation(-90))
    //.MajorGridLines(lines => lines.Visible(true))
    .MajorGridLines(1, "#D7DBDD", ChartDashType.Dot).Visible(true)
    .Title(title => title.Text("Total Tickets"))
    // .Title(title => title.Text("drpval"))
    )
    .ValueAxis(axis => axis
            .Numeric("%")
             .Min(0).Max(100)
             .Labels(labels => labels.Format("{0}%").Visible(true))
            .Line(line => line.Visible(false))
              .MajorGridLines(lines => lines.Visible(false))
        )

    .Tooltip(tooltip => tooltip
    //.Background("transparent")
    .Visible(true)
    .Color("#000000")
    .Template("#= series.name #: #= value #")

    )
    .Pannable(pannable => pannable
    .Lock(ChartAxisLock.Y)
    )
    .Zoomable(zoomable => zoomable
    .Mousewheel(mousewheel => mousewheel.Lock(ChartAxisLock.Y))
    .Selection(selection => selection.Lock(ChartAxisLock.Y))
    )
        .Events(events => events
            .DataBound("onChangeTitle_onDataBound")
             .SeriesClick("onChart5SeriesClick")
        )
    )

        </div>      
    </div>
    <div class="table-content hide" style="color: #000;padding: 0 18px;">
        @(Html.Kendo().Grid<INChartDashboardModel>
    ()
    .Name("Chart5Grid")
    .Columns(columns =>
    {

    columns.Bound(e => e.LongCategory).Title("Category").ClientFooterTemplate("Total");
    columns.Bound(e => e.IncidentCount).Title("Ticket Count").ClientFooterTemplate("#=sum#");
    columns.Bound(e => e.Percent).Title("in %").ClientFooterTemplate("100");
    })
    // .Scrollable()
    .AutoBind(false)
    .Sortable()
    .HtmlAttributes(new { style = "height:235px;" })
    .DataSource(dataSource => dataSource
    .Ajax()
    .Aggregates(agg =>
    {
    agg.Add(p => p.IncidentCount).Sum();
    agg.Add(p => p.Percent).Sum();
    })
    // .PageSize(25)
    .Read(read => read.Action("GetINDashboardDataDynamicGrid", "Dashboard").Data("ParameterDatanew5")))
    .Events(events => events
    .DataBound("Chart5Grid_onDataBound")
    )
    )
        
</div>
</div>