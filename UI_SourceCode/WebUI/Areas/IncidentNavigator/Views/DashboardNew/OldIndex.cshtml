<script type="text/javascript">

    function displayLoading(target) {
        var element = $(target);
        kendo.ui.progress(element, true);
        setTimeout(function () {
            kendo.ui.progress(element, false);
        }, 1000);
    }


    function ConfigItemChange() {

        updateDashboard();

    }
    function TicketTypeOnOpen()
    {

        var TicketType = $("#TicketType").data("kendoMultiSelect");
        TicketType.dataSource.read();
        //TicketType.refresh();
        TicketType.enable(true);
    }

    function updateDashboard()
    {
        displayLoading("#container");
        var chartTrend = $("#chartTrend").data("kendoChart");


        chartTrend.dataSource.read();
        chartTrend.refresh();


        var chartWorkgroup = $("#chartWorkGroup").data("kendoChart");


        chartWorkgroup.dataSource.read();
        chartWorkgroup.refresh();

        var chartCluster = $("#chartCluster").data("kendoChart");


        chartCluster.dataSource.read();
        chartCluster.refresh();



        var chartAvgResolutionCost = $("#chartAvgResolutionCost").data("kendoChart");


        chartAvgResolutionCost.dataSource.read();
        chartAvgResolutionCost.refresh();


    }
    function TicketTypeChange() {

        updateDashboard();
    }





    function ParameterData(e) {
        var ticketType = $("#TicketType").data("kendoMultiSelect");

        return {

            ConfigItemName: $("#ConfigItem").val(),
            TicketType: encodeURIComponent(JSON.stringify(ticketType.value())),
            StartDate: $("#start").val(),
            EndDate: $("#end").val(),

            };
    }


    function DrilldownClusterData(e) {
        var ticketType = $("#TicketType").data("kendoMultiSelect");

        return {

            ConfigItemName: $("#ConfigItem").val(),
            TicketType: encodeURIComponent(JSON.stringify(ticketType.value())),
            StartDate: $("#start").val(),
            EndDate: $("#end").val(),
            clusterlabel: $('#clusterlabelhidden').val(),

        };
    }


    function DrilldownTicketTrendData(e) {
        var ticketType = $("#TicketType").data("kendoMultiSelect");
       // alert($('#TrendFlowhidden').val());
        return {

            ConfigItemName: $("#ConfigItem").val(),
            TicketType: encodeURIComponent(JSON.stringify(ticketType.value())),
            StartDate: $("#start").val(),
            EndDate: $("#end").val(),
            InflowOutflow: $('#TrendFlowhidden').val(),
            YearMonth: $('#yearMonthhidden').val(),


        };
    }

    function DrilldownTicketHoldData(e) {
       // alert($('#TicketIdhidden').val());

        return {


            IncidentId: $('#TicketIdhidden').val(),


        };
    }

