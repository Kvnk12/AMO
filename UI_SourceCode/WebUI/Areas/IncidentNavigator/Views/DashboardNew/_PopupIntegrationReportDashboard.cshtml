@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.IncidentNavigator.Controllers;
@using WebUI.Areas.IncidentNavigator.Dto;
@using WebUI.Areas.IncidentNavigator.Models;
@using Kendo.Mvc.UI;
@using System.Data;
@using WebUI.Dto;
@model Integration_ReportListModel


@(Html.Kendo().Window()
                .Name("chartCategoryWindow")
                .Title("Distribution by Category")
                .Content(@<text>
            @(Html.Kendo().Chart<Integration_ReportModel>
    ()
    .Name("PopupChartCategory")
    //.Title(title => title.Text("UnResolved Tickets with highest Hold Time").Font("bold 14px Arial,Helvetica,sans-serif").Color("Black"))
    .Legend(legend => legend
    .Visible(true)
    .Align(ChartLegendAlign.Start)
    .Position(ChartLegendPosition.Bottom)
    //.Offset(1, 1)
    )
    .ChartArea(chartArea => chartArea
    .Background("transparent")
    .Height(420)
    )
       .AutoBind(false)
    .DataSource(ds => ds.Read(read => read.Action("GetIntegrationReportDashboard", "Integration_Report").Data("GetIR")))
      //   .SeriesDefaults(seriesDefaults => seriesDefaults
      //.Column().Overlay(ChartBarGradient.None)
      //  )
      .SeriesDefaults(seriesDefaults => seriesDefaults
                                    .Bar().Visual("LabelVisualIntegrated")

                                )
    .Series(series =>
    {
        series.Bar(model => model.IncidentCount).Name("Category Count").Spacing(0).CategoryField("LongCategory").Labels(labels => labels.Background("transparent").Visible(true))
        .Tooltip(tooltip => tooltip.Visible(true).Color("#000000").Template("#= series.name #: #= value #")).Color("#75B5F9");
        series.Bar(model => model.Percent).Name("Percentage").Axis("%").CategoryField("LongCategory").Tooltip(tooltip => tooltip.Visible(true).Color("#000000").Template("#= series.name #: #= value # %")).Labels(labels => labels.Background("transparent").Template("#= value# %").Visible(true)/*.Position(ChartBarLabelsPosition.InsideEnd)*/).Color("LightGray");

        // series.Bar(model => model.IncidentCount).Opacity(0).Name("Category").Markers(markers => markers.Visible(true).Background("#FFA500")).Labels(labels => labels.Visible(false)).CategoryField("LongCategory").Axis("Cate").Labels(labels => labels.Format("{0:N0}").Padding(0, 0, -15, 45).Background("transparent").Visible(true));
        //series.Bar(model => model.Percent).Name("Tickets Count").Axis("%").Spacing(0).CategoryField("LongCategory").Labels(labels => labels.Template("#= value# %").Position(ChartBarLabelsPosition.OutsideEnd).Background("transparent").Visible(true)).Color("#19BDFF");
        //series.Line(model => model.IncidentCount).Name("Tickets Count").CategoryField("LongCategory").Labels(labels => labels.Background("transparent").Visible(true)).Color("#FFA500");

    })

    .CategoryAxis(axis => axis
    .Min(0)
    .Max(10)
    .Categories(model =>model.LongCategory)
    .Line(line => line.Visible(false))
  //  .AxisCrossingValue(0)
    .Labels(labels => labels.Visible(false)/*.Mirror(true)*/)
    .MajorGridLines(1, "#D7DBDD", ChartDashType.Dot).Visible(true)
    //.MajorGridLines(lines => lines.Visible(false))
    //.Title(title => title.Text("Priority").Font("12px Arial,Helvetica,sans-serif"))
    )
     .Pannable(p => p.Lock(ChartAxisLock.X))
             .Zoomable(zoomable => zoomable
            .Mousewheel(mousewheel => mousewheel.Lock(ChartAxisLock.X))
            .Selection(selection => selection.Lock(ChartAxisLock.X))
        )

    .ValueAxis(axis => axis
    .Numeric("Cate").Visible(true)
    //.Max(10)
   // .AxisCrossingValue(0)
    .Line(line => line.Visible(false))
    .Labels(labels => labels.Rotation("auto"))
    .MajorGridLines(lines => lines.Visible(false))
    //.Title(title => title.Text("Incident Count").Font("12px Arial,Helvetica,sans-serif"))

    )
    .ValueAxis(axis => axis
    .Numeric("%").Visible(true)
    .Min(0).Max(100)
    .Labels(labels => labels.Format("{0}%").Visible(false))
    .Line(line => line.Visible(false))
    .MajorGridLines(lines => lines.Visible(false))
    )
    .Tooltip(tooltip => tooltip
    //.Background("transparent")
    .Visible(true)
    .Color("#000000")
    // .Template("#= series.name #: #= value #  #= kendo.format('{0:P}', percentage)#")

    )
    .Events(events => events
    .DataBound("i_category_max_onDataBound")
    .SeriesClick("onIntegrationReportSeriesClick"))
    )

                </text>)
                                                .Visible(false)
                                                .Draggable()
                                                .Resizable()
                                                .Width(1000)
                                                .Height(500)
                                                .AutoFocus(false)
                                                .Modal(true)

                                                .Actions(actions => actions.Close())

)
