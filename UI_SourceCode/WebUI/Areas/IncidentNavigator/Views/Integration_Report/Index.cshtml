<script type="text/javascript">
    function onDataBound(e) {
            // Clear up the loading indicator for this chart
        kendo.ui.progress($('#ChartIssueClusterNew'), false);

        }

    function GetDynamicdrilldownParameter(e) {
        return {
            drpval: document.getElementById("InflowOutFlowType").value,
            TicketType: typarr,
            Status: Staarr,
            Track: Towarr,
            Priority: Priarr,
            Datetype: $("#Datefield").val(),
            StartDate: $("#start").val(),
            EndDate: $("#end").val(),
            Contract: Contarr,
            Category: document.getElementById("category").value
        };

    }
    function ConfigItemChange() {

        updateDashboard();

    }
    function updateDashboard() {
        //    kendo.ui.progress($('#ChartIssueClusterNew'), true);
        Contarr = '';
        if ($("#Contract").data("kendoMultiSelect") != undefined)
            Contarr = $("#Contract").data("kendoMultiSelect").value().toString();
        var TypectrlSel = $('#Type').val();
        console.log(TypectrlSel);
        var TypeDesc = "";
        for (var i = 0; i < TypectrlSel.length; i++) {
            if (i > 0) { TypeDesc += "#"; }
            TypeDesc += $('#Type option:selected')[i].label;
        }
        typarr = TypeDesc;
        console.log(TypeDesc);
