                                                        columns.Bound(p => p.ResolutionDescription).Title("ResolutionDescription").Width(225).HtmlAttributes(new { @style = "overflow: hidden;text-overflow: ellipsis;white-space: nowrap;" })
                                                        .ClientTemplate("<div class=\"forTooltips\">#=ResolutionDescription#</div>");
                                                        columns.Bound(p => p.Priority).Title("Priority").Width(100).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.Status).Title("Status").Width(100).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.AssignedToSupportGroup).Title("Assigned Group").Width(100).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.CreatedDateTime).Title("Created").Format("{0:MM/dd/yyyy  hh:mm tt}").Width(100);
                                                        columns.Bound(p => p.ResolutionDateTime).Title("Resolved").Format("{0:MM/dd/yyyy  hh:mm tt}").Width(100);
                                                        columns.Bound(p => p.ClosedDateTime).Title("Closed").Format("{0:MM/dd/yyyy  hh:mm tt}").Width(100);
                                                        columns.Bound(p => p.LastUpdatedDateTime).Title("Last Updated").Format("{0:MM/dd/yyyy  hh:mm tt}").Width(100);
                                                        columns.Bound(p => p.Resolutiontype).Title("Resolution type").Width(100).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.Track).Title("Tower/Track").Width(100).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.Category).Title("Category").Width(100).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.Lever).Title("Lever").Width(100).Filterable(ftb => ftb.Multi(true));
                                                        columns.Bound(p => p.Token).Title("Token").Width(100).Filterable(ftb => ftb.Multi(true));
                                                    })
                                                    .ToolBar(tools =>
                                                    {
                                                        tools.Excel().Text("Export - ");
                                                    })
                                                    .Scrollable(e => e.Endless(true))
                                                    .Filterable()
                                                    .Sortable()
                                                    .Pageable()
                                                    .AutoBind(false)
                                                    .Groupable()
                                                    .Excel(excel => excel.FileName("DescriptionCluster_DrillDown_Report.xlsx")
                                                    .Filterable(true)
                                                    .AllPages(true)
                                                    .ProxyURL(Url.Action("Export_Tickets_Save", "ConfigureReport"))
                                                    )
                                                    .Resizable(r => r.Columns(true))
                                                    .DataSource(dataSource => dataSource
                                                    .Ajax()
                                                    .Model(model =>
                                                    {
                                                        model.Id(p => p.Id);

                                                    })
                                                    .PageSize(100)
                                                    //.Batch(true)
                                                    .Read(read => read.Action("GetTicketsdrilldown", "Integration_Report").Data("GetdrilldownTrendParameter"))
                                                    )
        )
                    </div>
                </div>
            </div>
        </div>
    </div>
