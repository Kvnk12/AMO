    function LabelVisualIntegrated(e) {
        var defaultLbl = e.createVisual();
        var rectX = e.rect.origin.x;
        var rectY = e.rect.origin.y;
        if (e.series.name != "Percentage") {
            var newPosition = [rectX, rectY - 12];
            var additionalLabel = new kendo.drawing.Text(e.category, newPosition);

            defaultLbl.append(additionalLabel);
            return defaultLbl;
