    function onTagChange(e) {
        console.log(e);
        var a = $("#NewTags").val();
        //console.log(a);
        a = a.substring(0, a.length);
        //console.log(a);
        if (a.charAt(a.length - 2) == ',') {
            a = a.substring(0, a.length - 2);
        }
        //console.log(tagslist);
        if (!(tagslist.includes(a))) {
            var fkid = $("#dtl_fdbkId").text();
            temp = "<div class='tags' id='tagname_" + fkid + "_" + tagCnt +"'>" + a + "<span class='closeTag' onclick='removeTag(" + fkid + "," + tagCnt +")'></span></div>";
            var para = document.createElement("div");
            para.innerHTML = temp;
            var element = document.getElementById("tagsListDtl");
            element.appendChild(para);
            tagCnt++;


            var mod = {
                fdbkid: fkid,
                tagname:a
            }
            var data = JSON.stringify(mod);
            var baseurl = '@Url.Content("~/FDBKManager/ViewFeedback/SaveTags")';

            $.ajax({
                type: 'post',
                url: baseurl,
                data: data,
                contentType: 'application/json; charset=utf-8',
                success: function (tagid) {
                    console.log(tagid);
                    if (tagid != 0) {
                        temp1 = "<div class='unSelectedFilt' id='tags_" + tagid + "'><label><span class='icon'></span><input type='checkbox' name='tags' value='" + a + "' hidden onchange='TagSel(this," + tagid + ")' /><span>" + a + "</span></label></div>";
                        var paraq = document.createElement("div");
                        paraq.innerHTML = temp1;
                        var element = document.getElementById("tagFilterDiv");
                        element.appendChild(paraq);
                    }


                },
                error: function (err, data) {
                    //console.log(arguments);
                }
            });
            var tags = $("#tagList_" + fkid).text();
            tags = tags + "," + a;
            $("#tagList_" + fkid).text(tags);
        }
        e.preventDefault();
        $("#NewTags").data("kendoAutoComplete").value("");
        //console.log(tagCnt);
        $("#tagaddView").addClass("hide");
        if (tagCnt >= 5) {
            $(".addTags").css("display", "none");
        }
        else {
            $(".addTags").css("display", "unset");
        }
    }
    function removeTag(fdid,i) {
        //console.log(fdid + " " + i);
        var tagname = $("#tagname_" + fdid + "_" + i).text();
        //console.log(tagname);
        $("#tagname_" + fdid + "_" + i).text("");
        var tags = $("#tagList_" + fdid).text();
        tags = tags.replace(tagname,"");
        $("#tagList_" + fdid).text(tags);
        $("#tagname_" + fdid + "_" + i).css("display", "none");
        var mod = {
            fdbkid: fdid,
            tagname: tagname
        };
        var baseurl = '@Url.Content("~/FDBKManager/ViewFeedback/RemoveTags")';

        var data = JSON.stringify(mod);
        $.ajax({
            type: 'post',
            url: baseurl,
            data: data,
            contentType: 'application/json; charset=utf-8',
            success: function (temp) {
                //console.log("tag saved");
                tagCnt--;
                if (tagCnt >= 5) {
                    $(".addTags").css("display", "none");
                }
                else {
                    $(".addTags").css("display", "unset");
                }
            },
            error: function (err, data) {
                //console.log(arguments);
            }
        });
    }
    $(".addTags").click(function () {
        $("#tagaddView").removeClass("hide");
    })
    $("#tagaddView").focusout(function () {
        $("#tagaddView").addClass("hide");
    });
