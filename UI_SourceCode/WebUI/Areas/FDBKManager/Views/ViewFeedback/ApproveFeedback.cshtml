        $("#dtl_lastAct").text(lastAct);
        $("#dtl_crtDt").text(crtDt);
        $("#dtl_lastAct1").text(lastAct);
        $("#vote").text(vote);
        $("#dtl_status").text(status);
        $("#dtl_fdbkId").text(fdbkid);
        $("#dtl_fdbkId2").text(fdbkid);
        $("#dtl_fdbkId3").text(fdbkid);
        $("#dtl_desc").html(brief);

        var voteStatus = $("#voteStatus_" + fdbkid).text();
        if (voteStatus == "True") {
            // console.log("true");
            $(".voted").css("display", "unset");
            $(".vote").css("display", "none");
            $("#dtl_voted").text(vote);
            //  console.log(vote);
        }
        else {
            // console.log("false");
            $("#dtl_vote").text(vote);
            $(".voted").css("display", "none");
            $(".vote").css("display", "unset");
            //console.log(vote);
        }
        // console.log(voteStatus);
        //if()
    }
