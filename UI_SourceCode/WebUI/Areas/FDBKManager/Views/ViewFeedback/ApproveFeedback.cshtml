        if (typeid == "1") {
            $("#dtl_prod").text(proddigiid);
            $("#feature_view").css("display", "unset");
            $("#business_view").css("display", "none");
        } else if (typeid == "2") {
            $("#dtl_Digi").text(proddigiid);
            $("#feature_view").css("display", "none");
            $("#business_view").css("display", "unset");
        }
