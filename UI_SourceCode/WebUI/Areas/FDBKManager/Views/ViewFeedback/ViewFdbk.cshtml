@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.FDBKManager.Controllers;
@using WebUI.Areas.FDBKManager.Models;
@using Domain.Entities;
@using Kendo.Mvc.UI;
@using System.Data;
@using NTTData.AMOPortal.Data;

@model FeedbackViewModel

@{
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />

    <link rel="stylesheet" href="~/Content/css/bootstrap-multiselect.css" />

    <script src="~/Scripts/JScript/kendo.all.min.js"></script>
    <script src="~/Content/js/bootstrap-multiselect.js"></script>
    <script src="~/Scripts/JScript/jszip.min.js"></script>
    <script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>

    <link rel="stylesheet" href="~/Content/plugins/scrollbar/css/jquery.scrollbar.css" />
    <script src="~/Content/plugins/scrollbar/js/jquery.scrollbar.min.js"></script>
    <link href="~/Content/css/custom-styles.css" rel="stylesheet">

    ViewBag.Title = "Feedback Manager";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/feedback_manager_white.svg");
    Layout = "~/Views/Shared/GenericLayOutWithoutFooter.cshtml";
    ViewBag.NucleusLogo = Url.Content("~/Content/images/NucleusLogo.png");

    Db db = new Db();
    int uid= (int)Session["UserId"];
    var prdMgr = (from a in db.IMFDBKProductMgr
                  where a.UserId == uid
                  select a).Count();
    var viewtyp = ViewBag.viewtyp;
}
<style>
    body {
        overflow: hidden;
    }
</style>
<div class="fdbk-content-main">
    <div style="display:flex;justify-content:space-between">
        <div class="drp-srch-content">
            <div class="fdbk-type-dropdown">
                @(Html.Kendo().DropDownList()
                .Name("SelectedFeedbackType")
                .DataTextField("Text")
                .DataValueField("Value")
                .HtmlAttributes(new { style = "width: 100%" })
                .Events(e => e.Change("OnTypeSeltnChange"))
                .BindTo(new List<SelectListItem>
                    ()
                    {
                    new SelectListItem() {
                    Text = "Feedback Feature", Value ="1"
                    },
                    new SelectListItem() {
                    Text = "Business Opportunity", Value ="2"
                    }
                    })
                    )
            </div>
            <input type="text" id="searchKeywords" placeholder="Type Search Keyword here" class="searchTextBox" />
            <div class="search-icon" onclick="searchKeyword()"></div>
        </div>

        <div class="post-fdbk-btn">
            <button type="button" class="post-button" onclick="FdbkPostClick()">Post New Feedback</button>
        </div>
    </div>

    <div class="fdbk-view-content">
        <div class="left-content">
            <div class="filter-content  scrollbar-inner">
                <div class="allFdbk selectedOpt" onclick="togglefdbk('allFdbk')"> All Feedbacks</div>
                <div class="myFdbk" onclick="togglefdbk('myFdbk')"> My Feedbacks</div>
                <div class="filterDiv" id="productftr">
                    <div>Products</div>
                    @{
                        foreach (var item in Model.ProductFtr)
                        {
                        <div class="unSelectedFilt selectedFilt" id="prodGrp_@item.grpId">
                            <label>
                                <div class="icon"></div>
                                <input type="checkbox" name="productGrp" value="grp_@item.grpId" hidden checked="checked" onchange="prodGroupSel(this,@item.grpId)" />
                                <span>@item.ProductGroupName</span>
                            </label>
                            <span class="downArrow" id="expProd_@item.grpId" onclick="expProd(@item.grpId)"></span>
                        </div>
                        <div id="showProd_@item.grpId" style="display: none; margin-left: 1em;">
                            @foreach (var itemList in item.prdListitem)
                                {
                            <div class="unSelectedFilt selectedFilt" id="prod_@itemList.prdid">
                                <label>
                                    <div class="icon"></div>
                                    <input type="checkbox" name="product_@item.grpId" value="@itemList.prdid" hidden checked="checked" onchange="prodSel(this,@item.grpId)" />
                                    <span>@itemList.product</span>
                                </label>
                            </div>
                                }
                        </div>
                        }
                    }
                </div>
                <div class="filterDiv" id="digitalftr" style="display:none">
                    <div>Digital Offering</div>
                    @{
                        foreach (var item in Model.offeringList)
                        {
                        <div class="unSelectedFilt selectedFilt" id="digi_@item.Value">
                            <label>
                                <div class="icon"></div>
                                <input type="checkbox" name="digital" value="@item.Value" hidden checked="checked" onchange="digiSel(this)" />
                                <span>@item.Text</span>
                            </label>
                        </div>
                        }
                    }
                </div>
                <div class="filterDiv">
                    <div>Status</div>
                    @{
                        foreach (var item in Model.StatusList)
                        {
                        <div class="unSelectedFilt selectedFilt" id="status_@item.Value">
                            <label>
                                <div class="icon"></div>
                                <input type="checkbox" name="status" value="@item.Value" hidden checked="checked" onchange="statusSel(this)" />
                                <span>@item.Text</span>
                            </label>
                        </div>
                        }
                    }
                </div>
                <div class="filterDiv">
                    <div>Sort By</div>
                    <div class="unSelectedFilt selectedFilt" id="recentCreateSort">
                        <label>
                            <div class="icon"></div>
                            <input type="checkbox" name="sortBy" value="recentCreated" hidden checked="checked" onchange="sortSel(this)" />
                            <span>Most Recent Created</span>
                        </label>
                    </div>
                    <div class="unSelectedFilt" id="recentUpdateSort">
                        <label>
                            <div class="icon"></div>
                            <input type="checkbox" name="sortBy" value="recentUpdated" hidden onchange="sortSel(this)" />
                            <span>Most Recent Updated</span>
                        </label>
                    </div>
                    <div class="unSelectedFilt " id="votedSort">
                        <label>
                            <div class="icon"></div>
                            <input type="checkbox" name="sortBy" value="voted" hidden onchange="sortSel(this)" />
                            <span>Most Voted</span>
                        </label>
                    </div>
                    <div class="unSelectedFilt " id="commentedSort">
                        <label>
                            <div class="icon"></div>
                            <input type="checkbox" name="sortBy" value="commented" hidden onchange="sortSel(this)" />
                            <span>Most Commented</span>
                        </label>
                    </div>
                </div>
                <div class="filterDiv" id="Tagfilterlistdiv" style="display:none">
                    <div>Select Tags</div>
                    @{
                        foreach (var item in Model.TagsList)
                        {
                        <div class="unSelectedFilt" id="tags_@item.Value">
                            <label>
                                <div class="icon"></div>
                                <input type="checkbox" name="tags" value="@item.Text" hidden onchange="TagSel(this,@item.Value)" />
                                <span>@item.Text</span>
                            </label>
                        </div>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="right-content">
            <div class="fdbk-list-content scrollbar-inner">
                @Html.Partial("_ViewFdbkList")
            </div>
            <div class="fdbk-detail-content scrollbar-inner">
                @Html.Partial("_ViewFdbkDetail")
            </div>
        </div>
    </div>

    <div id="Postfdbk" class="modalfdbkpost">
        <span class="closefdbkpost" onclick="FdbkPostClose()">&times;</span>
        @Html.Partial("_PostFeedback")
    </div>
    <div id="saveAlertModal" class="modal fade" role="dialog" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-body">

                <div class="alert alert-danger" id="lblErr1" style="display:none">
                    <div style="display:flex">
                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                        <label style="width:18em">Error while Submitting.</label>
                    </div>
                </div>
                <div class="alert alert-success" id="lblSuccess1" style="display:none">
                    <div style="display:flex">
                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                        <label style="width:18em">Feedback Submitted Successfully.</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @*<div id="imageModal" class="modal" role="dialog" aria-hidden="true" style="background: rgb(0,0,0,0.75);">
            <div class="modal-dialog">
                <div class="modal-body">
                    <button type="button" class="close" data-bs-dismiss="modal" onclick="closeImgModal()" aria-label="Close" style="position: fixed; top: 10px; right: 30px; color: #f1f1f1; font-size: 40px; font-weight: bold; transition: 0.3s;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <div style="display: flex; justify-content: center; align-items: center;">
                        <img id="fdbkimgsrc" src="" style="width: 70em;" />
                    </div>
                </div>
            </div>
        </div>*@
</div>


<script>
