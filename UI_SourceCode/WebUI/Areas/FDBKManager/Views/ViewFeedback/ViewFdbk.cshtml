    function collapseleft(productid) {
        $('#' + productid).toggleClass('hide');
        $('#main_' + productid).toggleClass('show-content');
    }
    function FdbkPostClick() {
        LogFdbkActivity("OpenFdbkPopup", "ToCreateFdbk")
        OnClearall();
        document.getElementById("Postfdbk").style.display = "block";
    }
    function FdbkPostClose() {
        LogFdbkActivity("CloseLightBox", "NoFdbkPosted");
        OnClearall();
        document.getElementById("Postfdbk").style.display = "none";
        $('iframe').contents().find('body').css('color', 'gray');
        $('iframe').contents().find('body').css('font-size', '10px');
        $('iframe').contents().find('body').css('font-style', 'italic');
        $('iframe').contents().find('body').css('font-family', 'cursive');
    }
    var fdbkVal = "All";
    var inputstring = "";
    var sortByVal = "recentCreated";
    var prdGrpid = "";
    var tagCnt = 0;
    var tagslist = [];

    function togglefdbk(sel){
        if (sel == 'allFdbk') {
            $(".allFdbk").addClass("selectedOpt");
            $(".myFdbk").removeClass("selectedOpt");
            fdbkVal = "All";
            //$("#status_1").css("display", "none");
        }
        else if (sel == 'myFdbk') {
            $(".allFdbk").removeClass("selectedOpt");
            $(".myFdbk").addClass("selectedOpt");
            fdbkVal = "user";
            //$("#status_1").css("display", "flex");
        }
        filterChanged();
    }
    function prodGroupSel(e, grpid) {
        if (e.checked) {
            LogFdbkActivityById("FilterByProduct", "ProductGroup", grpid, "selected");
            $("input[name='product_" + grpid + "']").each(function () {
                $(this).prop("checked", true);
                $("#prod_" + $(this).val()).addClass("selectedFilt");

            });
            $("#prodGrp_" + grpid).addClass("selectedFilt");
            $("#grp_" + grpid).prop("checked", true);
        }
        else {
            LogFdbkActivityById("FilterByProduct", "ProductGroup", grpid, "unselected");
            $("input[name='product_" + grpid + "']").each(function () {
                $(this).prop("checked", false);
                $("#prod_" + $(this).val()).removeClass("selectedFilt");

                console.log($(this).val());
            });
            $("#prodGrp_" + grpid).removeClass("selectedFilt");
            $("#grp_" + grpid).prop("checked", false);
        }
        filterChanged();
    }
    function prodSel(e,grpid) {
        if (e.checked) {
            LogFdbkActivityById("FilterByProduct", "Product",e.value, "selected");
            console.log(e.value + " is selected");
            $("#prod_" + e.value).addClass("selectedFilt");
        }
        else {
            LogFdbkActivityById("FilterByProduct","Product", e.value, "unselected");
            console.log(e.value + " is unselected");
            $("#prod_" + e.value).removeClass("selectedFilt");
        }
        var checkCount = $("input[name='product_" + grpid + "']:checked").length;
        var prodCount = $("input[name='product_" + grpid + "']").length;
        if (checkCount != prodCount) {
            $("#prodGrp_" + grpid).removeClass("selectedFilt");
            $("#grp_" + grpid).prop("checked", false);
        }
        else {
            $("#prodGrp_" + grpid).addClass("selectedFilt");
            $("#grp_" + grpid).prop("checked", true);
        }

        filterChanged();
    }
    function digiSel(e) {
        if (e.checked) {
            LogFdbkActivityById("FilterByDigitalOffering","digital" ,e.value, "selected");
            console.log(e.value + " is selected");
            $("#digi_" + e.value).addClass("selectedFilt");
        }
        else {
            LogFdbkActivityById("FilterByDigitalOffering", "digital",e.value, "unselected");
            console.log(e.value + " is unselected");
            $("#digi_" + e.value).removeClass("selectedFilt");
        }
        filterChanged();
    }
    function statusSel(e) {
        console.log(e)
        if (e.checked) {
            LogFdbkActivityById("FilterByStatus","Status" ,e.value, "selected");
            console.log(e.value + " is selected");
            $("#status_" + e.value).addClass("selectedFilt");
        }
        else {
            LogFdbkActivityById("FilterByStatus", "Status" ,e.value, "unselected");
            console.log(e.value + " is unselected");
            $("#status_" + e.value).removeClass("selectedFilt");
        }
        filterChanged();
    }
    function TagSel(e, tagid) {
        console.log(tagid);
        LogFdbkActivity("FilterByTag", "FilterByTag-'" + e.value + "'");
        if (e.checked) {
            console.log(e.value + " is selected");
            $("#tags_" + tagid).addClass("selectedFilt");
        }
        else {
            console.log(e.value + " is unselected");
            $("#tags_" + tagid).removeClass("selectedFilt");
        }
        filterChanged();
    }
    function sortSel(e) {
        LogFdbkActivity("SortBy", "SortBy-'" + e.value +"'");
        if (e.checked) {
            console.log(e.value + " is selected");
            sortByVal = e.value;
            console.log(sortByVal);
            if (e.value == "recentCreated") {
                $('#recentCreateSort').addClass("selectedFilt");
                $('#recentUpdateSort').removeClass("selectedFilt");
                $('#votedSort').removeClass("selectedFilt");
                $('#commentedSort').removeClass("selectedFilt");
                $('input[value="recentCreated"]').prop('checked', true);
                $('input[value="recentUpdated"]').prop('checked', false);
                $('input[value="voted"]').prop('checked', false);
                $('input[value="commented"]').prop('checked', false);
            }
            else if (e.value == "recentUpdated") {
                $('#recentCreateSort').removeClass("selectedFilt");
                $('#recentUpdateSort').addClass("selectedFilt");
                $('#votedSort').removeClass("selectedFilt");
                $('#commentedSort').removeClass("selectedFilt");
                $('input[value="recentCreated"]').prop('checked', false);
                $('input[value="recentUpdated"]').prop('checked', true);
                $('input[value="voted"]').prop('checked', false);
                $('input[value="commented"]').prop('checked', false);
            }
            else if (e.value == "voted") {
                $('#recentCreateSort').removeClass("selectedFilt");
                $('#recentUpdateSort').removeClass("selectedFilt");
                $('#votedSort').addClass("selectedFilt");
                $('#commentedSort').removeClass("selectedFilt");
                $('input[value="recentCreated"]').prop('checked', false);
                $('input[value="recentUpdated"]').prop('checked', false);
                $('input[value="voted"]').prop('checked', true);
                $('input[value="commented"]').prop('checked', false);
            }
            else if (e.value == "commented") {
                $('#recentCreateSort').removeClass("selectedFilt");
                $('#recentUpdateSort').removeClass("selectedFilt");
                $('#votedSort').removeClass("selectedFilt");
                $('#commentedSort').addClass("selectedFilt");
                $('input[value="recentCreated"]').prop('checked', false);
                $('input[value="recentUpdated"]').prop('checked', false);
                $('input[value="voted"]').prop('checked', false);
                $('input[value="commented"]').prop('checked', true);
            }
        }
        else {
            sortByVal = "";
            $('#recentCreateSort').removeClass("selectedFilt");
            $('#recentUpdateSort').removeClass("selectedFilt");
            $('#votedSort').removeClass("selectedFilt");
            $('#commentedSort').removeClass("selectedFilt");
        }
        filterChanged();
    }
    function filterChanged() {
        $('#filterList').empty();
        var stDesc = "";
        var stList = [];
        var tagDesc = "";
        var tagList = [];
        var GrpList = [];
        var prdList = [];
        var prdDesc = "";
        var dgDesc = "";
        var digiList = [];
        var typeid = $("#SelectedFeedbackType").val();
        if (typeid == "1") {
            $("input:checkbox[name=productGrp]").each(function () {
                var str1 = $(this).val();
                GrpList.push(str1.slice(4))
            });
            for (var j = 0; j < GrpList.length; j++) {
                $("input:checkbox[name=product_" + GrpList[j] + "]:checked").each(function () {
                    prdList.push($(this).val());
                })
            }
            for (var k = 0; k < prdList.length; k++) {
                prdDesc += prdList[k] + "#";
            }
            prdDesc = prdDesc.substring(0, prdDesc.length - 1);
        }
        else {
            $("input:checkbox[name=digital]:checked").each(function () {
                digiList.push($(this).val())
            });
            for (var i = 0; i < digiList.length; i++) {
                dgDesc += digiList[i] + "#";
            }
            dgDesc=dgDesc.substring(0, dgDesc.length - 1);
            //console.log(dgDesc);
        }
        $("input:checkbox[name=status]:checked").each(function () {
            stList.push($(this).val())
        });
        for (var i = 0; i < stList.length; i++) {
            stDesc += stList[i] + "#";
        }
        stDesc=stDesc.substring(0, stDesc.length - 1);
        //console.log(stDesc);
        $("input:checkbox[name=tags]:checked").each(function () {
            tagList.push($(this).val())
        });
        for (var i = 0; i < tagList.length; i++) {
            tagDesc += tagList[i] + "#";
        }
        tagDesc = tagDesc.substring(0, tagDesc.length - 1);

        var typeid = $("#SelectedFeedbackType").val();

        var model = {
            statusSel: stDesc,
            productSel: prdDesc,
            digitalSel: dgDesc,
            tagsSel: tagDesc,
            typeid: typeid,
            sortByVal: sortByVal,
            selMode: fdbkVal,
            inputstring: inputstring
        };
        var baseurl = "";
        if (@viewtyp != 0) {
            baseurl = 'GetFilteredFeedback';
        }
        else {
            baseurl = 'ViewFeedback/GetFilteredFeedback';
        }
       // console.log(model);
        var data = JSON.stringify(model);

        $.ajax(
            {
                type: 'post',

                url: baseurl,
                data: data,
                async: true,
                contentType: 'application/json; charset=utf-8',
                success: function (temp) {
                    //console.log(temp);
                    $('#ListFdbkViews').html(temp);
                    $("#detail_view").css("display", "none");
                    $(".fdbk-content-main .fdbk-view-content .fdbk-list-content .product_divs").css("margin-right", "4px");

                },
                error: function (err, data) {
                    console.log(arguments);
                }

            });
    }

    function OnTypeSeltnChange(e) {
        var index = this.dataItem(e.item);
        LogFdbkActivity("ChangeIdeaType", "Type Choosen-'" + index.Text+"'");
        console.log(index);
        switch (index.Value) {
            case "1": $("#productftr").css('display', 'block');
                $("#digitalftr").css('display', 'none');
                break;
            case "2": $("#productftr").css('display', 'none');
                $("#digitalftr").css('display', 'block');
                break;
        }
        filterChanged();
    }
