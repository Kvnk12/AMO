    $(".vote").click(function () {
        $(".voted").css("display", "unset");
        $(".vote").css("display", "none");
        //$(this).toggleClass("voted");
        var fid = $("#dtl_fdbkId").text();
        var voteid = "vote-" + $("#dtl_fdbkId").text();
        LogFdbkActivity("VoteFeedback", "Voted the Feedback");
        var baseurl = "";
        if (@viewtyp != 0) {
            baseurl = 'SaveVoteofUser';
        }
        else {
            baseurl = 'ViewFeedback/SaveVoteofUser';
        }
        var model = {
            voteid: voteid
        };
        var data = JSON.stringify(model);
        $.ajax({
            url: baseurl,
            type: 'GET',
            data: {
                voteid: voteid
            },
            success: function (temp) {
                console.log("save successfully");
                var vcount = $("#vote").text();
                const vsum = parseInt(vcount) + parseInt(1);
                $("#vote_" + fid).text(vsum);
                $("#vote").text(vsum);
                $("#voteStatus_" + fid).text("True");
                console.log(vsum, vcount);
                $("#dtl_voted").text(vsum);
            },
            error: function (err, data) {
                console.log(arguments);
            }
        });
    });
    $(".voted").click(function () {
        $(".voted").css("display", "none");
        $(".vote").css("display", "unset");
        //$(this).toggleClass("voted");
        var voteid = "vote-" + $("#dtl_fdbkId").text();
        var fid = $("#dtl_fdbkId").text();
        LogFdbkActivity("UnVoteFeedback", "UnVoted the Feedback");
        var baseurl = "";
        if (@viewtyp != 0) {
            baseurl = 'SaveVoteofUser';
        }
        else {
            baseurl = 'ViewFeedback/SaveVoteofUser';
        }
        var model = {
            voteid: voteid
        };
        var data = JSON.stringify(model);
        $.ajax({
            url: baseurl,
            type: 'GET',
            data: {
                voteid: voteid
            },
            success: function (temp) {
                console.log("save successfully");
                var vcount = $("#vote").text();
                const vsum = parseInt(vcount) - parseInt(1);
                $("#vote_" + fid).text(vsum);
                $("#vote").text(vsum);
                $("#voteStatus_" + fid).text("False");
                console.log(vsum, vcount);
                $("#dtl_vote").text(vsum);
            },
            error: function (err, data) {
                console.log(arguments);
            }
        });
    });
