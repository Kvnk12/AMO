        //console.log(@viewtyp);
        if (@prdMgr> 0) {
            $("#Tagfilterlistdiv").css("display", "block");
        }
        //$("#status_1").css("display", "none");
        $(".modalfdbkpost .post-feedback .post-fdbk-cont .post-content .fdbk-inputfield .fdbk-drp.digitalDrp span.k-input-value-text").css({
            'color': 'rgb(128, 128, 128)',
            'font-size': '10px',
            'font-style': 'italic'
        });
        $('.scrollbar-inner').scrollbar();
        $('iframe').contents().find('body').css('color', 'gray');
        $('iframe').contents().find('body').css('font-size', '10px');
        $('iframe').contents().find('body').css('font-style', 'italic');
        $('iframe').contents().find('body').css('font-family', 'cursive');
        multisel = $("#internalclient").kendoMultiSelect({
            includeSelectAllOption: true,
            filter: "contains",
            placeholder: "N/A",
            //  headerTemplate: "<div><input type='checkbox' id='Header1' class='Header_selectall'><label> Select All</label></div>",
            autoClose: false,
            dataTextField: "Name",
            dataValueField: "Id",
            tagMode: "single",
            height: 150,
        }).data("kendoMultiSelect");

        if (@viewtyp != 0) {
            FdbkPostClose();
            selectFdbk(@viewtyp);
        }
        console.log(@prdMgr);
