                        <li>
                            Select First Assessment :
                            @(Html.Kendo().DropDownListFor(m => m[0].AssessmentID)
                              .DataTextField("Text")
                              .DataValueField("Value")
                              .BindTo(Model[0].AssessmentNameList)
                              .Name("AssessmentName")
                               .Events(e =>
                               {
                                   e.Change("onSelectAssessmentName");
                               })
                               )
                        </li>


                        <li>
                            Select Second Assessment :
                            @(Html.Kendo().DropDownListFor(m => m[0].AssessmentID)
                              .DataTextField("Text")
                              .DataValueField("Value")
                              .BindTo(Model[0].SecondAssessmentList)
                              .Name("AssessmentName2")
                               .Events(e =>
                               {
                                   e.Change("onSelectAssessmentName2");
                               })
                               )
                        </li>

                        <li>
                            Select Third Assessment :
                            @(Html.Kendo().DropDownListFor(m => m[0].AssessmentID)
                              .DataTextField("Text")
                              .DataValueField("Value")
                              .BindTo(Model[0].ThirdAssessmentList)
                              .Name("AssessmentName3")
                              .Events(e =>
                              {
                                  e.Change("onSelectAssessmentName3");
                              })
                              )
                        </li>


                        <li>
                            Select Fourth Assessment :
                            @(Html.Kendo().DropDownListFor(m => m[0].AssessmentID)
                             .DataTextField("Text")
                             .DataValueField("Value")
                             .BindTo(Model[0].FourthAssessmentList)
                             .Name("AssessmentName4")
                             .Events(e =>
