<div class="content-main dark-bg heatMap">
    <ol class="breadcrumb">
        <li>Assessment Manager</li>
        <li class="active">HeatMap Comparative</li>
    </ol>
    @*<h4 id="hh" style=" color: white; font-size: 1.2em; font-family: HelveticaNeue; ">A3MM - HeatMap</h4>*@
    <div class="service-plan-content">

        <div class="heading-section">

            <div class="drpList" style="display: flex; margin-top: 3em; font-size: 1vw; margin-left:5em;">
                <div class=" AssessmentName" style="margin-top: -2em;">
                    <span class="custom-blue-label" style="margin-left:-5em; width: 13em; color: white;">First Assessment :</span>
                    <div class="custom-textbox Assessmentrp" style="margin-left:10em; margin-top: -1.5em;">
                        @(Html.Kendo().TextBox()
                                 .Name("AssessmentNametxtbox")
                                 .Value(Model[0].AssessmentNameList.FirstOrDefault().Text)
                                 .HtmlAttributes(new { style = "width: 19em;" })
                                 )
                    </div>
                </div>

                <div class=" AssessmentName" style="margin-top: -2em; margin-left: 1em">
                    <span class="custom-blue-label" style=" width: 13em; color: white;">Second Assessment :</span>
                    <div class="custom-textbox Assessmentrp" style=" margin-left: 14em; margin-top: -1.5em;">
                        @(Html.Kendo().TextBox()
                                 .Name("AssessmentName2txtbox")
                                 .Value(Model[0].SecondAssessmentList.FirstOrDefault().Text)
                                 .HtmlAttributes(new { style = "width: 19em;" })
                                 )
                    </div>
                </div>

            </div>


            <div class="drpList" id="secondRowLabels" style="display: none; margin-top: 3em; font-size: 1vw; margin-left:5em;">
                <div id="thirdAssessmentLabel" class=" AssessmentName" style="margin-top: -2em; display: none;">
                    <span class="custom-blue-label" style="margin-left:-5em; width: 13em; color: white;">Third Assessment :</span>
                    <div class="custom-textbox Assessmentrp" style="margin-left:10em; margin-top: -1.5em;">
                        @(Html.Kendo().TextBox()
                     .Name("AssessmentName3txtbox")
                     .Value(Model[0].AssessmentNameList.FirstOrDefault().Text)
                     .HtmlAttributes(new { style = "width: 19em;" })
                     )
                    </div>
                </div>

                <div id="fourthAssessmentLabel" class=" AssessmentName" style="margin-top: -2em; margin-left: 1em; display: none;">
                    <span class="custom-blue-label" style=" width: 13em; color: white;">Fourth Assessment :</span>
                    <div class="custom-textbox Assessmentrp" style=" margin-left: 14em; margin-top: -1.5em;">
                        @(Html.Kendo().TextBox()
                     .Name("AssessmentName4txtbox")
                     .Value(Model[0].SecondAssessmentList.FirstOrDefault().Text)
                     .HtmlAttributes(new { style = "width: 19em;" })
                     )
                    </div>
                </div>

            </div>


        </div>

        <div class="parameter-slider-overlay"></div>
        <div class="parameter-section">

            <div class="action-items" style="margin-top:-6.5vh">
