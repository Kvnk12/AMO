     function onSelectAssessmentName(e) {

         var AssessmentID = $("#AssessmentName").data("kendoDropDownList").text();
        // console.log("AssessmentID"+AssessmentID)
         var mod = {
             AssessmentName: AssessmentID
         }
     //    console.log("mod " + mod)
        var data1 = JSON.stringify(mod);
        baseurl = '@Url.Content("~/AssessmentManager/Assessment/getSecondAssessmentList")';
        $.ajax({

            type: 'post',
            url: baseurl,
            async: false,
            data: data1,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                //alert("Success");
              //  console.log(response);
                $('#AssessmentName2').data('kendoDropDownList').setDataSource(response);
                $("#AssessmentName2").data("kendoDropDownList").select(0);
                $('#AssessmentName2').data('kendoDropDownList').enable();


                $('#AssessmentName3').data('kendoDropDownList').setDataSource(response);
                $('#AssessmentName3').data('kendoDropDownList').select(0);
                $('#AssessmentName3').data('kendoDropDownList').enable(false);

                $('#AssessmentName4').data('kendoDropDownList').setDataSource(response);
                $('#AssessmentName4').data('kendoDropDownList').select(0);
                $('#AssessmentName4').data('kendoDropDownList').enable(false);

                //onSelectAssessmentName2();
                //onSelectAssessmentName3();

            },
            error: function (err, response) {
                // alert(err.responseText);
            }
        });
    }

