                    <button style="margin-top: -5px; margin-left: 1.5em;" type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>



<script>
    function Downloaduploadedfile(fid) {

        var mod = {
            fileId: fid
        };

        var data1 = JSON.stringify(mod);
        baseurl1 = '@Url.Content("~/AssessmentManager/Assessment/DownloaduploadedfileAction")';

        $.ajax(
            {
                url: baseurl1,
                type: 'post',
                data: data1,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                     x = fid;
                    window.location = '@Html.Raw(@Url.Action("DownloaduploadedfileAction", "Assessment"))' + '?fileId=' + x;
                },
                error: function (err, response) {
                }
            })
    }

    $(window).on("load", function () {
        var status = @Html.Raw(Json.Encode(Model.Status));
        var UserRole = @Html.Raw(Json.Encode(Model.UserRole));
        if (status == "Review") {
            //document.getElementById("btnPublish").disabled = false;
            document.getElementById("btnReview").disabled = true;
            if (UserRole == "Admin") {
                document.getElementById("btnPublish").disabled = true;
                document.getElementById("btnPublish").title = "Engagement team has to publish";
            } else if (UserRole == "User"){
                document.getElementById("btnEngagementPublish").disabled = false;
            }
        }
        if (status == "Analysis") {
            if (UserRole == "Admin") {
                document.getElementById("btnPublish").disabled = true;
                document.getElementById("btnReview").disabled = false;
            } else if (UserRole == "User"){
                document.getElementById("btnEngagementPublish").disabled = true;
            }
        }
        if (status == "Engagement Published") {
            if (UserRole == "Admin") {
                document.getElementById("btnPublish").disabled = false;
            } else if (UserRole == "User"){
                document.getElementById("btnEngagementPublish").disabled = true;
            }
            document.getElementById("btnReview").disabled = true;

        }


        if (status == "Published" || status == "Preparation" || status == "Initiated" || status == "Draft") {
            if (UserRole == "Admin") {
                document.getElementById("btnPublish").disabled = true;
                document.getElementById("btnReview").disabled = true;
            } else if (UserRole == "User"){
                document.getElementById("btnEngagementPublish").disabled = true;
            }
            console.log(status)

        }

      });


    function getAssessment() {
       // console.log("in getAssessment ");
        var SurveyTypeID = $("#AssessmentID").data("kendoDropDownList").value();
        var AssessmentID = $("#AssessmentName").data("kendoDropDownList").value();
      //  console.log("assessment id is : " + AssessmentID + ", " + SurveyTypeID);
        return {
            SurveyTypeID: SurveyTypeID,
            AssessmentID: AssessmentID
        };

    }



 function viewAssessmentOverview(AssessmentID, QuestionId) {
       // console.log(AssessmentID, QNo);

       baseurl1 = '@Url.Content("~/AssessmentManager/ResponseGathering/RedirectToDGView?AssessmentID=")';
       window.location.href = baseurl1 + AssessmentID + "&QuestionId=" + QuestionId;



    }

    function editAssessment(AssessmentID, QuestionId) {
        console.log(AssessmentID, QuestionId);
        var UserRole = @Html.Raw(Json.Encode(Model.UserRole));
        //var QNo1 = JSON.stringify(SQNo);
        //console.log("string QNo1", QuestionId);
