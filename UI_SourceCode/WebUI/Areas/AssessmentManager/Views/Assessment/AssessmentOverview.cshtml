    var addedOwner;
    function checkallvalidation() {
         var AssessmentID = $("#AssessmentName").data("kendoDropDownList").value();
        var mod = {
            AssessmentID: AssessmentID
        };

        var data1 = JSON.stringify(mod);
        baseurl1 = '@Url.Content("~/AssessmentManager/Assessment/Checkvalidation")';
        $.ajax(
            {
                url: baseurl1,
                type: 'post',
                data: data1,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    addedOwner = data;
                   // console.log(addedOwner)
                    if (data != false) {
                        $('#validationAlertModal').modal('show');
                        $('#lblErr2').show();
                        $('#validatelabel').text(data);

                    }
                }
            })

    }
    var allQRes;
