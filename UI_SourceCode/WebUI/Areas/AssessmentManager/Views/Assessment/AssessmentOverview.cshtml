    <div class="custom-kendo-treelist">
        @(Html.Kendo().TreeList<A3MMModel>()
                                            .Name("AssessmentOverviewTreeList")

                                            .Columns(columns =>
                                            {
                                                columns.Add().Field(p => p.QuestionResponseID).Hidden(true);
                                                columns.Add().Field(p => p.DisciplineId).Hidden(true);
                                                columns.Add().Field(p => p.AssessmentID).Hidden(true);
                                                columns.Add().Field(p => p.AspectID).Hidden(true);
                                                columns.Add().Field(p => p.QuestionId).Hidden(true);
                                                columns.Add().Field(p => p.SQNo).Title("Q#").Width(70);
                                                columns.Add().Field(p => p.DisciplineName).Title("Discipline").Width(110).Filterable(true);
                                                columns.Add().Field(p => p.ComponentName).Title("Component").Filterable(true).Width(125);
                                                columns.Add().Field(p => p.AspectName).Title("Aspect").Filterable(true).Width(100);
                                                columns.Add().Field(p => p.Question).Title("Question").Width(120).Filterable(true).TemplateId("DisplayQuestionDesc").HtmlAttributes(new { @style = "overflow: hidden;text-overflow: ellipsis;white-space: nowrap;" }).Template("#if(data.Question==null){#<div><div style='display:flex;margin-left:-5px'><button class='bg-image add-question' title='Add New Question Icon'  onclick='addQuestion(#:AspectID#);'>Add Question</button></div></div>#}if(data.Question != null ){# <div>  #=Question# </div>#}#");
                                                columns.Add().Field(p => p.Response).Title("Response").Width(150).Filterable(true).TemplateId("DisplayQuestionResponse").HtmlAttributes(new { @style = "overflow: hidden;text-overflow: ellipsis;white-space: nowrap;" });
                                                //columns.Add().Field(p => p.Feedback).Title("Feedback").Width(105).Filterable(true);
                                                columns.Add().Field(p => p.MaturityLevel).Title("Maturity Level").Width(125).Filterable(true);
                                                columns.Add().Field(p => p.AreasofImprovement).Title("Improvement").Width(150).Filterable(true).TemplateId("DisplayAreaOfImprovement").HtmlAttributes(new { @style = "overflow: hidden;text-overflow: ellipsis;white-space: nowrap;" });
                                                columns.Add().Field(p => p.RespAttachment).Filterable(false).Title("File Attached").Width(125).Template("# for(var i = 0; i < RespAttachment.length; i++) {# <a class='dwn-file-tag' onclick='Downloaduploadedfile(#: RespAttachment[i].Id #)'>#: RespAttachment[i].filename# </a> #};#") ;
                                                columns.Add().Title("Action").Filterable(false).Width(80).Template("#if (data.Question!=null){#<div><div style='display:flex;margin-left:-5px'><button class='edit-question bg-image'  title='Edit Icon' onclick='editAssessment(#:AssessmentID#,#:QuestionId#);'></button><button class='view-question' title='View Icon' onclick='viewAssessmentOverview(#:AssessmentID#,#:QuestionId#);'></button></div></div>#}if(data.Question == null){#<div></div>#}#");



                                            })
                                               // .Excel(excel => excel.FileName("Question Set Administration Export.xlsx")/*.ProxyURL(Url.Action("Export_Assessment_Overview_Save", "Assessment"))*/)
                                               // .Selectable(true)
                                               .Filterable()
                                               .Sortable()
                                              .Toolbar(tools =>
                                              {
                                                  // tools.Excel().Text(" ");
                                                  // tools.Create().Text("Add Question set");
                                              })
                                            .DataSource(dataSource => dataSource
                                                // .ServerOperation(true)
