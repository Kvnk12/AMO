    function onEngagementPublishClick() {
        checkallQRes();
        if (allQRes == false) {
            var AssessmentID = $("#AssessmentName").data("kendoDropDownList").value();

            var mod = {
                AssessmentID: AssessmentID,
                Action: "Engagement Published"
            };

            var data1 = JSON.stringify(mod);
            baseurl1 = '@Url.Content("~/AssessmentManager/Assessment/ReviewAssessment")';

            $.ajax(
                {
                    url: baseurl1,
                    type: 'post',
                    data: data1,
                    async: false,
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {
                        document.getElementById('AssessmentStatus').innerHTML = "Engagement Published";
                        $("#AssessmentStatus").data("kendoTextBox").value("Engagement Published");
                        document.getElementById("btnEngagementPublish").disabled = true;

                        //console.log("Published");
                        $('#saveAlertModal').modal('show');
                        $('#lblErr').hide();
                        $('#lblSuccess1').show();
                        $('#successlabel').text("Status of the Assessment has been changed to 'Engagement Published'");
                    }
