        border: 1px solid #807c7c;
        border-radius: 10px;
    }

    body {
        -webkit-print-color-adjust: exact;
    }

    #btnExp {
        background-image: url("../../Content/images/export_pdf.svg");
        background-color: transparent;
        color: white;
        background-repeat: no-repeat;
        border: none;
        background-position: right;
        padding-right: 2em;
        position: relative;
        margin-right: 0.5em;
        z-index: 1;
        font-size: 1vw !important;
    }

    .custom-blue-label {
        font-size: 1vw !important;
    }
    .k-widget.k-window {
        height: 34vw;
        width: 69vw;
    }
