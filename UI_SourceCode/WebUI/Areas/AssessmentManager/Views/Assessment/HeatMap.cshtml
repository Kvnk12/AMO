    var selCmp = "";
    function cmpClick(cmpid) {
        selCmp = $("#" + cmpid.id).text();
        $("#SingleDashboardDetail").data("kendoGrid").dataSource.read();
        $("#cmpName").text(selCmp);
        var popup = $("#ViewSingleCmpDetails").data("kendoWindow");
        popup.open();
        popup.center();
    }
    function cmpNameClick(cmpid) {
        selCmp = $("#" + cmpid).text();
        $("#SingleDashboardDetail").data("kendoGrid").dataSource.read();
        $("#cmpName").text(selCmp);
        var popup = $("#ViewSingleCmpDetails").data("kendoWindow");
        popup.open();
        popup.center();
    }

    function GetCmpDetails() {
        return {
            assessmentName: $("#AssessmentName").data("kendoDropDownList").text(),
            ComponentName: selCmp
        };
