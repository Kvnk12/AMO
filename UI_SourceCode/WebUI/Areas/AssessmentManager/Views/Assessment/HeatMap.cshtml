        border-radius: 10px;
    }

    .level3 {
        height: 1vw;
        width: 1vw;
        background-color: #FFB300;
        margin-right: 0.5em;
        margin-top: 0.25em;
        border: 1px solid #bcb56e;
        border-radius: 10px;
    }

    .level4 {
        height: 1vw;
        width: 1vw;
        background-color: #AAB300;
        margin-right: 0.5em;
        margin-top: 0.25em;
        border: 1px solid #bf965c;
