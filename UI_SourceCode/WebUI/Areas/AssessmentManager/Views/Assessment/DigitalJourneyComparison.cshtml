<div class="content-main custom-grid dark-bg">
    <div>
        <ol class="breadcrumb ">
            <li>A3MM</li>
            <li class="active">Dashboard</li>
        </ol>
    </div>

    <div class="content-wrapper incident-dashboard-container">
        @*<div id="exportpdf_btn" onclick="downloadimage()">EXPORT to pdf</div>*@
    

        <div class="parameter-slider-overlay"></div>
        <div class="parameter-section">
            <div style="display:flex;justify-content:space-between">
                <div>
                    <div class="a3mm-dash-fields">

                        <div class="custom-textbox" style="display: flex; margin-right: 2em;">
                            <div style="margin-right: 0.5em; width: 24em">First Assessment Name :</div>

                            @(Html.Kendo().TextBox()
                         .Name("AssessmentName")
                         .Value(Model.AssessmentName)
                         .Placeholder("No Data")
                         .HtmlAttributes(new { style = "" })
                        )
                        </div>

                        <div class="custom-textbox" style="display: flex;  margin-right: 2em;">
                            <div style="margin-right: 0.5em; width: 24em">Second Assessment Name :</div>

                            @(Html.Kendo().TextBox()
                         .Name("AssessmentName2")
                         .Value(Model.secondAssessmentDataList.AssessmentName)
                         .Placeholder("No Data")
                         .HtmlAttributes(new { style = "" })
                        )
                        </div>

                    </div>
                    <div class="a3mm-dash-fields" id="labelword-3" style="display:none">
                        @if (Model.ThirdAssessmentDataList != null)
                        {
                            if (Model.ThirdAssessmentDataList.AssessmentName != "No Selection")
                            {
                                <div class="custom-textbox" style="display: flex;  margin-right: 2em;">
                                    <div style="margin-right: 0.5em; width: 24em">Third Assessment Name :</div>

                                    @(Html.Kendo().TextBox()
 .Name("AssessmentName3")
 .Value(Model.ThirdAssessmentDataList.AssessmentName)
 .Placeholder("No Data")
 .HtmlAttributes(new { style = "" })
)
                                </div>
                            }

                        }

                        @if (Model.FourthAssessmentDataList != null)
                        {
                            if (Model.FourthAssessmentDataList.AssessmentName != "No Selection")
                            {


                                <div class="custom-textbox" id="labelword-4" style="display: none;  margin-right: 2em;">
                                    <div style="margin-right: 0.5em; width: 24em">Fourth Assessment Name :</div>

                                    @(Html.Kendo().TextBox()
     .Name("AssessmentName4")
     .Value(Model.FourthAssessmentDataList.AssessmentName)
     .Placeholder("No Data")
     .HtmlAttributes(new { style = "" })
)
                                </div>
                            }

                        }
                    </div>
                </div>
                <div class="action-items">
                    <button type="button" id="btnExp">Export - </button>
                    <span class="parameter-filter-icon"></span>
                </div>
            </div>
       

            <div class="parameter-slider">
                <span class="close-parameters"></span>
                <div class="parameter-list-main">

                    <ul>
                        <li>
                            Select First Assessment :
                            @( Html.Kendo().DropDownList().Name("AssessmentList")
                                                            .DataTextField("Text")
                                                            .DataValueField("Value")
                                                            .SelectedIndex(0)
                                                            .BindTo(Model.AssessmentList)
                                                             .Events(e =>
                                                              {
                                                               e.Change("onSelectAssessmentName");
                                                              })
                               )
                        </li>

                        <li>
                            Select Second Assessment :
                            @( Html.Kendo().DropDownList().Name("AssessmentList2")
                                                            .DataTextField("Text")
                                                            .DataValueField("Value")
                                                            .SelectedIndex(0)
                                                            .BindTo(Model.secondAssessmentDataList.AssessmentList)
                                                             .Events(e =>
                                                             {
                                                                 e.Change("onSelectAssessmentName2");
                                                             })
                                                             
                               )
                        </li>
                        @if (Model.ThirdAssessmentDataList == null)
                        {
                            <li>
                                Select Third Assessment :
                                @( Html.Kendo().DropDownList().Name("AssessmentList3")
                             .DataTextField("Text")
                             .DataValueField("Value")
                           //  .Value("No Selection")
                             .Enable(false)

                                )
                            </li>
                        }
                        else
                        {
                            <li>
                                Select Third Assessment :
                                @( Html.Kendo().DropDownList().Name("AssessmentList3")
                             .DataTextField("Text")
                             .DataValueField("Value")
                             // .SelectedIndex(0)
                             .BindTo(Model.ThirdAssessmentDataList.AssessmentList)
                           .Events(e =>
                           {
                               e.Change("onSelectAssessmentName3");
                           })
                          
                                )
                            </li>
                        }

                        @if (Model.FourthAssessmentDataList == null)
                        {
                            <li>
                                Select Fourth Assessment :
                                @( Html.Kendo().DropDownList().Name("AssessmentList4")
                             .DataTextField("Text")
                             .DataValueField("Value")
                             // .Value("No Selection")
                                .Enable(false)

)
                            </li>
                        }
                        else
                        {
                            <li>
                                Select Fourth Assessment :
                                @( Html.Kendo().DropDownList().Name("AssessmentList4")
                             .DataTextField("Text")
                             .DataValueField("Value")
                             .Enable(false)
                             // .SelectedIndex(0)
                             .BindTo(Model.FourthAssessmentDataList.AssessmentList)


)
                            </li>
                        }


                        <li>
                            @(Html.Kendo().Button()
                                      .Name("btnPreview")
                                      .Content("Apply")
                                      .HtmlAttributes(new { type = "button", @class = "k-primary" })

                            )
                        </li>
                    </ul>
                </div>
            </div>

            <div>
                @Html.Partial("_DigitalJourneyComp")
            </div>
        </div>


    </div>

    <div>
        @Html.Partial("_ComponentDetails")
    </div>
</div>

<script type="text/javascript">
    $('.parameter-filter-icon').on('click', function () {
        $(this).addClass('open');
        $('.parameter-slider-overlay').addClass('open');
        $('.parameter-slider').addClass('open');
    });
    $('.close-parameters').on('click', function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');
    });
    $('.parameter-slider-overlay').click(function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        /*$('.parameter-slider').removeClass('open');*/
    });
    var app;
    $('#btnPreview').click(function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');
        console.log("apply clicked");
        app = $("#AssessmentList").data("kendoDropDownList");

        var FirstAssessmentID = $("#AssessmentList").data("kendoDropDownList").value();
        var SecondAssessmentID = $("#AssessmentList2").data("kendoDropDownList").value();
        var ThirdAssessmentID = $("#AssessmentList3").data("kendoDropDownList").value();
        var FourthAssessmentID = $("#AssessmentList4").data("kendoDropDownList").value();

        var FirstAssessmentName = $("#AssessmentList").data("kendoDropDownList").text();
        var SecondAssessmentName = $("#AssessmentList2").data("kendoDropDownList").text();
        var ThirdAssessmentName = $("#AssessmentList3").data("kendoDropDownList").text();
        var FourthAssessmentName = $("#AssessmentList4").data("kendoDropDownList").text();

       
        if (SecondAssessmentName == "No Selection") {
            alert("please select Second Assessment")

        } else {
        var mod = {
            AssessmentName: FirstAssessmentName,
            AssessmentName2: SecondAssessmentID != "" ? SecondAssessmentName :"No Selection",
            AssessmentName3: ThirdAssessmentID != "" ? ThirdAssessmentName :"No Selection",
            AssessmentName4: FourthAssessmentID != "" ? FourthAssessmentName :"No Selection"

        }
            console.log(mod)
        var data1 = JSON.stringify(mod);
        baseurl = '@Url.Content("~/AssessmentManager/Assessment/GetEngageLevelByAssNameForComparison")';

        $.ajax({

            type: 'post',
            url: baseurl,
            async: false,
            data: data1,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                $("#digiJourney").html(response);
                var acct = $("#SelAccount").text();
                $("#Account").val(acct);
                $("#AssessmentName").val(FirstAssessmentName);
                $("#AssessmentName2").val(SecondAssessmentName);
                if (ThirdAssessmentName!="") {
                    $("#AssessmentName3").val(ThirdAssessmentName);
                    if (FourthAssessmentName!="") {
                        $("#AssessmentName4").val(FourthAssessmentName);
                    }
                }
                if (SecondAssessmentName != "No Selection" && (ThirdAssessmentName == "No Selection" || ThirdAssessmentName == "")){
                    document.getElementById("compare_2").style.display = "flex";
                    document.getElementById("labelword-3").style.display = "none";
                    document.getElementById("labelword-4").style.display = "none";
                    document.getElementById("compare_3").style.display = "none";
                    document.getElementById("compare_4").style.display = "none";
                }
                else if (SecondAssessmentName != "No Selection" && ThirdAssessmentName != "No Selection" && (FourthAssessmentName == "No Selection"||FourthAssessmentName=="")) {
                    document.getElementById("compare_2").style.display = "none";
                    document.getElementById("compare_3").style.display = "flex";
                    document.getElementById("compare_4").style.display = "none";
                    document.getElementById("labelword-3").style.display = "flex";
                    document.getElementById("labelword-4").style.display = "none";
                }
                else if (SecondAssessmentName != "No Selection" && ThirdAssessmentName != "No Selection" && FourthAssessmentName != "No Selection") {
                    document.getElementById("compare_2").style.display = "none";
                    document.getElementById("compare_3").style.display = "none";
                    document.getElementById("compare_4").style.display = "flex";
                    document.getElementById("labelword-3").style.display = "flex";
                    document.getElementById("labelword-4").style.display = "flex";

                }
                
            },
            error: function (err, response) {
                console.log(err);
            }
        });
    }
    });
    var selCmp = "";
    var orderTemp = 1;
    function cmpClick(cmpid, order) {
        selCmp = $("#" + cmpid.id).text();
        orderTemp = order;
        var FirstAssessmentName = $("#AssessmentList").data("kendoDropDownList").text();
        var SecondAssessmentName = $("#AssessmentList2").data("kendoDropDownList").text();
        var ThirdAssessmentName = $("#AssessmentList3").data("kendoDropDownList").text();
        var FourthAssessmentName = $("#AssessmentList4").data("kendoDropDownList").text();
        if (SecondAssessmentName != "No Selection" && (ThirdAssessmentName == "No Selection" || ThirdAssessmentName == "")) {
            $("#DashboardDetail").data("kendoGrid").dataSource.read();
            document.getElementById("grid-2").style.display = "block";
            document.getElementById("grid-3").style.display = "none";
            document.getElementById("grid-4").style.display = "none";
        }
        else if (SecondAssessmentName != "No Selection" && (ThirdAssessmentName != "No Selection" || ThirdAssessmentName == "") && (FourthAssessmentName == "No Selection" || FourthAssessmentName == "")) {
            $("#DashboardDetail3").data("kendoGrid").dataSource.read();
            document.getElementById("grid-2").style.display = "none";
            document.getElementById("grid-3").style.display = "block";
            document.getElementById("grid-4").style.display = "none";
        }
        else if (SecondAssessmentName != "No Selection" && ThirdAssessmentName != "No Selection" && FourthAssessmentName != "No Selection") {
            $("#DashboardDetail4").data("kendoGrid").dataSource.read();
            document.getElementById("grid-2").style.display = "none";
            document.getElementById("grid-3").style.display = "none";
            document.getElementById("grid-4").style.display = "block";
        }
       
        $("#cmpName").text(selCmp);
            var popup = $("#ViewCmpDetails").data("kendoWindow");
            popup.open();
            popup.center();

    }

    function GetCmpDetails() {
        console.log("OrderTemp", orderTemp);
            return {
                firstassessment: $("#AssessmentList").data("kendoDropDownList").text(),
                secondassessment: $("#AssessmentList2").data("kendoDropDownList").text(),
                ComponentName: selCmp
            };
    }
    function GetCmpDetails3() {
        console.log("OrderTemp", orderTemp);
            return {
                firstassessment: $("#AssessmentList").data("kendoDropDownList").text(),
                secondassessment: $("#AssessmentList2").data("kendoDropDownList").text(),
                thirdassessment: $("#AssessmentList3").data("kendoDropDownList").text(),
                ComponentName: selCmp
            };
    }
    function GetCmpDetails4() {
        console.log("OrderTemp", orderTemp);
            return {
                firstassessment: $("#AssessmentList").data("kendoDropDownList").text(),
                secondassessment: $("#AssessmentList2").data("kendoDropDownList").text(),
                thirdassessment: $("#AssessmentList3").data("kendoDropDownList").text(),
                fourassessment: $("#AssessmentList4").data("kendoDropDownList").text(),
                ComponentName: selCmp
            };
    }

     function onSelectAssessmentName(e) {

         var AssessmentName = $("#AssessmentList").data("kendoDropDownList").text();
        var mod = {
            AssessmentName: AssessmentName
        }
        var data1 = JSON.stringify(mod);
        baseurl = '@Url.Content("~/AssessmentManager/Assessment/getSecondAssessmentList")';
        $.ajax({

            type: 'post',
            url: baseurl,
            async: false,
            data: data1,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                //alert("Success");
                console.log(response);
                $('#AssessmentList2').data('kendoDropDownList').setDataSource(response);
                $('#AssessmentList2').data('kendoDropDownList').select(0);
                $('#AssessmentList2').data('kendoDropDownList').enable();

                $('#AssessmentList3').data('kendoDropDownList').setDataSource(response);
                $('#AssessmentList3').data('kendoDropDownList').select(0);
                $('#AssessmentList3').data('kendoDropDownList').enable(false);

                $('#AssessmentList4').data('kendoDropDownList').setDataSource(response);
                $('#AssessmentList4').data('kendoDropDownList').select(0);
                $('#AssessmentList4').data('kendoDropDownList').enable(false);
            },
            error: function (err, response) {
                // alert(err.responseText);
            }
        });
    }

       function onSelectAssessmentName2(e) {

       var AssessmentName1 = $("#AssessmentList").data("kendoDropDownList").text();
       var AssessmentName2 = $("#AssessmentList2").data("kendoDropDownList").text();
      var mod = {
          AssessmentName1: AssessmentName1,
          AssessmentName2: AssessmentName2
      }
      var data1 = JSON.stringify(mod);
      baseurl = '@Url.Content("~/AssessmentManager/Assessment/getThirdAssessmentList")';
      $.ajax({

          type: 'post',
          url: baseurl,
          async: false,
          data: data1,
          contentType: 'application/json; charset=utf-8',
          success: function (response) {

              //console.log(response);
              $('#AssessmentList3').data('kendoDropDownList').setDataSource(response);
              $('#AssessmentList3').data('kendoDropDownList').select(0);
              $('#AssessmentList3').data('kendoDropDownList').enable();
              // $('#AssessmentList4').data('kendoDropDownList').setDataSource(response);
              $('#AssessmentList4').data('kendoDropDownList').setDataSource(response);
              $('#AssessmentList4').data('kendoDropDownList').select(0);
              $('#AssessmentList4').data('kendoDropDownList').enable(false);
          },
          error: function (err, response) {

          }
      });
    }
       function onSelectAssessmentName3(e) {

     var AssessmentName1 = $("#AssessmentList").data("kendoDropDownList").text();
    var AssessmentName2 = $("#AssessmentList2").data("kendoDropDownList").text();
    var AssessmentName3 = $("#AssessmentList3").data("kendoDropDownList").text();
    var mod = {
        AssessmentName1: AssessmentName1,
        AssessmentName2: AssessmentName2,
        AssessmentName3: AssessmentName3
    }
    var data1 = JSON.stringify(mod);
    baseurl = '@Url.Content("~/AssessmentManager/Assessment/getFourthAssessmentList")';
    $.ajax({

        type: 'post',
        url: baseurl,
        async: false,
        data: data1,
        contentType: 'application/json; charset=utf-8',
        success: function (response) {

            $('#AssessmentList4').data('kendoDropDownList').setDataSource(response);
            $('#AssessmentList4').data('kendoDropDownList').select(0);
            $('#AssessmentList4').data('kendoDropDownList').enable();
        },
        error: function (err, response) {

        }
    });
}
</script>

