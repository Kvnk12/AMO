                transform-origin: 0 50%;
                transform: rotate(90deg);
                transition: transform .5s;
                margin-top: -0.5em;
            }

            .arrow.down::before {
                position: relative;
                content: '';
                width: 0;
                height: 0;
                border: .5em solid transparent;
                border-left-color: #5876AA;
                transform: rotate(0deg);
                transition: transform .25s;
                margin-top: -0.5px;
