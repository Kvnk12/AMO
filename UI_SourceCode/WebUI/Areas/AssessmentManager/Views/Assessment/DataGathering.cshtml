        }

            .auditIcon .popUpText {
                visibility: hidden;
                width: 72vw;
                height: 3vw;
                background-color: #eee;
                color: #fff;
                text-align: center;
                border-radius: 6px;
                padding: 2px 2px;
                position: absolute;
                z-index: 1;
                /* bottom: -94%; */
                /* left: 146%; */
                margin-left: 7px;
                margin-top: -0.3em;
            }

                .auditIcon .popUpText::after {
                    content: "";
                    position: absolute;
                    top: 37%;
                    left: -1.8%;
                    /* margin-left: -5px; */
                    border-width: 8px;
                    border-style: solid;
                    border-color: transparent #eee transparent transparent;
                }

            .auditIcon .show {
                visibility: visible;
                -webkit-animation: fadeIn 1s;
                animation: fadeIn 1s;
            }

            /* Add animation (fade in the popup) */
            @@-webkit-keyframes fadeIn {
             from{
                    opacity: 0;

                 }
             to {
                  opacity: 1;

              }
            }
