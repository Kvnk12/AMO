            if (ischanged) {
                $("#AssessIdSel").text(AssessmentID);
                $("#questSel").text(QNo);
                $('#ChangesSaveAlertModal').modal('show');
            } else {
                pageClick(QNo, AssessmentID);
            }
        }
        function retriveChng() {
            $('#ChangesSaveAlertModal').modal('hide');
        }
        function nextQuest() {
            var AssessmentID= $("#AssessIdSel").text();
            var QNo = $("#questSel").text();
            $('#ChangesSaveAlertModal').modal('hide');
            pageClick(QNo, AssessmentID);
        }
