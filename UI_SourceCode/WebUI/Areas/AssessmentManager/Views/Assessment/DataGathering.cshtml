<body>

    <div class="content-main dark-bg dataGathering">
        <ol class="breadcrumb" style="margin-bottom:8px">
            <li>Assessment Manager</li>
            <li class="active">Assessment Data Gathering</li>
        </ol>
        <div class="dg-header">
            <div>
                <span id="titleHeader">Assessment- Data Gathering</span>
            </div>
            <div>
                <button id="btnClose" class="closeBtn" onclick="closeButton()"></button>
            </div>
        </div>
        <div class="Datagathering-main">
            <div style="display: flex;flex-direction:column;margin: 0em 0.6em">
                <div class="mainContainer">
                    <div class="arrow">
                        <span class="expandTitle">Assessment</span>
                    </div>
                    <div class="content">
                        <div class="flexClassForLabels" style=" margin: 0em 1em;">
                            <div class="flexClassForLabels FirstOne" style="width:23vw">
                                <div class="custom-blue-label" style="width: 9.5vw;">Assessment Type :</div>
                                <div class="custom-dropdown AssessmentType" style="margin-top: 0.5vw;">
                                    @(Html.Kendo().DropDownListFor(m => m.AssessmentID)
                                     .DataTextField("Text")
                                     .DataValueField("Value")
                                     .BindTo(Model.AssessmentList)
                                     .Value(Model.SurveyTypeID.ToString())
                                     .Name("AssessmentID")
                                     .HtmlAttributes(new { style = "width: 12vw;border:none;font-size: 1vw;border-radius: 0px;box-shadow: none;line-height: 0.935714em;border-bottom: 1px solid #ccc;" })
                                      .Events(e =>
                                      {
                                          e.Select("onSelectAssessmentType");
                                      })
                                 )
                                </div>
                            </div>
                            <div class="flexClassForLabels FirstTwo" style="width:31vw;margin-left:1em">
                                <div class="custom-blue-label" style=" width: 10vw;">Assessment Name :</div>
                                <div class="custom-dropdown AssessmentName" style="margin-top: 0.5vw;">
                                    @(Html.Kendo().DropDownListFor(m => m.AssessmentID)
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    .BindTo(Model.AssessmentNameList)
                                    .Name("AssessmentName")
                                    .Events(e =>
                                    {
                                      e.Select("onSelectAssessmentName");
                                    })
                                    .HtmlAttributes(new { style = "width:21vw;border:none;font-size:  1vw;border-radius: 0px;box-shadow: none;line-height: 0.935714em;border-bottom: 1px solid #ccc;" })
                                      )
                                </div>
                            </div>
                            <div class="flexClassForLabels FirstThree" style="width: 23vw; margin-left: 3em;">
                                <div class="custom-blue-label " style="width: 10.3vw;">Assessment Status :</div>
                                <div class="custom-textbox Assessment-status" style="margin-top: 0.5vw;">
                                    @(Html.Kendo().TextBox()
                                    .Name("Status")
                                    .Value(Model.Status)
                                    .Enable(false)
                                    .HtmlAttributes(new { style = "width:12vw;font-size: 1vw;height:1.8vw" })
                                    )
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mainContainer" >
                    <div class="arrow1">
                        <span class="expandTitle">Question Identifier</span>
                    </div>
                    <div class="content1">
                        <div class="flexClassForLabels" style=" margin: 0em 1em 0.5em;">
                            <div class="flexClassForLabels SecondOne" style="width:11vw;">
                                <div class="custom-blue-label" style="width:5vw;">Question set # :</div>
                                <div class="custom-textbox question-version" style="margin-top: 0.5vw;">
                                    @(Html.Kendo().TextBox()
                                    .Name("QVerTxtBox")
                                    .Value(Model.VersionID)
                                    .Enable(false)
                                    .HtmlAttributes(new { style = "width: 6vw;font-size: 1vw;height:1.6vw;" })
                               )
                                </div>
                            </div>
                            <div class="flexClassForLabels SecondTwo" style="width:20vw;">
                                <div class="custom-blue-label" style="width: 6vw; margin-left: 1.5em;">Discipline : </div>
                                <div class="custom-dropdown Discipline">
                                    @(Html.Kendo().DropDownListFor(m => m.DisciplineId)
                                     .DataTextField("Text")
                                     .DataValueField("Value")
                                     .BindTo(Model.DisciplineList)
                                     .Enable(true)
                                     .Value(Model.DisciplineId.ToString())
                                     .Name("DisciplineId")
                                     .Events(e =>
                                     {
                                         e.Change("onChangeDscName");
                                     })
                                     .HtmlAttributes(new { style = "width:12vw;font-size: 1vw;" })
                                                          )
                                </div>
                            </div>
                            <div class="flexClassForLabels SecondThree" style="width: 20vw; margin-left: 1.5vw;">
                                <div class="custom-blue-label" style="width: 7vw;">Component : </div>
                                <div class="custom-dropdown" style="margin-top: 0.5vw;">
                                    @(Html.Kendo().DropDownListFor(m => m.ComponentId)
                                     .DataTextField("Text")
                                     .DataValueField("Value")
                                     //.BindTo(Model.ComponentList)
                                     .Value(Model.ComponentId.ToString())
                                     .Enable(true)
                                     .Name("ComponentId")
                                     .Events(e =>
                                     {
                                         e.Change("onChangeCompName");
                                     })

                                     //.AutoBind(false)
                                     .DataSource(d => d.Read(r => r.Action("Readcomponent", "Assessment").Data("loadcomponent")))


                                     .HtmlAttributes(new { style = "width:12vw;font-size: 1vw;" })
                                                         )
                                </div>
                            </div>
                            <div class="flexClassForLabels SecondFour" style="width: 22vw; margin-left: 1.5vw;">
                                <div class="custom-blue-label" style="width: 5vw;">Aspect : </div>
                                <div class="custom-dropdown" style="margin-top: 0.5vw;">
                                    @(Html.Kendo().DropDownListFor(m => m.AspectID)
                                    .DataTextField("Text")
                                    .DataValueField("Value")
                                    //.BindTo(Model.AspectList)
                                    .Value(Model.AspectID.ToString())
                                    .Enable(true)

                                     .Events(e =>
                                     {
                                         e.Change("onChangeAspName");
                                     })
                                     // .AutoBind(false)
                                     .DataSource(d => d.Read(r => r.Action("ReadAspect", "Assessment").Data("loadAspect")))
                                    .HtmlAttributes(new { style = "width:12vw;font-size: 1vw;" })
                                     )
                                </div>
                            </div>
                            <div style="display: flex; justify-content: flex-end; margin-top: 0.5vw; margin-right: -3vw; ">
                                <button style="width: 5vw; color: rgb(91,121,171); font-size: 0.9vw; margin-top: 2px; margin-right: 1em; background-image: url(../../Content/images/clear_all.svg); background-repeat: no-repeat; border: none; background-color: transparent; padding-left: 1vw; background-size: 1.1vw; background-position: left;" class="custom-button" type="button" onclick="onclearADCName()">CLEAR</button>
                                <button style="width: 10vw; background-image: url(../../Content/images/Apply_selection.svg); color: rgb(91,121,171); font-size: 0.9vw; margin-top: 2px; margin-right: 1em; background-repeat: no-repeat; border: none; background-color: transparent; padding-left: 1vw; background-size: 1.1vw; background-position: left; " class="custom-button" type="button" onclick="onChangeADCName()">APPLY SELECTION</button>
                            </div>
                        </div>


                    </div>
                </div>
                <div class="mainContainer">
                    <div class="arrow2">
                        <span class="expandTitle">Question Display</span>
                    </div>
