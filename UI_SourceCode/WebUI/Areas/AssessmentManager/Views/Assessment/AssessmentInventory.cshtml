<div id="saveAlertModal" class="modal fade" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-body">
            <div class="alert alert-danger" id="lblErr1" style="display:none">
                <div style="display:flex">
                    <label id="labelError" style="width: 18em; margin-top: 4px; margin-left: 1em; ">Error while saving Assessment.</label>
                    <button style="margin-top: -5px; margin-left: 5.5em;" type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
            <div class="alert alert-success" id="lblSuccess1" style="display:none">
                <div style="display:flex">
                    <label id="labelSuccess" style="width: 29em; margin-top: 4px; margin-left: 1em;">Assessment Saved Successfully.</label>
                    <button style="margin-top: -5px; margin-left: -1.5em;" type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var gridObj;

    $(window).resize(function () {
        gridAutoHeight(gridObj);
    });
    function gridAutoHeight(gridObj, bottomMargin) {
        try {
            if (gridObj) {
                gridObj.element.height($(window).height() - gridObj.element[0].offsetTop - (bottomMargin || 150));
                gridObj.resize();
            }
        } catch (e) {
            console.log('Error resizing grid: ' + e.toString());
        }
    }
    $(document).ready(function () {
        gridObj = $('#AssessmentListGrid').getKendoGrid();
        gridAutoHeight(gridObj);
        var winObject = $("#EditViewAssessmentpopUp").data("kendoWindow");
