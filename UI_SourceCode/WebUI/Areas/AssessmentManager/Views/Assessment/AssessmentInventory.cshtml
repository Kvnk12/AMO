    ViewBag.ImagePathOne = Url.Content("~/Content/images/Assessment_manager_white.svg");
    Layout = "~/Views/Shared//GenericLayOut.cshtml";
}

<style>
    .k-state-active .k-icon:before {
        background-color: #fff !important;
        color: #000 !important;
        margin: 2px !important;
    }

    .k-grid-header th.k-header {
        font-weight: bold;
        font-size: 13px;
        text-overflow: ellipsis;
        border: thin 1px #ccc;
    }

    td {
        overflow: hidden;
        white-space: nowrap;
    }

    .custom-kendo-grid .k-widget.k-grid .k-toolbar.k-grid-toolbar .k-button.k-grid-excel {
        padding-right: 2.3em;
    }

    #saveAlertModal .alert {
        width: 30em;
        height: 2.5em !important;
        padding: unset;
        display: flex;
    }

    #assessmentInventoryScreen #AssessmentListGrid .k-grid-content.k-auto-scrollable::-webkit-scrollbar {
        width: 9px;
        height: 9px;
    }

    #assessmentInventoryScreen #AssessmentListGrid .k-grid-content.k-auto-scrollable::-webkit-scrollbar-track {
        background-repeat: repeat-y;
    }

    #assessmentInventoryScreen #AssessmentListGrid .k-grid-content.k-auto-scrollable::-webkit-scrollbar-track-piece {
        border-radius: 3px;
        background-color: #C4C4C4;
        border: 3px solid #eee;
    }

    #assessmentInventoryScreen #AssessmentListGrid .k-grid-content.k-auto-scrollable::-webkit-scrollbar-thumb {
        background: #0780B0;
        border-radius: 6px;
    }

    #assessmentInventoryScreen #AssessmentListGrid .k-grid-content.k-auto-scrollable::-webkit-scrollbar-thumb {
        background: rgb(91,121,171);
        border-radius: 6px;
    }

    #AssessmentListGrid .k-icon.k-i-filter:before {
        content: "\e031";
    }
    #assessmentInventoryScreen .k-widget.k-grid {
        height: 58vh !important;
    }

    .a3mm-edit-icon {
        background-image: url('../../Content/images/edit_blue.svg');
        background-position: center;
        background-repeat: no-repeat;
        color: rgb(91,121,171);
        cursor: pointer;
        text-align: center;
        border: none;
        text-indent: -14px;
        background-color: transparent;
        background-size: 1.5em;
        padding: 0.8em;
        display: inline-grid;
    }
    .a3mm-view-icon {
        background-image: url('../../Content/images/view_blue.svg');
        background-position: center;
        background-repeat: no-repeat;
        color: rgb(91,121,171);
        cursor: pointer;
        text-align: center;
        border: none;
        text-indent: -14px;
        background-color: transparent;
        background-size: 1.5em;
        padding: 0.8em;
        display: inline-grid;
    }
    .a3mm-data-icon {
        background-image: url('../../Content/images/data_gathering.svg');
        background-position: center;
        background-repeat: no-repeat;
        color: rgb(91,121,171);
        cursor: pointer;
        text-align: center;
        border: none;
        text-indent: -14px;
        background-color: transparent;
        background-size: 1.5em;
        padding: 0.8em;
        display: inline-grid;
