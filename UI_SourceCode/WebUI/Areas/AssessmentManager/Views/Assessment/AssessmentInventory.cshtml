    function Ass_Inven_excelExport(e) {
        var sheet = e.workbook.sheets[0];
        for (var rowIndex = 1; rowIndex < sheet.rows.length; rowIndex++) {
            var sheet = e.workbook.sheets[0];
            sheet.rows[0].cells[7].value = null;
            sheet.rows[0].cells[7].background = "#fff";
            sheet.filter.to= 6;
            console.log(sheet);
            for (var rowIndex = 1; rowIndex < sheet.rows.length; rowIndex++) {
                var row = sheet.rows[rowIndex];
               // console.log(row);
               // row.cells[4].format = "{0:MM/dd/yyyy}"
                row.cells[7].value = null;

            }
        }
    }

