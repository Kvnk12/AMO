<div class="content-main custom-grid dark-bg">
    <div>
        <ol class="breadcrumb ">
            <li>A3MM</li>
            <li class="active">Dashboard</li>
        </ol>
    </div>

    <div class="content-wrapper incident-dashboard-container">
        @*<div id="exportpdf_btn" onclick="downloadimage()">EXPORT to pdf</div>*@
        <div class="a3mm-dash-fields">

            <div class="custom-textbox" style="display: flex; width: 24%; margin-right: 2em;">
                <div style="margin-right: 0.5em;width:6em">Account :</div>
                @(Html.Kendo().TextBox()
                             .Name("Account")
                             .Value(Model.Account)
                             .HtmlAttributes(new { style = "" })
                            )
            </div>

            <div class="custom-textbox" style="display: flex; width: 35%; margin-right: 2em;">
                <div style="margin-right: 0.5em; width: 13.5em">Assessment Name :</div>

                @(Html.Kendo().TextBox()
                             .Name("AssessmentName")
                             .Value(Model.AssessmentName)
                             .Placeholder("No Data")
                             .HtmlAttributes(new { style = "" })
                            )
            </div>
            <div class="custom-textbox" style="display: flex; width: 13%; margin-right: 2em;">
                @*<div style="margin-right: 0.5em; width: 6em">Contract :</div>

        @(Html.Kendo().TextBox()
                         .Name("Contract")
                         .Value(Model.Contract)
                         .HtmlAttributes(new { style = "" })
                        )*@
               
            </div>
            
        </div>

        <div class="parameter-slider-overlay"></div>
        <div class="parameter-section">
            <div class="action-items" style=" margin-top: -2.5vh;">
                <button type="button" id="btnExp">Export - </button>
                <span class="parameter-filter-icon"></span>
            </div>
           
            <div class="parameter-slider">
                <span class="close-parameters"></span>
                <div class="parameter-list-main">

                    <ul>
                        <li>
                            Assessment Name:
                            @( Html.Kendo().DropDownList().Name("AssessmentList")
                                                            .DataTextField("Text")
                                                            .DataValueField("Value")
                                                            .SelectedIndex(0)
                                                            .BindTo(Model.AssessmentList)
                                                             //.Events(e =>
                                                             //{
                                                             //e.Change("onSelectAccount");
                                                             //})
                               )
                        </li>
                        <li>
                            @(Html.Kendo().Button()
                                      .Name("btnPreview")
                                      .Content("Apply")
                                      .HtmlAttributes(new { type = "button", @class = "k-primary" })

                            )
                        </li>
                    </ul>
                </div>
            </div>

            <div>
                @Html.Partial("_DigitalJourney")
            </div>
        </div>


    </div>

    <div>
        @Html.Partial("_SingleComponentDetails")
    </div>
</div>

<script type="text/javascript">
    $('.parameter-filter-icon').on('click', function () {
        $(this).addClass('open');
        $('.parameter-slider-overlay').addClass('open');
        $('.parameter-slider').addClass('open');
    });
    $('.close-parameters').on('click', function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');
    });
    $('.parameter-slider-overlay').click(function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        /*$('.parameter-slider').removeClass('open');*/
    });
    var app;
    $('#btnPreview').click(function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');
        console.log("apply clicked");
        app = $("#AssessmentList").data("kendoDropDownList");

        var mod ={
            AssessmentName: app.value()
              }

            var data1 = JSON.stringify(mod);
            baseurl = '@Url.Content("~/AssessmentManager/Assessment/GetEngageLevelByAssName")';

        $.ajax({

            type: 'post',
            url: baseurl,
            async: false,
            data: data1,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                console.log(response);
               // $("#Account").value(response.Account);
                $("#digiJourney").html(response);
                var acct = $("#SelAccount").text();
                $("#Account").val(acct);
                $("#AssessmentName").val(app.value());
            },
            error: function (err, response) {
                console.log(err);
            }
        });
    });
    var selCmp = "";
    function cmpClick(cmpid) {
        selCmp = $("#" + cmpid.id).text();
        $("#SingleDashboardDetail").data("kendoGrid").dataSource.read();
        $("#cmpName").text(selCmp);
        var popup = $("#ViewSingleCmpDetails").data("kendoWindow");
            popup.open();
            popup.center();

    }

    function GetCmpDetails() {
        return {
            assessmentName: $("#AssessmentList").data("kendoDropDownList").value(),
            ComponentName: selCmp
        };
    }
    
</script>
