    function RefreshReport() {
        var DisciplineSel = $('#Discipline').val();
        var  DisciplineDesc = "";
        for (var i = 0; i < DisciplineSel.length; i++) {
            if (i > 0) { DisciplineDesc += "##"; }
            DisciplineDesc += $('#Discipline option:selected')[i].value;
        }
        var Disciplinearr = DisciplineDesc.split('##');


        var ComponentSel = $('#Component').val();
        var ComponentDesc = "";
        for (var i = 0; i < ComponentSel.length; i++) {
            if (i > 0) { ComponentDesc += "##"; }
            ComponentDesc += $('#Component option:selected')[i].value;
        }
        var Componentarr = ComponentDesc.split('##');
        //SaveReportParameters(TypectrlSel, StatusctrlSel, PriorityctrlSel, GroupctrlSel, TowerctrlSel, WaiveOption);
        var viewer = $("#reportViewerA3MM_MaturityLevelCompare").data("telerik_ReportViewer");

