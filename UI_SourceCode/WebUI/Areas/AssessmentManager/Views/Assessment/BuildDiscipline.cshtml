            document.getElementById("id_addSubQ").style.display = 'block';
            return false;
        }
        else {
           // console.log("in");
            document.getElementById("id_addSubQ").style.display = 'none';
        }
        var SurveyTypeID = $("#SubAssessmentID").data("kendoDropDownList").value();
        var DisciplineId = $("#SubDisciplineId").data("kendoDropDownList").value();
        var ComponentId = $("#subComponentId").data("kendoDropDownList").value();
        var AspectID = $("#SubAspectID").data("kendoDropDownList").value();
        var QVerTxtBox = $("#SubQVerTxtBox").data("kendoTextBox").value();

        var AnswerField = $("#SubExampleAnswer").val();
        var dataSource = $("#SubDatasourceId").data("kendoDropDownList").value();
        var ParentID = document.getElementById('ParentIDHidden').value;
        var ParentQNO = $("#ParentQNumber").data("kendoTextBox").value();

      //  console.log(SurveyTypeID + " " + DisciplineId + " " + ComponentId + " " + AspectID + " " + QVerTxtBox+" "+QuestionField+" "+AnswerField)

          var mod ={
              SurveyTypeID: SurveyTypeID,
              DisciplineId: DisciplineId,
              ComponentId: ComponentId,
              AspectID: AspectID,
              VersionID: QVerTxtBox,
              Question: QuestionField,
              ExampleAnswer: AnswerField,
              DatasourceId: dataSource,
              ParentID: ParentID,
              QNo:ParentQNO
        }

            var data1 = JSON.stringify(mod);
             baseurl = '@Url.Content("~/AssessmentManager/Assessment/SaveQuestion")';
            $.ajax({

                type: 'post',
                url: baseurl,
                async: false,
                data: data1,
                contentType: 'application/json; charset=utf-8',
                success: function (response) {

                    $("#New_QuestionsTreeList").data("kendoTreeList").dataSource.read();
                   // console.log(response);
                    var popup = $("#AddSubQuestionpopUp").data("kendoWindow");
                    popup.close();
                    $('#saveAlertModal').modal('show');
                    $('#lblErr').hide();
                    $('#lblSuccess1').show();

                    //var qNotxtbox1 = $("#SubQuestion").data("kendoTextBox");
                    //qNotxtbox1.value("");
                    //var qNotxtbox2 = $("#SubExampleAnswer").data("kendoTextBox");
                    //qNotxtbox2.value("");

                },
                error: function (err, response) {
                    $('#saveAlertModal').modal('show');
                    $('#lblSuccess1').hide();
                    $('#lblErr').show();
                }
            });

    }


    function onFinalizeClickEdit() {
        var questionID = document.getElementById('questionIDHidden').value;
           var mod ={
               QuestionId: questionID
        }

            var data1 = JSON.stringify(mod);
             baseurl = '@Url.Content("~/AssessmentManager/Assessment/FinalizeSingleQuestion")';
            $.ajax({

                type: 'post',
                url: baseurl,
                async: false,
                data: data1,
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                    $("#New_QuestionsTreeList").data("kendoTreeList").dataSource.read();
                    var popup = $("#EditQuestionpopUp").data("kendoWindow");
                    popup.close();
                    $('#saveAlertModal').modal('show');
                    $('#lblErr').hide();
                    $('#labelSuccess').text("Question has been finalized");
                    $('#lblSuccess1').show();
                },
                error: function (err, response) {
                    $('#saveAlertModal').modal('show');
                    $('#lblSuccess1').hide();
                    $('#labelError').text("Error while finalize the question");
                    $('#lblErr').show();
                }
            });
    }
    function ExportBuildTemplate() {
         var SurveyTypeID = $("#AssessmentID_panel").data("kendoDropDownList").value();
        var QSetNo = $("#QuestionVerDrpdown").data("kendoDropDownList").text();
        var isView = @Html.Raw(Json.Encode(Model.isView));
        var baseurl = '@Url.Content("~/AssessmentManager/Assessment/ExportBuildDiscipline")' + "?SurveyTypeID=" + SurveyTypeID + "&QSetNo=" + QSetNo + "&isView=" + isView;
          window.location.replace(baseurl);
    }
