                var Aspectdrpdpwn = $("#AspectID").data("kendoDropDownList");
                Aspectdrpdpwn.value(data.AspectID);
                var popup = $("#AddQuestionpopUp").data("kendoWindow");
                //$('.k-window-title').text("Add KEDB");
                popup.open();
                popup.center();
            }
        })


    }

