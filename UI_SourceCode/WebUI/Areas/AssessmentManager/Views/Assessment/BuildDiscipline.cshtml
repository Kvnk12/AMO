    function launchAssessment() {
      //  console.log("Launch ");
        $('#ContractList_alert').hide();
        document.getElementById("confirmLaunch").style.display = "none";
        var popup = $("#LaunchAssessmentpopUp").data("kendoWindow");
        $("#AssessmentID_Launch").data("kendoDropDownList").select(0);
        $("#AccountNamesList").data("kendoDropDownList").select(0);
        $("#EnagagementPOC").data("kendoDropDownList").select(0);
        $("#ContractList").data("kendoDropDownList").select(0);
        $("#EngagementTC").data("kendoDropDownList").select(0);
        $("#QVerTxtBox_Launch").data("kendoTextBox").value("Ver - 0.1");
        $("#AssessmentTeam").data("kendoTextBox").value("Assessment Team 1");
        $("#AssessmentName_Launch").data("kendoTextBox").value("Loblaw-A3MM-2022Q1");
        //$('.k-window-title').text("Add KEDB");
        $("#AssessmentID_Launch").data("kendoDropDownList").enable(true);
        $("#AccountNamesList").data("kendoDropDownList").enable(true);
        $("#ContractList").data("kendoDropDownList").enable(true);
        $("#EnagagementPOC").data("kendoDropDownList").enable(true);
        $("#EngagementTC").data("kendoDropDownList").enable(true);
        $("#AssessmentTeam").data("kendoTextBox").enable(true);
        $("#QVerTxtBox_Launch").data("kendoTextBox").enable(true);
        $("#StartDate_Launch").data("kendoDatePicker").enable(true);
        //$("#AssessmentName_Launch").data("kendoTextBox").enable(true);




        popup.open();
        popup.center();
    }

    function onLaunchClick() {
     //   console.log("Inside onLaunchClick()");

        var ContractID = $("#ContractList").data("kendoDropDownList").value();

        document.getElementById("btnConfirmNo").style.marginLeft = "44.5em";
        document.getElementById("btnConfirmNo").style.marginTop = "-3.25em";
        document.getElementById("btnConfirmYes").style.marginTop = "-3.25em";


        var AssessmentType = $("#AssessmentID_Launch").data("kendoDropDownList").text();
        var AccountName = $("#AccountNamesList").data("kendoDropDownList").text();
        var ContractName = $("#ContractList").data("kendoDropDownList").text();
        if (ContractName == 'Select contract...') {
