                document.getElementById("AssessmentID_panel").disabled = false;
                document.getElementById("QuestionVerDrpdown").disabled = false;
                document.getElementById("btnLaunch").disabled = false;
                document.getElementById("btn-addPques").disabled = false;
                document.getElementById("btnFinalize").style.display = 'block';
            }

        });



    function getComponentDefToolTip(e) {
            var dataItem = $("#DisciplineGrid").data("kendoGrid").dataItem(e.target.closest("tr"));
