    .custom-tooltip {
        white-space: normal;
        width: 20vw;
        word-wrap: break-word;
        position: absolute;
        padding: 1px 3px;
        border-radius: 3px;
        z-index: 999999;
        display: none;
        border: none;
        background-color: lightgrey !important;
    }

    label:hover .custom-tooltip {
        position: absolute;
        display: block;
        visibility: visible;
    }

