       $(window).on("load", function () {

      
            var QSetStatus = @Html.Raw(Json.Encode(Model.QSetStatus));

            if (QSetStatus == "Draft") {
                document.getElementById("btnFinalize").disabled = false;
                document.getElementById("btn-addPques").disabled = false;

            }
            else {
                document.getElementById("btnFinalize").disabled = true;
                document.getElementById("btn-addPques").disabled = true;

           }
            var isView = @Html.Raw(Json.Encode(Model.isView));

            if (isView == "Yes") {
                document.getElementById("AssessmentID_panel").disabled = true;
                document.getElementById("QuestionVerDrpdown").disabled = true;
                document.getElementById("btnLaunch").disabled = true;
                document.getElementById("btn-addPques").disabled = true;
                document.getElementById("btnFinalize").style.display = 'none';


