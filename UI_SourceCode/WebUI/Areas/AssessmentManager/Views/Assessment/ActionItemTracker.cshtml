        <div class="custom-kendo-grid" style="margin-top: 2em;">

            @(Html.Kendo().Grid<ActionItemTrackerModel>
    ()
    .Name("ActionItemTrackerGrid")
    .Columns(columns =>
    {
        columns.Bound(p => p.Id).Title("Action Item ID").Width(140);
        columns.Bound(p => p.AssessmentID).Hidden();
        //columns.Bound(p => p.ClientId).Hidden();
        columns.Bound(p => p.AssessmentName).Title("Assessment Name").Width(165).Filterable(ftb => ftb.Multi(true));
        columns.Bound(p => p.DisciplineName).Title("Discipline").Width(130).Filterable(ftb => ftb.Multi(true));
        columns.Bound(p => p.ComponentName).Title("Component").Width(130).Filterable(ftb => ftb.Multi(true));
        columns.Bound(p => p.AspectName).Title("Aspect").Width(130).Filterable(ftb => ftb.Multi(true));
        columns.Bound(p => p.ActionItem).Title("Action Item").Width(160).Filterable(false).HtmlAttributes(new { @style = "overflow: hidden;text-overflow: ellipsis;white-space: nowrap;" })
        .ClientTemplate("<div class=\"forTooltips1\">#=ActionItem#</div>");
        columns.Bound(p => p.ImplementationPlan).Title("Implementation Plan").Width(130).Filterable(ftb => ftb.Multi(true));
        columns.Bound(p => p.Priority).Title("Priority").Width(130).Filterable(ftb => ftb.Multi(true));
        columns.Bound(p => p.BusinessDriver).Title("Business Driver").Width(130).Filterable(ftb => ftb.Multi(true));
        columns.Bound(p => p.AMSCatalog).Title("AMS Catalog").Width(130).Filterable(ftb => ftb.Multi(true));
        columns.Bound(p => p.OwnerName).Title("Owner").Filterable(ftb => ftb.Multi(true)).Width(135);
        //columns.Bound(p => p.PlannedCompletionDate).Title("Planned Completion Date").Format("{0:MM/dd/yyyy }").Width(190).Filterable(true).HtmlAttributes(new { @style = "overflow: hidden;text-overflow: ellipsis;white-space: nowrap;" });
        columns.Bound(p => p.PlannedCompletionDate).Title("Planned Completion Date").Width(200).Format("{0:MM/dd/yyyy }").Filterable(true).HtmlAttributes(new { @style = "overflow: hidden;text-overflow: ellipsis;white-space: nowrap;" });
        columns.Bound(p => p.Status).Title("Status").Width(120).Filterable(ftb => ftb.Multi(true));
        columns.Bound(p => p.Benefits).Title("Benefits").Width(150).Filterable(false).HtmlAttributes(new { @style = "overflow: hidden;text-overflow: ellipsis;white-space: nowrap;" })
        .ClientTemplate("<div class=\"forTooltips3\">#=Benefits#</div>");

        columns.Bound(p => p.Comments).Title("Comments").Width(150).Filterable(false).HtmlAttributes(new { @style = "overflow: hidden;text-overflow: ellipsis;white-space: nowrap;" })
        .ClientTemplate("<div class=\"forTooltips2\">#=Comments#</div>");
        columns.Bound(p => p.ClientID).Title("Action").Width(120).Filterable(false).Sortable(false)
        .ClientTemplate("#if(data.Status!='Cancelled' && data.Status!='Completed'){#<div> <div style='display:flex;margin-left:-5px'><button class='bg-image' title='Add/Edit Action Item' style='background-image: url(" + @Url.Content("~/Content/images/edit_blue.svg") + "); background-repeat: no-repeat; width:10em;height:2em;margin-top: 3px;margin-left: 2em;color: rgb(91,121,171); cursor:pointer;text-align:center;border:none;text-indent: -14px;background-color: transparent;background-size: 1.38em;display: inline-grid;padding-right: 20px;' onclick='addoreditActionItem(#:Id#,\"#:PlannedCompletionDate#\",\"#:Status#\");'></button></div></div>#}#");
    })
