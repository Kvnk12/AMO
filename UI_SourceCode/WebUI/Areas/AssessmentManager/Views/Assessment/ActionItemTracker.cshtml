<script>

    $('.parameter-filter-icon').on('click', function () {
        $(this).addClass('open');
        $('.parameter-slider-overlay').addClass('open');
        $('.parameter-slider').addClass('open');
    });
    $('.close-parameters').on('click', function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');
    });
    $('.parameter-slider-overlay').click(function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        /*$('.parameter-slider').removeClass('open');*/
    });
    $('#btnPreview').click(function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');
        console.log("apply clicked");

        $("#ActionItemTrackerGrid").data("kendoGrid").dataSource.read();
        $("#ActionItemLogGrid").data("kendoGrid").dataSource.read();

    });




    function addoreditActionItem(Id,plannedDate,Status) {
        console.log(Id);
        console.log(plannedDate);
        var date = new Date(plannedDate);
        console.log("date " + date);

        var year = date.getFullYear();

        var month = (1 + date.getMonth()).toString();
        month = month.length > 1 ? month : '0' + month;

        var day = date.getDate().toString();
        day = day.length > 1 ? day : '0' + day;

        var plannedCompDate = month + '/' + day + '/' + year;

        console.log("plannedCompDate " + plannedCompDate);

        var datepicker = $('#PlannedCompletionDate').data("kendoDatePicker");
        if (plannedDate == null || plannedDate == "null") {

            datepicker.setOptions({
                min: new Date()
            });
        }
        else {
            datepicker.setOptions({
                min: plannedCompDate
            });
        }


        if (Status == "Cancelled" || Status == "Completed") {
            $('#PlannedCompletionDate').data("kendoDatePicker").enable(false);
        } else {
            $('#PlannedCompletionDate').data("kendoDatePicker").enable(true);
        }


        var mod = {
            ActionItemID: Id,
        }

         var data1 = JSON.stringify(mod);
        baseurl = '@Url.Content("~/AssessmentManager/Assessment/getActionItemRecord")';

        $.ajax({

            type: 'post',
            url: baseurl,
            async: false,
            data: data1,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                //$("#DisciplineGrid").data("kendoGrid").dataSource.read();
                //alert("Success");
               // console.log("Success");
               // $('#PlannedCompletionDate_alert').hide();
                // console.log(response);
                $("#Owner").data("kendoDropDownList").value(response.OwnerID);
                $("#Status").data("kendoDropDownList").value(response.Status);
                $('#Comments').val(response.Comments);
                $('#Benefits').val(response.Benefits);
                $('#PlannedCompletionDate').data("kendoDatePicker").value(response.PlannedCompletionDate);
                document.getElementById("temp").innerHTML = response.Id;
                document.getElementById("status").innerHTML = response.Status;
                document.getElementById("AsName").innerHTML = response.ActionItem;
                console.log("status"+ response.AssessmentStatus)
                if (response.AssessmentStatus == "Published") {
                    $("#Status").data("kendoDropDownList").enable(true);
                } else {
                    $("#Status").data("kendoDropDownList").enable(false);

                }
                var popup = $("#AddoreditpopUp").data("kendoWindow");
                popup.open();
                popup.center();
            },
            error: function (err, response) {
                // alert(err.responseText);
            }
        });




    }



    function onWinClose() {

    }


    function onSaveClick() {

        var Id = document.getElementById("temp").innerHTML;
        var OwnerID  = $("#Owner").data("kendoDropDownList").value();
        var Status   =  $("#Status").data("kendoDropDownList").value();
        var Comments = $('#Comments').val();
        var Benefits = $('#Benefits').val();
        var Actionitem = document.getElementById("AsName").innerHTML
        
        var PlannedCompletionDate =  $('#PlannedCompletionDate').data("kendoDatePicker").value();


        var mod = {
            Id: Id,
            OwnerID: OwnerID,
            Status: Status,
            Comments: Comments,
            Benefits: Benefits,
            PlannedCompletionDate: PlannedCompletionDate,
            Actionitem: Actionitem
        }

        var data1 = JSON.stringify(mod);
        baseurl = '@Url.Content("~/AssessmentManager/Assessment/SaveActionItem")';


        $.ajax({

            type: 'post',
            url: baseurl,
            async: false,
            data: data1,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                //alert("Success");
                console.log(response);

                var popup = $("#AddoreditpopUp").data("kendoWindow");
                popup.close();


                $("#ActionItemTrackerGrid").data("kendoGrid").dataSource.read();
                $("#ActionItemLogGrid").data("kendoGrid").dataSource.read();

                $('#saveAlertModal').modal('show');
                $('#lblErr').hide();
                $('#lblSuccess1').show();

            },
            error: function (err, response) {
                $('#saveAlertModal').modal('show');
                $('#lblSuccess1').hide();
                $('#lblErr').show();

                // alert(err.responseText);
            }
        });

    }
    function onChangeActionStatus() {
        //$('#PlannedCompletionDate_alert').hide();
        var Id = document.getElementById("temp").innerHTML;
        var oldstatus = document.getElementById("status").innerHTML;
        var Status   =  $("#Status").data("kendoDropDownList").value();
        var mod = {
            Id: Id,
            Status: Status
        }
        var data1 = JSON.stringify(mod);
        baseurl = '@Url.Content("~/AssessmentManager/Assessment/CheckActionIdeaStatus")';
        $.ajax({

            type: 'post',
            url: baseurl,
            async: false,
            data: data1,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                if (response == 'SubmitForRevision') {
                    $("#Status").data("kendoDropDownList").value(oldstatus);
                }
            },
            error: function (err, response) {

            }
        });

    }


    function onCancelClick() {
        var popup = $("#AddoreditpopUp").data("kendoWindow");
        popup.close();
    }


