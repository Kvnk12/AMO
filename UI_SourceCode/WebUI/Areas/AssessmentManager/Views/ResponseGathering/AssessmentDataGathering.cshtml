<div class="content-main dark-bg " style="padding: 0 30px 48px">
    <ol class="breadcrumb" style="font-size: 11px;">
        <li>Assessment Manager</li>
        <li class="active"> Assessment UI</li>
    </ol>
    <div class=" neweg-bg egdscreen" style="display:flex;">
        <label style="color: white; font-size: 12px;">Assessment : @Model.AssessmentName</label>
        <label style="color: white; font-size: 12px; margin-left: 12px; border-left: 1px dashed; padding-left: 10px;">Assessment Status : @Model.Status</label>
    </div>
    <div class="eng-que-quedrp">

        <label style="font-size:12px;color: white; padding-right: 1em; border-right: 1px solid #ffffff;">Question Identifier</label>

        <div style="display:flex">

            <div class="eng-ques-drpsec">
                <div class="eng-ques-drplbl">Discipline : </div>
                <div class="new-dropdown">
                    @(Html.Kendo().DropDownListFor(m => m.DisciplineId)
           .DataTextField("Text")
           .DataValueField("Value")
           .BindTo(Model.DisciplineList)
           .Enable(true)
           .Value(Model.DisciplineId.ToString())
           .Name("DisciplineId")
           .Events(e =>
           {
               e.Change("onChangeDscName");
           })
           .HtmlAttributes(new { style = "width:12vw;background-color:#fff;" })
                                )
                </div>
            </div>
            <div class="eng-ques-drpsec">
                <div class="eng-ques-drplbl">Component : </div>
                <div class="new-dropdown">
                    @(Html.Kendo().DropDownListFor(m => m.ComponentId)
           .DataTextField("Text")
           .DataValueField("Value")
           //.BindTo(Model.ComponentList)
           .Value(Model.ComponentId.ToString())
           .Enable(true)
           .Name("ComponentId")
           .Events(e =>
           {
               e.Change("onChangeCompName");
           })

           //.AutoBind(false)
           .DataSource(d => d.Read(r => r.Action("Readcomponent", "Assessment").Data("loadcomponent")))


           .HtmlAttributes(new { style = "width:12vw;background-color:#fff;padding-right: 0.2em;" })
                               )
                </div>
            </div>
            <div class="eng-ques-drpsec">
                <div class="eng-ques-drplbl">Aspect : </div>
                <div class="new-dropdown">
                    @(Html.Kendo().DropDownListFor(m => m.AspectID)
          .DataTextField("Text")
          .DataValueField("Value")
          //.BindTo(Model.AspectList)
          .Value(Model.AspectID.ToString())
          .Enable(true)

           .Events(e =>
           {
               e.Change("onChangeAspName");
           })
           // .AutoBind(false)
           .DataSource(d => d.Read(r => r.Action("ReadAspect", "Assessment").Data("loadAspect")))
          .HtmlAttributes(new { style = "width:12vw;background-color:#fff;" })
           )
                </div>
            </div>
            <div style="padding-left: 2em;  border-left: 1px solid #ffffff;"></div>
            <div style="display: flex; justify-content: flex-end; margin-top: 0.3vw; margin-right: -2vw; ">

                <button style=" width: 5vw; font-size: 0.95vw; margin-right: 1em; margin-left: -7px;" class="custom-button " type="button" onclick="onChangeADCName()"> APPLY </button>
                <button style="width: 5vw; color: #fff; font-size: 0.9vw; margin-top: 2px; margin-right: 1em; background-image: url(../../Content/images/revise.svg); background-repeat: no-repeat; border: none; background-color: transparent; padding-left: 1vw; background-size: 0.9vw; background-position: left;" class="custom-button" type="button" onclick="onclearADCName()">CLEAR</button>
            </div>
        </div>
    </div>
