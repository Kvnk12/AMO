<script>
    var GunAnswered = true;
    var GResponseInProgress = true;
    var GResponsed = true;
    var GRatingInProgress = true;
    var GCompleted = true;
    var GisChanged = false;
    var Ggroupname = "";
    $(document).ready(function () {

        $('#RefFiles').attr('title', '');
        var elementsload = document.getElementsByClassName("eng-res-texteditor");
        console.log("document ready function" + elementsload);
        console.log(elementsload.length);
        $('.main-response iframe').contents().find('body').css({
            'color': 'white'
        });
        $('.firstresponseclass iframe').contents().find('body').css({
            'color': 'black'
        });
        if (elementsload.length != 0) {
            for (var i = 0; i < elementsload.length; i++) {

                $($('#' + elementsload[i].id).data().kendoEditor.body).attr('contenteditable', false);
            }

        }

        var Status = @Html.Raw(Json.Encode(Model.Status));

        if (Status == 'Analysis' || Status == 'Review') {
            $("#ImplementationPlan").data("kendoDropDownList").enable(true);
            $("#BusinessDriver").data("kendoDropDownList").enable(true);
            $("#Priority").data("kendoDropDownList").enable(true);
            $("#AMSCatalog").data("kendoDropDownList").enable(true);

        }
        else {
            $("#ImplementationPlan").data("kendoDropDownList").enable(false);
            $("#BusinessDriver").data("kendoDropDownList").enable(false);
            $("#Priority").data("kendoDropDownList").enable(false);
            $("#AMSCatalog").data("kendoDropDownList").enable(false);

        }



        var responseStatus = @Html.Raw(Json.Encode(Model.responseStatus));

        if (responseStatus == 'Unanswered' || responseStatus == 'ResponseInProgress' || responseStatus == 'Completed') {
            document.getElementById('btnrating').disabled = true;
        }
        else {
            document.getElementById('btnrating').disabled = false;
        }



        var addfollowuplbl = document.getElementById('btn-followup-add');
        if (addfollowuplbl != null) {
            if (responseStatus == 'Responded' || responseStatus == 'RatingInProgress') {
