    document.addEventListener('DOMContentLoaded', function () {
        const buttonContainer = document.querySelector('.assess-dg-Ar-ratingButtons');
        const colors = ['#FF0D0D', '#FF8E15', '#FAB733', '#ACB334', '#69B34C'];
        const tooltips = ['Components unpredictable, poorly managed and/or reactive', 'Components identified for the engagement are often reactive', 'Components characterized for the engagement and is proactive', 'Components outcome are measured and controlled', 'Components focuses on improvement'];
        for (let i = 0; i < colors.length; i++) {
            const button = document.createElement('button');
            button.textContent = `${i + 1}`;
            button.classList.add('assess-ratingButton');
            button.id = `assessRt${i + 1}`;
            button.style.backgroundColor = colors[i];
            button.title = tooltips[i];
            //button.onclick = engagementRatingSelection(`${i + 1}`);
            //button.click = engagementRatingSelection(`${i + 1}`);
            button.style.borderColor = colors[i];
            button.setAttribute("onclick", "assessmentRatingSelection(" + `${i + 1}` + ");");
            buttonContainer.appendChild(button);

        }
        const buttonNA = document.createElement('button');
        buttonNA.textContent = 'NA';
        buttonNA.classList.add('assess-ratingButton');
        buttonNA.id = 'engrtNA';
        buttonNA.style.backgroundColor = '#72A0C1';
        buttonNA.title = 'Not Applicable';
        buttonNA.style.borderColor = '#72A0C1';
        buttonNA.style.width = '1.2em';
        buttonNA.setAttribute("onclick", "assessmentRatingNASelection();");
        buttonContainer.appendChild(buttonNA);
    });

    function assessmentRatingSelection(rat) {
        console.log("before setting", rat);
        $("#AssessmentRatingSelectedVal").val(rat);
        console.log("after setting ", $("#AssessmentRatingSelectedVal").val());

        document.getElementById('assessmentRatingSelectedInfo').style.visibility = 'visible';
        document.getElementById('assessRatingNo').innerHTML = rat;

        document.getElementById('matContentInfo').style.visibility = 'visible';
        if (rat == 1) {
            document.getElementById('matContent').innerHTML = "Components unpredictable, poorly managed and/or reactive";

        }
        if (rat == 2) {
            document.getElementById('matContent').innerHTML = "Components identified for the engagement are often reactive";

        }
        if (rat == 3) {
            document.getElementById('matContent').innerHTML = "Components characterized for the engagement and is proactive";

        }
        if (rat == 4) {
            document.getElementById('matContent').innerHTML = "Components outcome are measured and controlled";

        }
        if (rat == 5) {
            document.getElementById('matContent').innerHTML = "Components focuses on improvement";

        }


    }

