            @Html.Partial("_QuestionNavigation")
        </div>

        <div class="ques-detail">
            <div class="ques-detail-head">
                Details
            </div>
            <div class="ques-detail-content">
                @Html.Partial("_AssessmentViewQuestionDetail")
            </div>
        </div>
    </div>


