            $(".arrow2").addClass("down");
            $('.blockB').css('display', 'none')
            $(".blockB").removeClass("active");

            $('.blockC').css('display', 'none')
            $(".arrow3").addClass("down")
            $(".blockC").removeClass("active")

            $('.blockE').css('display', 'none')
            $(".arrow5").addClass("down")
            $(".blockE").removeClass("active")
        } else if (grpsec == 'comp') {
            $(".blockE").addClass("active");
            $('.blockE').css('display', 'block')
            $(".arrow5").removeClass("down");
            Ggroupname = "Completed";

            $(".arrow1").addClass("down");
            $('.blockA').css('display', 'none')
            $(".blockA").removeClass("active");

            $(".arrow2").addClass("down");
            $('.blockB').css('display', 'none')
            $(".blockB").removeClass("active");

            $('.blockC').css('display', 'none')
            $(".arrow3").addClass("down")
            $(".blockC").removeClass("active")

            $('.blockD').css('display', 'none')
            $(".arrow4").addClass("down")
            $(".blockD").removeClass("active")
        }

    }

