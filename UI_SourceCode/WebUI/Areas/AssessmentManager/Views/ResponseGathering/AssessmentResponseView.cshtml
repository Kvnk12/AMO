<script>


    $(document).ready(function () {

        $('#RefFiles').attr('title', '');
        var responseStatus = @Html.Raw(Json.Encode(Model.Response));

         var loadedSQno =@Html.Raw(Json.Encode(Model.SQNo));
         $(".pager-btn").removeClass("ques-selected");
         $("#Quesid_" + loadedSQno).addClass("ques-selected");
         var grpsec = $("#Quesid_" + loadedSQno).attr('data-grp');
         callleftQuestionNavigation(grpsec);
    });
    var isdrpchanged = 0;
    var isdiscChanged = 0;
    var iscompChanged = 0;
    var isAspChanged = 0;
    var GDisciplineId = 0;
    var GComponentId = 0;
    var GAspectID = 0;
    function onChangeDscName() {
        isdiscChanged = 1;
        iscompChanged = 0;
        isAspChanged = 0;
        $("#ComponentId").data("kendoDropDownList").dataSource.read();
        $("#AspectID").data("kendoDropDownList").dataSource.read();
        GDisciplineId = $("#DisciplineId").data("kendoDropDownList").value();
    }
    function onChangeCompName() {
        isdiscChanged = 0;
        iscompChanged = 1;
        isAspChanged = 0;
        $("#AspectID").data("kendoDropDownList").dataSource.read();
        GComponentId = $("#ComponentId").data("kendoDropDownList").value();
    }
    function onChangeAspName() {
        isdiscChanged = 0;
        iscompChanged = 0;
        isAspChanged = 1;
        GAspectID = $("#AspectID").data("kendoDropDownList").value();
    }
    function onChangeADCName() {
         isdrpchanged = 1;

     var DisciplineId = $("#DisciplineId").data("kendoDropDownList").value();
     var ComponentId = $("#ComponentId").data("kendoDropDownList").value();
     var AspectID = $("#AspectID").data("kendoDropDownList").value();
     var mod = {
         AssessmentID: @Model.AssessmentID,
         DisciplineId: DisciplineId,
         ComponentId: ComponentId,
         AspectID: AspectID,
         isdiscChanged: isdiscChanged,
         iscompChanged: iscompChanged,
         isAspChanged: isAspChanged

			};

			var data1 = JSON.stringify(mod);
			baseurl1 = '@Url.Content("~/AssessmentManager/ResponseGathering/GetAssessmentTypeWithACD")';

         $.ajax(
             {
                 url: baseurl1,
                 type: 'post',
                 data: data1,
                 async: false,
                 contentType: 'application/json; charset=utf-8',
                 success: function (data) {
                     //console.log(data);
                     $('#Id-ques-navigation-main').html(data);
                     var assId = document.getElementById("AssessmentId").value;
                     var sqno = document.getElementById("nav-Sqno-id").value;

                    // console.log(sqno, assId);
                     pageSelectalert(sqno, assId);
