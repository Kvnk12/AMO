    .eng-ratingButton {
        position: relative; /* This allows us to position the pseudo-elements relative to the button */
        padding: 8px 16px;
        background-color: #f0f0f0;
        outline: none;
        cursor: pointer;
        font-weight: bold;
        margin-right: 2em;
        border-radius: 4px;
        height: 1.5em;
        width: 0.5em;
        color: white;
        border: none;
        text-align: center;
    }

        .eng-ratingButton::before {
            content: '';
            position: absolute;
            pointer-events: none; /* This ensures the pseudo-elements don't interfere with button interaction */
            transition: all 0.3s ease; /* Smooth transition for hover and click effects */
        }



        .eng-ratingButton::after {
            content: '';
            position: absolute;
            pointer-events: none; /* This ensures the pseudo-elements don't interfere with button interaction */
            transition: all 0.3s ease; /* Smooth transition for hover and click effects */
        }

        .eng-ratingButton::before,
        .eng-ratingButton::after {
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
        }

        .eng-ratingButton:hover::before {
            top: -3px;
            left: -3px;
            right: -3px;
            bottom: -3px;
            border: 2px solid #000;
            border-radius: 6px;
        }

        .eng-ratingButton:hover::after {
            top: -7px;
            left: -7px;
            right: -7px;
            bottom: -7px;
            border: 2px dashed #000;
            border-radius: 8px;
        }

        .eng-ratingButton.clicked::before {
            top: -3px;
            left: -3px;
            right: -3px;
            bottom: -3px;
            border: 2px solid #000;
            border-radius: 6px;
        }

        .eng-ratingButton.clicked::after {
            top: -7px;
            left: -7px;
            right: -7px;
            bottom: -7px;
            border: 2px dashed #000;
            border-radius: 8px;
        }
