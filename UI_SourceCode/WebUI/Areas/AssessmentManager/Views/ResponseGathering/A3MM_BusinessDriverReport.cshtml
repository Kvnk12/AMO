<div class="custom-popup-grid modal fade" id="A3MMPopUp" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-popup-title">
                <label class="custom-white-label" id="A3MMPopLabel"></label>
                <button type="button" class="close" title="Close" @*onclick="onModalclose()"*@ data-bs-dismiss="modal">&times;</button>
            </div>

            <div class="modal-body">
                @*<label>Welcome to popup</label>*@
                <div class="custom-kendo-grid report-drilldowm">
                    @(Html.Kendo().Grid<A3MMModel>
    ()
    .Name("GridA3MM_MaturityData")
    .Columns(columns =>
    {
        columns.Bound(e => e.AssessmentName).Title("AssessmentName").Width(250);
        //columns.Bound(p => p.SurveyTypeID).ClientTemplate("#if (data.SurveyTypeID=='2') {#<div>A3MM</div> #} else {#<div>IVV</div>#}#").Title("SurveyTypeID ID").Width(75);
        columns.Bound(p => p.AspectName).Title("Aspect Name").Width(100);
        columns.Bound(p => p.MaturityLevel).Title("MaturityLevel").Width(75).Filterable(ftb => ftb.Multi(true));
        columns.Bound(p => p.Response).Title("Action Item").Width(351);




    })
    .ToolBar(tools =>
    {
        tools.Excel().Text("Export -");
    })
    .Scrollable(e => e.Endless(true))
    .Filterable()
    .Pageable()
    .Sortable()
    .Groupable()
    .Excel(excel => excel.FileName("Consolidated_DrillDown_Report.xlsx")
    .Filterable(true)
    .AllPages(true)
    .ProxyURL(Url.Action("Export_Tickets_Save", "ConfigureReport"))
    )
    .Resizable(r => r.Columns(true))
    .DataSource(dataSource => dataSource
    .Ajax()
    .PageSize(100)
    .Model(model =>
    {
        model.Id(p => p.Id);

    })
    .Read(read => read.Action("GetAssessmentDetails", "Assessment").Data("GetMaturityReportParameters"))
    )
    )

                </div>
            </div>
        </div>
    </div>
</div>
