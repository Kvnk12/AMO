<script>
    $('.custom-multiselect-dropdown').multiselect({
        maxHeight: 200,
        numberDisplayed: 1,
        includeSelectAllOption: true,
        includeResetOption: true
    });
    $(".custom-multiselect-dropdown").multiselect('selectAll', true);
    $(".custom-multiselect-dropdown").multiselect('updateButtonText');

    $('.parameter-filter-icon').on('click', function () {
        $(this).addClass('open');
        $('.parameter-slider').addClass('open');
        $('.parameter-slider-overlay').addClass('open');
    });
    $('.close-parameters').on('click', function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');
    });
    $('.parameter-slider-overlay').click(function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        /*$('.parameter-slider').removeClass('open');*/
    });
    $('#btnPreview').click(function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');

    });

    $('#btnDrilldown').click(function () {
        $('.parameter-filter-icon').removeClass('open');
        $('.parameter-slider-overlay').removeClass('open');
        $('.parameter-slider').removeClass('open');

    });

    $('#btnPreview').on("click", function (e) {
        // var multi = $("#Contract").data("kendoMultiSelect").value();
        RefreshReport();
    });


    $('#btnDrilldown').on("click", function (e) {
        // var multi = $("#Contract").data("kendoMultiSelect").value();

        var avg_MaturityLevel = "1";
        var AssessmentName = "AssessmentName";
        var Component_ID = "1";
        var ComponentName = "ComponentName";
        var Assessment_id = "75";
        document.getElementById("avg_MaturityLevel").value = avg_MaturityLevel;
        document.getElementById("AssessmentName").value = AssessmentName;
        document.getElementById("Assessment_id").value = Assessment_id;
        document.getElementById("Component_ID").value = Component_ID;
        document.getElementById("ComponentName").value = ComponentName;
        document.getElementById('A3MMPopLabel').innerHTML = " " + AssessmentName + " Details  ";
        var gridp = $("#GridA3MM_MaturityData").data("kendoGrid");
        gridp.dataSource.read();
        $('#A3MMPopUp').modal('show');




    });


    function onAccountchange() {
        alert('onAccountchange')
    }
    function RefreshReport() {
        
    //SaveReportParameters(TypectrlSel, StatusctrlSel, PriorityctrlSel, GroupctrlSel, TowerctrlSel, WaiveOption);
        var viewer = $("#reportViewerA3MM_MaturityLevelCompare").data("telerik_ReportViewer");

        console.log(@clientId);
        if (viewer !== undefined) {
                viewer.reportSource({
                    report: viewer.reportSource().report,
                    parameters: {


                        DisciplineID: '',//'Closed',
                        ComponentID: '',
                        Assessmentid: $("#Assessment").val(),
                        UserName: '@Model.UserName',
                        DateTimeNow:'@Model.CreatedDt',
                        Assessmentids: $('#Assessment').val().toString(), //assessString
                        ClientId:@clientId
                  }
                });

        }
        //setting the HTML5 Viewer's reportSource, causes a refresh automatically
        //if you need to force a refresh for other case, use:
        viewer.refreshReport();

    }
    function GetAccId() {

        var app = $("#Account").data("kendoDropDownList");
        return {
            Accid: app.value()
        }
    }
    function onAccountchange(e) {
        var app = $("#Account").data("kendoMultiSelect");
        app.dataSource.read();
    }

    $('#Account').on("change", function (e) {
        // var multi = $("#Contract").data("kendoMultiSelect").value();
        AccountChange();
    });

    function AccountChange(Accarr) {

        //Ajax call begin

        var Accarr1 = $('#Account').val();

        var model = {
            AccountDropDown: Accarr1,

        };
        var data = JSON.stringify(model);

        $.ajax(
            {
                type: 'post',

                url: 'OnAccountChanged',
                data: data,
                async: true,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    //                    alert('Success');
                },
                error: function (err, data) {
                    console.log(arguments);
                    //                    alert('Ajax Error');
                }

            });
        //Ajax end

    }
    function InteractiveEnter(e, args) {
        if (args.action.Type === 'customAction') {
            color = $(args.element).css("background-color");
            $(args.element).css({ 'font-weight': 'bolder', 'background-color': '#d1d1d1' });
        }
    }

    function interactiveActionConsolidated(e, args) {
        if (args.action.Type === 'customAction') {

            console.log("argument" + args);
            var avg_MaturityLevel = "";
            var AssessmentName = null;
            var Component_ID = "";
            var ComponentName = "";
            var Assessment_id = ";"







            if (args.action.Value.Parameters[0] != undefined) {
                avg_MaturityLevel = args.action.Value.Parameters[0].Value;
                console.log("avg_MaturityLevel is " + avg_MaturityLevel);

            }
            if (args.action.Value.Parameters[1] != undefined) {
                AssessmentName = args.action.Value.Parameters[1].Value;
                console.log("AssessmentName is " + AssessmentName);

            }
            if (args.action.Value.Parameters[2] != undefined) {
                Component_ID = args.action.Value.Parameters[2].Value;
                console.log("Component_ID is " + Component_ID);


            }
            if (args.action.Value.Parameters[3] != undefined) {
                ComponentName = args.action.Value.Parameters[3].Value;
                console.log("ComponentName is " + ComponentName);

            }
            if (args.action.Value.Parameters[4] != undefined) {
                Assessment_id = args.action.Value.Parameters[4].Value;
                console.log("Assessment_id is " + Assessment_id);






















            }




            document.getElementById("avg_MaturityLevel").value = avg_MaturityLevel;
            document.getElementById("AssessmentName").value = AssessmentName;

            document.getElementById("Assessment_id").value = Assessment_id;
            document.getElementById("Component_ID").value = Component_ID;
            document.getElementById("ComponentName").value = ComponentName;


            document.getElementById('A3MMPopLabel').innerHTML = " " + ComponentName + " Details  ";









            var gridp = $("#GridA3MM_MaturityData").data("kendoGrid");
            gridp.dataSource.read();
            $('#A3MMPopUp').modal('show');
        }
    }


    function InteractiveLeave(e, args) {
        if (args.action.Type === 'customAction') {
            //$(args.element).css({ 'font-weight': 'normal', 'background-color': '#EEF4FB' });
            $(args.element).css({ 'font-weight': 'normal', 'background-color': color });

        }
    }
    function GetMaturityReportParameters(e) {


        return {
            ComponentName: document.getElementById("ComponentName").value,
            Component_ID: document.getElementById("Component_ID").value,
            Assessment_id: $('#Assessment').val().toString(),
            AssessmentName: document.getElementById("AssessmentName").value,
            avg_MaturityLevel: 1

        };
    }










    function getWhereClause() {
        var Accarr2 = $('#Account').val();





        console.log(Accarr2);
        return {
            AccountDropDown: Accarr2
        };

    }



</script>