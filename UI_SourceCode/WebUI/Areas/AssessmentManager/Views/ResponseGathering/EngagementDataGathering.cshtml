    function buttonEngagementSelfAssessment() {
        console.log(ischanged)
        if (ischanged == true) {
            $('#ChangesuploadAlertModal').modal('show');
        } else {
            var responseID = $('#responseIDOnQuesClick').text();

            var mod = {
                responseID: responseID,

            }

            var data1 = JSON.stringify(mod);

            baseurl = '@Url.Content("~/AssessmentManager/ResponseGathering/GetSelfAssessmentDetailsForResponse")';



            $.ajax({

                type: 'post',
                url: baseurl,
                async: false,
                data: data1,
                contentType: 'application/json; charset=utf-8',
                success: function (detail) {
                    //alert("Success");
                    console.log(detail);



                    if (detail.responseStatus == 'Completed' || detail.responseStatus == 'RatingInProgress' || detail.responseStatus == 'Responded') {
                        document.getElementById("selfAssessmentbtn").disabled = true;
                        $('#selfAssessmentSaveAlertModal').modal('show');
                        $('#engagementSASuccessLabel').hide();
                        $('#lblError1').hide();
                        $('#lblError2').show();
                    }
                    else {
                        document.getElementById("selfAssessmentbtn").disabled = false;
                        var popup = $("#engagementSelfAssessmentpopUp").data("kendoWindow");
                        //console.log(popup);
                        //$('.k-window-title').text("Add KEDB");
                        popup.open();
                        popup.center();
                    }

                    if (detail.engagementComments != null) {
                        $('#EngagementSAComments').val(detail.engagementComments);
                    }

                    if (detail.EngagementRating != null) {
                        document.getElementById('ratingSelectedInfo').style.visibility = 'visible';
                        document.getElementById('ratingNo').innerHTML = detail.EngagementRating;
                        $("#engagementRatingSelected").val(detail.EngagementRating);
                    }
                    else {
                        document.getElementById('ratingSelectedInfo').style.visibility = 'hidden';
                        $("#engagementRatingSelected").val(0);
                    }



                },
                error: function (err, response) {
                    console.log("error " + err);
                    $('#selfAssessmentSaveAlertModal').modal('show');
                    $('#engagementSASuccessLabel').hide();
                    $('#lblError2').hide();
                    $('#lblError1').show();
                    onCancelSelfAssessment();
                    $("#engagementRatingSelected").val(0)
                    // alert(err.responseText);
                }
            });

        }
    }

    function engagementRatingSelection(rat) {
         console.log("before setting", rat);
         $("#engagementRatingSelected").val(rat);
         console.log("after setting ", $("#engagementRatingSelected").val());
         document.getElementById('ratingSelectedInfo').style.visibility = 'visible';
         document.getElementById('ratingNo').innerHTML = rat;

        document.getElementById('matContentInfo').style.visibility = 'visible';
        if (rat == 1) {
            document.getElementById('matContent').innerHTML = "Components unpredictable, poorly managed and/or reactive";

        }
        if (rat == 2) {
            document.getElementById('matContent').innerHTML = "Components identified for the engagement are often reactive";

        }
        if (rat == 3) {
            document.getElementById('matContent').innerHTML = "Components characterized for the engagement and is proactive";

        }
        if (rat == 4) {
            document.getElementById('matContent').innerHTML = "Components outcome are measured and controlled";

        }
        if (rat == 5) {
            document.getElementById('matContent').innerHTML = "Components focuses on improvement";

        }
        }


