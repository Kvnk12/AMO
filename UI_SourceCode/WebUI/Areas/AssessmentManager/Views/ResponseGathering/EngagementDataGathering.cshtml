<script>
    var GunAnswered=true;
    var GResponseInProgress =true;
    var GResponsed =true;
    var GRatingInProgress =true;
    var GCompleted=true;
    var GisChanged = 0;
    var Ggroupname = "Incompleted";

    $(document).ready(function () {
        var loadedSQno =@Html.Raw(Json.Encode(Model.SQNo));
              $(".pager-btn").removeClass("ques-selected");
              $("#Quesid_" + loadedSQno).addClass("ques-selected");
              var grpsec = $("#Quesid_" + loadedSQno).attr('data-grp');
              callleftQuestionNavigation(grpsec);


        $('#RefFiles').attr('title', '');
        var elementsload = document.getElementsByClassName("eng-res-texteditor");
        console.log("document ready function" + elementsload);
        console.log(elementsload.length);
        $('.main-response iframe').contents().find('body').css({
            'color': 'white'
        });
        $('.firstresponseclass iframe').contents().find('body').css({
            'color': 'black'
        });
        if (elementsload.length!=0) {
            for (var i = 0; i < elementsload.length; i++) {

                $($('#' + elementsload[i].id).data().kendoEditor.body).attr('contenteditable', false);
            }

        }


        var responseStatus = @Html.Raw(Json.Encode(Model.Response));
        var markAsCompletecheckBox = @Html.Raw(Json.Encode(Model.responseStatus));
        if (markAsCompletecheckBox == 'Completed' || markAsCompletecheckBox == 'RatingInProgress' || markAsCompletecheckBox == 'Responded') {
            console.log("response status on Question click : ", responseStatus);

            var elements = document.getElementsByClassName("editdisablebtn");

            for (var i = 0; i < elements.length; i++) {
                document.getElementById(elements[i].id).disabled = true;
            }

