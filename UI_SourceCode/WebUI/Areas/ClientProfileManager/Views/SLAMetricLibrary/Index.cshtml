    function getServiceId() {
       /* alert("get param");*/
        var serviceName = document.getElementById("tempSName").innerHTML;
        var serviceCatName = document.getElementById("tempSCatName").innerHTML;
       
        console.log("tempSName is " + serviceName);
        console.log("tempSCatName is " + serviceCatName);
      


        return {
