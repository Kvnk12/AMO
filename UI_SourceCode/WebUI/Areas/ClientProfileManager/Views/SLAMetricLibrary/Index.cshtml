                success: function (data) {
                   /* var popup = $("#chartSLACreateWindow").data("kendoWindow");*/

                    document.getElementById('metric-menu').insertAdjacentHTML("beforeend",
                        "<label style='margin-left:5em'>Metric Catalog  : </label>" + data.ServiceCategory + " > " + data.Service + " > " + MetricName);

                    $("#SLAGrid1").data("kendoGrid").dataSource.read();
