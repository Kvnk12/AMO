<div class="content-main">
    @using (Html.BeginForm("ClientDetails", "TicketInfo", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
<div class="container" style="padding: 0;">
    <div class="treeMenuArea tab-pane opened" id="treeMenuArea">
        <div class="treeMenuContent" style="min-height: 700px">
            <div class="well well-sm"><strong>Client Details</strong></div>
            <div id="grid">
                <div class="k-header k-grid-toolbar">
                    <a id="k-grid-Export" class="k-button k-button-icontext k-grid-ExporttoExcel" role="button" href="#">Export to Excel</a>
                </div>
            </div>
            <div>
                <label>Ticket Info</label>

