    .Name("grid2")
    .Columns(columns =>
    {
        columns.Bound(p => p.FromDate).Format("{0:MM/dd/yyyy HH:mm:ss}"); ;
        columns.Bound(p => p.Todate).Format("{0:MM/dd/yyyy HH:mm:ss}");
        columns.Bound(p => p.TicketInfoType);
        columns.Bound(p => p.Incidents).HtmlAttributes(new { @style = "text-align:right;" });
        columns.Bound(p => p.Problems).HtmlAttributes(new { @style = "text-align:right;" });
        columns.Bound(p => p.UserSupportSR).HtmlAttributes(new { @style = "text-align:right;" });
        columns.Bound(p => p.Enhancements).HtmlAttributes(new { @style = "text-align:right;" });
        columns.Bound(p => p.Comments).HtmlAttributes(new { @style = "text-align:right;" });

    })
    .Groupable()
    .Pageable()
    .Scrollable()
    .HtmlAttributes(new { style = "height:750px;" })

    //.Excel(excel => excel
    //    .FileName("Kendo UI Grid Export.xlsx")
    //    .Filterable(true)
    //    .ProxyURL(Url.Action("Excel_Export_Save", "Grid"))
    //)

    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(16)
        .Group(g => g.Add(p => p.FromDate))
        .Group(g=>g.Add(p=>p.Todate))
        .Read(read => read.Action("Excel_Export_Read", "TicketInfo"))

    )
                    )
                @*@Html.Partial("_ClientTicketInfo", Model.ClientTicketInfoList)*@



            </div>
        </div>
    </div>
</div>}

