                          data-tSev2="@x.TotalSev2" data-tSev3="@x.TotalSev3" data-tSev4="@x.TotalSev4"
                          onmouseover="hoverfunc(this);" onmouseout="close();">
                        @naaaame
                    </span>
                    <br />


                }
            </div>

