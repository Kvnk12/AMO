    //    //    var template = "<ul>";
    //    //    for (var i = 0; i < data.Products.length; i++) {
    //    //        var product = data.Products[i];
    //    //        template += kendo.format("<li>Product: {0}, Price: {1:c} </li>", product.ProductName, product.Price);
    //    //    }
    //    //    template += "</ul>"
    //    //    return template;
    //    //}
    //}

   

</script>
