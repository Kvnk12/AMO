                $(".k-grid-add").removeAttr("href");
            }
        });

    }


    function validateidentifier(obj)
    {
        //alert("fdzgzdg");
        var actionurl = '@Url.Content("~/ClientProfileManager/Survey/IsQuesIdExist")';
        var x = obj.value;
        var y =  @Model.Id;
        //alert(x);
        $.ajax({
            url: actionurl,
            type: "POST",
            async: false,
            data: {

                QuestionIdentifier: x,
                surveyId :y,

                  },
            error: function (response)
            {
                alert('error');
            },
            success: function (response) {
                if (response == false)
                {
                    $('#QuestionIdentifier').val('');
                    alert("Question Identifier already exist in database. Please select unique Question Identifier.");
                    return false;
                }
                else
                {
                    return true;
                }
            }
        });
    }

    //sortable rows
    var noHint = $.noop;
    function placeholder(element) {
        return element.clone().addClass("k-state-hover").css("opacity", 0.65);
    }

    function onChange(e) {
        var grid = $("#QuestionGrid").data("kendoGrid"),
            skip = grid.dataSource.skip(),
            oldIndex = e.oldIndex + skip,
            newIndex = e.newIndex + skip,
            data = grid.dataSource.data(),
            dataItem = grid.dataSource.getByUid(e.item.data("uid"));

        grid.dataSource.remove(dataItem);
        grid.dataSource.insert(newIndex, dataItem);
        fdata = grid.dataSource.data();
         }
</script>

<style>
    .k-grid tbody tr {
        cursor: move;
    }
</style>








