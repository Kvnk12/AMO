                            <td>
                                @(Html.Kendo().TextBoxFor(m => m.CreatedByName)
.Name("CreatedByName")
.Enable(false)
                                )
                            </td>
                        </tr>

                    </table>
                    <br />
                    <br />
                    <div>

                    </div>
                    @*<div class="right" style="margin-right:55px">
                            <button type="submit" id="btnUpload" class="btn btn-primary" tabindex="30">Clone Survey</button>
                        </div>*@
                </td>
            </tr>
        </table>
        <div class="k-edit-buttons k-state-default">
            <button type="submit" id="btnUpload" class="btn btn-primary" tabindex="30">

                <span class="k-icon k-i-check">
                </span>
