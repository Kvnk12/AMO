
@using WebUI.Areas.ClientProfileManager.Dto
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@using NTTData.AMOPortal.Domain.Entities;
@using WebUI.Areas.ClientProfileManager.Controllers;
@model Survey_Model
@using WebUI.Dto; 

@{
    ViewBag.Title = "SurveyViewModel";
    var dictionary = new Dictionary<string, string>
    {
          { "Rating", "Rating" },
          { "Dynamic","Dynamic" }
//          { "APR", "Rating" },
//    { "Cloud Migrator", "Cloud Migrator" },
//    { "RA", "RA" },
//    { "General", "General" },
//    { "APR2","Dynamic" }

    };
  //  var client = (Client)Session["Client"];
    ClientDetail client = (ClientDetail)Session["SessionClient"];
    int usid = (int)Session["UserId"];
    var v = new PerspectiveConfigurationController();

    var ApplicationList = v.ApplicationList(client.ClientId, usid);

}
