                            <td>
                                @(Html.Kendo().NumericTextBoxFor(e => e.EndDay)
.Name("EndDay")
//.Format("n")
.Spinners(false)

                                        //.HtmlAttributes(new { rows = "5", tabindex = "5", style = "width:70%"})
                                )
                            </td>
                        </tr>

                        <tr>
