                        </tr>

                        <tr>
                            <td><br /></td>
                        </tr>

                        <tr>
                            <td style="width: 40%">
                                <span>Tool Name: </span>
                            </td>
                            <td>
                                @Html.DropDownListFor(m => m.ToolId, new SelectList(ViewData["ToolList"] as IEnumerable<SelectListItem>, "Value", "Text", Model.ToolId), "Select Tool Type", new { @class = "k-dropdown k-dropdown-wrap k-state-default", style = "width: 71%;height: 2.94em;border: none;border-bottom: 1px solid #c3bfbf;border-radius: unset; " })


                                @*@(Html.Kendo().DropDownListFor(m => m.ToolId)
.Name("ToolId")
.OptionLabel("Select")
.DataTextField("Text")
.DataValueField("Value")
//.Events(e => e.Change("SurveyTypeChange"))
.BindTo(ApplicationList)

                                )*@
                            </td>
                        </tr>

                        <tr>
                            <td><br /></td>
                        </tr>
                        <tr>
