<script type="text/javascript">


        function OpenModalWindow(f) {
            //alert(f);
            //var actionurl1 = '@Url.Content("~/ClientProfileManager/ClientTicketInfo/getTicketInforForId")';
            var _d = f;




            window.location.href = '@Url.Content("~/ClientProfileManager/ClientTicketInfo/getTicketInforForId")?_id=' + _d;

            //alert(x);
            //$.ajax({
            //    url: actionurl,
            //    type: "POST",
