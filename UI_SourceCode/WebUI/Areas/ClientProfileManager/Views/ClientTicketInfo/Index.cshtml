            //    data: {
            //        _id: d,
            //    },
            //    error: function (response) {

            //        alert('Error.');
            //    },
            //    success: function (response) {

            //    }
            //});
        }






        function btnDelClick(id)
        {
            //alert('asd');
           // var tktinfoid = id;
            //alert(id);
            var actionurl = '@Url.Content("~/ClientProfileManager/ClientTicketInfo/DeleteTicketInfo")';
            var d = id;

            //alert(x);
            $.ajax({
                url: actionurl,
                type: "POST",
                async: false,
                data: {
                    did: d,
                },
                error: function (response)
                {

                    alert('Could not delete the Ticket detail.');
                },
                success: function (response) {
                    $('#grid').data('kendoGrid').dataSource.read();
                    $('#grid').data('kendoGrid').refresh();
                }
            });
            //refresh grid false; u need to call delete action by passing this id and refresh the grid
        }

        function grid_error(e) {
            // alert('err');
            if (e.errors) {
                var message = "Error occurred:\n";
                // Create a message containing all errors.
                $.each(e.errors, function (key, value) {
                    if ('errors' in value) {
                        $.each(value.errors, function () {
                            message += this + "\n";
                        });
                    }
                });
                // Display the message.
                alert(message);
                // Cancel the changes.
                $('#grid').data('kendoGrid').dataSource.read();
                $('#grid').data('kendoGrid').refresh();
            }
        }


</script>
