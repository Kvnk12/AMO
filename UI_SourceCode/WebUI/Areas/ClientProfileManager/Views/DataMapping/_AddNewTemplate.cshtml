<style>
    hr {
        color: rgb(91,121,171);
        border-top: dashed 1.5px;
        width: 63em;
        margin-left: 13px;
    }



    #btnUpload {
        background-color: rgb(91,121,171);
        color: white;
        font-size: 12px;
        width: fit-content;
        vertical-align: middle;
        border-radius: 4px;
        border: none;
        padding: 0.4em 1em;
        /*margin-left: 46em;
        margin-top: 3em;*/
    }

    #btnReset {
        background-color: darkgray;
        color: white;
        font-size: 12px;
        width: fit-content;
        vertical-align: middle;
        border-radius: 4px;
        border: none;
        padding: 0.4em 1em;
    }

    .selectpicker {
        width: 12em;
        border: none;
        border-bottom: 1px solid;
        cursor: pointer;
    }

    #btnCancel {
        background-color: darkgray;
        color: white;
        font-size: 12px;
        width: fit-content;
        vertical-align: middle;
        border-radius: 4px;
        border: none;
        padding: 0.4em 1em;
    }



