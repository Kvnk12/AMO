    }*/

   .modal {
        overflow-y: unset;
        transform: translate(-15%, 10px);
    }
.modal.in .modal-dialog {
            transform: translate(0, 40%);
        }
 .modal-dialog {
        width: 42%;
    }
.modal-header {
        background-color: rgb(91,121,171);
        color: #fff;
        padding: 10px 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
 .modal-header .modal-title {
            font-family: 'HelveticaNeue-Light';
        }
    .modal-header .close {
        opacity: 1;
        border: none;
        box-shadow: none;
        color: #fff;
        background-image: url('../../Content/images/close.svg');
        background-size: 12px;
        width: 12px;
        height: 12px;
        background-repeat: no-repeat;
        background-color: transparent;
    }
 .modal-header .close span {
                text-shadow: none;
                display: none;
            }
.modal-body {
        padding: 16px 25px 5px;
        background-color: #fcfcfc;
    }
    .modal-body input[type="text"], .modal-body input[type="number"] {
        border: 1px solid;
        border-radius: unset;
        /* padding: unset; */
        padding-left: 8px;
        width: 19em;
        height: 3em;
    }
 .modal-content {
        border: none;
        border-radius: 0;
        width: 63em;
    }
 .modal-footer {
        border: none;
        padding: 10px 25px 16px;
        background-color: #fcfcfc;
        margin: 0;
    }
 .modal-footer .btn {
            background-color: rgb(91,121,171);
            color: #fff;
            padding: 2px 12px;
            font-size: 11px;
            font-weight: bold;
        }
    .modal select.selectpicker {
        border: none;
        border-bottom: 1px solid black;
