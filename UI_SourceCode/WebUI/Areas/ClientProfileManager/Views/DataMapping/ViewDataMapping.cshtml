<div class="content-main dark-bg">
    <!--start of breadcrumb-->
    <ol class="breadcrumb">
        <li>Client Profile Manager</li>
        <li>Client Administration</li>
        <li class="active">Data Mapping</li>
    </ol>
    <div class="viewDataMap">
        @using (Html.BeginForm("UpdateMappingDetail", "DataMapping", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <div style="padding: 0;">
                <div>
                    @if (!ViewData.ModelState.IsValid)
                    {
                        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
                    }
                    @if (TempData["ValidationSuccessMsgACK"] != null)
                    {
                        var str = new HtmlString(@TempData["ValidationSuccessMsgACK"].ToString());
                        <p class="alert alert-success">
                            <strong>Success:</strong><label>@Html.Raw(str)</label>
                            <a href="mailto:AMSsupport@nttdata.com">AMSsupport@nttdata.com</a>
                        </p>
                    }
                    @if (TempData["ValidationSuccessMsg"] != null)
                    {
                        <p class="alert alert-success"><strong>Success:</strong>@Html.Raw(@TempData["ValidationSuccessMsg"].ToString())</p>
                    }

                    <div class="viewMapData">
                            <div>
                                @Html.HiddenFor(model => Model.template.MappingId)
                                @Html.HiddenFor(model => Model.template.BaseMappingId)
                                @Html.HiddenFor(model => Model.template.FileFormat)
                                @Html.HiddenFor(model => Model.template.ClientId)
                                @Html.HiddenFor(model => Model.template.FileDelimiter)
                                @*@Html.HiddenFor(model => Model.template.FileDelimiter)*@
                            </div>
                            <div class="mapDataDetails">
                                <label class="mapDataLabel">Data mapping detail</label>
                            </div>
                            <div style="display:flex;">
                                <div style="width: 25%; display: flex;margin: 1em 5em 0em 0em;">
                                    <label id="" class="custom-blue-label" style="font-weight: bold;font-size: 13px;">Application Name: </label>
                                    <div style="padding-left: 1em;">
                                        @Html.TextBoxFor(m => Model.template.AppName, new { @class = "form-control", @readonly = "true", @style = "width: 13em;font-size: 13px;" })
                                    </div>
                                </div>
                                <div style="width: 25%;display: flex;margin: 1em 5em 0em 0em;">
                                    <label id="" class="custom-blue-label" style="font-weight: bold;font-size: 13px;">Template Name: </label>
                                    <div style=" padding-left: 1em;">
                                        @if (Model.template.BaseMappingId == null)
                                        {
                                            @Html.TextBoxFor(m => Model.template.TemplateName, new { @class = "form-control", @readonly = "true", @style = "width: 13em;font-size: 13px;" })
                                        }
                                        else
                                        {
                                            @Html.TextBoxFor(m => Model.template.BaseMappingTemplateViewModel.TemplateName, new { @class = "form-control", @readonly = "true", @style = "width: 13em;font-size: 13px;" })
                                        }


                                    </div>
                                </div>
                                <div style="width: 25%; display: flex;margin: 1em 5em 0em 0em;">
                                    <label id="" class="custom-blue-label" style="font-weight: bold;font-size: 13px;">Template Identifier: </label>
                                    <div style=" padding-left: 0.8em;">
                                        @Html.TextBoxFor(m => Model.template.GlobalMappingIdentifier, new { @class = "form-control", @readonly = "true", @style = "width: 13em;font-size: 13px;" })
                                        @*@Html.DisplayFor(m => Model.template.GlobalMappingIdentifier)*@
                                    </div>
                                </div>
                            </div>
                        </div>
                    <div class="form-horizontal">
                        <div style="display:flex;justify-content:flex-end;margin: 2em 0em 2em 2em;">

                            <button class="custom-button" type="submit" name="btnSubmit" id="btnSave1" value="Save" tabindex="1">SAVE</button> &nbsp;&nbsp;&nbsp;

                            <button class="custom-button" type="submit" name="btnSubmit" id="btnAck1" value="Acknowledge" tabindex="3">ACKNOWLEDGE</button> &nbsp;&nbsp;

                            <button class="custom-button" style="background-color: #b3b3b3;" type="reset" id="btnReset" tabindex="4" >RESET</button> &nbsp;&nbsp;

                            <button class="custom-button" style="background-color: #b3b3b3;" type="submit" id="btnCancel" tabindex="5" onclick="location.href='@Url.Action("index", "DataMapping")';return false;">BACK</button> &nbsp;&nbsp;
                        </div>
                        <div class="form-group">
                            <div class="grid_4" style="overflow-x:auto;">
                                <table class="table table-striped" cellpadding="0">
                                    <thead>
                                        <tr>
                                            <th width="1%"></th>
                                            <th width="35%" scope="col">APP data field</th>
                                            <th width="5%" scope="col">Data type</th>
                                            <th width="5%" scope="col">Size</th>
                                            <th width="15%" scope="col">Source field</th>
                                            <th width="14%" scope="col">Concatenation</th>
                                            @*<th width="1%" scope="col"></th>*@
                                            <th width="14%" scope="col" title="Calculation">Calculation</th>
                                            <th width="25%" scope="col">Default value</th>
                                            <th width="25%" scope="col">Display value</th>
                                            @*<th width="13%" scope="col">Modified by</th>*@
                                            @*<th width="13%" scope="col">Modified on</th>*@
                                            <th width="10%" scope="col">Data Masking</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @{
                                            //var sourceFields = Model.SourceFields();
                                            for (int i = 0; i < Model.templateMapping.Count; i++)
                                            {
                                                var reqString = "";
                                                var sField = "";
                                                if (Model.templateMapping[i].IsMandatory)
                                                {
                                                    reqString = "*";
                                                }
                                                if (string.IsNullOrEmpty(Model.templateMapping[i].SField))
                                                {
                                                    //by default selecting fields which are same name in source file as well as in IN table.
                                                    // sField = Model.templateMapping[i].MappingCol;
                                                }
                                                else
                                                {
                                                    sField = Model.templateMapping[i].SField;
                                                }
                                                string updatedTime = "";
                                                if (Model.templateMapping[i].UpdatedOn != DateTime.MinValue)
                                                {
                                                    updatedTime = Model.templateMapping[i].UpdatedOn.ToString();
                                                }
                                                string mFieldtoolTip = Model.templateMapping[i].MapColDesc; ;

                                                <tr>
                                                    <td><span class="mandate">@reqString</span>@Html.HiddenFor(model => Model.templateMapping[i].IsMandatory)</td>
                                                    <td style="word-break: break-word;width:20%">
                                                        <div> @Html.HiddenFor(model => Model.templateMapping[i].Id)</div>
                                                        <div>
                                                            @Html.HiddenFor(model => Model.templateMapping[i].CreatedBy)
                                                        </div>
                                                        <div>
                                                            @Html.HiddenFor(model => Model.templateMapping[i].CreatedOn)
                                                        </div>
                                                        <div> @Html.HiddenFor(model => Model.templateMapping[i].UpdatedByUserName)</div>
                                                        <div>
                                                            @Html.HiddenFor(model => Model.templateMapping[i].UpdatedOn)
                                                        </div>
                                                        <div>
                                                            @Html.HiddenFor(model => Model.templateMapping[i].MappingTable)
                                                        </div>
                                                        <div>
                                                            @Html.HiddenFor(model => Model.templateMapping[i].MappingCol)
                                                            @Html.HiddenFor(model => Model.templateMapping[i].MapColDesc)
                                                        </div>
                                                        <div>
                                                            @Html.HiddenFor(model => Model.templateMapping[i].DataType)
                                                        </div>
                                                        <div>
                                                            @Html.HiddenFor(model => Model.templateMapping[i].DLength)
                                                        </div>
                                                        <div data-toggle="tooltip" data-placement="right" title="@mFieldtoolTip">
                                                            @Model.templateMapping[i].MappingCol
                                                        </div>
                                                    </td>
                                                    <td>@Model.templateMapping[i].DataType</td>
                                                    <td>@Model.templateMapping[i].DLength</td>
                                                    <td>@Html.DropDownListFor(m => Model.templateMapping[i].SField, new SelectList(Model.SourceFields, "value", "text", sField), "Nothing Selected", new { @class = "btn btn-default dropdown-toggle" })</td>
                                                    <td>
                                                        <div data-tip="@Model.templateMapping[i].FieldConcatinationsForDisplay">
                                                            <table cellpadding="0" cellspacing="0" border="0">
                                                                <tr style=" background-color: #f9f9f9;">
                                                                    <td>@Html.TextBoxFor(m => Model.templateMapping[i].FieldConcatinationsForDisplay, new { @class = "form-control", @readonly = "true",@style= "font-size: 13px;" })</td>
                                                                    <td><button type="button" data-id="templateMapping[@i].FieldConcatinationsForDisplay" data-hidid="templateMapping[@i].FieldConcatinations" class="hrefClass concatinationButton"></button></td>
                                                                </tr>
                                                            </table>
                                                        </div>
                                                        @Html.HiddenFor(m => Model.templateMapping[i].FieldConcatinations)
                                                    </td>

                                                    <td>
                                                        <div data-tip="@Model.templateMapping[i].FieldCalculationsForDisplay">
                                                            <table cellpadding="0" cellspacing="0" border="0">
                                                                <tr style=" background-color: #f9f9f9;">
                                                                    <td>@Html.TextBoxFor(m => Model.templateMapping[i].FieldCalculationsForDisplay, new { @class = "form-control", @readonly = "true", @style = "font-size: 13px;" })</td>
                                                                    <td><button type="button" data-id="templateMapping[@i].FieldCalculationsForDisplay" data-hidid="templateMapping[@i].FieldCalculations" class="hrefCalClass calculationButton"></button></td>
                                                                </tr>
                                                            </table>
                                                        </div>
                                                        @Html.HiddenFor(m => Model.templateMapping[i].FieldCalculations)
                                                    </td>

                                                    <td>@Html.TextBoxFor(m => Model.templateMapping[i].DefVal, new { @class = "form-control", placeholder = "Default value", @style = "width: 8em;word-break: break-word;text-align: center;padding-right: 0px;font-size:13px;" })</td>
                                                    <td>@Html.TextBoxFor(m => Model.templateMapping[i].DisplayName, new { @class = "form-control", placeholder = "Display name" , @style= "width: 12em;word-break: break-word;text-align: center;padding-right: 0px;font-size:13px;" })</td>
                                                    @*<td>
                                                        <div data-toggle="tooltip" data-placement="right" title="Updated on: @Model.templateMapping[i].UpdatedOn" style="overflow: hidden;width:100px; height:50px; text-overflow: ellipsis;">
                                                            @Model.templateMapping[i].UpdatedByUserName
                                                        </div>
                                                    </td>*@

                                                    @if ((Model.templateMapping[i].DataType == "ntext" || Model.templateMapping[i].DataType == "nvarchar" || Model.templateMapping[i].DataType == "varchar") && (Model.templateMapping[i].DLength > 8 || Model.templateMapping[i].DLength == -1 || Model.templateMapping[i].DLength == null))
                                                    {
                                                        <td> @Html.CheckBoxFor(m => m.templateMapping[i].DataMasking, new { @class = "form-control", @style = "width: 20px;height: 20px;background-color: unset;", tabindex = "", id = "datamasking" })</td>
                                                    }
                                                    else
                                                    {
                                                        <td> @Html.CheckBoxFor(m => m.templateMapping[i].DataMasking, new { @class = "form-control", @style = "width: 20px;height: 20px;background-color: unset;", tabindex = "", id = "datamasking", disabled = "disabled" })</td>

                                                    }

                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>                        
                            @*<div style="display:flex;justify-content:flex-end;">

                                <button class="custom-button" type="submit" name="btnSubmit" id="btnSave" value="Save" tabindex="6">SAVE</button> &nbsp;&nbsp;

                                <button class="custom-button" type="submit" name="btnSubmit" id="btnAck" value="Acknowledge" tabindex="8">ACKNOWLEDGE</button> &nbsp;&nbsp;

                                <button class="custom-button" type="reset" id="btnReset" tabindex="9">RESET</button> &nbsp;&nbsp;

                                <button class="custom-button" type="submit" id="btnCancel" onclick="location.href='@Url.Action("index", "DataMapping", new { ClientId= Model.template.ClientId})';return false;" tabindex="10">BACK</button> &nbsp;&nbsp;&nbsp;
                            </div>*@
                        <div class="modal fade" id="ConcateModal"tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h4 class="modal-title">Source field concatenation</h4>
                                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <table height="400">
                                            <tr style="color: rgb(91,121,171);">
                                                <th scope="col">Source data field</th>
                                                <th scope="col">Seperator</th>
                                            </tr>
                                            <tr>
                                                <td>@Html.DropDownList("s0", new SelectList(Model.SourceFields, "value", "text", ""), "", new { @class = "selectpicker", placeholder="Select Source Data Field" })</td>
                                                <td><input type="text" name="sp0" id="sp0" class="form-control" style="font-size: 13px;"/> </td>
                                            </tr>
                                            <tr>
                                                <td>@Html.DropDownList("s1", new SelectList(Model.SourceFields, "value", "text", ""), "", new { @class = "selectpicker", placeholder = "Select Source Data Field" })</td>
                                                <td><input type="text" name="sp1" id="sp1" class="form-control" style="font-size: 13px;"/> </td>
                                            </tr>
                                            <tr>
                                                <td>@Html.DropDownList("s2", new SelectList(Model.SourceFields, "value", "text", ""), "", new { @class = "selectpicker", placeholder = "Select Source Data Field" })</td>
                                                <td><input type="text" name="sp2" id="sp2" class="form-control" style="font-size: 13px;"/> </td>
                                            </tr>
                                            <tr>
                                                <td colspan="2" height="150"></td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-default" data-bs-dismiss="modal">Close</button>
                                        <button type="button" name="btnConcateSave" id="btnConcateSave" class="btn btn-primary">Save</button>
                                    </div>
                                </div><!-- /.modal-content -->
                            </div><!-- /.modal-dialog -->
                        </div><!-- /.modal -->

                        <div class="modal fade" id="CalculationModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h4 class="modal-title">Source field Calculation</h4>
                                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <table height="400">
                                            <tr style=" color: rgb(91,121,171);">
                                                <th scope="col">Operator</th>
                                                <th scope="col">Source data field</th>
                                                <th scope="col">Constant</th>
                                            </tr>
                                            <tr>
                                                <td>@Html.DropDownList("Co0", new SelectList(Model.OperatorFields, "value", "text", ""), "", new { @class = "selectpicker", placeholder = "Select Operator" })</td>
                                                <td>@Html.DropDownList("Cs0", new SelectList(Model.SourceFields, "value", "text", ""), "", new { @class = "selectpicker", placeholder = "Select Source Data Field" })</td>
                                                <td><input type="number" name="Csp0" id="Csp0" class="form-control" /> </td>
                                            </tr>
                                            <tr>
                                                <td>@Html.DropDownList("Co1", new SelectList(Model.OperatorFields, "value", "text", ""), "", new { @class = "selectpicker", placeholder = "Select Operator" })</td>
                                                <td>@Html.DropDownList("Cs1", new SelectList(Model.SourceFields, "value", "text", ""), "", new { @class = "selectpicker", placeholder = "Select Source Data Field" })</td>
                                                <td><input type="number" name="Csp1" id="Csp1" class="form-control" /> </td>
                                            </tr>
                                            <tr>
                                                <td>@Html.DropDownList("Co2", new SelectList(Model.OperatorFields, "value", "text", ""), "", new { @class = "selectpicker", placeholder = "Select Operator" })</td>
                                                <td>@Html.DropDownList("Cs2", new SelectList(Model.SourceFields, "value", "text", ""), "", new { @class = "selectpicker", placeholder = "Select Source Data Field" })</td>
                                                <td><input type="number" name="Csp2" id="Csp2" class="form-control" /> </td>
                                            </tr>
                                            <tr>
                                                <td colspan="3" height="150"></td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-default" data-bs-dismiss="modal">Close</button>
                                        <button type="button" name="btnCalculateSave" id="btnCalculateSave" class="btn btn-primary">Save</button>
                                    </div>
                                </div><!-- /.modal-content -->
                            </div><!-- /.modal-dialog -->
                        </div><!-- /.modal -->
                    </div>
                </div>
