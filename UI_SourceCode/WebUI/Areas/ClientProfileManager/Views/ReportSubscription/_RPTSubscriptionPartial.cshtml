<script>
    $(document).ready(function () {
        document.getElementById('selectTimeMonthly').style.display = "none";
        document.getElementById('SelectTime_Day').style.display = "none";
    });



    $('.day-of-week').on('change', function () {
        $('.day-of-week').not(this).prop('checked', false);
    });




    function onDailyClick() {
        document.getElementById('selectTimeMonthly').style.display = "none";
        document.getElementById('SelectTime_Day').style.display = "none";
        document.getElementById('selectTimeHid').style.display = "block";
        document.getElementById('selectTimeHid').style.display = "flex";
        document.getElementById('rpt_secrowfields').style.height = "10em";
        document.getElementById('select_time').style.marginTop = "0em";
        document.getElementById('select_day').style.marginTop = "0em";
    }

    function onWeeklyClick() {
        document.getElementById('selectTimeMonthly').style.display = "none";
        document.getElementById('selectTimeHid').style.display = "none";
        document.getElementById('SelectTime_Day').style.display = "block";
        document.getElementById('rpt_secrowfields').style.height = "12em";
        document.getElementById('select_time').style.marginTop = "1em";
        document.getElementById('select_day').style.marginTop = "1.2em";
    }

    function onMonthlyClick() {
        document.getElementById('SelectTime_Day').style.display = "none";
        document.getElementById('selectTimeHid').style.display = "none";
        document.getElementById('selectTimeMonthly').style.display = "block";
        document.getElementById('selectTimeMonthly').style.display = "flex";
        document.getElementById('rpt_secrowfields').style.height = "10em";
        document.getElementById('select_time').style.marginTop = "0em";
        document.getElementById('select_day').style.marginTop = "0em";
    }

    $('#parameter-add-blue-button').on('click', function () {

        console.log("Email Icon Clicked");
         var a = $("#EmailAdd").data("kendoTextBox").value();
         console.log(a);

         if (a != "") {
             if (validateEmail(a)) {
                 var b = document.getElementById('Recipients').value;
                 var c = $('.delete -icon').val();
                 console.log(b);

                 if (b == '' || b == null) {
                     document.getElementById('Recipients').value = a;
                     document.getElementById('EmailAdd').value = '';
                     $(".delete-icon").html(a);
                     $("#delIcon").attr("data-word", a);

                     console.log("if");

                 } else {
                     document.getElementById('Recipients').value = b + ";" + a;
                     document.getElementById('EmailAdd').value = '';
                     $(".delete-icon").html(b + ";" + a);
                     $("#delIcon").attr("data-word", b + ";" + a);
                     console.log("else");

                 }
                 var object = { id: a , class: "emailcustWord" , onclick:"deleteemail(id)"};
                 var addition = $("<div>", object);
                 addition.html(a);
                 $(".email-word").append(addition);
             } else {
                 //error message to be displayed for incorrect email format.
                 alert("Entered email id is not in correct email format, please re-enter email id");
             }
        }


    });

    $('.emailcustWord').on('click', function () {
        console.log("delete icon click");
        //var a = $(this).data('id');
        var word = $(this).data('word');
        console.log(word);

       });

    function deleteemail(id) {
        console.log("delete");
        console.log(id);
        var element = document.getElementById(id);
        element.parentNode.removeChild(element);
    }

   function validateEmail(a) {
       var expr = /^([\w-\.]+)@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
       if (expr.test(a)) {
           console.log("success");
           return true;
       } else {
           return false;
       }
        }


    function cancelPopup() {
        var popup = $("#RPTSubspopUp").data("kendoWindow");
        popup.close();
    }

    //On save click in pop-up
    function saveSubscriptionDetails() {

        var email_subject = $("#Email_Subject").val();
        var Recipients_list="";

        const divIds = $('#parentEmail > div').map((i, div) => div.id).get(); //fetch values of child divs created through JS

        console.log(Recipients_list);
        for (i = 0; i < divIds.length; i++) {
            Recipients_list += divIds[i] + ';';
        }
        Recipients_list += '@emailId';
