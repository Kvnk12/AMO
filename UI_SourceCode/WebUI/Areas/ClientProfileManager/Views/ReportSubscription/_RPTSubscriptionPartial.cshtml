@{
    <link rel="stylesheet" href="~/Content/plugins/scrollbar/css/jquery.scrollbar.css" />
    <link href="@Url.Content("~/Content/css/custom-styles.css")" rel="stylesheet">
    <link href="https://kendo.cdn.telerik.com/2018.2.620/styles/kendo.common.min.css" rel="stylesheet" />
    int usid = (int)Session["UserId"];
    ReportSubscriptionController rptc = new ReportSubscriptionController();
    var emailId = rptc.getEmailID(usid);

    List<int> listhours = new List<int>();
    List<string> listminutes = new List<string>();
    List<string> listmonths = new List<string>();
    for (int i = 0; i <= 23; i++)
    {
        listhours.Add(i);
    }

    IEnumerable<SelectListItem> hours = listhours.Select(g =>
                   new SelectListItem
                   {
                       Text = g.ToString(),
                       Value = g.ToString()
                   }).ToList();


    for (int i = 0; i <= 59; i++)
    {
        if (i >= 0 && i < 10)
        {
            listminutes.Add("0" + i.ToString());
        }
        else
        {
            listminutes.Add(i.ToString());
        }
    }

    IEnumerable<SelectListItem> minutes = listminutes.Select(g =>
                   new SelectListItem
                   {
                       Text = g.ToString(),
                       Value = g.ToString()
                   }).ToList();


    for (int i = 1; i <= 31; i++)
    {
        if (i >= 1 && i < 10)
        {
            listmonths.Add("0" + i.ToString());
        }
        else
        {
            listmonths.Add(i.ToString());
        }
    }

    IEnumerable<SelectListItem> months = listmonths.Select(g =>
               new SelectListItem
               {
                   Text = g.ToString(),
                   Value = g.ToString()
               }).ToList();

    IEnumerable<string> userEmailList = ViewBag.userEmailList;
   
   
}
