    function getMetric(Id, MetricName) {

        console.log(Id, MetricName);
        document.getElementById("tempID").innerHTML = Id;
        document.getElementById("tempName").innerHTML = MetricName;
        var tempID = document.getElementById("tempID").innerHTML;
        var tempName = document.getElementById("tempName").innerHTML;
        console.log("getMetric ", Id);
