        var Id = document.getElementById("tempID").innerHTML;
        var metricName = document.getElementById("tempName").innerHTML;
        console.log("tempID is " + Id);
        console.log("tempName is " + metricName);


        return {
            Id: Id,
            MetricName : metricName
        };

    }



</script>





