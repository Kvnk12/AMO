@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.ClientProfileManager.ViewModel
@using WebUI.Areas.ClientProfileManager.Dto;
@using System.Data;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;

@model WebUI.Areas.ClientProfileManager.ViewModel.DispositionAutomationModel
@{
    ViewBag.Title = "Client Profile Manager";
    // var clientlist = GetDropDownListItems.ClientList;
    ViewBag.ImagePathOne = Url.Content("~/Content/images/home/Client_Profile_manager_white.svg");
    //Layout = "~/Views/Shared/_AppLayout.cshtml";
    Layout = "~/Views/Shared//GenericLayoutWithoutFooter.cshtml";
}
<link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
<link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
<link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />


<script src="~/Scripts/jquery-3.6.0.min.js"></script>
<script src="~/Scripts/JScript/kendo.all.min.js"></script>
<script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>
<div class="content-main dark-bg">

    <!--start of breadcrumb-->
    <ol class="breadcrumb">
        <li>Client Profile Manager</li>
        <li>Client Administration</li>
        <li class="active">Alternative Dashboard Option</li>
    </ol>

    <div style="background-color: white; padding: 1em; margin-top: 1em;">
        <div id="lblErr" hidden>
            <label class="alert alert-danger" id="lblErr1">Error while saving data.</label>
        </div>
        <div id="lblSuccess" hidden>
            <label class="alert alert-success" id="lblSuccess1">Saved successfully.</label>
        </div>
        <div class="form-group">
            <label class="col-sm-3" for="IsAlternative">Include Alternative Dashboard</label>
            <div class="col-sm-2 Alternativesave">
                <input type="checkbox" id="IsAlternative" class="col-sm-3 k-checkbox">
                <label for="IsAlternative" class="col-sm-2 k-checkbox-label"></label>
            </div>
            <button type="button" name="btnSave" class="btn" style="background-color:rgb(91,121,171);color:white" onclick="onSaveClick()">Save</button>
        </div>
       
    </div>
</div>
<script>


    function onSaveClick()
    {

        var EnableAlternative = $('#IsAlternative').prop('checked');
        var model = {
            IncludeAlternativeDashboard: EnableAlternative,
        };
        var data = JSON.stringify(model);
        var RootUrl = '@Url.Content("~/")';

        $.ajax(
       {
           type: 'post',

           url: RootUrl + 'AlternativeDashboard/SetAlternativeDetails',
           data: data,
           async: true,
           contentType: 'application/json; charset=utf-8',
           success: function (data) {
               $('#lblErr').hide();
               $('#lblSuccess').show(); //='Saved successfully.';
           },
           error: function (err, data) {
               $('#lblErr').show();
               $('#lblSuccess').hide(); //='Saved successfully.';
           }

       });


    }



    $(window).on('load', function () {
        $('[name="IsAlternative"]').removeAttr('checked');
        var ReadURl = '@Url.Content("~/AlternativeDashboard/GetDispositionDetail")';

        $.ajax(
            {
                url: ReadURl,
                type: 'post',
                //data: data,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    if (data.IncludeAlternativeDashboard == true) {
                        $('#IsAlternative').prop('checked', true);
                    }
                    else
                    {
                        $('#IsAlternative').prop('checked', false);
                    }



                }

            })
    });

</script>
