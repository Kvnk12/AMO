@using System.Collections;
@using Kendo.Mvc.UI;
@using WebUI.Areas.RetirementAccelerator.Models;
@using WebUI.Areas.RetirementAccelerator;
@using Kendo.Mvc.Infrastructure;
@using Kendo.Mvc.Resources
@using Kendo.Mvc.Extensions;
@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.ClientProfileManager.ViewModel
@using WebUI.Areas.ClientProfileManager.Dto
@using WebUI.Areas.ClientProfileManager.Controllers;
@using System.Data;
@using System.Web.Mvc;

@model UserSurvey

@{
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />


    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/JScript/kendo.all.min.js"></script>
    <script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>
    ViewBag.Title = "AM-Optimization tool Survey";
    // var clientlist = GetDropDownListItems.ClientList;
    Layout = "~/Views/Shared/_Anonymouslayout.cshtml";
    //var client = (Client)Session["Client"];
    //var v = new SurveyUserController();

    //  var cname = v.getCltName(client.Id);

}
<div style="margin:5px">
    <div style="margin:5px" class="well well-sm"><strong>AM-Optimization tool Survey</strong></div>
    <div style="margin:5px">
        <div class="validation-summary-errors alert alert-success container" data-valmsg-summary="true" id="AssessSaveSuccess" hidden>
            <ul>
                <li>Your responses are recorded sucessfully, Please submit to complete the Survey.</li>
            </ul>
        </div>
        <div class="validation-summary-errors alert alert-danger container" data-valmsg-summary="true" id="AssessSaveFailure" hidden>
            <ul>
                <li>Error while assigning.</li>
            </ul>
        </div>
        
        <div style="margin:5px" class="form-horizontal">
            <div class="form-group">
                @Html.HiddenFor(model => Model.SurveyId)
                @Html.HiddenFor(model => Model.UserSurveyToken)
                @Html.HiddenFor(model=> Model.PersonnelId)
                @Html.HiddenFor(model => Model.surveyenddate)
                @Html.HiddenFor(model => Model.SurveyForRefId)
                @Html.HiddenFor(model => Model.SurveyUserId)


            </div>

            <div class="form-group" style="display:flex">
                <label id="" class="col-sm-3 control-label">Client: </label>
                <div class="col-sm-5">
                    @Model.ClientName
                </div>
            </div>

            <div class="form-group" style="display:flex">
                <label id="" class="col-sm-3 control-label">Survey Name:</label>
                <div class="col-sm-5">
                    @Model.SurveyName
                </div>
            </div>
            <div class="form-group" style="display:flex">
                <label id="" class="col-sm-3 control-label">Survey End Date:</label>
                <div class="col-sm-5">
                    @Model.surveyenddate
                </div>
            </div>
            <div class="form-group" style="display:flex">
                <label id="" class="col-sm-3 control-label">Survey Type/Survey for</label>
                <div class="col-sm-5">
                    @Model.SurveyType  / @Model.SurveyFor
                </div>
            </div>
            <div class="form-group" style="display:flex">
                <label id="" class="col-sm-3 control-label">Survey Description</label>
                <div class="col-sm-5">
                    @Model.Description
                </div>
            </div>
        </div>
        <div style="margin-left:10px;">
            <button class="btn btn-primary" onclick="setFinalAndOriginalRating('save')">Save Changes</button>
            <button class="btn btn-primary" onclick="setFinalAndOriginalRating('submit')">Submit</button>
        </div>
        <div style="margin:10px;">
            @(Html.Kendo().Grid<AssessmentModel>()
    .Name("AssessGrid")
    //.Events(e=>e.SaveChanges("setFinalAndOriginalRating"))
    .Columns(columns =>
    {
        columns.Bound(p => p.subPerspective).Title("Sub Perspective").Width(150);
        columns.Bound(p => p.SurveyUserId).Hidden();
        columns.Bound(p => p.SurveyModelId).Hidden();
        columns.Bound(p => p.Question);
        columns.Bound(p => p.OriginalRating).Hidden(true);
        columns.Bound(p => p.FinalRating).Hidden(true);
        columns.Bound(p => p.OR).Width(150).ClientTemplate("#= OriginalRatingTemplate(data) #").Title("Original ");
        columns.Bound(p => p.FR).Width(150).ClientTemplate("#= FinalRatingTemplate(data) #").Title("Final ");
        columns.Bound(p => p.Comments).Width(200);
    })
    .ToolBar(toolbar =>
    {
        //toolbar.Save();

    })

    .Editable(editable => editable.Mode(GridEditMode.InCell))
    .Navigatable()
    .Sortable()
    .HtmlAttributes(new { @style = "height:550px" })
    .Scrollable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Batch(true)
        .ServerOperation(false)
        .Events(events => events.Error("error_handler"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(r => r.Question).Editable(false);
            model.Field(r => r.subPerspective).Editable(false);
            model.Field(r => r.OR).Editable(false);
            model.Field(r => r.FR).Editable(false);
            model.Field(r => r.OriginalRating);
            model.Field(r => r.FinalRating);
        })
        .Read(read => read.Action("AssessRead", "SurveyUser").Data("GetData"))
        .Update(up => up.Action("AssessSave", "SurveyUser"))
    )
            )
        </div>
    </div>
</div>
<script type="text/javascript">
    function GetData(e) {
        return {
            SurveyId: '@Model.SurveyId',
            SurveyPersonnel: '@Model.PersonnelId',
            ApplicationId:'@Model.SurveyForRefId'
        }
    }

    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }

    function OriginalRatingTemplate(data) {
        var template = "<div class='ParentDiv'><div class='rate'>";
        for (var i = 0; i < data.QuestionOptions.length; i++) {
            var option = data.QuestionOptions[i];
            var uniqId = 'Original' + String(data.Id) + String(data.QuestionOptions[i].Id);
            var OrgUniqName = 'OriginalRating' + String(data.Id);
            var rowUid = data.uid;
            if (data.OriginalRating == option.Id) {
                template += kendo.format("<input  data-rowuid='{4}' type='radio' checked  id='{0}' name='{3}' value='{1}' /><label for='{0}' title='{2}'>{2}</label>", uniqId, option.Id, option.Rating, OrgUniqName, rowUid);
            }
            else {
                template += kendo.format("<input  data-rowuid='{4}' type='radio' id='{0}' name='{3}' value='{1}' /><label for='{0}' title='{2}'>{2}</label>", uniqId, option.Id, option.Rating, OrgUniqName, rowUid);
            }
        }
        template += "</div></div>";
        return template;
    }

    function FinalRatingTemplate(data) {
        var template = "<div class='ParentDiv'><div class='rate'>";
        for (var i = 0; i < data.QuestionOptions.length; i++) {
            var option = data.QuestionOptions[i];
            var uniqId = 'Final' + String(data.Id) + String(data.QuestionOptions[i].Id);
            var FinUniqName = 'FinalRating' + String(data.Id);
            if (data.FinalRating == option.Id) {
                template += kendo.format("<input  type='radio' id='{0}' checked name='{3}' value='{1}' /><label for='{0}' title='{2}'>{2}</label>", uniqId, option.Id, option.Rating, FinUniqName);
            }
            else {
                template += kendo.format("<input type='radio' id='{0}' name='{3}' value='{1}' /><label for='{0}' title='{2}'>{2}</label>", uniqId, option.Id, option.Rating, FinUniqName);
            }
        }
        template += "</div></div>";
        return template;
    }

    function setFinalAndOriginalRating(btnType) {
        $('#AssessSaveFailure').hide();
        $('#AssessSaveSuccess').hide();
        // item.PreventDefault();
        var RatingsList = [];
        var grid = $("#AssessGrid").data("kendoGrid");
        var dataSource = grid.dataSource;
        //console.log(dataSource);
        var allData = dataSource.data();
        //console.log(allData.length);
        for (i = 0; i < allData.length; i++) {
            var uid = allData[i].uid;
            var row = grid.tbody.find("tr[data-uid='" + uid + "']");
            //var dataItem = grid.dataItem(row);

            var FinUniqName = 'FinalRating' + String(allData[i].Id);
            var finalRatingVal = $('input[name=' + FinUniqName + ']:checked', '.rate').val();
            var originalUniqName = 'OriginalRating' + String(allData[i].Id);
            var originalRatingVal = $('input[name=' + originalUniqName + ']:checked', '.rate').val();

            //console.log('OR: {0},   FR: {1}', originalRatingVal, finalRatingVal);


            var AnswersCollection = {};
            AnswersCollection.RowId = allData[i].Id;
            AnswersCollection.OriginalRating = originalRatingVal;
            AnswersCollection.FinalRating = finalRatingVal;
            AnswersCollection.Comments = allData[i].Comments;
            AnswersCollection.SurveyUserId = allData[i].SurveyUserId;
            AnswersCollection.SurveyModelId = allData[i].SurveyModelId;
            RatingsList.push(AnswersCollection);

        }


        //ajax call to controller
        sendDataToController(RatingsList, btnType);
    }



    function sendDataToController(data, btnType) {
        var SaveURl = '@Url.Content("~/ClientProfileManager/SurveyUser/AssessAjaxSave")';
        var mod = {};
        mod.ApplicationId = '@Model.SurveyForRefId';
        mod.SurUserId = '@Model.SurveyUserId '
        mod.RatingsList = data;
        mod.ButtonType = btnType;
        mod.url = SaveURl;
        mod.type = "POST";
        mod.dataType = "json";
        mod.data = JSON.stringify(mod);
        mod.contentType = "application/json";
        mod.success = function (response) {
            //alert("success");
            if (response == 'save') {
                $('#AssessSaveSuccess').show();
                var tre = $("#AssessGrid").data("kendoGrid");
                tre.dataSource.read();
            }
            else {                
                var indexurl = '@Url.Content("~/ClientProfileManager/SurveyUser/ThankYou")';
                window.location.href = indexurl;
            }
        };
        mod.error = function (response) {
            $('#AssessSaveFailure').show();
        };
        $.ajax(mod);

    }
</script>

<style>
    /*.k-edit-cell>.k-textbox, .k-edit-cell>.k-widget, .k-grid-edit-row>td>.k-textbox, .k-grid-edit-row>td>.k-widget, .k-grid-edit-row>td>.text-box {
        width: 100%;
        height:100%;
        margin-left: 3px;
        border-radius: 5px;
    }*/

    .k-grid-header th.k-header {
        font-weight: bold;
        font-size: 13px;
        text-overflow: ellipsis;
        border: thin 1px #ccc;
    }



    .ParentDiv {
        margin: 0;
        padding: 0;
    }

    .rate {
        float: left;
        height: 26px;
        padding: 0 10px;
    }

        .rate:not(:checked) > input {
            position: absolute;
            /*top: -9999px;*/
            display: none;
        }

        .rate:not(:checked) > label {
            float: right;
            width: 1em;
            overflow: hidden;
            white-space: nowrap;
            cursor: pointer;
            font-size: 20px;
            color: #ccc;
        }

            .rate:not(:checked) > label:before {
                content: ' ★ ';
            }

        .rate > input:checked ~ label {
            color: #ffc700;
        }

        .rate:not(:checked) > label:hover,
        .rate:not(:checked) > label:hover ~ label {
            color: #deb217;
        }

        .rate > input:checked + label:hover,
        .rate > input:checked + label:hover ~ label,
        .rate > input:checked ~ label:hover,
        .rate > input:checked ~ label:hover ~ label,
        .rate > label:hover ~ input:checked ~ label {
            color: #c59b08;
        }
</style>



