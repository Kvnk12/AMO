<link rel="stylesheet" href="~/Content/css/INstyles.css" />
<body>
    <div class="container-fluid survey-header">
        <figure class="brand-logo">
            <span class="logo">
                <img src="~/Content/images/portfolio_analyzer.png" alt="Portfolio Analyzer icon">
                <p>Portfolio Analyzer Survey - <span>Optimization Tool</span></p>
            </span>
            <span class="ntt-logo">
                <img src="~/Content/images/nttdata_logo.png" alt="NTT Data logo">
            </span>

        </figure>
    </div>
    <div class="survey-page-content" style="height:100%">
        @ViewBag.Message
    </div>


    <footer class="page-footer">
        <div class="container-fluid survey-footer">
            <div id="copyrights">©2020 NTT DATA, Inc. All rights reserved. </div>
        </div>
    </footer>

</body>


