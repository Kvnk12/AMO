@using WebUI.Areas.RetirementAccelerator.Models

@{
    ViewBag.Title = "_WorkProduct";
}


<div>
    <div style="margin:10px">
        <h5 style="text-align:center">Work Product</h5>
        
        <div style="margin:10px; padding:5px; padding-top:0px;"class="custom-kendo-grid">
            @(Html.Kendo().Grid<WorkProductModel>()
                .Name("WorkProductGrid")
                .Columns(column =>
                {
                    column.Bound(e => e.Id).Hidden();
                    column.Bound(e => e.WorkProduct).Width(200);
                    column.Bound(e => e.Url).ClientTemplate("<a href='" + Url.Content("#= Url  #") + "' target='_blank'>#: Url #</a>").HeaderTemplate("Source URL").Width(220);
                    //column.Bound(e => e.Url);
                    column.Command(command => { command.Edit(); command.Destroy(); }).Width(250);
                })


                .Sortable()
                .Scrollable()
                 .Editable(editable => editable.Mode(GridEditMode.InLine).DisplayDeleteConfirmation("Are you sure you want to delete?"))
                      .ToolBar(toolbar => toolbar.Create().Text("Add New Work Product"))
                      .HtmlAttributes(new { style = "height:550px;" })
                      .DataSource(dataSource => dataSource
                      .Ajax()
                      .Model(model => model.Id(f => f.Id))
                      .Read(read => read.Action("GetWorkProduct", "MetaData"))
                      .Create(create => create.Action("AddWorkProduct", "MetaData"))
                      .Update(update => update.Action("EditWorkProduct", "MetaData"))
                      .Destroy(destroy => destroy.Action("DeleteWorkProduct", "MetaData"))

                          ))
        </div>
    </div>
</div>

