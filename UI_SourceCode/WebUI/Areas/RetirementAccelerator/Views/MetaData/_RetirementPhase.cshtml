@using WebUI.Areas.RetirementAccelerator.Models

@{
    ViewBag.Title = "_RetirementPhase";
}

<div>
    <div style="margin:10px">
        <h5 style="text-align:center">Retirement Phase</h5>
        
        <div style="margin:10px; padding:5px; padding-top:0px;"class="custom-kendo-grid">
            @(Html.Kendo().Grid<RetirementPhaseModel>()
                .Name("RetirementPhaseGrid")
                .Columns(column =>
                {
                    column.Bound(e => e.Id).Hidden();
                    column.Bound(e => e.RetirementPhase);
                    column.Command(command => { command.Edit(); command.Destroy(); }).Width(250);
                })
                .Sortable()
                .Scrollable()
                 .Editable(editable => editable.Mode(GridEditMode.InLine).DisplayDeleteConfirmation("Are you sure you want to delete?"))
                      .ToolBar(toolbar => toolbar.Create().Text("Add New Retirement Phase"))
                      .HtmlAttributes(new { style = "height:550px;" })
                      .DataSource(dataSource => dataSource
                      .Ajax()
                      .Model(model => model.Id(f => f.Id))
                      .Read(read => read.Action("GetRetirementPhase", "MetaData"))
                      .Create(create => create.Action("AddRetirementPhase", "MetaData"))
                      .Update(update => update.Action("EditRetirementPhase", "MetaData"))
                      .Destroy(destroy => destroy.Action("DeleteRetirementPhase", "MetaData"))

                          ))
        </div>
    </div>
</div>