@using WebUI.Areas.RetirementAccelerator.Models


@{
    ViewBag.Title = "_ResourceGroup";
}

<div>
    <div style="margin:10px">
        <h5 style="text-align:center">Resource Group</h5>
        
        <div style="margin:10px; padding:5px; padding-top:0px;" class="custom-kendo-grid">
            @(Html.Kendo().Grid<ResourceGroupModel>()
                .Name("ResourceGroupGrid")
                .Columns(column =>
                {
                    column.Bound(e => e.Id).Hidden();
                    column.Bound(e => e.ResourceGroup);
                    column.Command(command => { command.Edit(); command.Destroy(); }).Width(250);
                })
                .Sortable()
                .Scrollable()
                 .Editable(editable => editable.Mode(GridEditMode.InLine).DisplayDeleteConfirmation("Are you sure you want to delete?"))
                      .ToolBar(toolbar => toolbar.Create().Text("Add New Resource Groups"))
                      .HtmlAttributes(new { style = "height:550px;" })
                      .DataSource(dataSource => dataSource
                      .Ajax()
                      //.PageSize(10)
                      .Model(model => model.Id(f => f.Id))
                      .Read(read => read.Action("GetResourceGroups", "MetaData"))
                      .Create(create => create.Action("AddResourceGroup", "MetaData"))
                      .Update(update => update.Action("EditREsourceGroup", "MetaData"))
                      .Destroy(destroy => destroy.Action("DeleteResourceGroup", "MetaData"))

                          ))
        </div>
    </div>
</div>