@using WebUI.Areas.RetirementAccelerator.Models;
@using WebUI.Areas.RetirementAccelerator;
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data;
@using System.Collections;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Infrastructure;
@using Kendo.Mvc.Resources
@using Kendo.Mvc.Extensions;

<div style="margin:5px;" class="custom-kendo-grid">

    <!--Kendo Grid-->

    @(Html.Kendo().Grid<SupportCostModel>()
            .Name("SupportCostGrid")
            .Columns(columns =>
            {
                columns.Bound(p => p.Id).Hidden();
                columns.Bound(p => p.SupportActivity).Title("ACTIVITY");
                columns.Bound(p => p.AnnualFTE).Title("CURRENT ANNUAL SUPPORT FTE'S");
                columns.Bound(p => p.BlendedRate).Title("CURRENT BLENDED RATE ($/HR)");
                columns.Bound(p => p.AnnualSupportCost).Title("CURRENT ANNUAL SUPPORT COST ($)");
                columns.Bound(p => p.FutureAnnualSupportFTE).Title("FUTURE ANNUAL SUPPORT FTE'S");
                columns.Bound(p => p.FutureBlendedRate).Title("FUTURE BLENDED RATE ($/HR)");
                columns.Bound(p => p.FutureAnnualSupportCost).Title("FUTURE ANNUAL SUPPORT COST ($)");
                columns.Bound(p => p.AnnualFTESavings).Title("ANNUAL SUPPORT FTE SAVINGS");
                columns.Bound(p => p.AnnualCostSavings).Title("ANNUAL SUPPORT COST SAVINGS");

            })
            .ToolBar(toolbar =>
            {
                toolbar.Save();

            })

            .Editable(editable => editable.Mode(GridEditMode.InCell))
            .Navigatable()
            .Sortable()
            .HtmlAttributes(new { @style = "height:550px" })
            .Scrollable()
            .DataSource(dataSource => dataSource
                .Ajax()
                .Batch(true)
                .ServerOperation(false)
                //.Events(events => events.Error("error_handler"))
                .Model(model =>
                {
                    model.Id(p => p.Id);
                    model.Field(r => r.SupportActivity).Editable(false);

                })
                .Read(read => read.Action("SupportCostRead", "Assessment").Data("GetAppId"))
                .Update(up => up.Action("SupportCostSave", "Assessment"))
            )
    )


</div>






