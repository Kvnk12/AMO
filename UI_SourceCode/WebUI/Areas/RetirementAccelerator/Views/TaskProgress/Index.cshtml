                                                        var StatusText = sl.Text;
                                                        var StatusValue = sl.Value;
                                                        <option value="@StatusValue">@StatusText</option>
                                                    }
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="tabPopup labelstyleee">
                                            <label class="labelstyleee">Milestone </label>
                                        </td>
                                        <td class="tabPopup">
                                            <input type="checkbox" class="checkboxFour" name="Milestone" />
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="tabPopup labelstyleee">
                                            <label class="labelstyleee">Estimated Start Date</label>
                                        </td>
                                        <td class="tabPopup">
                                            <input data-role="datetimepicker" name="EstimatedStart" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="tabPopup labelstyleee">
                                            <label class="labelstyleee">Estimated End Date</label>
                                        </td>
                                        <td class="tabPopup">
                                            <input data-role="datetimepicker" name="EstimatedEnd" />
                                        </td>
                                    </tr>



                                </tbody>
                            </table>


                        </td>
                        <td width="15%">
                        </td>
                        <td>
                            <table>
                                <tbody>
                                    <tr>
                                        <td class="tabPopup labelstyleee">
                                            <label class="labelstyleee">Estimated Efforts(Hrs)</label>
                                        </td>
                                        <td class="tabPopup">
                                            <input class="txtbxStyle" name="EstimatedEfforts" type="number" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="tabPopup labelstyleee">
                                            <label class="labelstyleee">Actual Efforts(Hrs) </label>
                                        </td>
                                        <td class="tabPopup">
                                            <input class="txtbxStyle" type="number" name="ActualEfforts" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="tabPopup labelstyleee">
                                            <label class="labelstyleee">Role</label>
                                        </td>
                                        <td class="tabPopup">
                                            <select class="txtbxStyle" name="RoleId">
                                                @{

                                                    foreach (var role in rolesList)
                                                    {
                                                        var roleText = role.Text;
                                                        var roleValue = role.Value;
                                                        <option value="@roleValue">@roleText</option>
                                                    }
                                                }
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="tabPopup labelstyleee">
                                            <label class="labelstyleee">Resource Group </label>
                                        </td>
                                        <td class="tabPopup">
                                            <select class="txtbxStyle" name="ResourceGroupId">
                                                @{

                                                    foreach (var res in ResourceGroupList)
                                                    {
                                                        var resourceText = res.Text;
                                                        var resourceValue = res.Value;
                                                        <option value="@resourceValue">@resourceText</option>
                                                    }
                                                }
                                            </select>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="tabPopup labelstyleee">
                                            <label class="labelstyleee"> Work Product </label>
                                        </td>
                                        <td class="tabPopup">
                                            <select class="txtbxStyle" name="WorkProdId">
                                                @{

                                                    foreach (var res in WorkProdList)
                                                    {
                                                        var workProdText = res.Text;
