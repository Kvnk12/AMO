                border-radius: 5px 5px 5px 5px;
                position: relative;
                box-shadow: 0px 1px 3px rgba(0,0,0,0.5);
            }



    </style>





    <script id="RATaskPopupEditor" type="text/x-kendo-template">
        <div style="margin:10px;">
            <table>
                <tbody>
                    <tr>
                        <td>
                            <table>
                                <tbody>
                                    <tr>
                                        <td class="tabPopup labelstyleee">
                                            <label class="labelstyleee">Title</label>
                                        </td>
                                        <td class="tabPopup">
                                            <input class="txtbxStyle" name="title" type="text" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="tabPopup labelstyleee">
                                            <label class="labelstyleee">Actual Start Date </label>
                                        </td>
                                        <td class="tabPopup">
                                            <input data-role="datetimepicker" name="start" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="tabPopup labelstyleee">
                                            <label class="labelstyleee">Actual End Date </label>
                                        </td>
                                        <td class="tabPopup">
                                            <input data-role="datetimepicker" name="end" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="tabPopup labelstyleee">
                                            <label class="labelstyleee">Completion </label>
                                        </td>
                                        <td class="tabPopup">
