.BindTo(LOBlist)

.Enable(true)
.AutoBind(true)
    .Events(e =>
    {
        e.Change("onChangePortfolio");
    })
                        //.HtmlAttributes(new { style = "width:350px;" })
                        )
                    </div>
                </td>
                <td>
                    <label class="custom-black-label">Application:</label> 
                    
                         
                </td>
                <td>
                    <div class="custom-combobox">
                        @(Html.Kendo().ComboBox()
              .Name("Application")
              //.HtmlAttributes(new { style = "width:350px;" })
              //.Placeholder("Select Application...")
              .DataTextField("Text")
              .DataValueField("Value")
              .Filter(FilterType.Contains)

              .DataSource(source =>
              {
                  source.Read(read =>
                  {
                      read.Action("Cascading_Get_Applications", "APRAjaxService")
                          .Data("filterApplications");
                  })
                  .ServerFiltering(true);
              })
               .Events(e =>
               {
                   e.Change("onChangeApp");
               })
               .SelectedIndex(0)
              .Enable(false)
              .AutoBind(false)
              .CascadeFrom("Portfolio")
                        )
                    </div>
                </td>
            </tr>
        </table>
        
    </div>
    
