                    //.Pageable()
                    // .Scrollable()
                    //.Sortable()
                    //.Filterable()
                    //.ToolBar(tools => tools.Excel())

                    .Columns(col =>
                    {
                        col.Bound(c => c.PerspectiveName).Width(250);
                        col.Bound(c => c.BBTRating).Width(100).ClientTemplate("#= LineItems_Databound(BBTRating)#");
                        col.Bound(c => c.STRating).Width(100).ClientTemplate("#= LineItems_Databound(STRating)#");

                    })
            .HtmlAttributes(new { style = "height:258px" })
            .DataSource(datasource => datasource
                .Ajax()
                .Read(read => read.Action("AppClientHeatmap", "MultiTenantReporting").Data("ParameterData"))
            )
            )
    </div>
</div>
</div>
<script>

    $(document).ready(function () {
        var grid = $("#ClientHeatMap").data("kendoGrid");

        grid.dataSource.read();
    });

    function ParameterData() {
        //var Appdata = $("#AppName").val();
        //var PId = PerspectiveTypeID
        //var Sur = $("#appsurvey").data("kendoDropDownList");
        //PerspectiveTypeID = 0;//Setting
        var App = $("#Application").data("kendoComboBox")
        return {
            //SurveyId: Sur.value(),
           
            //AppId: Appdata
            AppName: App.text(),

            AppId: App.value()
        }
    }

    function ConfigItemChange() {

        updateDashboard();

    }

    function filterApplications() {
        return {
            Portfolio: $("#Portfolio").val(),
           
        };
        var grid = $("#ClientHeatMap").data("kendoGrid");

        grid.dataSource.read();
    }


    function onChangeApp() {
      
        var grid = $("#ClientHeatMap").data("kendoGrid");

        grid.dataSource.read();
    }

    function onChangePortfolio() {

        var grid = $("#ClientHeatMap").data("kendoGrid");

        grid.dataSource.read();
    }

    function LineItems_Databound(x) {
        var formatNum = parseFloat(x);
        if (x < 3) {
            return "<div style='background: red; color: red;'>" + formatNum + "</div>";
        }
        else if (x >= 3 && x < 4) {
            return "<div style='background: yellow; color: yellow;'>" + formatNum + " </div>";
        }
        else if (x >= 4) {
            return "<div style='background: green;  color: green;'>" + formatNum + " </div>";
        }
        else {
            return formatNum;
        }
    }

    $(".export-img").click(function () {
        // Convert the DOM element to a drawing using kendo.drawing.drawDOM
        kendo.drawing.drawDOM($(".divHeatmap"))
        .then(function (group) {
            // Render the result as a PNG image
            return kendo.drawing.exportImage(group);
        })
        .done(function (data) {
            // Save the image file
            kendo.saveAs({
                dataURI: data,
                fileName: "Heatmap.png",
                proxyURL: "@Url.Action("Pdf_Export_Save")"
            });
    });
    });
</script>
