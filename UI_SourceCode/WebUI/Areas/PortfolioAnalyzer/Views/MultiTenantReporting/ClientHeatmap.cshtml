    <div class="custom-kendo-grid divHeatmap" style="padding:10px;">
        @(Html.Kendo().Grid<ClientHeatmapModel>()
                            .Name("ClientHeatMap")
                            //.Excel(excel => excel
                            //    .FileName("APRAppInventoryData")
