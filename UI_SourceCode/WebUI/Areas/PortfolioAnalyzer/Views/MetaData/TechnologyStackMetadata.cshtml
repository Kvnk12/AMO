    function resetForm($form) {
        $form.find('input:text, input:password, input:file, select, textarea').val('');
        $form.find('input:radio, input:checkbox')
             .removeAttr('checked').removeAttr('selected');
    }



    function getFormData($form) {
        var unindexed_array = $form.serializeArray();
        var indexed_array = {};

        $.map(unindexed_array, function (n, i) {
            indexed_array[n['name']] = n['value'];
        });

        return indexed_array;
    }

    function InsertUpdateHost() {
        var $form = $("#form");
        var data = JSON.stringify(getFormData($form));

        //var model=JSON.stringify( $("#form").serializeArray() );
        //alert(data);
        var RootUrl = '@Url.Content("~/")';
        //var model = {
        //    AppId: appid
        //};

        //alert(myArray[0].id + " ," + myArray[0].value);
        //var data1 = { 'listObject': myArray };
        //var data = JSON.stringify(model)

        $.ajax({

            type: 'post',
            url: RootUrl + 'APRAjaxService/InsertUpdateHostlist',
            data: data,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {


            },
            error: function (err, response) {
                alert(err.responseText);
            }
        });
    }
    function ApplicationIDValue() {

        var appid = $("#AppName").val();
        //alert('check here'+appid);
        return {
            ApplicationID: appid
        };
    }


    function getHost(hostid) {


        //var appid = $("#AppName").val();

        //var RootUrl = '@Url.Content("~/")';
        var model = {
            HostId: hostid
        };
        var data = JSON.stringify(model)

        baseurl = '@Url.Content("~/APRAjaxService/GetAppHost")';
        //baseurl = baseurl + '?ApplicationID=' + appid
        //alert('post' + baseurl + $("ApplicationList").data("kendoComboBox").Value());
        $.ajax(
        {
            url: baseurl,
            type: 'post',
            data: data,
            async: false,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                //alert(response.AppDomainId);
                $('#Id').val(response.Id);
                $('#HostName').val(response.HostName);
                $("#AssetTag").val(response.AssetTag);
                $("#IPAddress").val(response.IPAddress);
                $("#OperatingSystem").val(response.OperatingSystem);
                $("#OSVersion").val(response.OSVersion);
                $("#ServerModel").val(response.ServerModel);
                $("#NoOfCoreProcessors").val(response.NoOfCoreProcessors);
                $("#CPUSpeed").val(response.CPUSpeed);
                $("#RAM").val(response.RAM);
                $("#TotalCPUs").val(response.TotalCPUs);
                $("#DiskSpace").val(response.DiskSpace);
                $("#ServerBuilding").val(response.ServerBuilding);
                $("#ServerLocation").val(response.ServerLocation);
                $("#VendorName").data("kendoComboBox").value(response.VendorName);
                //$("#AppDomainId").data("kendoDropDownList").value(response.AppDomainId);
                //$("#AliasName").val(response.AliasName);
                //$("#OwningCompanies").val(response.OwningCompanies);

            },
            error: function (data) {
                //alert('err' + data);
            }

        });
    }
