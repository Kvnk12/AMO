            .armchair img {
                display: block;
                margin-bottom: 10px;
            }

        .k-window-content p {
            margin-bottom: 1em;
        }

        .k-window-content a {
            color: #BBB;
        }

        @@media screen and (max-width: 1023px) {
            div.k-window {
                display: none !important;
            }
        }
    </style>
</div>

<script type="text/javascript">
    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }
</script>
