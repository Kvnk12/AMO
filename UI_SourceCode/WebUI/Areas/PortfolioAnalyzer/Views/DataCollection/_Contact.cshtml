<script>
    $("#customButtonStoretoApp").click(function (e) {
        e.preventDefault();
        //var chart = $("#chart").data("kendoChart");
        //chart.dataSource.read();
        //chart.refresh();
        var appid = $("#AppName").val();

        var myArray = Array();
        var grid = $('#gridPersonnel').data('kendoGrid');
        var rows = grid.select();
        var RootUrl = '@Url.Content("~/")';
        rows.each(
            function () {
                var dataItem = grid.dataItem($(this));
                id = dataItem.Id;
                //IncidentID = dataItem.Incidentid;
                //alert('Selected : ' + IncidentID);
                myArray.push({ id: id, AppId: appid });
            }
        )
        //alert(myArray[0].id + " ," + myArray[0].value);
        var data1 = { 'listObject': myArray };
        var data = JSON.stringify(data1)
        $.ajax({
            type: 'post',
            url: RootUrl + 'APRAjaxService/InsertPersonnelRole',
            data: data,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                var gridPersonnel = $("#gridPersonnel").data("kendoGrid");

                if ($("#gridPersonnel .k-state-selected").length > 0) {
                    gridPersonnel.clearSelection();
                }
                gridPersonnel.dataSource.read();
                alert("Contacts stored successfully");

                var GridPersonnelRole = $("#GridPersonnelRole").data("kendoGrid");
                GridPersonnelRole.dataSource.read();
                $('#GridPersonnelRole').data('kendoGrid').refresh();

                console.log("contact saved successfully");
            },
            error: function (response) {
                alert("error occured");
            }
        });

    });

    function LoadDestinationCluster() {

        return {

            AppId: $("#AppName").val()

        };
    }


    function onGridPersonnelRoleEdit(arg) {
        // i have assumed that newly addded row have ID field's value is Zero.
        if (arg.model.Id) {
            var _id = parseInt(arg.model.Id);
            if (_id != 0) {
                if (arg.container.find("input[name=PersonnelId]").length > 0) {

                    $("#GridPersonnelRole").data("kendoGrid").closeCell(arg.container)

                }
            }
        }

    }
</script>

