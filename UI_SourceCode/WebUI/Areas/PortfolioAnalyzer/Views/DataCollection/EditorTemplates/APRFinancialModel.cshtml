@using WebUI.Areas.PortfolioAnalyzer.Models;
@model APRFinancialModel
<style>
    .k-widget.k-window{
        width:70%;
    }
    .k-popup-edit-form .k-edit-form-container .k-edit-buttons{
        width:850px;
    }
</style>
@{
    ViewBag.Title = "Financial";
    var dictionary = new Dictionary<int, string>
{
    { 2018, "2018" },
    { 2017, "2017" },
    { 2016, "2016" },
    { 2015, "2015" },
    { 2014, "2014" },
    { 2013, "2013" },
    { 2012, "2012" },
    { 2011, "2011" },
    { 2010, "2010" }
    };
}

<div style="width:850px;padding:0 1em">
    <table>
        <tr>
            <td style="width:150px">
                @*@(Html.TextBoxFor(p => p.Id, new { @class = "k-textbox" }))*@
                @Html.HiddenFor(x => x.Id, new
                {
                    id = "Id",
               Name = "Id"
           })
                <span data-for="ID" class="k-invalid-msg"></span>
            </td>
            <td style="width:150px">
                  @Html.HiddenFor(x => x.AppId, new
                {
                    id = "AppId",
                    Name = "AppId"
                    })
            </td>

        </tr>
    </table>
    <table style="width:100%;height:100%;">
        <tr>
            <td>
                <table>
                    <tr>
                        <td>
                            <table>
                                <tr>
                                    <td>
                                        <Label class="custom-blue-label">Year: </Label>
                                        </td>
