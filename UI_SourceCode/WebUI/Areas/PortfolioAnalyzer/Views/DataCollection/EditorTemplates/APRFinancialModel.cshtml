                                        <div class="custom-dropdown">
                                        @(Html.Kendo().DropDownListFor(m => m.Year)
                                                         .Name("Year")
                                                         .OptionLabel("Select")
                                                          .DataTextField("Text")
                                                          .DataValueField("Value")
                                                     .DataSource(datasource => datasource
                                                    .Read(read => read.Action("getYears", "AppDashboard"))
                                                    )
                                                     )
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td>
