                                        <th>External FTEs </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><label>Discretionary :</label></td>
                                        <td>
                                            <div class="apr-numeric-textbox">
                                                @(Html.Kendo().NumericTextBoxFor(m => m.DiscretionaryCostInternal)
            .Name("DiscretionaryCostInternal")
            .HtmlAttributes(new { @style = "text-align:right" })
            .Format("c")
            .Min(0)
                                                )
                                            </div>

                                        </td>
                                        <td>
                                            <div class="apr-numeric-textbox">
                                                @(Html.Kendo().NumericTextBoxFor(m => m.DiscretionaryCostExternal)
            .Name("DiscretionaryCostExternal")
            .HtmlAttributes(new { @style = "text-align:right" })
            .Format("c")
            .Min(0)
                                                )
                                            </div>

                                        </td>
                                        <td>
                                            <div class="apr-numeric-textbox">
                                                @(Html.Kendo().NumericTextBoxFor(m => m.DiscretionaryFTEInternal)
                                                        .Name("DiscretionaryFTEInternal")
                                                        .HtmlAttributes(new { @style = "text-align:right" })
                                                )
                                                </div>
                                        </td>
                                        <td>
                                            <div class="apr-numeric-textbox">
                                                @(Html.Kendo().NumericTextBoxFor(m => m.DiscretionaryFTEExternal)
                                                        .Name("DiscretionaryFTEExternal")
                                                        .HtmlAttributes(new { @style = "text-align:right" })
                                                )
                                                </div>
                                        </td>
