@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.PortfolioAnalyzer.Controllers;
@using WebUI.Areas.PortfolioAnalyzer.Dto;
@using WebUI.Areas.PortfolioAnalyzer.Models;
@using Kendo.Mvc.UI;
@using System.Data;
@using System.Collections.Generic;
@using System.Collections;
@model ApplicationInformationModel

@{
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />


    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/JScript/kendo.all.min.js"></script>
    <script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>
    //ViewBag.ImagePathOne = Url.Content("~/Content/images/pplogo.png");
    ViewBag.Title = "Portfolio Analyzer";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/home/portfolio_analyzer_white.svg");
    Layout = "~/Views/Shared//GenericLayout.cshtml";
}

<div class="content-main dark-bg">
    <div>
        <!--start of breadcrumb-->
        <ol class="breadcrumb">
            <li>Portfolio Analyzer</li>
            <li>Data Collection</li>
            <li class="active">Demographics/Cost</li>
        </ol>
    </div>
    <div>
        <!-- Wrap all page content here -->
        @Html.Partial("_APRHeaderFilters")

    </div>
    @using (Html.BeginForm("IndexAction", "DataCollection", FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id, new { id = "Id" })
        <div class="apr-Demographics-cost">
                    <div class="apr-progress-bar">
                        @(Html.Kendo().ProgressBar()
                              .Name("profileCompleteness")
                              .Type(ProgressBarType.Value)
                              .ShowStatus(false)
                              .Min(0)
                              .Max(7)
                              .Value(1)
                        )
                        </div>
                        <div class="custom-kendo-tabstrip">
                            @(Html.Kendo().TabStrip()
                          .Name("tabstrip")
                          .Items(tabstrip =>
                          {
                              tabstrip.Add().Text("Basic Info")
                                  .Selected(true)

                                  .Content(m => Html.Partial("_contactInfo", Model)
                                   );

                              tabstrip.Add().Text("Life Cycle & Criticality")
                                  .Enabled(false)
                                  .Content(m => Html.Partial("_LifeCycle", Model));

                              tabstrip.Add().Text("Performance")
                                  .Enabled(false)
                                  .Content(m => Html.Partial("_Performance", Model));

                              tabstrip.Add().Text("Arch & Geography")
                                  .Enabled(false)
                                  .Content(m => Html.Partial("_ArchGeo", Model));

                              tabstrip.Add().Text("Cost")
                                  .Enabled(false)
                                  .Content(m => Html.Partial("_Financial", Model));

                              tabstrip.Add().Text("Notes")
                                  .Enabled(false)
                                  .Content(m => Html.Partial("_Notes", Model));

                              tabstrip.Add().Text("Contacts")
                                .Enabled(false)
                                .Content(m => Html.Partial("_Contact", Model));

                          })
                        .Events(ev =>
                        {
                            ev.Select("onSelect");
                            ev.Show("onShow");
                            ev.ContentLoad("onContentload");
                        })

                        )
                        </div>
                    </div>
    }
</div>
