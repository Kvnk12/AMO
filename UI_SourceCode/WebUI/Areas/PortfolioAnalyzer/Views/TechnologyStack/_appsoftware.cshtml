        //        var model = e.items[0];
        //        model.set("ProductId", 0);
        //    }
        //}
    }

    function getCurrentEditedModel() {
        var grid = $("#softwareGrid").data("kendoGrid");
        var editRow = grid.tbody.find("tr:has(.k-edit-cell)");
        return grid.dataItem(editRow);
    }

    function filterVendors() {
        //var model = getCurrentEditedModel();
       
        return {
            VendorId: $("#VendorId").data("kendoDropDownList").value()
        };
    }

    function filterProducts() {
        //var model = getCurrentEditedModel();
      
        return {
            ProductId: $("#VendorProductId").data("kendoDropDownList").value()
        };
    }
</script>