<script id="EcoGridTemplate" type="text/kendo-tmpl">
    
    @(Html.Kendo().Grid<PortfolioEcoModel>()
            .Name("AppGrid#=LOBId#")
            .Columns(columns =>
            {
                columns.Bound(e => e.EcoId).Hidden();//.ClientTemplate("#:ApplicationName#");
                columns.Bound(e => e.EcoSystemName).Title("EcoSystem"); //to be worked
                                                                        //columns.Bound(p => p.Category).ClientTemplate("#=ecosystem.EcosystemName#").Sortable(false).Width(180);
                columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);
            })
    .Sortable()
    .Editable(editable => editable.Mode(GridEditMode.PopUp).ConfirmDelete("test").DisplayDeleteConfirmation("Are you sure you want to delete?"))
    .HtmlAttributes(new { style = "height:350px;" })
    .Pageable()

     .ToolBar(
   tools =>
   {
       tools.Create().Text("Add EcoSystem");
   })
    .Scrollable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Model(model =>
        {
            model.Id(o => o.LobEcoId); model.Field(f => f.LobEcoId).Editable(false);
        })
        .PageSize(10)
        .Read(read => read.Action("GetEcosForLOB", "PortfolioEco", new { Id = "#=LOBId#" }))
        .Create(create => create.Action("CreateEcoApp", "PortfolioEco", new { Id = "#=LOBId#" }))
        .Update(update => update.Action("EditingLOBEco", "PortfolioEco"))
        .Destroy(delete => delete.Action("DeleteLOBEco", "PortfolioEco"))
    )
    .Events(events => events
     .DataBound("onDataBound")
    .Save("EcoSystemGrid_Save"))
     .ClientDetailTemplateId("AppsGridTemplate")
    .ToClientTemplate())

</script>

<script id="AppsGridTemplate" type="text/kendo-tmpl">

    @(Html.Kendo().Grid<PortfolioEcoAppsModel>()
            .Name("AppGrid#=LobEcoId#")
            .Columns(columns =>
            {
                columns.Bound(e => e.AppId).Hidden();//.ClientTemplate("#:ApplicationName#");
                columns.Bound(e => e.ApplicationName).Title("Application/Service"); //to be worked
                columns.Bound(e => e.ClientApplicationNumber).Title("Client Application/Service Number")/*.Width(100)*/;
                columns.Bound(e => e.ApplicationAliasName).Title("Alias Name")/*.Width(100)*/;
                //columns.Bound(e => e.ApplicationName).Title("Application Name ");
                columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);
            })
    .Sortable()
    .Editable(editable => editable.Mode(GridEditMode.PopUp).ConfirmDelete("test").DisplayDeleteConfirmation("Are you sure you want to delete?"))
    .HtmlAttributes(new { style = "height:350px;" })
    .Pageable()

     .ToolBar(
   tools =>
   {
       tools.Create().Text("Add Application/Service");
   })
    .Scrollable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Model(model =>
        {
            model.Id(o => o.PEAId);
        })
        .PageSize(10)
        .Read(read => read.Action("GetAppsbyLOBECOId", "PortfolioEco", new { LobEcoId = "#=LobEcoId#" }))
        .Create(create => create.Action("CreateAppsByLOBEcoId", "PortfolioEco", new { Id = "#=LobEcoId#" }))
        .Update(update => update.Action("UpdateAppsByLOBEcoId", "PortfolioEco"))
        .Destroy(delete => delete.Action("DeleteAppsByLOBEcoId", "PortfolioEco"))
    )
    .Events(events => events
     // .DataBound("onDataBound")
    .Save("ApplicationGrid_Save"))
    .ToClientTemplate())

</script>



