        <div style="display:none">

            @(Html.Kendo().Grid<PortfolioEcoAppsModel>()
        @*@(Html.Kendo().Grid(Model.ClusterReportlist)*@
    .Name("Grid")

    .Columns(columns =>
    {

        columns.Bound(p => p.PortFolioName).Title("PortFolio");
        columns.Bound(p => p.EcoSystemName).Title("EcoSystem");
        columns.Bound(p => p.ApplicationName).Title("Application");
        columns.Bound(p => p.ClientApplicationNumber).Title("Client Application Id");
        columns.Bound(p => p.ApplicationType).Title("Application Type");
    })
    .HtmlAttributes(new { style = "height: 500px;width:100%" })
