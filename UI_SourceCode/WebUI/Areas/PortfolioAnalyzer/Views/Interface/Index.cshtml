    function OnApplicationChange() {
        //$('[name="EntangledInterface"]').removeAttr('checked');
        var appid = $("#AppName").val();
        $('[name="EntangledInterface"]').removeAttr('checked');

        var model = {
            AppId: appid,
        };
        var data = JSON.stringify(model);
       var ReadURl = '@Url.Content("~/APRAjaxService/GetInterfaceDetail")';

        $.ajax(
            {
                url: ReadURl,
                type:'post',
                data: data,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    //alert(data.InboundInterface);
                    $('#lblErr').hide();
                   $('#lblSuccess').hide();

                    $("#InboundInterface").val(data.CountInboundInterfaces);

                    $("#OutboundInterface").val(data.CountOutboundInterfaces);
                    if (data.EntangledInterface == true) {
                     
                        $('#EntangledInterface').prop('checked', true);
                    } else {
                        $('#EntangledInterface').prop('checked', false);
                    }
                    //$("#InterfaceMethods").val(data.InterfaceMethods);
                    $("#InterfaceMethods").data("kendoMultiSelect").value(data.InterfaceMethods);
                }

            })

    }
    $(window).on('load', function () {
        OnApplicationChange();
    });
