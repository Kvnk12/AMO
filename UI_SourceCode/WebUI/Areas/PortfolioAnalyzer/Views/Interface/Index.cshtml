        function onSaveClick(e) {
            var appid = $("#AppName").val();

            var EntangledInterface = $('#EntangledInterface').prop('checked');
            var Inbound = $("#InboundInterface").val();
            var Outbound = $("#OutboundInterface").val();
            var multi = $("#InterfaceMethods").data("kendoMultiSelect");
           // var multi = $("#InterfaceMethods").val();
           // console.log(multi);
            var cid = multi.value();
            $('input:hidden[name=InterfaceMethodsId]').val(cid);

            var model = {
                Id: appid,
                CountInboundInterfaces: Inbound,
                CountOutboundInterfaces: Outbound,
                EntangledInterface: EntangledInterface,
                InterfaceMethodsId: cid,


            };
            var data = JSON.stringify(model);
            var RootUrl = '@Url.Content("~/")';

            $.ajax(
           {
               type: 'post',

               url: RootUrl + 'APRAjaxService/SetInterfaceDetail',
               data: data,
               async: true,
               contentType: 'application/json; charset=utf-8',
               success: function (data) {
                   //alert("bc")
                   $('#alertModal').modal('show');
                   $('#lblErr').hide();
                   $('#lblSuccess').show();
               },
                    error: function (err, data) {
                   $('#alertModal').modal('show');
                   $('#lblErr').show();
                   $('#lblSuccess').hide();
               }

           });

        }
