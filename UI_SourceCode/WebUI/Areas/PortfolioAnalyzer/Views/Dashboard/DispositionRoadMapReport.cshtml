<div class="content-main dark-bg">

    <div>
        <!--start of breadcrumb-->
        <ol class="breadcrumb ">
            <li >Portfolio Analyzer</li>
            <li >Disposition Road Map</li>
        </ol>

    </div>

    @*<div id ="circle" style="background-color:red;border-color:black;" ></div >*@


        @*<div class="clearfix"></div>*@<!--This is to clear the floats-->

        <div class="custom-kendo-grid apr-disposition-roadmap-report">

            @(Html.Kendo().Grid<DispositionRoadMapModel>()
        @*@(Html.Kendo().Grid(Model.ClusterReportlist)*@
.Name("Grid")

.Columns(columns =>
{
    columns.Bound(p => p.ClientApplicationNumber).Title("Application Number").Width(250);
    columns.Bound(p => p.ApplicationName).Title("Application Name").Width(250).ClientFooterTemplate("Total Count: #=count#")
            .ClientGroupFooterTemplate("Count: #=count#");
    columns.Bound(p => p.DispositionName).Title("Planned Disposition").Filterable(ftb => ftb.Multi(true)).Width(150).ClientGroupFooterTemplate("Count: #=count#");
    //columns.Bound(d => d.Color).Title("color").Width(150);
    columns.Bound(p => p.DispositionActionType).Title("Disposition Action Immediacy").Filterable(ftb => ftb.Multi(true)).Width(100).HeaderHtmlAttributes(new { style = "white-space: normal" }).HtmlAttributes(new { style = "text-align:center;" }).ClientTemplate(
"# if (Color != null) { #" +

//"<div id='" + "circle'></div>" +
"<center><div id='" + "circle' align='center' style='background-color: #= Color # !important'></div></center>" +
//"<img src='" + Url.Content("~/Content/icons/") + "#= Color #.png' alt='#= Color # icon' />" +
"# } else { #" +
"#: DispositionActionType #" +
"# } #"
)
            //.ClientFooterTemplate("Total Disposition: #=count#")
            ;

    // columns.Bound(p => p.DispositionActionType).Title("Disposition Action Type").HeaderHtmlAttributes(new { style = "white-space: normal" }).Filterable(ftb => ftb.Multi(true)).Width(150);
    columns.Bound(p => p.DispositionRationaleType).Title("Disposition Rationale").HeaderHtmlAttributes(new { style = "white-space: normal" }).Filterable(ftb => ftb.Multi(true)).Width(150);
    columns.Bound(p => p.OriginalRetirementDate).ClientTemplate("#if(OriginalRetirementDate === null){# N/A #}else{# #= kendo.toString(kendo.parseDate(OriginalRetirementDate), 'dd/MM/yyyy') # #}#").HeaderHtmlAttributes(new { style = "white-space: normal" }).Title("Original Retirement Date").Width(120);
    columns.Bound(p => p.PlannedDispositionDate).ClientTemplate("#if(PlannedDispositionDate === null){# N/A #}else{# #= kendo.toString(kendo.parseDate(PlannedDispositionDate), 'dd/MM/yyyy') # #}#").HeaderHtmlAttributes(new { style = "white-space: normal" }).Title("Planned Disposition Date").Width(120);
    columns.Bound(p => p.ApplicationClassificationName).HeaderHtmlAttributes(new { style = "white-space: normal" }).Title("Classification Name").Width(120);
    columns.Bound(p => p.Year).Title("Cost Year").Width(150);
    columns.Bound(p => p.Totalcost).Title("Total Cost").Width(250);
    //columns.Bound(p => p.AvgResolutionTime).Title("Avg.Resolution Time in hours").Width(230).HtmlAttributes(new { style = "text-align:right;" });
    //columns.Bound(p => p.AvgCostPerTicket).Title("Avg. Cost of Resolving Tickets").Width(230).HtmlAttributes(new { style = "text-align:right;" });

})
//.Pageable(pageable => pageable
//   .Input(true)
//   .Numeric(false)
// )
.Sortable()
// .Pageable()
.Groupable()
.Scrollable(scr => scr.Height(430))
.Resizable(resize => resize.Columns(true))
.Filterable()
.ColumnMenu()
.AutoBind(true)
.ToolBar(
        tools =>
        {
            tools.Excel();
            tools.Pdf();

        })
 .Excel(excel => excel
        .FileName("DispositionRoadmap.xlsx")
        .Filterable(true)
        .AllPages(true)
        .ProxyURL(Url.Action("Excel_Export_Save", "AjaxService"))
    )
    .Pdf(pdf => pdf
            .AllPages()
            .AvoidLinks()
            .PaperSize("A4")
            .Scale(0.8)
            .Margin("2cm", "1cm", "1cm", "1cm")
            .Landscape()
            .RepeatHeaders()
            .TemplateId("page-template")
            .FileName("DispositionRoadmap.pdf")
            .ProxyURL(Url.Action("Pdf_Export_Save", "APRAjaxService"))
        )

.DataSource(dataSource => dataSource
    .Ajax()
    .Aggregates(aggregates =>
    {
        aggregates.Add(p => p.ApplicationName).Count();
        aggregates.Add(p => p.DispositionName).Count();

    })
      // .PageSize(20)
      //.Read(read => read.Action("GetData", "AjaxService", new { ClientID = Model.ClientId }))
      .Read(read => read.Action("GetAppDispositionRoadmap", "APRAjaxService"))
 )
            )
