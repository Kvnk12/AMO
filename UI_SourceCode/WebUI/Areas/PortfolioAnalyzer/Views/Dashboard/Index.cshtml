            //var data1 = { 'listObject': myArray };
            var data = JSON.stringify(model)

            $.ajax({

                type: 'post',
                url: RootUrl + 'APRAjaxService/ApplicationDashboard',
                data: data,
                contentType: 'application/json; charset=utf-8',
                success: function (response) {

                    $('#ClientAppNumber span').text(response.ClientApplicationNumber);
                    $('#AppDescription span').text(response.Description);

                    $('#AppCriticality span').text(response.Criticality);
                    $('#AppUsers span').text(response.NoOfUsers);
                    $('#AppRevenueImpact span').text(response.RevenueImpact);
                    $('#AppCodeType span').text(response.CodeType);
                    $('#AppDomain span').text(response.AppDomain);
                    $('#AppSecurity span').text(response.SecurityLevel);
                    $('#AppTechnicalOwner span').text(response.TechnicalOwnerName);
                    $('#AppArchitecture span').text(response.Architecture);
                    $('#AppSize span').text(response.AppSize);
                    $('#AppAnalysis span').text(response.Analysis);
                    $('#AppRecommandation span').text(response.Recommendation);
