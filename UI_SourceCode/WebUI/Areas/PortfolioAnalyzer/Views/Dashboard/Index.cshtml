                },
                error: function (err, response) {
                    alert(err.responseText);
                }
            });
        }
    });
    function displayLoading(target) {
        var element = $(target);
        kendo.ui.progress(element, true);
        setTimeout(function () {
            kendo.ui.progress(element, false);
        }, 1000);
    }


    function AppNameChange() {

        updateDashboard();

    }


    function updateDashboard()
    {
        displayLoading("#container");
        //var chartTrend = $("#chartTrend").data("kendoChart");

        //alert($("#AppName").val());
        var appid = $("#AppName").val();
        //chartTrend.dataSource.read();
        //chartTrend.refresh();

        var RootUrl = '@Url.Content("~/")';
        var model = {
            AppId: appid
        };

        //alert(myArray[0].id + " ," + myArray[0].value);
        //var data1 = { 'listObject': myArray };
        var data = JSON.stringify(model)

        $.ajax({

            type: 'post',
            url: RootUrl + 'APRAjaxService/ApplicationDashboard',
            data: data,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {

                $('#ClientAppNumber span').text(response.ClientApplicationNumber);
                $('#AppDescription span').text(response.Description);

                $('#AppCriticality span').text(response.Criticality);
                $('#AppUsers span').text(response.NoOfUsers);
                $('#AppRevenueImpact span').text(response.RevenueImpact);
                $('#AppCodeType span').text(response.CodeType);
                $('#AppDomain span').text(response.AppDomain);
                $('#AppSecurity span').text(response.SecurityLevel);
                $('#AppTechnicalOwner span').text(response.TechnicalOwnerName);
                $('#AppArchitecture span').text(response.Architecture);
                $('#AppSize span').text(response.AppSize);
                $('#AppAnalysis span').text(response.Analysis);
                $('#AppRecommandation span').text(response.Recommendation);
            },
            error: function (err,response) {
                alert(err.responseText);
            }
        });






    }


    function ddlFilterchange() {
       
        displayLoading("#tblPieChart");
        var DashboardPieCharts = $("#DashboardPieCharts").data("kendoChart");


        DashboardPieCharts.dataSource.read();
        DashboardPieCharts.refresh();
      

        var grid = $("#Grid").data("kendoGrid");
        grid.dataSource.read();
        grid.refresh();
        if ($("#ddlFilter").val() == 1) {
            $("#Grid thead [data-field=PieChartColumnName] .k-link").html("Criticality")
        }
        if ($("#ddlFilter").val() == 2) {
            $("#Grid thead [data-field=PieChartColumnName] .k-link").html("Application Type")
        }
        if ($("#ddlFilter").val() == 3) {
            $("#Grid thead [data-field=PieChartColumnName] .k-link").html("Source Code Type")
        }
        if ($("#ddlFilter").val() == 4) {
            $("#Grid thead [data-field=PieChartColumnName] .k-link").html("Disposition")
        }
        if ($("#ddlFilter").val() == 5) {
            $("#Grid thead [data-field=PieChartColumnName] .k-link").html("Business Function")
        }
    };

    function ParameterData(e) {
        var value = $("#ddlFilter").val();
       
        return {

            filterOption: $("#ddlFilter").val(),
            
        };
    }

</script>