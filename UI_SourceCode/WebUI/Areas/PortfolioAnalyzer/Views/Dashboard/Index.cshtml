                    //$("#P1Blendedrate").data("kendoNumericTextBox").value(response.P1Blendedrate);
                    //$("#P2Blendedrate").data("kendoNumericTextBox").value(response.P2Blendedrate);
                    //$("#P3Blendedrate").data("kendoNumericTextBox").value(response.P3Blendedrate);
