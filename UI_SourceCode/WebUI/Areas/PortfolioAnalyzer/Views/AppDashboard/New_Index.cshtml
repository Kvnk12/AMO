@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.PortfolioAnalyzer.Controllers;
@using WebUI.Areas.PortfolioAnalyzer.Dto;
@using WebUI.Areas.PortfolioAnalyzer.Models;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@using Kendo.Mvc.Resources
@using System.Data;
@using WebUI.Dto;
@model ApplicationDashboardModel
@{

    <link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />


    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/JScript/kendo.all.min.js"></script>
    <script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>
    ViewBag.Title = "Portfolio Analyzer";
    var clientlist = GetDropDownListItems.ClientList;
    ViewBag.ImagePathOne = Url.Content("~/Content/images/home/portfolio_analyzer_white.svg");
    Layout = "~/Views/Shared//GenericLayOut.cshtml";
    ClientDetail client = (ClientDetail)Session["SessionClient"];
    var v = new APRAjaxServiceController();
    var ApplicationList = v.ApplicationList(client.ClientId);
}
<style>
    #ExportToPDF {
        page-break-inside: auto;
    }
</style>

<div class="content-main dark-bg">

    <ol class="breadcrumb">
        <li>Portfolio Analyzer</li>
        <li class="active">Application Dashboard</li>
    </ol>

    <div class="portfolio-analyzer" id="AppDashboardOverview" style="padding:0;">
        <div class="portfolio-analyzer-header">
            <label class="custom-white-label" style="padding-top:6px">Application/Service Name: </label>
            <div class="custom-combobox" style="margin-left:8px;margin-top:-4px">
                @(Html.Kendo().ComboBox()
                    .Name("AppName")
                    .Filter("contains")
                    .Placeholder("Select Application")
                    .DataTextField("Text")
                    .DataValueField("Value")
                    //.Events(e => e.Change("AppNameChange"))
                    .BindTo(ApplicationList)
                    .Enable(true)
                    .AutoBind(true)
                )


            </div>
        </div>
        <div class="tab-container">
            <div class="tab-main">
                <span id="ApplicationOverviewTab" class="tab-link active" onclick="openTab(event, 'ApplicationOverview')">Application Overview</span>
                <span id="CostReportValuesTab" class="tab-link" onclick="openTab(event, 'CostReportValues')">Cost Report(s)/Values</span>
                <span id="RecommendationTab" class="tab-link" onclick="openTab(event, 'Recommendation')">Recommendation</span>
                <span id="DispositionTab" class="tab-link" onclick="openTab(event, 'Disposition')" style="display:none;">Disposition</span>
            </div>
            <div class="export-button">
                <button type="submit" id="ExportToPDFbtn">Export -       </button>
            </div>
        </div>
        <div id="ExportToPDF">
            <div id="ApplicationOverview" class="tab-content">
                @Html.Partial("_ApplicationOverview", Model)
            </div>
            <div id="CostReportValues" class="tab-content" style="display:none">
                @Html.Partial("_CostValueDashboard", Model)
            </div>
            <div id="Recommendation" class="tab-content" style="display:none">
                @Html.Partial("_RecommendationDashboard", Model)
            </div>
            <div id="Disposition" class="tab-content" style="display:none">
                @Html.Partial("_DispositionDashboard", Model)
            </div>
        </div>
          
        </div>
    </div>
