    //Functions for Tab Click..
    function openTab(evt, divName) {
        var i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tab-content");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }
        tablinks = document.getElementsByClassName("tab-link");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].className = tablinks[i].className.replace(" active", "");
        }
        document.getElementById(divName).style.display = "block";
        evt.currentTarget.className += " active";
    }

    $("#ExportToPDFbtn").click(function (e) {
        e.preventDefault();
        var dataItem = $("#AppName").val(); // this.dataItem(e.item);
        var dat = {
            Id: dataItem
         }
        var dataa = JSON.stringify(dat);
        console.log(dataItem);
        var baseurl1 = '@Url.Content("~/AppDashboard/appData")';
         if (dataItem.Value != "") {
             $.ajax({
                 async: false,
                 type: "post",
                 url: baseurl1,
                 data: dataa,
                 contentType: "application/json; charset=utf-8",
                 success: function (response) {
                     console.log(response);
                     var idx = response.IncludeAlternativeDashboard;
                     var Application = response.ApplicationName + "_Dashboard.pdf";
                     var app = 0;
                     var cost = 0;
                     var recomm = 0;
                     if ($('#ApplicationOverview').css('display') == 'none') {
                         app = 1;
                     }
                     if ($('#CostReportValues').css('display') == 'none') {
                         cost = 1;
                     }
                     if ($('#Recommendation').css('display') == 'none') {
                         recomm = 1;
                     }

                     var activeTab = $(".tab-content").find(".active");
                     var id = activeTab.attr('id');
                     console.log(id);
                     $("#appOverview-tab2").css('display', 'block');
                     $("#appOverview-tab3").css('display', 'block');
                     $("#appOverview-tab4").css('display', 'block');
                     $("#appOverview-tab5").css('display', 'block');
                     $("#CostReportValues").css('display', 'block');
                     $("#Recommendation").css('display', 'block');
                     $("#ApplicationOverview").css('display', 'block');
                     //$("#ApplicationOverviewTab").addClass('active');
                     //$("#CostReportValuesTab").addClass('active');
                     //$("#RecommendationTab").addClass('active');
                     if ($('#Disposition').css('display') != 'none') {
                         $("#Disposition").addClass("active");
                         $("#hideDesc").addClass('hide');
                         $("#pdfDesc").removeClass('hide');
                     }
                     $("#pdfAnalysis").css('display', 'block');
                     $("#pdfRecom").css('display', 'block');
                     $("#analysisEditor").css('display', 'none');
                     $("#recommEditor").css('display', 'none');
                     kendo.drawing.drawDOM($("#ExportToPDF"))
                         .then(function (group) {

                     return kendo.drawing.exportPDF(group, {
                         paperSize: "auto",
                     });

                 })
                         .done(function (data) {
                     kendo.saveAs({
                         dataURI: data,
                         fileName: Application,
                         proxyURL: "@Url.Action("Pdf_Export_Save", "APRAjaxService")"
                     });
                 });
                     $("#appOverview-tab2").css('display', 'none');
                     $("#appOverview-tab3").css('display', 'none');
                     $("#appOverview-tab4").css('display', 'none');
                     $("#appOverview-tab5").css('display', 'none');
                     if (app == 1)
                         $("#ApplicationOverview").css('display', 'none');
                    if (cost == 1)
                         $("#CostReportValues").css('display', 'none');
                     if (recomm == 1)
                         $("#Recommendation").css('display', 'none');

                     if (idx != 0) {
                         $("#hideDesc").removeClass('hide');
                         $("#pdfDesc").addClass('hide');
                     }

                     //$("#hideAnalysis").removeClass('hide');
                     $("#pdfAnalysis").css('display', 'none');
                     //$("#hideRecom").removeClass('hide');
                     $("#pdfRecom").css('display', 'none');
                     $("#analysisEditor").css('display', 'unset');
                     $("#recommEditor").css('display', 'unset');
                     //if (id != "ApplicationOverviewTab")
                     //    $("#ApplicationOverviewTab").removeClass('active');
                     //if (id != "CostReportValuesTab")
                     //    $("#CostReportValuesTab").removeClass('active');
                     //if (id != "RecommendationTab")
                     //    $("#RecommendationTab").removeClass('active');

                     if (id != "DispositionTab" && idx != 0) {
                         $("#DispositionTab").removeClass('active');
                     }
               }
             });
         }
    });
    function switchAppVisible(tab) {
        console.log(tab);
        var showtab = document.getElementById("arrowdown-bg" + tab);
        var hidetab = document.getElementById("arrow-bg" + tab);
        var showcontent = document.getElementById("appOverview-tab" + tab);
        if (showtab.style.display == "none") {
            showtab.style.display = "inline";
            hidetab.style.display = "none";
            showcontent.style.display = "block";
        }
        else {
            showtab.style.display = "none";
            hidetab.style.display = "inline";
            showcontent.style.display = "none";
        }

    }
