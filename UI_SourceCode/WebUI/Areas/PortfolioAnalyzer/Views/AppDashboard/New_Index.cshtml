            AppId: Appdata
        }
    }
    function refreshRatingGrid(e) {

        var Ratgrid = $("#RatingGrid").data("kendoGrid");
        Ratgrid.refresh();
        Ratgrid.dataSource.read();
    }
    function BarChartColor(x) {
        // alert(x.value);
        if (x.value < 3) {
            return "red";
        }
        else if (x.value >= 3 && x.value < 4) {
            return "yellow";
        }
        else if (x.value >= 4) {
            return "#3ed643";
        }

    }
</script>