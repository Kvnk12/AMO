    function refreshRatingGrid1(PId, Sur, Appdata) {
 
        var dat = {
            SurveyId: Sur,
            PerspectiveId: PId,
            AppId: Appdata
        }
        var dataa = JSON.stringify(dat);
        var baseurl1 = '@Url.Content("~/AppDashboard/PerspectiveTypeRating")';

        $.ajax({
            async: false,
            type: "post",
            url: baseurl1,
            data: dataa,
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                var ratDataSource = new kendo.data.DataSource({
                    data: response
                });
                var ratingGrid = $('#RatingGrid').data('kendoGrid');
                ratingGrid.setDataSource(ratDataSource);
            }
        });
    }
        
    function RefreshRatingChart() {
        var Appdata = $("#AppName").val(); // this.dataItem(e.item);
        var Surveylist = $("#appsurvey").data("kendoDropDownList").value();
         var dat = {
            ApplicationID: Appdata,
            surId:Surveylist
        }
        var dataa = JSON.stringify(dat);
        var baseurl1 = '@Url.Content("~/AppDashboard/AppSurveyRating")';
        $.ajax({
            async: false,
            type: "post",
            url: baseurl1,
            data: dataa,
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                //rating
                var ratingSumm = response.ratingModel;
                var ratDataSource = new kendo.data.DataSource({
                    data: ratingSumm
                });
                var ratChart = $('#RatingSummaryChart').data('kendoChart');
                ratChart.setDataSource(ratDataSource);

                //var ratingGrid = $('#RatingGrid').data('kendoGrid');
                //ratingGrid.setDataSource(ratDataSource);
            },
            error: function (response) {
                console.log(response);
            }
        });
    }

    function RefreshCostChart() {
        var dataItem = $("#AppName").val(); // this.dataItem(e.item);
        var Yearlist = $("#costyear").data("kendoDropDownList").value();
        var dat = {
            AppId: dataItem,
            Year: Yearlist
        }
        var dataa = JSON.stringify(dat);
        var baseurl1 = '@Url.Content("~/AppDashboard/applicationFTECost")';
        $.ajax({
            async: false,
            type: "post",
            url: baseurl1,
            data: dataa,
            contentType: "application/json; charset=utf-8",
            success: function (response) {

                //cost Summary
                var costSumm = response.costModel;
                var costDataSource = new kendo.data.DataSource({
                    data: costSumm
                });
                var costChart = $('#CostSummaryChart').data('kendoChart');
                costChart.setDataSource(costDataSource);

                var costGrid = $('#CostGrid').data('kendoGrid');
                costGrid.setDataSource(costDataSource);

                //labor Summary
                var labor = response.laborModel;
                var labourDataSource = new kendo.data.DataSource({
                    data: labor
                });
                var labourChart = $('#LaborChart').data('kendoChart');
                labourChart.setDataSource(labourDataSource);

                var FteGrid = $('#FTEGrid').data('kendoGrid');
                FteGrid.setDataSource(labourDataSource);
            },
            error: function (response) {
                console.log(response);
            }
        });   
    }

