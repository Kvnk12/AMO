                 $("#costdashboard").removeClass('active');
             if (id != "appdashboard")
                         $("#appdashboard").removeClass('active');

                     if (id != "DispositionDashboard" && idx != 0) {
                         $("#DispositionDashboard").removeClass('active');
                     }
             if (id != "recommendation")
                         $("#recommendation").removeClass('active');
                 }
             });
         }
    });


    function LineItems_Color(answer , x) {
        var formatNum = parseFloat(x).toFixed(1);
        if (x < 3) {
            return "<div style='background: red;'>" + answer + "&nbsp;&nbsp; </div>";
        }
        else if (x >= 3 && x < 4) {
            return "<div style='background: yellow;'>" + answer + "&nbsp;&nbsp; </div>";
        }
        else if (x >= 4) {
            return "<div style='background: green;'>" + answer + "&nbsp;&nbsp; </div>";
        }
        else {
            return formatNum;
        }
    }


</script>
