    function LineItems_Databound(x) {
        var formatNum = parseFloat(x).toFixed(1);
        if (x < 3) {
            return "<div style='background: red; text-align:right;'>" + formatNum + "&nbsp;&nbsp; </div>";
        }
        else if (x >= 3 && x < 4) {
            return "<div style='background: yellow; text-align:right;'>" + formatNum + "&nbsp;&nbsp; </div>";
        }
        else if (x >= 4) {
            return "<div style='background: green; text-align:right;'>" + formatNum + "&nbsp;&nbsp; </div>";
        }
        else {
            return formatNum;
        }
    }


    function BarChartColor(x) {
       // alert(x.value);
        if (x.value < 3) {
            return "red";
        }
        else if (x.value >= 3 && x.value < 4) {
            return "yellow";
        }
        else if (x.value >= 4) {
            return "green";
        }
        
    }

