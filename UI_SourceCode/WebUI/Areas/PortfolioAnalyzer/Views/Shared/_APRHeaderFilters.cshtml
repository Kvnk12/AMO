
@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.PortfolioAnalyzer.Controllers;
@using WebUI.Areas.IncidentNavigator.Dto;
@using WebUI.Areas.IncidentNavigator.Models;
@using Kendo.Mvc.UI;
@using System.Data;
@using WebUI.Dto; 
@{
    // var client = (Client)Session["Client"];
    ClientDetail client = (ClientDetail)Session["SessionClient"];
    var v = new APRAjaxServiceController();
    var ApplicationList = v.ApplicationList(client.ClientId);

}


        <div class="apr-header-filter">
            <label class="custom-white-label">Application/Service Name: </label>
            <div class="custom-combobox">
                @(Html.Kendo().ComboBox()
.Name("AppName")
.Filter("contains")
.Placeholder("Select Application")
.DataTextField("Text")
.DataValueField("Value")
.Events(e => e.Change("AppNameChange"))
.BindTo(ApplicationList)
.Enable(true)
.AutoBind(true)
                //.CascadeFrom("fabric")
                //.HtmlAttributes(new { style = "width:350px;" })
                )


            </div>
        </div>

    


    


