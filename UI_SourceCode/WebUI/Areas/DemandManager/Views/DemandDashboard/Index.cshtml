    <div class="im-Dashboard">
        <div class="im-Dashboard-top">
            <div class="im-chart">
                <div class="chart-head">
                    Demand Posted
                </div>
                <div class="chart-content">
                    @(Html.Kendo().Chart<DashboardDemandModel>()
                                                                .Name("DashboardPieChart1")
                                                                .Legend(legend => legend
                                                                //.Position(ChartLegendPosition.Right)
                                                                .Visible(false)
                                                                )
                                                                .ChartArea(chartArea => chartArea
                                                                .Background("transparent")
                                                                //.Height(300)
                                                                )
                                                                .DataSource(ds => ds.Read(read => read.Action("GetDashboardFilterOptions", "DemandDashboard").Data("Chart1")))
                                                                .SeriesColors(new string[] { "#76448A", "#F1C40F", "#2E86C1", "#D98880", "#0B5345", "#03a9f4", "#ff9800", "#fad84a", "#4caf50" })
                                                                .Events(e => e
                                                                        .SeriesClick("DemandPostedClick")
                                                                )
                                                                  .Series(series =>
                                                                  {
                                                                      series.Pie(model => model.Count, model => model.Category, null)
                                                                      .Labels(labels => labels
                                                                      .Template("#= category #: \n #= value#, #= kendo.format('{0:P}', percentage)#")
                                                                      .Background("transparent")
                                                                      .Visible(true)
                                                                      .Position(ChartPieLabelsPosition.OutsideEnd)
                                                                      )
                                                                      .StartAngle(150);
                                                                  })

                                                                .Tooltip(tooltip => tooltip
                                                                    .Visible(true)
                                                                    .Template("#= category #: \n #= value#,  #= kendo.format('{0:P}', percentage)#")
                                                                )
                                                    )
                </div>

            </div>
