    @(Html.Kendo().Window()
    .Name("DemandsPostedWindow")
    .Title("Demands Posted details")
    .Content(@<text>
            @(Html.Kendo().Grid<DashboardDemandModel>(Model.DemandPosted)
.Name("DemandsPosted")
.Columns(column =>
{
    column.Bound(m => m.Category);
    column.Bound(m => m.Count).HtmlAttributes(new { @style = "text-align:right" });
})
.ToolBar(tools => tools.Excel().HtmlAttributes(new { style = "float:right;", @class = "btn-primary" }))
 .Excel(excel => excel
        .FileName("DemandsPosted.xlsx")
        .Filterable(true)
        .AllPages(true)
        .ProxyURL(Url.Action("Excel_Export_Save", "DemandDashboard"))
    )
.HtmlAttributes(new { @style = "width:460px" })
//.Pageable()
.DataSource(data => data
.Ajax()

)
            )
        </text>)
    .Visible(false)
    .Draggable()
    .Resizable()
    .Width(500)
    .AutoFocus(true)
    .Modal(true)
    .Actions(actions => actions.Pin().Minimize().Maximize().Close())
 )
