@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.DemandManager.Controllers;
@using WebUI.Areas.DemandManager.Dto;
@using WebUI.Areas.DemandManager.Models;
@using Kendo.Mvc.UI;
@using System.Data;
@using WebUI.Dto;
<div>
    <div class="top-content-heading">
        <h6>Distribution by Priority</h6>
        <div class="top-content-right">
            <p class="view-type graph-view" id="d1c2">Table/Graph</p>
            <span class="expand-view" title="Maximise the chart" onclick="maximiseChartPriority()"></span>

        </div>
    </div>
    <div class="chart-content">
        <div class="chart-area">
            @(Html.Kendo().Chart<DMChartDashboardModel>()
                                .Name("ChartPriority")
                               .Legend(legend => legend
                                .Visible(true)
                                .Align(ChartLegendAlign.Start)
                                .Position(ChartLegendPosition.Bottom)
                                //.Offset(1, 1)
                                )
                                .ChartArea(chartArea => chartArea
                                .Background("transparent")
                                .Height(280)
                                )
                                .DataSource(ds => ds.Read(read => read.Action("GetDashboardTower", "DemandDashboard").Data("GetPriorityParameter")))
                                               //   .SeriesDefaults(seriesDefaults => seriesDefaults
                                               //.Column().Overlay(ChartBarGradient.None)
                                               //  )
                                .Series(series =>
                                {
                                    series.Bar(model => model.DemandCount).Name("Demands Count").Spacing(0).CategoryField("DrpCategory").Labels(labels => labels.Background("transparent").Template("#= value# #= kendo.format('{0:P}', percentage)#").Visible(true)).Color("#19BDFF");
                                    series.Bar(model => model.Percent).Name("Percentage").Axis("%").CategoryField("DrpCategory").Labels(labels => labels.Background("transparent").Template("#= value# %").Visible(true)).Tooltip(tooltip => tooltip.Visible(true).Color("#000000").Template("#= series.name #: #= value # %"))
                                                                                                                                                .Color("LightGray");
                                })
                                .CategoryAxis(axis => axis
                                .Categories(model =>model.DrpCategory)
                                .Line(line => line.Visible(false))
                                .AxisCrossingValue(10000, 0, 2)
                                .Labels(labels => labels.Visible(true).Template("P:#= value# ")/*.Mirror(true)*/)
                                .MajorGridLines(1, "#D7DBDD", ChartDashType.Dot).Visible(true)
                                //.MajorGridLines(lines => lines.Visible(false))
                                //.Title(title => title.Text("Priority").Font("12px Arial,Helvetica,sans-serif"))
                                )
                                .ValueAxis(axis => axis
                                .Numeric()
                                //.Max(10)
                                //.AxisCrossingValue(1)
                                .Line(line => line.Visible(false))
                                .Labels(labels => labels.Rotation("auto"))
                                .MajorGridLines(lines => lines.Visible(false))
                                //.Title(title => title.Text("Incident Count").Font("12px Arial,Helvetica,sans-serif"))

                                )
                                   .ValueAxis(axis => axis
            .Numeric("%")
             .Min(0).Max(100)
             .Labels(labels => labels.Format("{0}%").Visible(false))
            .Line(line => line.Visible(false))
             .MajorGridLines(lines => lines.Visible(false))
        )
                                .Tooltip(tooltip => tooltip
                                //.Background("transparent")
                                .Visible(true)
                                .Color("#000000")
                                .Template("#= series.name #: #= value #  #= kendo.format('{0:P}', percentage)#")

                                )
                                .Events(events => events
                                               .SeriesClick("onPrioritySeriesClick"))
        )
        </div> 
    </div>
    <div class="table-content hide" style="color: #000;padding: 0 18px;">
        <div class="head-div" style="display: flex; border: 2px solid rgb(91,121,171); width: 101.1%; padding: 2px 0 0 4px ">
            <div style="width:139px" onclick="kendoGridHeaderSort('PriorityTable', 'LongCategory')">Priority</div>
            <div style="width:109px" onclick="kendoGridHeaderSort('PriorityTable', 'DemandCount')">Demand Count</div>
            <div style="width:37px" onclick="kendoGridHeaderSort('PriorityTable', 'Percent')">in %</div>
        </div>
        @(Html.Kendo().Grid<DMChartDashboardModel>
                                    ()
                                    .Name("PriorityTable")
                                    .Columns(columns =>
                                    {
                                        columns.Bound(e => e.LongCategory).Title("Priority").Width(139).ClientFooterTemplate("Total");
                                        columns.Bound(e => e.DemandCount).Title("Demand Count").Width(109).ClientFooterTemplate("#=sum#");
                                        columns.Bound(e => e.Percent).Title("in %").ClientFooterTemplate("100");

                                    })
                                    .AutoBind(false)
                                    .HtmlAttributes(new { style = "height:235px;" })
                                    .DataSource(dataSource => dataSource
                                    .Ajax()
                                     .Aggregates(agg =>
                                                {
                                                    agg.Add(p => p.DemandCount).Sum();
                                                    agg.Add(p => p.Percent).Sum();
                                                })
                                        .Read(read => read.Action("GetDMDashboardDataDynamicGrid", "DemandDashboard").Data("GetPriorityParameter"))
                                        )
        )

    </div>
    </div>