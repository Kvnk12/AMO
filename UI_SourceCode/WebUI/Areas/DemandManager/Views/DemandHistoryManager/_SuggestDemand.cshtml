@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@model NTTData.AMOPortal.WebUI.Dto.DMPostDemandInput

<div id="DemandContainer">
    <div id="action" style="margin-top:25px">
        <button class="btn btn-primary" id="btnSaveLinks" style="margin-left: 40%">Link Demand</button>
    </div>
    <div id="SuggestDemands" style="width:100%;margin:auto"></div>
</div>


<script type="text/javascript">

    $('#btnSaveLinks').click(function (event) {


        if (SaveSelectedDemands())
        {
            //alert('save');
            //$('#SuggestDemands').jtable('load');

        }

        return false;

    });

    function SaveSelectedDemands()
    {
        var ClientId = "@Model.ClientId";
        var ItemId = "@Model.Id";
        var DemandIds = "";
        var href = "@Url.Action("AddSelectedDemands")" + "?ClientId=" + ClientId;

        var $selectedRows = $('#SuggestDemands').jtable('selectedRows');

        if ($selectedRows.length > 0) {
            //Show selected rows
            $selectedRows.each(function () {
                var record = $(this).data('record');
                DemandIds += "," + record.Id;
            });
        } else {
            //No rows selected
            $('#SelectedRowList').append('No row selected! Select rows to see here...');
        }


            {
                $.ajax({
                    url: href,
                    type: 'POST',
                    data: { ItemId: ItemId, ClientId: ClientId, DemandIds:DemandIds},
                    success: checkLinkDemandSuccess,
                    failure: errorLinkDemandFailure,
                    async: false

                })
            }

            return true;
    }

    function checkLinkDemandSuccess(data)
    {
        if (data == "Success")
        {
            alert('Selected Demands linked successfully');
            recordadd();
        }

    }


    function errorLinkDemandFailure()
    {
        alert('Failure');
    }

    $(document).ready(function () {
        var ClientId = "@Model.ClientId";
        var ChallengeId = "@Model.Id";

        if (ClientId != null) {
            $('#SuggestDemands').jtable({
                title: 'Demands',
                selecting: true, //Enable selecting
                multiselect: true, //Allow multiple selecting
                selectingCheckboxes: true, //Show checkboxes on first column
                //selectionChanged:rowsselectedevent,
                messages: {
                    addNewRecord: 'Suggest  a New Demand'
                },
                actions: {
                    listAction: "@Url.Action("GetListedDemandDetails")" + "?ClientId=" + ClientId + "&ChallengeId=" + ChallengeId,
                },
                fields: {
                    Id: {
                        key: true,
                        list: false
                    },

                    ItemName: {
                        title: 'Name',
                        width: '30%'
                    },



                    Description: {
                        title: 'Description',
                        width: '30%'
                    },

                    CreatedByUser:
                        {
                            title: 'Posted By',
                            width: '10%'
                        },


                    CreateDateString:
            {
                title: 'Posted On',
                width: '10%'
            }




                }

            });
            $('#SuggestDemands').jtable('load');
        }


    });

    function recordadd(event, data)
    {
        $('#SuggestDemands').jtable('reload', myfunction);
        $('#ListedDemands').jtable('load');
    }
    function myfunction()
    {
        var $selectedRows = $('#SuggestDemands').jtable('selectedRows');
        var $chkBox = $selectedRows.find('td.jtable-selecting-column input').attr('checked', true); $chkBox.attr('checked', false);
        $selectedRows.each(function () {
            $(this).removeClass('jtable-row-selected ui-state-highlight');
        });
    }


</script>
