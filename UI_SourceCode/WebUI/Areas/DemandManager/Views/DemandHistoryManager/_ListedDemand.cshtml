@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@model NTTData.AMOPortal.WebUI.Dto.DMPostDemandInput

<div id="DemandContainer">
    <div id="ListedDemands" style="width:100%;margin:auto"></div>
</div>


<script type="text/javascript">





    function errorLinkDemandFailure()
    {
        alert('Failure');
    }



    $(document).ready(function () {
        var ClientId = "@Model.ClientId";
        var ChallengeId = "@Model.Id";
        if (ClientId != null) {
            $('#ListedDemands').jtable({
                title: 'Demands Suggested So far',
                actions: {
                    listAction: "@Url.Action("GetListedDemands")" + "?ClientId=" + ClientId+"&ChallengeId="+ChallengeId
                },
                fields: {
                    Id: {
                        key: true,
                        list: false
                    },

                    ItemName: {
                        title: 'Name',
                        width: '30%'
                    },

                    Description: {
                        title: 'Description',
                        width: '30%'
                    },

                    CreatedByUser:
                        {
                            title: 'Posted By',
                            width: '10%'
                        },


                    CreateDateString:
            {
                title: 'Posted On',
                width: '10%'
            }

                }

            });
            $('#ListedDemands').jtable('load');
        }


    });




</script>
