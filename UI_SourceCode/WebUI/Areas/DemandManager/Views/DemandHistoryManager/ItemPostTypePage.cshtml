@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@using WebUI.Dto
@model NTTData.AMOPortal.WebUI.Dto.DMPostDemandInput



@{ ViewBag.Title = "Demand Manager";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/demand_manager_white.png");
    Layout = "~/Views/Shared/GenericLayoutWithoutFooter.cshtml";
    // var Client = (Client)Session["Client"];
    var Client = (ClientDetail)Session["SessionClient"];
    var ClientID = Client.ClientId; }


<div>
    <ol class="breadcrumb">
        <li>Demand Manager</li>
        <li class="active">View Demands</li>
    </ol>
</div>
<div class="clear">
</div>

<div style="padding:0;">

    <div class="well well-sm"><strong>Demand</strong></div>
    <div>
        @Html.Partial("_DemandHistory")
    </div>




    <!--end of grid-->
</div>
<!--.valchainContent-->
