<script type="text/javascript">
    $(document).ready(function () {


        $('select#ClientId').change(function () {
            //var SelectedclientId = $('#ClientId :selected').val();
            var SelectedclientId = @ClientID;
            if (SelectedclientId != 0) {


                var href = window.location.href.split('/');
                //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
                var baseurl = '';



                if (href[3].toLowerCase() == 'demandmanager') {
                    var baseurl = href[0] + '//' + href[2] + '/' + 'DemandManager/ChallengeHistoryManager/DisplayHomePage/?clientId={clientId}';
                }
                else {
                    var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'DemandManager/ChallengeHistoryManager/DisplayHomePage/?clientId={clientId}';
                }

                baseurl = baseurl.replace("{clientId}", SelectedclientId);
                window.location = baseurl;
                return false;

            }

        });

    });


    $('#cancelDemand').click(function () {


        var confirm = window.confirm('Do you want cancel the changes?');
        if (confirm) {


            var href = window.location.href.split('/');
            //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
            var baseurl = '';



            if (href[3].toLowerCase() == 'demandmanager') {
                var baseurl = href[0] + '//' + href[2] + '/' + 'Demandmanager/ChallengeHistoryManager/DisplayChallenges/?clientId={clientId}';
            }
            else {
                var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'Demandmanager/ChallengeHistoryManager/DisplayChallenges/?clientId={clientId}';
            }

            baseurl = baseurl.replace("{clientId}", "@Model.ClientId");
            window.location = baseurl;
            return false;
            }
            else { return false; }

            });

    $('#homepage').click(function () {


        var href = window.location.href.split('/');

        var baseurl = '';



        if (href[3].toLowerCase() == 'demandmanager') {
            var baseurl = href[0] + '//' + href[2] + '/' + 'Demandmanager/ChallengeHistoryManager/DisplayChallenges/?clientId={clientId}';
        }
        else {
            var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'Demandmanager/ChallengeHistoryManager/DisplayChallenges/?clientId={clientId}';
        }
        baseurl = baseurl.replace("{clientId}", "@Model.ClientId");
        window.location = baseurl;
        return false;


    });

</script>






