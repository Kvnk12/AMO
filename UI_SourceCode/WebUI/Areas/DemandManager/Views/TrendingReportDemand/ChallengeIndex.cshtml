@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.IncidentNavigator.Controllers;
@using WebUI.Areas.IncidentNavigator.Dto;
@using Kendo.Mvc.UI;
@using System.Data;
@using WebUI.Dto
@{
   // var objclient = (NTTData.AMOPortal.Domain.Entities.Client)Session["Client"];
    var objclient = (ClientDetail)Session["SessionClient"];
    var clientId = objclient.ClientId.ToString();
    var clientName = objclient.ClientName.ToString();
}

@{
    ViewBag.Title = "Demand Manager";
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />
    <script src="//cdnjs.cloudflare.com/ajax/libs/jszip/2.4.0/jszip.min.js"></script>


    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/JScript/kendo.all.min.js"></script>
    <script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>

    ViewBag.ImagePathOne = Url.Content("~/Content/images/INlogo.png");
    Layout = "~/Areas/IncidentNavigator/Views/Shared/_INLayout.cshtml";
}
<div id="wrap">
    <div class="clear"></div>
    <div>
        <!--start of breadcrumb-->
        <ol class="breadcrumb">
            <li class="active">Demand Manager</li>
            <li class="active">Dashboard</li>
            <li class="active">Analysis Challenge Report</li>
        </ol>
    </div>
    <div class="" style="padding:0;">
        <div class="clearfix"></div><!--This is to clear the floats-->
        <iframe id="frameTrendig" src='@Url.Content("~/Areas/DemandManager/AspxReport/WebForm3.aspx")' border="0" frameborder="0" height="1100px" width="100%"></iframe>
        <style>
            #export {
                margin: 0 0 10px 1px;
                float: right;
            }
        </style>

    </div>
    <!--/.container-->
</div>


<script type="text/javascript">

    function btnClick() {

        $("#configurator").toggle();

    }
    $("#export").click(function (e) {
        var pivotgrid = $("#pivotgrid").data("kendoPivotGrid");
        pivotgrid.saveAsExcel();
    });

    function additionalData(e) {
        var ddlItem = $("#fabric").data("kendoComboBox").value();
        //alert(ddlItem);
        return { ClientID: ddlItem }
    }
    function filterProducts() {
        //alert($("#fabric").val());
        return {
            ClientID: $("#fabric").val()
            //productFilter: $("#products").data("kendoComboBox").input.val()
        };
    }

      function filterTypes(e) {

            return {
                ClientID: $("#fabric").val(),
            ConfigItem: $("#ConfigItem").val()
            };
        }

</script>

