                                                        + "#}#");
                                            columns.Bound(e => e.Status).Title("Status").Width(80).Filterable(ftb => ftb.Multi(true));
                                            columns.Bound(e => e.CreatedBy).Title("Created By").Width(80).Filterable(ftb => ftb.Multi(true))/*.Filterable(filterable => filterable.UI("CreaterFilter"))*/;
                                            columns.Bound(e => e.CreatedDt).Title("Created Date").Format("{0:MM/dd/yyyy}").Width(100);
                                            columns.Bound(e => e.StatusChangeDt).Title("Status Change Date").Format("{0:MM/dd/yyyy}").Width(120);
                                            columns.Bound(e => e.LastModifiedDt).Title("Last Modified Date").Format("{0:MM/dd/yyyy}").Width(120);

