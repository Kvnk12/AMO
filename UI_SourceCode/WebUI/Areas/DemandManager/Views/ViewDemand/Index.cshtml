@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI
@using WebUI.Areas.DemandManager.Models
@using System.Data;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Infrastructure;
@using Kendo.Mvc.Resources
@using Kendo.Mvc.Extensions;

@model  DemandViewModel

@{
    ViewBag.Title = "Demand Manager";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/demand_manager_white.png");
    // Layout = "~/Views/Shared/_AppLayout.cshtml";
    Layout = "~/Views/Shared//GenericLayoutWithoutFooter.cshtml";

    <link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />
    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/JScript/kendo.all.min.js"></script>
    <script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>
    //<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
}
<style>
    .k-state-active .k-icon:before {
        background-color: #fff !important;
        color: #000 !important;
        margin: 2px !important;
    }

    .k-state-selected a {
        color: #ffffff;
    }

    /*Status Change Buttons Inside Tabs*/
    .StatusChangeButton {
        text-overflow: ellipsis;
        width: 150px;
        line-height: 1.75em;
        border-radius: 5px;
        background-color: #2196F3;
        border: solid;
        border-color: #357ebd;
        color: white;
        padding: 0px 0px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 14px;
        margin: auto;
        margin-right: 17px;
        -webkit-transition-duration: 0.4s; /* Safari */
        transition-duration: 0.4s;
        cursor: pointer;
        background-color: #2196F3;
    }

    /* Kendo Modifications*/
    .k-grid-header th.k-header {
        font-weight: bold;
        font-size: 13px;
        text-overflow: ellipsis;
        border: thin 1px #ccc;
    }
    /*Column Header- FullName*/
    .k-filter-row th, .k-grid-header th.k-header {
        white-space: normal;
        border: thin 1px #ccc;
    }
</style>

<div id="wrap">
    <div class="content-main dark-bg idea-manager">
        <!--start of breadcrumb-->
        <ol class="breadcrumb">
            <li>Demand Manager</li>
            <li class="active">View/Post Demand</li>
        </ol>
        <div id="MainDivforA" class="idea-manager-content">
            <!--Contains Radio buttons, Search Bar-->
            <div class="main-heading-section">
                <div class="view-ideas-toggle">
                    <span class="active" id="myDemands"> MY Demand </span>
                    <span id="allDemands"> ALL Demand </span>
                </div>
                <div class="search-container">
                    <input type="text" id="DemandSearchBox" placeholder="Search Demands" name="search">
                    <button type="submit" class="search-submit" onclick="DemandSearchClick()"></button>
                </div>
            </div>

            <!-- Tab links -->
            <div class="tab-container">
                <div class="tab-main">
                    <span id="CreatedOpen" class="tab-link" onclick="openTab(event, 'Created')">Pre-Approval</span>
                    <span id="ReviewOpen" class="tab-link" onclick="openTab(event, 'Review')">Submitted for Review/ Approval</span>
                    <span id="ApprovedOpen" class="tab-link" onclick="openTab(event, 'Approved')">Approved/ Declined/ Cancelled</span>
                    <span id="ImplementationOpen" class="tab-link" onclick="openTab(event, 'Implementation')">Implementation</span>
                    <span id="CompleteOpen" class="tab-link" onclick="openTab(event, 'Complete')">Complete</span>
                    <span id="HeadDemandSearch" class="tab-link" hidden>Search Results...</span>
                </div>
                @if (Model.IsSysAdmin == true)
                {
                    <div class="export-button">
                        <form action="@Url.Action("ExportServer", "ViewDemand")" method="POST">
                            @*<input type="hidden" id="export-data" name="data" />
                                <input type="hidden" id="export-model" name="model" />*@
                            <input type="hidden" id="export-AllDemands" name="AllDemands" />
                            <button type="submit" id="ExportToExcel">Export -       </button>
                        </form>
                    </div>
                }
            </div>
            <div id="DemandSearch" class="tab-content" hidden>
                <!--Search Grid-->
                <button type="submit" class="btn btn-primary" onclick="location.href='@Url.Action("Index","ViewDemand")';return false;">Return to View Demands</button>
                <br />
                <div class="custom-grid">
                    @(Html.Kendo().Grid<DemandSearchModel>()
                                        .Name("DemandSearchGrid")
                                        .Columns(columns =>
                                        {
                                            columns.Bound(e => e.DemandId).Hidden();
                                            columns.Bound(e => e.DemandNumber).Title("Demand No.");
                                            columns.Template(@<text></text>).Title("Name")
            .ClientTemplate("<a target='_blank' rel='noopener noreferrer' href='" + Url.Action("Index", "PostDemand", new { DemandId = "#=DemandId#" }) + "'>#=DemandName#</a>");

                                            columns.Bound(e => e.Status).Title("Status");

                                        })
.PersistSelection()
.Filterable()
.Sortable()

.Scrollable()
.HtmlAttributes(new { @style = "height:250px;" })
.DataSource(dataSource => dataSource
.Ajax()
.Model(model =>
{
model.Id(f => f.DemandId);
})
.Read(read => read.Action("DemandSearch", "ViewDemand").Data("SearchString")) //Data--
)
                    )
                </div>
            </div>
            <div id="Created" class="tab-content">
                <!--Status Change Buttons-->
                <div class="tab-action-buttons">
                    <button id="PostNewDemandButton" onclick="NewDemandClick()" class="post-new-idea">Post New Demand</button>
                    <button id="DeleteButton" onclick="DeleteClick()" class="delete-idea">Delete</button>
                    <button id="SubmitForReviewButton" onclick="SubmitForReviewClick()" class="submit-idea">Submit for Review</button>
                </div>
