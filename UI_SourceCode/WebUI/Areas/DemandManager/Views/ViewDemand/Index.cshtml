<script type="text/javascript">

    //Data for Kendo Grid..
    function MyDemandsOrAllDemands() {
       
        var val = $('.view-ideas-toggle span.active').attr('id');
        if (val == 'myDemands') {
            return {
                AllDemands: 1
            }
        } else {
            return {
                AllDemands: 2
            }
        }

    }

    //Button Functions
    //---Tab -1------
    function NewDemandClick() {
        var indexurl = '@Url.Content("~/DemandManager/PostDemand/Index")';
        window.location.href = indexurl


    }

    function DeleteClick() {
        var grid = $("#PreApprovalGrid").getKendoGrid()
        var selectedIDs = grid.selectedKeyNames().join(", ");
        var mod = {
            DemandIDs: selectedIDs
        };
        var data = JSON.stringify(mod);
        var baseurl = '@Url.Content("~/PostDemand/DeleteDemands")';
        $.ajax(
        {
        url: baseurl,
        type: 'post',
        data: data,
        async: false,
        contentType: 'application/json; charset=utf-8',
        success: function (data) {
            $('#PreApprovalGrid').data('kendoGrid').dataSource.read();
            $('#SubmitForReviewGrid').data('kendoGrid').dataSource.read();
            //alert("Participants Successfully Added");
            }
        })

    }

    function SubmitForReviewClick() {
        var grid = $("#PreApprovalGrid").getKendoGrid()
        var selectedIDs = grid.selectedKeyNames().join(", ");
        var mod = {
            DemandIDs: selectedIDs
        };
        var data = JSON.stringify(mod);
        var baseurl = '@Url.Content("~/PostDemand/SubmitforReview")';
        $.ajax(
        {
        url: baseurl,
        type: 'post',
        data: data,
        async: false,
        contentType: 'application/json; charset=utf-8',
        success: function (data) {
            $('#PreApprovalGrid').data('kendoGrid').dataSource.read();
            $('#SubmitForReviewGrid').data('kendoGrid').dataSource.read();
            //alert("Participants Successfully Added");
            }
        })

    }

    //---Tab - 2 --------
    function SubmitForApprovalClick() {

        var grid = $("#SubmitForReviewGrid").getKendoGrid()
        var selectedIDs = grid.selectedKeyNames().join(", ");
        var mod = {
            DemandIDs: selectedIDs
        };
        var data = JSON.stringify(mod);

        var approvalurl = '@Url.Content("~/DemandManager/DemandApproval/Index")';
        window.location.href = approvalurl;

    }


    //---------Search Tab-------------//
    function DemandSearchClick() {
        $(".tab-link").hide();

        $("#Created").hide();
        $("#Review").hide();
        $("#Approved").hide();
        $("#Implementation").hide();
        $("#Complete").hide();

        $("#HeadDemandSearch").show();
        $("#DemandSearch").show();

        $('#DemandSearchGrid').data('kendoGrid').dataSource.read();
        $('#DemandSearchGrid').data('kendoGrid').refresh();
    }

    function SearchString() {
        var obj = $("#DemandSearchBox").val();

        return {
            stringLike: obj.trim()
        }
    }

    //On change of Radio Button
    $('.view-ideas-toggle').on('click', 'span', function () {
        $(this).addClass('active');
        $(this).siblings().removeClass('active');

        var DemandVar = $(this).attr('id');
        console.log(DemandVar);
        if (DemandVar == 'allDemands')
        {
        //alert('2');
            //var SFRB = $("#SubmitForReviewButton").data("kendoButton");
            //SFRB.enable(false);
            //var DB = $("#DeleteButton").data("kendoButton");
            //DB.enable(false);
            //var SFAB = $("#SubmitForApproveButton").data("kendoButton");
            //SFAB.enable(false);

            $('#SubmitForReviewButton').prop('disabled', true);
            $('#DeleteButton').prop('disabled', true);
            //$('#SubmitForApproveButton').prop('disabled', true);

        }
        if (DemandVar == 'myDemands')
        {


            $('#SubmitForReviewButton').prop('disabled', false);
            $('#DeleteButton').prop('disabled', false);
            //$('#SubmitForApproveButton').prop('disabled', false);

        }
        //Refreshing Grids.
        var preApproval = $('#PreApprovalGrid').data('kendoGrid');
        preApproval.dataSource.read();

        var submitForReview = $('#SubmitForReviewGrid').data('kendoGrid');
        submitForReview.dataSource.read();

        var approved = $('#ApprovedGrid').data('kendoGrid');
        approved.dataSource.read();

        var implementation = $('#ImplementationGrid').data('kendoGrid');
        implementation.dataSource.read();

        var completion = $('#CompletionGrid').data('kendoGrid');
        completion.dataSource.read();

    });

    //Functions for Tab Click..
    function openTab(evt, cityName) {
        var i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tab-content");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }
        tablinks = document.getElementsByClassName("tab-link");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].className = tablinks[i].className.replace(" active", "");
        }
        document.getElementById(cityName).style.display = "block";
        evt.currentTarget.className += " active";
        //Using sessionStorage to save tab information
        sessionStorage.setItem("ViewDemandTab", cityName);
    }

    // Get the element with id="CreatedOpen" and click on it
    $(window).on('load', function () {
        var ViewDemandTabName = sessionStorage.getItem("ViewDemandTab");
        if (ViewDemandTabName == null) {
            document.getElementById("CreatedOpen").click();
        }
        else {
            var newString = ViewDemandTabName + 'Open';
            document.getElementById(newString).click();
        }
    })

    $("#ExportToExcel").click(function () {
        var val = $('.view-ideas-toggle span.active').attr('id');
        if (val == 'myDemands') {
            val = 1;
        } else {
            val = 2;
        }
        //$("#export-data").val(encodeURIComponent(JSON.stringify(options)));
        //$("#export-model").val(encodeURIComponent(JSON.stringify(grid.columns)));
        $("#export-AllDemands").val(encodeURIComponent(JSON.stringify(val)));
    });
