    .Sortable()
    .Editable(editable => editable.Mode(GridEditMode.InLine).ConfirmDelete("test").DisplayDeleteConfirmation("Are you sure you want to delete?"))
    //.HtmlAttributes(new { style = "height:350px;" })
    //.Pageable()
    .ToolBar(
   tools =>
   {
       tools.Create().Text("New Config Item");
   })
    .Scrollable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Model(model =>
        {
            model.Id(o => o.CIId);
        })
        //.PageSize(10)
        .Read(read => read.Action("GetConfigurationitem", "ConfigDemand", new { ConId = "#=CTId#" }))
        .Create(create => create.Action("AddConfigurationitem", "ConfigDemand", new { Id = "#=CTId#" }))
        .Update(update => update.Action("EditConfigurationitem", "ConfigDemand"))
        .Destroy(delete => delete.Action("DeleteConfigurationitem", "ConfigDemand"))
    )
    //.Events(events => events.Save("SaveConfigurationitem"))
    .ToClientTemplate())
</script>

<script>
    function SaveClassification(e) {
        var Classification = e.model.Classification.toUpperCase().replaceAll(' ', '');
        var CalId = e.model.CalId;
        var data = this.dataSource.data();

        for (var i = 0; i < data.length; i++) {
            if (data[i].Classification.toUpperCase().replaceAll(' ', '') === Classification && data[i].CalId != CalId) {
                e.preventDefault();
                alert("Classification Already Exists. Please Enter Unique Name!");
            }
        }

    }

    function SaveCategory(e) {
        var Category = e.model.Category.toUpperCase().replaceAll(' ', '');
        var CaId = e.model.CaId;
