@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI
@using WebUI.Areas.DemandManager.Controllers
@using WebUI.Areas.DemandManager.Models
@using WebUI.Areas.DemandManager.Dto
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data;
@using System.Collections;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Infrastructure;
@using Kendo.Mvc.Resources
@using Kendo.Mvc.Extensions;
@model  DemandViewModel
<div class="im-postidea-benefitsgrid">
    <div class="custom-kendo-grid">
        @(Html.Kendo().Grid<DMItemCommentsInput>()
                         .Name("DMCommentsGrid")
                         .Columns(columns =>
                         {
                             columns.Bound(e => e.Id).Hidden();
                             columns.Bound(e => e.Comments).Title("Comments");
                             columns.Bound(e => e.CreatedByName).Title("Posted By");
                             columns.Bound(e => e.CreateDateString).Title("Posted On");
                             columns.Command(command => { command.Edit().UpdateText(" ").CancelText(" ").Text(" "); command.Destroy().Text(" "); }).Width(200);
                         })
                      .Sortable()
                      .Scrollable()
                      //.Pageable()
                      .Editable(editable => editable.Mode(GridEditMode.InLine).ConfirmDelete("test").DisplayDeleteConfirmation("Are you sure you want to delete?"))
                      .ToolBar(toolbar => toolbar.Create().Text("Add New Comments"))
                      .DataSource(dataSource => dataSource
                      .Ajax()
                      //.PageSize(10)
                      .Model(model => { model.Id(f => f.Id);
                          model.Field(f => f.CreatedByName).Editable(false);
                          model.Field(f => f.CreateDateString).Editable(false);
                      })
                      .Read(read => read.Action("GetComments", "PostDemand").Data("GetDemandId"))
                      .Create(create => create.Action("AddComments", "PostDemand").Data("GetDemandId"))
                      .Update(update => update.Action("EditComments", "PostDemand"))
                      .Destroy(destroy => destroy.Action("DeleteComments", "PostDemand"))

                          )

        )
    </div>
    </div>



