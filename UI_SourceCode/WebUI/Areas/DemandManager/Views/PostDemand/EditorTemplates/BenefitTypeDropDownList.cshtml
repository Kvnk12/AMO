@model string

@(Html.Kendo().DropDownListFor(m => m)
                            .Name("BenefitType")
                            .OptionLabel("Select Benefit Type..")
                            .DataTextField("Text")
                            .DataValueField("Value")
                            .BindTo(new List<SelectListItem>() {
              new SelectListItem() {
                  Text = "Tangible",
                  Value = "Tangible"
              },
              new SelectListItem() {
                  Text = "InTangible",
                  Value = "InTangible"
              }
          })

              .AutoBind(true)
)