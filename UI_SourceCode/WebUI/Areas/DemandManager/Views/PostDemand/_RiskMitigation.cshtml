@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI
@using WebUI.Areas.DemandManager.Controllers
@using WebUI.Areas.DemandManager.Models
@using WebUI.Areas.DemandManager.Dto
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data;
@using System.Collections;
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Infrastructure;
@using Kendo.Mvc.Resources
@using Kendo.Mvc.Extensions;
@model DemandViewModel

<div>
    @(Html.Kendo().Grid<DMRiskAndMitigationModel>()
                     .Name("DMRiskAndMitigationGrid")
                     .Columns(columns =>
                     {
                         columns.Bound(e => e.Id).Hidden();
                         columns.Bound(e => e.DemandId).Hidden();
                         columns.Bound(e => e.CreatedDt).Title("Date").Format("{0:MM/dd/yyyy}");
                         columns.Bound(e => e.Risk).Title("Risk");
                         columns.Bound(e => e.MitigationPlan).Title("Mitigation Plan");
                         columns.Bound(e => e.Comments).Title("Comments");
                         columns.Command(command => { command.Edit(); command.Destroy(); }).Width(250);
                     })
                  .Sortable()
                  .Scrollable()
                  .Editable(editable => editable.Mode(GridEditMode.InLine).ConfirmDelete("test").DisplayDeleteConfirmation("Are you sure you want to delete?"))
                  .ToolBar(toolbar => toolbar.Create().Text("Add New Risk And Mitigation"))
                  .HtmlAttributes(new { style = "height:550px;" })
                  .DataSource(dataSource => dataSource
                  .Ajax()
                  .Model(model => {
                      model.Id(f => f.Id);
                      model.Field(f => f.CreatedDt).Editable(false);
                  })
                      .Read(read => read.Action("GetRiskAndMitigation", "PostDemand", new{ IId = Model.DemandId }))
                      .Create(create => create.Action("AddRiskAndMitigation", "PostDemand", new { IId = Model.DemandId }))
                      .Update(update => update.Action("EditRiskAndMitigation", "PostDemand"))
                      .Destroy(destroy => destroy.Action("DeleteRiskAndMitigation", "PostDemand"))

                          )

        )
</div>
