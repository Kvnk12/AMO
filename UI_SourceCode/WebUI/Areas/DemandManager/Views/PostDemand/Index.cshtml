@{
    ViewBag.Title = "Demand Manager";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/demand_manager_white.png");
    // Layout = "~/Views/Shared/_AppLayout.cshtml";

    Layout = "~/Views/Shared//GenericLayout.cshtml";
    HomeInput MenuItemsInput = (HomeInput)Session["MenuItemsInput"];
}

<style>
    /*----------------Tabs-------------------*/
    .tab {
        /*overflow: hidden;*/
        width: 100%;
        /*height:250px;*/
        display: inline-flex;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }
        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            /*float: left;*/
            border: none;
            outline: none;
            cursor: pointer;
            padding: 12px 14px;
            transition: 0.3s;
            font-size: 17px;
            width: auto;
            /*display:inline-flex;*/
            text-overflow: ellipsis;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
            }
            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
                text-decoration: underline;
            }
    /* Style the tab content */
    .tabcontent {
        display: none;
        padding: 6px 12px;
        border: 1px solid #ccc;
        border-top: none;
        /*height: 200px;*/
        padding-top: 1%;
    }

    .tablinks {
        width: auto;
        margin: auto;
        /*text-overflow:ellipsis;*/
    }


    /*Tree View Disabling class*/
    .treedivDisable {
        pointer-events: none;
        cursor: no-drop;
        color: #c2c2c2 !important;
        background-color: #f5f5f5;
        border-radius: 3px;
    }
    .k-tabstrip-top > .k-tabstrip-items-wrapper {
        margin:unset !important;
    }
</style>

<div class="content-main dark-bg idea-manager-postidea">
    <div>
        <!--start of breadcrumb-->
        <ol class="breadcrumb">
            <li>Demand Manager</li>
            <li>View Demand</li>
            <li class="active">Post Demand</li>
        </ol>
    </div>

    <div>

        @if (MenuItemsInput.UserRole.ToLower() == "sysadmin")
        {
            if (Model.DemandId != 0 && Model.DemandStatusID != (int)DMStatus.SubmitForReview)
            {
                <button id="EditDemand" class="btn btn-primary" style="width:150px" onclick="SysAdminEditClick()">Edit</button>
            }
            if (Model.DemandStatusID == (int)DMStatus.SubmitForRevision)
            {
                <button style="width:10%" ; type="submit" class="btn btn-primary" title="Click here If Demand has been Revised!" onclick="ReviseDemand()">Revised</button>
            }
            if ((Model.DemandStatusID == (int)DMStatus.SubmitForReview || Model.DemandStatusID == (int)DMStatus.SubmitForApproval) && Model.IsSysAdmin == true)
            {
                <button id="EditDemand" class="btn btn-default" style="width:150px; cursor:not-allowed;" title="Demand cannot be edited in this Status.">Edit</button>
                <button style="width:10%" ; class="btn btn-primary" onclick="location.href='@Url.Action("Index","DemandApproval")';return false;" style="width:150px;" title="Go to Approval Page to perform action on the Demands submitted for Review to you.">Next Steps</button>
            }
        }
        else
        {
            if (Model.IsDeleted == false)
            {
                if (Model.PostNewDemand == false)
                {
                    //if () { }
                    <!--Read Only Mode :  Edit Button Visible only to [CreatedUser] and [Admin/SysAdmin]-->
                    if ((Model.DemandStatusID == (int)DMStatus.SubmitForReview || Model.DemandStatusID == (int)DMStatus.SubmitForApproval || Model.DemandStatusID == (int)DMStatus.Declined || Model.DemandStatusID == (int)DMStatus.Cancelled || Model.ImpDemandStatusID == (int)DMStatus.Implemented) && (Model.IsDemandMine == true || Model.IsSysAdmin == true))
                    {
                        <!--Button will be visible but not Enabled [Id Admin or CreatedUser] -->
                        <button id="EditDemand" class="btn btn-default" style="width:150px; cursor:not-allowed;" title="Demand cannot be edited in this Status.">Edit</button>

                        if ((Model.DemandStatusID == (int)DMStatus.SubmitForReview || Model.DemandStatusID == (int)DMStatus.SubmitForApproval) && Model.IsSysAdmin == true)
                        {
                            <button style="width:10%" ; class="btn btn-primary" onclick="location.href='@Url.Action("Index","DemandApproval")';return false;" style="width:150px;" title="Go to Approval Page to perform action on the Demands submitted for Review to you.">Next Steps</button>
                        }

                    }

                    else
                    { <!--If Demand is not in the Statuses above mentioned.-->
                        <!--   -->
                        if ((Model.DemandStatusID != (int)DMStatus.SubmitForReview || Model.DemandStatusID != (int)DMStatus.SubmitForApproval || Model.DemandStatusID != (int)DMStatus.Declined || Model.DemandStatusID != (int)DMStatus.Cancelled || Model.ImpDemandStatusID != (int)DMStatus.Implemented) && (Model.IsDemandMine == true || Model.IsSysAdmin == true || Model.IsImplementationManager == true))
                        {
                            //If Status is Approved--- [Pre-Approval details cannot be edited]
                            if ((Model.DemandStatusID == (int)DMStatus.Approved || Model.ImpDemandStatusID == (int)DMStatus.SubmitForPlanning || Model.ImpDemandStatusID == (int)DMStatus.Planned || Model.ImpDemandStatusID == (int)DMStatus.Initiated))
                            {
                                if ((Model.IsImplementationManager == true || Model.IsSysAdmin == true) && (Model.DemandStatusID != (int)DMStatus.Cancelled || Model.ImpDemandStatusID != (int)DMStatus.Implemented))
                                {
                                    //Editing Details Post Approval -- [Only for Admins/Sysadmin, Implementation Manager]

                                    <button id="EditDemand" class="btn btn-primary" style="width:150px" onclick="AdminEditClick()">Edit</button>


                                }
                            }
                            //Edit Demand Completely
                            if ((Model.DemandStatusID == (int)DMStatus.Created || Model.DemandStatusID == (int)DMStatus.SubmitForRevision || Model.DemandStatusID == (int)DMStatus.Revised) && Model.IsDemandMine == true)
                            {

                                <button id="EditDemand" class="btn btn-primary" style="width:150px" onclick="UserEditClick()">Edit</button>
                                if (Model.DemandStatusID == (int)DMStatus.SubmitForRevision)
                                {
                                    <button style="width:10%" ; type="submit" class="btn btn-primary" title="Click here If Demand has been Revised!" onclick="ReviseDemand()">Revised</button>
                                }
                            }
                        }
                        else if (Model.IsDemandMine == false || Model.IsSysAdmin == false)
                        {
                            //Do not display..
                        }
                    }
                }
                else
                {
                    <!--If it is PostNewDemand-->
                    <!--Do Not display any Button-->
                }
            }
        }

        <button style="width:15%" ; type="submit" class="btn btn-primary" onclick="location.href='@Url.Action("Index","ViewDemand")';return false;">Return to View Demand</button>

        @if (Model.IsDeleted == false)
        {


            if (Model.PostNewDemand == false && ((Model.DemandStatusID != null) && (Model.IsDemandMine == true || Model.IsSysAdmin == true)))
            {

                //<div style="width:100%;height:3%">
                <button type="submit" onclick="DetailDemand()" class="im-custom-button im-btn-print" style="float:right;display:inline-block;">Print View</button>
                // </div>

            }
        }

        <!----------------------------------------Button to view Demand ----------------------------------------------->


    </div>
    <div class="im-postidea-header">
        <h5 style="width:40%" ;>Demand Name : <label class="custom-white-label">@Model.DemandName</label></h5>
        <h5 style="width:30%" ;>Demand Status : <label class="custom-white-label"> @Model.DemandStatus</label></h5>
        <h5 style="width:25%" ;>Demand Number : <label class="custom-white-label">@Model.DemandNumber</label></h5>
    </div>

    <div class="tab-container im-postidea-tab custom-kendo-tabstrip">
        <!--Kendo Tab-->
        @(Html.Kendo().TabStrip()
                                         .Name("demandtabstrip")
                                         .Items(tabstrip =>
                                         {
                                             tabstrip.Add().Text("Home")
                                                 .Selected(true)

                                                 .Content(m => Html.Partial("_Home", Model));
                                             //tabstrip.Add().Text("Approver(s)")
                                             //tabstrip.Add().Text("Submit For Review")
                                             //               .Enabled(false)
                                             //                .Content(m => Html.Partial("_Approvers", Model));

                                             tabstrip.Add().Text("Classification")
                                                 .Enabled(false)
                                                 .Content(m => Html.Partial("_ClassificationAndCategory", Model));

                                             //tabstrip.Add().Text("Business Benefits")
                                             //    .Enabled(false)
                                             //    .Content(m => Html.Partial("_BusinessBenefits", Model));

                                             //tabstrip.Add().Text("IT Savings")
                                             //    .Enabled(false)
                                             //    .Content(m => Html.Partial("_ITSavings", Model));

                                             //tabstrip.Add().Text("Config Items")
                                             //    .Enabled(false)
                                             //    .Content(m => Html.Partial("_ConfigItems", Model));

                                             //tabstrip.Add().Text("Analysis/ Root Cause")
                                             //    .Enabled(false)
                                             //    .Content(m => Html.Partial("_Analysis", Model));

                                             tabstrip.Add().Text("Solution")
                                               .Enabled(false)
                                               .Content(m => Html.Partial("_Solution", Model));

                                             //tabstrip.Add().Text("Risk Mitigation")
                                             //    .Enabled(false)

                                             //    .Content(m => Html.Partial("_RiskMitigation", Model));

                                             //tabstrip.Add().Text("Metrics")
                                             //    .Enabled(false)

                                             //    .Content(m => Html.Partial("_Metrics", Model));

                                             tabstrip.Add().Text("Comments")
                                                 .Enabled(false)
                                                 .Content(m => Html.Partial("_Comments", Model));

                                             tabstrip.Add().Text("Implementation").HtmlAttributes(new { @title = "Only Implementation Managers can edit this section after Demands gets Approved/Submitted for Planning." })
                                                 .Enabled(false)
                                                 .Content(m => Html.Partial("_Implementation", Model));

                                             tabstrip.Add().Text("Log")
                                                 .Enabled(false)

                                                 .Content(m => Html.Partial("_Log", Model));
                                         })

    )
    </div>
</div>





