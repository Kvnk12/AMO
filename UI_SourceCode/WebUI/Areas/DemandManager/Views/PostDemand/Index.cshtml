    //Analysis and Solutions
    function saveAnalysis() {
        var editor = $("#AnalysisEditor").data("kendoEditor");
        var content = editor.value();
        if (content.trim() != '') {
            var mod = {
                DemandId: '@Model.DemandId',
                analysis:content
            };
            var data = JSON.stringify(mod);
            var baseurl = '@Url.Content("~/DemandManager/PostDemand/UpdateAnalysis")';
            $.ajax(
                {
                    url: baseurl,
                    type: 'post',
                    data: data,
                    async: false,
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {

                        //alert("Participants Successfully Added");
                    }
                })
        }
        else {
            alert('This should not be left Empty');
        }
    }

    function saveSolution() {
        var editor = $("#SolutionEditor").data("kendoEditor");
        var content = editor.value();
        if (content.trim() != '') {
             var mod = {
                DemandId: '@Model.DemandId',
                solution:content
            };
            var data = JSON.stringify(mod);
            var baseurl = '@Url.Content("~/DemandManager/PostDemand/UpdateSolution")';
            $.ajax(
                {
                    url: baseurl,
                    type: 'post',
                    data: data,
                    async: false,
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {

                        //alert("Participants Successfully Added");
                    }
                })
        }
        else {
            alert('This should not be left Empty');
        }
    }

    function AdminEditClick() {
        console.log("1");
        //Changing button content and Background
        var bto = document.getElementById("EditDemand");
