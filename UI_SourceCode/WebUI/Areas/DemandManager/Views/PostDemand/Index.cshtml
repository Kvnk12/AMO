    function ItemNameExists(ItemName) {

    var res;
        var href = window.location.href.split('/');
        //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
        var baseurl = '';
        if (href[3].toLowerCase() == 'demandmanager') {
            var baseurl = href[0] + '//' + href[2] + '/' + 'DemandManager/PostDemand/CheckItemName';
        }
        else {
            var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'DemandManager/PostDemand/CheckItemName';
        }

        {
            $.ajax({
                url: baseurl,
                type: 'POST',
                async: false,
                data: { ItemName: ItemName, ItemId: '@Model.DemandId'},
                success: function (data) {
                    $("#DemandNameExists_alert").hide();
                    if (data == true) {
                        $("#DemandNameExists_alert").show();
                        res= true;
                    }
                    else{
                        res= false;
                    }
                }

            })
        }
        return res;

    }



