    function ReviseDemand() {
        var mod = {
            DemandId: '@Model.DemandId'
        };
        var data = JSON.stringify(mod);
        var indexurl = '@Url.Content("~/DemandManager/PostDemand")';
        var ReviseDemandURl = '@Url.Content("~/DemandManager/PostDemand/ReviseDemand")';
        $.ajax(
            {
                url: ReviseDemandURl,
                type: 'post',
                data: data,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    window.location.href = indexurl +'?DemandId='+@Model.DemandId;
                }
            })
    }


    function DetailDemand() {

        var indexurl = '@Url.Content("~/DemandManager/DetailDemand")';
        if(@Model.DemandId==0){
