@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@model NTTData.AMOPortal.WebUI.Dto.DMPostDemandInput


<div id="DemandSources" style="width:100%"></div>


<script type="text/javascript">
    $(document).ready(function () {
        var ItemId = "@Model.Id";

        var href = window.location.href.split('/');
        //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
        var baseurl = '';


        if (ItemId != null) {
            $('#DemandSources').jtable({
                title: 'Demand Source',
                actions: {
                    listAction: "@Url.Action("GetDemandSourceDetails")",
                    createAction: "@Url.Action("AddDemandSourceDetails")",
                    updateAction: "@Url.Action("UpdateDemandSourceDetails")"


                },
                fields: {
                    Id: {
                        key: true,
                        list: false
                    },
                    DemandSource: {
                        title: 'Demand Source:',
                        width: '50%'
                    }
                },
                formCreated: function (event, data) {
                    data.form.find('input[name="DemandSource"]').addClass(
                      'validate[required]');

                    data.form.validationEngine();
                },
                formSubmitting: function (event, data) {
                    return data.form.validationEngine('validate');
                },
                formClosed: function (event, data) {
                    data.form.validationEngine('hide');
                    data.form.validationEngine('detach');
                }


            });
            $('#DemandSources').jtable('load');


        }
    });

</script>
