@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Areas.DemandManager.Object
@using WebUI.Areas.DemandManager.Dto;
@using System.Data
@using PagedList.Mvc;
@using PagedList;
@using System.Web.Mvc;
@using WebUI.Dto
@model IPagedList<NTTData.AMOPortal.WebUI.Dto.DMPostDemandModel>


    @{
        ViewBag.Title = "Demand Manager";
        ViewBag.ImagePathOne = Url.Content("~/Content/images/demand_manager_white.png");
        Layout = "~/Views/Shared/GenericLayoutWithoutFooter.cshtml";
       // var Client = (Client)Session["Client"];
        var Client = (ClientDetail)Session["SessionClient"]; 
        var ClientID = Client.ClientId;
    }
                     <div class="content-main">

                         <div>
                             <ol class="breadcrumb">
                                 <li>Demand Manager</li>
                                 <li class="active">Post Demand</li>
                             </ol>
                         </div>


                         <div style="padding: 0;">

                             <div style="height:1000px">
                                 <div class="row">
                                     <div class="col-sm-2">
                                         <button tabindex="30" class="btn btn-primary" id="btnAdd" style="margin-bottom:10px">Post New Demand</button>
                                     </div>
                                 </div>
                                 <div>
                                     <div>
                                         <div>
                                             <table class="table" cellpadding="0" cellspacing="0" style="width:100%">
                                                 <thead>
                                                     <tr>
                                                         <th><u>@Html.ActionLink("Last Modified Date", "DisplayDemands", new { Page = Model.PageNumber, sortOrder = ViewBag.LastModifiedDate }, new { @style = "color:white;" })</u></th>
                                                         <th><u>@Html.ActionLink("Demands", "DisplayDemands", new { Page = Model.PageNumber, sortOrder = ViewBag.Demands }, new { @style = "color:white;" })</u></th>
                                                         <th><u>@Html.ActionLink("Posted by", "DisplayDemands", new { Page = Model.PageNumber, sortOrder = ViewBag.Postedby }, new { @style = "color:white;" })</u></th>
                                                         <th><u>@Html.ActionLink("Status", "DisplayDemands", new { Page = Model.PageNumber, sortOrder = ViewBag.Status }, new { @style = "color:white;" })</u></th>
                                                         <th><u>@Html.ActionLink("Status Comments", "DisplayDemands", new { Page = Model.PageNumber, sortOrder = ViewBag.StatusComments }, new { @style = "color:white;" })</u></th>
                                                         <th><u>@Html.ActionLink("Created Date", "DisplayDemands", new { Page = Model.PageNumber, sortOrder = ViewBag.CreatedDate }, new { @style = "color:white;" })</u></th>
                                                     </tr>
                                                 </thead>


                                                 @{

                                                     var uid = (int)Session["UserId"];


                                                     foreach (var vwItem in Model)
                                                     {

                                                         var name = (DMStatus)vwItem.StatusId;

                                                         <tr>
                                                             <td> @vwItem.LastUpdatedDate </td>

                                                             <td>
                                                                 @if ((vwItem.StatusId == (int)DMStatus.Created || vwItem.StatusId == (int)DMStatus.Declined) && (vwItem.CreatedBy == uid))
                                                                 {
                                                                     @*@vwItem.ItemName*@
                                                                     @Html.ActionLink(vwItem.ItemName, "DisplayHomePage", new { ItemId = vwItem.Id, SaveData = "", TabName = "home" }, null)
                                                                 }
                                                                 else
                                                                 {
                                                                     @vwItem.ItemName
                                                                 }
                                                             </td>

                                                             <td> @vwItem.CreatedByUser </td>

                                                             <td>
                                                                 @if (vwItem.StatusId == (int)DMStatus.Approved && (vwItem.CreatedBy == uid))
                                                                 {
                                                                     <div data-toggle="tooltip" data-placement="right" title="Click here if Demand is Implemented" style="overflow: hidden; text-overflow: ellipsis;">
                                                                         @name <br /> (@Html.ActionLink("Mark as Implemented", "implementedStatus", new { idid = vwItem.Id }, null))
                                                                     </div>
                                                                 }
                                                                 else
                                                                 {
                                                                     @name
                                                                 }
                                                             </td>

                                                             <td> @vwItem.StatusComments </td>
                                                             <td> @vwItem.CreateDateString </td>

                                                         </tr>

                                                     }

                                                     //}


                                                 }


                                             </table>
                                             <div class="pagination">
                                                 @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
                                                 @Html.PagedListPager(Model, page => Url.Action("DisplayDemands", new { page = page, sortOrder = Request["sortOrder"] }))
                                             </div>
                                         </div>
                                     </div>
                                 </div>
                             </div>

                             <!--/.treeMenuContent-->

                         </div>

                     </div>

    <script type="text/javascript">


            $('#btnAdd').click(function () {


                var href = window.location.href.split('/');
                var baseurl = '';

                if (href[3].toLowerCase() == 'demandmanager') {
                    baseurl = href[0] + '//' + href[2] + '/demandmanager/demandmanager/DisplayHomePag/?TabName=Add'
                }
                else {
                    baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'demandmanager/demandmanager/DisplayHomePage/?TabName=Add'
                }

                window.location = baseurl;


                return false;

            });


    </script>
