<script type="text/javascript">
    $(document).ready(function () {

        $('select#ClientId').change(function () {
            var SelectedclientId = $('#ClientId :selected').val();

            //if (SelectedclientId != 0)
            {

                var href = window.location.href.split('/');
                //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
                var baseurl = '';



                if (href[3].toLowerCase() == 'demandmanager') {
                    var baseurl = href[0] + '//' + href[2] + '/' + 'demandmanager/demandmanager/DisplayDemandDashboard/?clientId={clientId}';
                }
                else {
                    var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'demandmanager/demandmanager/DisplayDemandDashboard/?clientId={clientId}';
                }
                baseurl = baseurl.replace("{clientId}", SelectedclientId);
                window.location = baseurl;
                
            }

        });
    });

</script>







