@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@model NTTData.AMOPortal.WebUI.Dto.DMPostDemandInput
<style>
    #ITBenefits td:nth-child(3), #ITBenefits td:nth-child(4) {
        text-align: right;
    }

    .ui-dialog #Edit-FTEHours, #Edit-Value {
        text-align: right;
    }

    #ITBenefits td:nth-child(3)::before {
        content: '$';
    }
</style>
<div id="ITBenefits" style="width:100%"></div>


<script type="text/javascript">
    $(document).ready(function () {
        var ItemId = "@Model.Id";

        var href = window.location.href.split('/');
        //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
        var baseurl = '';


        if (ItemId != null) {
            $('#ITBenefits').jtable({
                title: 'IT Savings',
                actions: {
                    listAction: "@Url.Action("GetITBenefitDetails")"+ "?ItemId="+ItemId,
                    createAction: "@Url.Action("AddITBenefitDetails")" + "?ItemId=" + ItemId, title:"asda",
                    updateAction: "@Url.Action("UpdateITBenefitDetails")" + "?ItemId=" + ItemId,
                    deleteAction: "@Url.Action("DeleteITBenefitDetails")"

                },
                fields: {
                    Id: {
                        key: true,
                        list: false
                    },


                    Name: {
                        title: 'Name',
                        width: '30%'
                    },

                    Detail: {
                        title: 'Details',
                        width: '30%'
                    },

                    Value: {
                        title: 'Value',
                        width: '20%'
                    },
                    FTEHours: {
                        title: 'FTE Hours',
                        width: '20%'
                    }
                },
                formCreated: function (event, data) {
                    data.form.find('input[name="Name"]').addClass(
                      'validate[required]');
                    data.form.find('input[name="Detail"]').addClass(
                      'validate[required]');
                    data.form.find('input[name="Name"]').addClass(
                      'validate[required]');
                    data.form.find('input[name="Detail"]').addClass(
                      'validate[required]');
                    data.form.find('input[name="FTEHours"]').addClass(
                      'validate[required,custom[number]]');
                    data.form.find('input[name="Value"]').addClass(
                      'validate[required,custom[number]]');

                    data.form.find('#Edit-Value').before('$');

                    data.form.validationEngine();
                },
                formSubmitting: function (event, data) {
                    return data.form.validationEngine('validate');
                },
                formClosed: function (event, data) {
                    data.form.validationEngine('hide');
                    data.form.validationEngine('detach');
                }


            });
            $('#ITBenefits').jtable('load');

        }




    });

</script>
