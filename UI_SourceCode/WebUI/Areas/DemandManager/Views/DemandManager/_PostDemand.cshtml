@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@using Kendo.Mvc.UI;
@using Kendo.Mvc.Extensions;
@using WebUI.Areas.PortfolioAnalyzer.Controllers;
@using WebUI.Dto
@model NTTData.AMOPortal.WebUI.Dto.DMPostDemandInput

<link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
<link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
<link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />

<script src="~/Scripts/JScript/kendo.all.min.js"></script>
<script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>

@{


    // var Client = (Client)Session["Client"];
    var Client = (ClientDetail)Session["SessionClient"];
    var ClientID = Client.ClientId;
    var v = new APRAjaxServiceController();
    var ApplicationList = v.ApplicationList(ClientID);

}
<style>

    .bootstrap-select > .btn {
        width: 97%;
    }

    .jHtmlArea, .ToolBar {
        width: 806px !important;
    }
</style>
@using (Html.BeginForm("SavePostDemand", "DemandManager", new { ClientId = Model.ClientId }, FormMethod.Post))
{

<div style="min-height:700px">
    @*<div class="well well-sm"><strong>Heatmap Builder : Threshold</strong></div>*@

    @if (!ViewData.ModelState.IsValid && !ViewData.ModelState.ContainsKey("Success"))
    {
        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger container", id = "danger" })
    }

    @if (ViewData.ModelState.ContainsKey("Success"))
    {
        @Html.ValidationSummary(false, "", new { @class = "alert alert-success container", id = "success" })
    }
    else
    {
        //@Html.ValidationSummary(false,"", new { @class = "alert alert-danger container" })
    }


    <div class="DemandManagerContent">
        <h4>Post Demand</h4>

        <!-- Nav tabs -->
        <ul class="nav nav-tabs" role="tablist" id="Demandtab">
            <li class="active"><a href="#home" role="tab" data-toggle="tab">Home</a></li>
            <li><a href="#classification" role="tab" data-toggle="tab">Classification</a></li>
            <li><a href="#benefits" role="tab" data-toggle="tab">Business Benefits</a></li>
            <li><a href="#itsavings" role="tab" data-toggle="tab">IT Savings</a></li>
            <li><a href="#divcomments" role="tab" data-toggle="tab">Comments</a></li>
            <li><a href="#divlistapprovers" role="tab" data-toggle="tab">Select Approver(s)</a></li>
            @if (Model.Id > 0)
            {@*<li><a href="#divprioirtyhistory" role="tab" data-toggle="tab">Priority & Status Update</a></li>*@}
        </ul>

        <!-- Tab panes -->
        <div class="tab-content">
            <div class="tab-pane active" id="home">

                @Html.Hidden("ItemId", @Model.Id)
                <div class="leftarea form-horizontal">
                    <div class="form-group">
                        <label id="lblChallengeName" class="col-sm-5 control-label" for="accname"><span class="mandate">*</span>Demand Name</label>
                        <div class="col-sm-5">
                            @Html.TextBoxFor(m => m.PostDemandInput.ItemName, new { @class = "form-control", placeholder = "", tabindex = "1", id = "txtchallange" })<label id="alertt" hidden><span class="mandate" style="font-size:small">This field is required!</span></label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-5 control-label" for="qtfyDemand">@*<span class="mandate">*</span>*@Value (Quantify in $)</label>
                        <div class="col-sm-5">
                            <i style="display: inline-block; margin-left: -12px;">$</i>
                            @Html.TextBoxFor(m => m.PostDemandInput.QtyFication, new
                            {
                                @class = "form-control",
                                placeholder = "",
                                tabindex = "2",
                                id = "txtqtfyDemand",@*onkeypress = "return isNumberKey(this)",*@maxlength = "5",
                                style = "text-align:right;display:inline-block"
                            })@*<label id="alertt1" hidden><span class="mandate" style="font-size:small">This entry can only contain numbers!</span></label>*@
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="DemandType" class="col-sm-5 control-label" id=""><span class="mandate">*</span>Demand Type</label>
                        <div class="col-sm-5">
                            @Html.DropDownListFor(m => m.PostDemandInput.DemandTypeId, new SelectList(Model.DMDemandTypes, "value", "text", Model.DMDemandTypes), "", new { @class = "selectpicker", id = "DemandType", name = "DemandType", required = "required" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="DemandType" class="col-sm-5 control-label" id=""><span class="mandate">*</span>Demand Source</label>
                        <div class="col-sm-5">
                            @Html.DropDownListFor(m => m.PostDemandInput.DemandSourceId, new SelectList(Model.DMDemandSources, "value", "text", Model.DMDemandSources), "", new { @class = "selectpicker", id = "DemandType", name = "DemandType", required = "required" })
                        </div>
                    </div>
                    <div>
                        @Html.HiddenFor(m => m.PostDemandInput.CreatedBy)
                        @Html.HiddenFor(m => m.PostDemandInput.StatusId)
                    </div>

                    <div class="form-group">
                        <label for="DemandType" class="col-sm-5 control-label" id=""><span class="mandate">*</span>LOB/Department</label>
                        <div class="col-sm-5">
                            @Html.DropDownListFor(m => m.PostDemandInput.LOBId, new SelectList(Model.DMLOBSourceList, "value", "text", Model.DMLOBSourceList), "", new { @class = "selectpicker", id = "DemandType", name = "DemandType", required = "required" })
                        </div>
                    </div>



                    <div class="form-group" style="display: inline-block;">
                        <label for="desc" class="col-sm-3 control-label" style="padding: 19px;">Description</label>
                        <div class="col-sm-9">
                            @Html.TextAreaFor(m => m.PostDemandInput.Description, new { @class = "", rows = "10", style = "width:750px;height:250px", placeholder = "Description", tabindex = "3", id = "txtdescription" })

                        </div>
                    </div>
                    <div id="action">
                        @if (Model.Id == 0)
                        {
                        <button class="btn btn-primary" id="btnSave" name="command" value="saveDemand" style="margin-left: 40%">Post Demand</button>
                        }
                        else
                        {
                            <button class="btn btn-primary" id="btnSave" name="command" value="saveDemand" style="margin-left: 40%">Save</button>
                        }

                        <button class="btn btn-default" id="cancelDemand">Cancel</button>
                        @*<button class="btn btn-primary" id="homepage">Home</button>*@
                    </div>
                </div>


                <div class="rightarea form-horizontal">
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Complexity</label>
                        <div class="col-sm-5">
                            @Html.DropDownListFor(m => m.PostDemandInput.Complexity, new List<SelectListItem>
                                                     {
                                             new SelectListItem{ Text="Low", Value = "low" },
                                             new SelectListItem{ Text="Medium", Value = "medium" },
                                             new SelectListItem{ Text="High", Value = "high" }
                                         }, new { @class = "selectpicker", @style = "width:100px;" })

                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Risk</label>
                        <div class="col-sm-5">
                            @Html.TextBoxFor(m => m.PostDemandInput.Risk, new { @class = "form-control", placeholder = "", tabindex = "1", style = "text-align:left;" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Risk Mitigation</label>
                        <div class="col-sm-5">
                            @Html.TextBoxFor(m => m.PostDemandInput.RiskMitigation, new { @class = "form-control", placeholder = "", tabindex = "1", style = "text-align:left;" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Internal Initiative?</label>
                        <div class="col-sm-5">
                            @Html.CheckBoxFor(m => m.PostDemandInput.InternalInitiative, new { @class = "form-control", @style = "width:50px;", tabindex = "", id = "chkSLA" })
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-5 control-label">Configuration Item</label>
                        <div class="col-sm-5">
                            @*@(Html.Kendo().DropDownListFor(m => m.PostDemandInput.ConfigItem)
          .Name("ConfigItem")
          .DataTextField("Text")
          .OptionLabel("Select Item")
          .DataValueField("Value")
          .BindTo(ApplicationList)
          //.AutoBind(true)
        )*@
                            @Html.DropDownListFor(m => m.PostDemandInput.ConfigItem, new SelectList(ApplicationList, "value", "text", ApplicationList), "", new { @class = "selectpicker" })
                        </div>
                    </div>

                </div>


                <!--/.form-horizontal-->
                @*  *@

            </div>

            <div class="tab-pane" id="classification">
                @Html.Partial("_AssignItemCategory", Model)
            </div>
            <div class="tab-pane" id="benefits">@Html.Partial("_BusinessBenefits", Model)</div>
            <div class="tab-pane" id="itsavings">
                @Html.Partial("_ITBenefits", Model)
        </div>
        <div class="tab-pane" id="divcomments">@Html.Partial("_ItemComments", Model)</div>
        <div class="tab-pane" id="divlistapprovers">@Html.Partial("_DemandApprover1", Model)</div>
        @if (Model.Id > 0)
        {

<div class="tab-pane" id="divprioirtyhistory">@Html.Partial("_PriorityHistory", Model)</div>}

    </div>



    <!--/.leftarea-->
    <!--/.rightarea-->

</div>

</div>}


<script>




    $(document).ready(function () {

        //For Tab Activation  On 10th Dec 2014
        var tabName = "@Model.TabName";
        if (tabName == "classification") {
            $('#Demandtab li:eq(1) a').tab('show');
        }

        ////

        //$(function () {

        //    $("#accordion").accordion({

        //        collapsible: true

        //    });

        //});




        //$('#txtdescription').htmlarea();

        $('#txtdescription').htmlarea({
            toolbar: [
                    ["bold", "italic", "underline", "strikethrough", "p"],
                    ["h1", "h2", "h3", "h4", "h5", "h6"],
                    ["orderedList", "unorderedList"],
                    ["superscript", "subscript", "indent", "outdent"],
                    ["Justifyleft", "justifycenter", "justifyright", "Increasefontsize", "decreasefontsize", "Forecolor", "horizontalrule"],
                    ["cut", "copy", "paste"],
            ]
        });




        if(!$("#home").hasClass('active')) {
                $('#success').hide();
           }

    });


    $('#btnSave').click(function () {

        //var SelectedclientId = $('#ClientId :selected').val();

        var SelectedclientId = @ClientID;
        $('#alertt').hide();
        $('#alertt1').hide();

        if ($('#txtchallange').val() == "") {
            //alert('Please enter name');
            $('#txtchallange').focus();
            $('#alertt').show();
            return false;
        }

        else {

            var itemName = $('#txtchallange').val();
            var itemId = $('#ItemId')[0].value;

            ItemNameExists(itemName, itemId);
            if (blnItemNameExists) {
                alert('Demand name already exists, please change');
                $('#txtchallange').focus();
                return false;

            }
        }

    });


    function ItemNameExists(ItemName, ItemId) {

        var href = window.location.href.split('/');
        //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
        var baseurl = '';

        if (href[3].toLowerCase() == 'demandmanager') {
            var baseurl = href[0] + '//' + href[2] + '/' + 'DemandManager/DemandManager/CheckItemName';
        }
        else {
            var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'DemandManager/DemandManager/CheckItemName';
        }

        {
            $.ajax({
                url: baseurl,
                type: 'POST',
                data: { ItemName: ItemName, ItemId: ItemId },
                success: checkItemSuccess,
                failure: errorItem,
                async: false

            })
        }

    }

    function checkItemSuccess(status) {

        blnItemNameExists = status;
    }

    function errorItem() {
        alert('An error occurred. Please contact administrator');
    }

    $('.tab-pane a').click(function (e) {
        $("#success").hide();
        $("#danger").hide();

    })

</script>
