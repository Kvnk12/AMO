@using NTTData.AMOPortal.Domain.Entities
@using WebUI.Areas.AlignmentManager.Models
@using WebUI.Areas.AlignmentManager.Objects
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@model NTTData.AMOPortal.WebUI.Dto.DataSetupInput

@using (Html.BeginForm("SaveRegisterDataSet", "DataSetAddEdit", new { ClientId = Model.ClientId, RegDataSetId = Model.DataSetId, RegDataSetCreate = Model.regDataSetStatus }, FormMethod.Post))
    {
    
    
    
    
    
      <div class="treeMenuContent" style="min-height:700px">
              @*<div class="well well-sm"><strong>Heatmap Builder : Threshold</strong></div>*@

           @if (!ViewData.ModelState.IsValid && !ViewData.ModelState.ContainsKey("Success"))
                {
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger container" })               
                }

            @if (ViewData.ModelState.ContainsKey("Success"))
                {                        
                @Html.ValidationSummary(false, "", new { @class = "alert alert-success container" })
                }
            else
            {
            //@Html.ValidationSummary(false,"", new { @class = "alert alert-danger container" })
            }
               <div>
               <div class="form-horizontal" style="float:left">
              <div class="form-group">
                <label for="clientName" class="col-sm-5 control-label">Data Set Name</label>
                <div class="col-sm-7">
                    @Html.TextBoxFor(m => m.registerDataSetInput.DataSetName, new { @class = "form-control", placeholder = "", tabindex = "1", id = "txtDataSetName" })
                </div>
              </div>
            </div>
            
            <div class="form-horizontal hbtppmargin" style="float:left">
              <div class="form-group">
                <label for="clientName" class="col-sm-5 control-label">Data Table Name</label>
                <div class="col-sm-5">
                  @Html.DropDownListFor(m => m.registerDataSetInput.DatabaseObjectName, new SelectList(Model.registerDataSetInput.GetAllTables, "value", "text", Model.registerDataSetInput.GetAllTables), "", new { @class = "selectpicker", id = "DataSetObjectId", name = "DataSetObjectId", required = "required" })  
                </div>
              </div>
            </div>
            <div class="clearfix"></div>

			@Html.Hidden("RegDataSetid", @Model.registerDataSetInput.Id) 
      

            
            <div class="pplareanw" style="min-height:500px">
           
            <h4>Data Elements</h4>
            <table class="table table-bordered">
            	<colgroup>
                   <col style="width:28%">
				   <col style="width:27%">
				   <col style="width:30%">
               </colgroup>
             <thead>
                <tr><th>Select</th>
                <th>Source Column</th>
                <th>Virtual Column</th>
                </tr></thead>
            </table>
            
             <div class="grid_4 ht400 mtopmin21">
             
             <table class="table-bordered">
             <colgroup>
             	<col style="width:31%">
                <col style="width:30%">
                <col style="width:31%;">
             </colgroup>
             <tbody>
                 @{
    int counter = 0;
                    IEnumerable<DataSetColumnMap> mapItems = Model.registerDataSetInput.registeredColumns;
                    
                     foreach (DataSetColumnMap mapItem in mapItems)  
                       {
                       
                       counter++;
                 <tr>
             	<td class="text-center">
                     
                     @*@Html.RadioButton("radioChk" , mapItem.isSelected, new { @class = "metricchk", @id=counter.ToString(), @checked=mapItem.isSelected })*@
                     @*@Html.RadioButtonFor(m => mapItem.isSelected, counter.ToString(), new { @class = "metricchk", @id = counter.ToString(), @name="myradio" })*@

                     <input type="radio" class="metricchk" checked="@mapItem.isSelected" name="radiochk" value="@counter" />
                     @*@Html.CheckBoxFor(m => mapItem.isSelected, counter.ToString(), new { @class = "metricchk", @id = counter.ToString(), @name = "myradio", @checked=(mapItem.isSelected==true? "checked": "") })*@
                     @*@Html.RadioButtonFor("radiochck", mapItem.isSelected, new { @class = "metricchk", @id = counter.ToString(), @name = "myradio" })*@
                     @*@Html.RadioButton(mapItem.isSelected, new {@class = "form-control value", id="radioseleccolumn_"+counter.ToString(), Name="radioseleccolumns"})*@
                </td>
                <td class="text-center">
                @Html.Label(mapItem.SourceColumnName, new { @class = "col-sm-1" })
                @Html.Hidden("sourecolumn" + counter, mapItem.SourceColumnName)
                @Html.Hidden("datasetmapid"+counter, mapItem.Id)
                </td>
                <td class="text-center">
                     @Html.DropDownList("virtualColumn" + counter.ToString(), mapItem.GetAllVarTypes,   mapItem.VariableType==""?"":mapItem.VariableType, new { @class = "form-control", @selected=mapItem.VariableType != "" ?"Selected":"" })
                      @*@Html.DropDownListFor(m => mapItem.VirtualColumnName, new SelectList(mapItem.GetAllVarTypes, "Value", "text", mapItem.GetAllVarTypes), "", new { @class = "selectpicker", @id="mapcolumn"+counter.ToString(), name = "virtualColumnName", required = "required" })  *@
                </td>
             </tr>
                     }
    
                     }
             </tbody>

             </table>
           
             </div><!--grid_4-->
            </div> <!--end of leftarea-->



    
  
            
           
            
            </div>
                   <!--end of grid-->             
                @*<div class="addvalaction"> <a href="#" class="btn btn-primary">Back</a> *@
                <div class="addvalaction">
                 @*<a href="#" class="btn btn-primary">Save</a>*@
                    <button type="Submit" tabindex="30" class="btn btn-primary" id="btnSave">Save</button>
                    <button  tabindex="30" class="btn btn-primary" id="btnBack">Back</button>
                    <button class="btn btn-primary" tabindex=""  id="btnDelete">Delete</button>
                    <button class="btn btn-primary" tabindex=""  id="btnAdd">New Data Set</button>
                    <button class="btn btn-default" id="cancelregDataSetMap" tabindex="" type="submit">Cancel</button>

                </div>
         </div>
    }
         

<script>

    $(document).ready(function () {


        var blndataSetNameExists = false;

        $('#btnAdd').click(function () {
            var href = window.location.href.split('/');
            var baseurl = '';
            if (href[3].toLocaleLowerCase() == 'alignmentmanager') {
                //alert('local url');

                var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/DataSetAddEdit/DisplayViewDataSet/?ClientId=@Model.ClientId&RegDataSetCreate=Add';
            }
            else {
                //alert('server');
                var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'AlignmentManager/DataSetAddEdit/DisplayViewDataSet/?ClientId=@Model.ClientId&RegDataSetCreate=Add'
            }


            window.location = baseurl;
            return false;

       @*     var localToServer = "/";
            var sPageURL = window.location.search.substring(1);
            var sURLVariables = sPageURL.split('&');

            if (window.location.pathname.split("/")[1].toLocaleLowerCase() != "alignmentmanager")
            {
                localToServer = "/" + window.location.pathname.split("/")[1] + "/";
            }

            var strUrl = window.Location.constructor("http://" + window.location.host + localToServer + "AlignmentManager/DataSetAddEdit/DisplayViewDataSet/?ClientId=@Model.ClientId&RegDataSetCreate=Add");

            window.location = strUrl;
            return false;*@

           });


        $('#cancelregDataSetMap').click(function () {
            var confirm = window.confirm('Do you want cancel the changes?');
            if (confirm) {

                var href = window.location.href.split('/');

                var baseurl = '';
                if (href[3].toLocaleLowerCase() == 'alignmentmanager') {
                    //alert('local url');

                    var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/DataSet/DisplayHomePage/?ClientId=@Model.ClientId';
                }
                else {
                    //alert('server');
                    var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'AlignmentManager/DataSet/DisplayHomePage/?ClientId=@Model.ClientId'
                }


                window.location = baseurl;

                return false;
            }
@*                var localToServer = "/";
                var sPageURL = window.location.search.substring(1);
                var sURLVariables = sPageURL.split('&');

                if (window.location.pathname.split("/")[1].toLocaleLowerCase() != "alignmentmanager") {
                    localToServer = "/" + window.location.pathname.split("/")[1] + "/";
                }

                var strUrl = window.Location.constructor("http://" + window.location.host + localToServer + "AlignmentManager/DataSet/DisplayHomePage/?ClientId=@Model.ClientId");

                window.location = strUrl;
                return false;
            }
            else { return false; }*@

        });


        $('#btnDelete').click(function () {

            var RegDataSetid = $('#RegDataSetid')[0].value;

            var DataSetName = $('#txtDataSetName')[0].value;
            
            if (RegDataSetid == 0)
            { return false; }
            var confirm = window.confirm('Do you want delete this data Set: '+DataSetName+'?');
            if (confirm) {


                var href = window.location.href.split('/');

                var baseurl = '';
                if (href[3].toLocaleLowerCase() == 'alignmentmanager') {
                    //alert('local url');

                    var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/DataSetAddEdit/DeleteDatSetName/?ClientId=@Model.ClientId';
                }
                else {
                    //alert('server');
                    var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'AlignmentManager/DataSetAddEdit/DeleteDatSetName/?ClientId=@Model.ClientId'
                }

                baseurl += "&RegDataSetId=" + RegDataSetid;
                window.location = baseurl;
                return false;
            }
            else {
                return false;
            }


@*                var localToServer = "/";
                var sPageURL = window.location.search.substring(1);
                var sURLVariables = sPageURL.split('&');

                if (window.location.pathname.split("/")[1].toLocaleLowerCase() != "alignmentmanager") {
                    localToServer = "/" + window.location.pathname.split("/")[1] + "/";
                }

                var strUrl = window.Location.constructor("http://" + window.location.host + localToServer + "AlignmentManager/DataSetAddEdit/DeleteDatSetName/?ClientId=@Model.ClientId");
                strUrl  += "&RegDataSetId=" + RegDataSetid;
                
                window.location = strUrl;
                return false;
            }
            else { return false; }*@

           });


    })

    $('#btnBack').click(function () {
       

        var href = window.location.href.split('/');

        var baseurl = '';
        if (href[3].toLocaleLowerCase() == 'alignmentmanager') {
            //alert('local url');

            var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/DataSet/DisplayHomePage/?ClientId=@Model.ClientId';
                }
                else {
                    //alert('server');
            var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'AlignmentManager/DataSet/DisplayHomePage/?ClientId=@Model.ClientId'
                }

        window.location = baseurl;
        return false;


@*            var localToServer = "/";
            var sPageURL = window.location.search.substring(1);
            var sURLVariables = sPageURL.split('&');

            if (window.location.pathname.split("/")[1].toLocaleLowerCase() != "alignmentmanager") {
                localToServer = "/" + window.location.pathname.split("/")[1] + "/";
            }

            var strUrl = window.Location.constructor("http://" + window.location.host + localToServer + "AlignmentManager/DataSet/DisplayHomePage/?ClientId=@Model.ClientId");

                window.location = strUrl;
                return false;*@
       
     });

        
    

    $('#btnSave').click(function () {
        

        if ($('#txtDataSetName').val() == "") {
            alert('Please enter Dataset name');
            $('#txtDataSetName').focus();
            return false;
        }
        else {
            
            var datasetName = $('#txtDataSetName').val();
            var datasetId = $('#RegDataSetid')[0].value;

            dataSetNameExists(datasetName, datasetId);
            if (blndataSetNameExists) {
                alert('Data set name already exists, please change');
                $('#txtDataSetName').focus();
                return false;

            }
        }


        var dboject = $('#DataSetObjectId :selected').val();
        if (dboject == "" || dboject == "0") {
            alert('Please select Data Table from the list');
            return false;
        }

        var selected = $("input[type='radio'][name='radiochk']:checked");

        if (selected.length == 0) {
            alert('Please Select one Row from  Data Elements');
            return false;
        }

       
        //{
        //alert('Daset name exists, please change the data set name');
        //$('#txtDataSetName').focus();
        //return false;
        //}

        if (selected.length > 0) {
            selectedVal = selected.val();
            selectVirtualColumn = $('#virtualColumn' + selectedVal + ' :selected').text();
            $('#virtualColumn' + selectedVal + ' :selected').val(selectVirtualColumn);
            //alert(selectVirtualColumn);
            if (selectVirtualColumn == "0" || selectVirtualColumn == "") {
                alert('Please Select  Column Name from the List');
                return false;
            }
        }
    });        


        function dataSetNameExists(dataSetName, dataSetId) {

            //var localToServer = "/";
            //var sPageURL = window.location.search.substring(1);
            //var sURLVariables = sPageURL.split('&');

            //if (window.location.pathname.split("/")[1].toLocaleLowerCase() != "alignmentmanager") {
            //    localToServer = "/" + window.location.pathname.split("/")[1] + "/";
            //}

            //var strUrl = window.Location.constructor("http://" + window.location.host + localToServer + "AlignmentManager/DataSetAddEdit/CheckDatSetName");


            var href = window.location.href.split('/');

            var baseurl = '';
            if (href[3].toLocaleLowerCase() == 'alignmentmanager') {
                //alert('local url');

                var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/DataSetAddEdit/CheckDatSetName';
        }
        else {
            //alert('server');
                var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'AlignmentManager/DataSetAddEdit/CheckDatSetName'
        }

            
             {
                $.ajax({
                    url: baseurl,
                    type: 'POST',
                    data: { datasetName: dataSetName, dataSetId: dataSetId },
                    success: checkDataSet,
                    failure: errorCheckDataSet,
                    async: false

                })
            }
            
        }

        function checkDataSet(status) {


            blndataSetNameExists = status;
            
            
            //$.each(status, function (key, value) {
            //    if (value == true) {
            //        alert('Data set name already exists, please change');
            //        return false;
            //    }
            //});
        }

        function errorCheckDataSet() {
            alert('An error occurred. Please contact administrator');
        }


        $('select#DataSetObjectId').change(function () {
            var SelectedDataSetObjectName = $('#DataSetObjectId :selected').val();
            var SelectedclientId = $('#ClientId :selected').val();

            var RegDataSetid = $('#RegDataSetid')[0].value;

            var DataSetName = $('#txtDataSetName')[0].value;

            if (SelectedclientId != 0 && SelectedDataSetObjectName != "") {
                var href = window.location.href.split('/');
                //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
                var baseurl = '';
                if (href[3].toLocaleLowerCase() == 'alignmentmanager') {
                    //alert('local url');

                    var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/DataSetAddEdit/DisplayDataSetColumns/?ClientId={clientid}&DataSetObjectName={datasetid}&DataSetName={datasetname}&RegDataSetId={regdatasetid}'
                }
                else {
                    //alert('server');
                    var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'AlignmentManager/DataSetAddEdit/DisplayDataSetColumns/?ClientId={clientid}&DataSetObjectName={datasetid}&DataSetName={datasetname}&RegDataSetId={regdatasetid}'
                }

                baseurl = baseurl.replace("{clientid}", SelectedclientId);
                baseurl = baseurl.replace("{datasetid}", SelectedDataSetObjectName);
                baseurl = baseurl.replace("{datasetname}", DataSetName);
                baseurl = baseurl.replace("{regdatasetid}", RegDataSetid);



                window.location = baseurl;
            }

        });
    
</script>
         