<script>

    
    $(document).ready(function () {
        $("input[name*='score'], input[name*='weight'] ").keypress(function (evt){  
            return(isNumberKey(evt));
        });
    });

    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (
           (charCode < 48 || charCode > 57))
            return false;

        return true;
    }

    $(document).ready(function () {
        $('#tblname1').change(function () {
            var list = this;
            var SelectedclientId = $('#tblname1 :selected').val();
            var href = window.location.href.split('/');
            var baseurl = '';
            if (href[3].toLocaleLowerCase() == 'alignmentmanager') {
                var baseurl = href[0] + '//' + href[2] + '/' + 'Alignmentmanager/AlignmentManager/BindService'
            }
            else {
                var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'Alignmentmanager/AlignmentManager/BindService'
            }

            
            if ($("#tblname1 :selected").val() != "") {
                $.ajax({
                    url: baseurl,
                    type: 'GET',
                    data: { sercatId: SelectedclientId },
                    success: getClientsAccountsFunc,
                    failure: errorInClientAccountsunc
                });
            }
        });


