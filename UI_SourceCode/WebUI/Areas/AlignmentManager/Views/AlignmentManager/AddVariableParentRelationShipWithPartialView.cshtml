<script>

    
    $(document).ready(function () {
        $('.score, .weight').keypress(function (evt) {
            return(isNumberKey(evt));
        });
    });

    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (
           (charCode < 48 || charCode > 57))
            return false;

        return true;
    }
</script>
