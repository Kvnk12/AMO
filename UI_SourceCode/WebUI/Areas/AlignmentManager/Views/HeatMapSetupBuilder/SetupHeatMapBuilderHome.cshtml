            if (SelectedclientId == "" || SelectedclientId == "0")
            {
                alert('Please Select Client name from the list');
                return false;
            }


            var href = window.location.href.split('/');
            //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
            var baseurl = '';

            var SelectedclientId = $('#ClientId :selected').val();

            if (href[3].toLowerCase() == 'alignmentmanager') {
                var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/HeatMapSetupBuilder/SetupHeatMapBuilder/?ClientId=@Model.ClientId&ReportType=Add'
            }
            else {
                var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'AlignmentManager/HeatMapSetupBuilder/SetupHeatMapBuilder/?ClientId=@Model.ClientId&ReportType=Add'
            }

            window.location = baseurl;
            




