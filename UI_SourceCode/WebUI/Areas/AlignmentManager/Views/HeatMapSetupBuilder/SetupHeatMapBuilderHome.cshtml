                var SelectedclientId = $('#ClientId :selected').val();

                if (href[3].toLowerCase() == 'alignmentmanager') {
                    var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/HeatMapSetupBuilder/DisplayHeatMapBuilder/?clientId={clientId}'
            }
            else {
                    var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'AlignmentManager/HeatMapSetupBuilder/DisplayHeatMapBuilder/?clientId={clientId}'
            }
                baseurl=  baseurl.replace("{clientId}", SelectedclientId);
                window.location = baseurl;
                return false;
