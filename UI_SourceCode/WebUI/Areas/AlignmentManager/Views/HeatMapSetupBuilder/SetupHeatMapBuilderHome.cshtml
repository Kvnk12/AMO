@using NTTData.AMOPortal.Domain.Entities
@using WebUI.Areas.AlignmentManager.Models
@using WebUI.Areas.AlignmentManager.Objects
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@model NTTData.AMOPortal.WebUI.Dto.HeatMapBuilderSetupInput

@{
    ViewBag.Title = "Performance Predictor";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/performancePredLogo.png");
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@section PPMenu {

    @Html.Partial("_PPTopMenu")
    
    }


<div class="selectappArea">
    <!-- Wrap all page content here -->
    <div class="container">
        <div class="selectApp form-horizontal">
            <div class="form-group">
                <label for="clientName" class="col-sm-4 control-label" id=""><span class="mandate">*</span>Client Name</label>
                <div class="col-sm-5">
                      @using (Html.BeginForm())
                          {
                        @Html.DropDownListFor(m => m.ClientId, new SelectList(Model.ClientList, "value", "text", Model.ClientList), "", new { @class = "selectpicker", id = "ClientId", name = "ClientId", required = "required" })  
                          }
                </div>
            </div>
        </div>
    </div>
    <!--/.container-->
</div>

@*<div class="clear">
</div>*@

<div class="container" style="padding: 0;">
    <!-- <ul class="nav nav-tabs">
                  <li class="active"><a href="#treeMenuArea" data-toggle="tab">Metrics Library</a></li>
                  <li><a href="#metricSetupArea" data-toggle="tab">Metric Setup</a></li>
                  <li><a href="#serviceCreditsArea" data-toggle="tab">Service Credits</a></li>
                  <li><a href="#workingHoursArea" data-toggle="tab">Working Hours</a></li>
			</ul>-->

    <div class="treeMenuArea tab-pane opened" id="treeMenuArea">
        <div class="treeMenuContent" style="min-height: 700px">
            <div class="well well-sm"><strong>Heat Map Reports</strong></div>
            <div class="">
                <!--valchainContent-->
                @{
                    
                if(Model.ClientId > 0)
                    {
                      
                
                <div class="container_12">
                    <button  tabindex="30" class="btn btn-primary" id="btnAdd" style="margin-bottom:10px">New Report</button>
                    <div class="grid_4 height400">
                        <table class="table table-striped" id="pp38Home" cellpadding="0" cellspacing="0" style="width:50%">
                            <thead>
                                <tr>
                                    <th width="45%" scope="col">Heat Map Reports</th>
                                    @*<th width="12%" scope="col">BA Designation</th>*@
@*                                    <th width="35%" scope="col">Source Column</th>
                                    <th width="35%" scope="col">Virtual Column</th>*@
@*                                    <th width="21%" scope="col">Metric</th> 
                                    <th width="28%" scope="col">Weight</th>*@
                                </tr>
                            </thead>

                            @{
                                if (Model.ClientId > 0)
                                    {
                                        
                                    
                                    IList<ReportConfiguration> heatMapReports = Model.heatMapReports;
                                    foreach (ReportConfiguration vwItem in heatMapReports)
                                        {
                                        //if (dataSetObjectName != vwItem.DataSetName)
                                        //    {
                                        //    dataSetObjectName = vwItem.DataSetName;
                                        <tr>
                                            <td>@Html.ActionLink(vwItem.ReportName, "SetupHeatMapBuilder", "HeatMapSetupBuilder", new { ClientId = Model.ClientId, ReportId = vwItem.Id, ReportType="Edit"}, null)</td>  
                                        </tr>
                                        @*<td><a= <b>@dataSetObjectName</b> </td>*@
@*                                        <td>@vwItem.DatasetColumnName</td>
                                        <td>@vwItem.VirtualColumnName</td>
                                        </tr>
                                            }
                                        else
                                            {
                                        <tr>
                                        <td></td>
                                        <td>@vwItem.DatasetColumnName</td>
                                        <td>@vwItem.VirtualColumnName</td>
                                        </tr>*@
                                            }

                                        }


                                    }
                                
                             
                            </table>
                </div>
            </div>
                    }
               }
            <!--.valchainContent-->
                

            <!--/.treeMenuContent container-->
        </div>
        <!--/.treeMenuContent-->
    </div>
    <!--/.treeMenuArea-->

</div>
    </div>

<script>
    $(document).ready(function () {
               
        $('select#ClientId').change(function () {
