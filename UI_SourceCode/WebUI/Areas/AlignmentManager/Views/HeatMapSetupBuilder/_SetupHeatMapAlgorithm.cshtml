        //Selected Columns Button Clicks

        $('#btnRight1').click(function (e) {
            var selectedOpts = $('#lstBox1_1 option:selected');
            if (selectedOpts.length == 0) {
                //alert("Nothing to move.");
                e.preventDefault();
            }

            $('#lstBox1_2').append($(selectedOpts).clone());
            $(selectedOpts).remove();
            e.preventDefault();
        });

        $('#btnLeft1').click(function (e) {
            var selectedOpts = $('#lstBox1_2 option:selected');
            if (selectedOpts.length == 0) {
                //alert("Nothing to move.");
                e.preventDefault();
            }

            $('#lstBox1_1').append($(selectedOpts).clone());
            $(selectedOpts).remove();
            e.preventDefault();
        });

