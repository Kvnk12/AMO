                            foreach (DataSetColumnsForHeatMapReport item in selectedColumns)
                            {
                            if (counter % 2 == 0)
                                {
                                                        <tr>
                            <td>@item.ColumnName</td>
                            <td class="text-center">
                                <input type="checkbox" checked="@item.isSelected"  name="chkCols" value="@item.ColumnName" /></td>
                        </tr>

                                }
                            else
                            { 
