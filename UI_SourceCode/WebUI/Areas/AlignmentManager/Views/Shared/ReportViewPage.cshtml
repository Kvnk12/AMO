@using NTTData.AMOPortal.Domain.Entities
@using WebUI.Areas.AlignmentManager.Models
@using WebUI.Areas.AlignmentManager.Objects
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@model WebUI.Areas.AlignmentManager.Dto.ReportInput

@{
    ViewBag.Title = "Performance Predictor";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/performancePredLogo.png");
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    
}

@section PPMenu {

    @Html.Partial("_PPTopMenu")
    
    }



<div class="selectappArea">
    <!-- Wrap all page content here -->
    <div class="container">
        <div class="selectApp form-horizontal">
            <div class="form-group">
                <label for="clientName" class="col-sm-4 control-label" id=""><span class="mandate">*</span>Client Name</label>
                <div class="col-sm-5">
                    @using (Html.BeginForm())
                        {
                        @Html.DropDownListFor(m => m.ClientId, new SelectList(Model.ClientList, "value", "text", Model.ClientList), "", new { @class = "selectpicker", id = "ClientId", name = "ClientId", required = "required" })  
                        }
                </div>
            </div>
        </div>
    </div>
    <!--/.container-->
</div>
<div class="clear">
</div>

<div class="container" style="padding: 0;">
    <div class="treeMenuArea tab-pane opened" id="treeMenuArea">
        <div class="treeMenuContent">

                    <div class="container" style="padding:0;">
          <div class="amgrcontentLeft" style="width:100%">
            <div class="well well-sm"> <strong>@Model.PageHeading</strong> </div>



                    

            <div class="heatmapContentrtna">
              <div>


                    @if(Model.ClientId > 0)
                        {
                      <ul>

                                                            
                          <li>
                              <iframe src='@Url.Content("~/Reports/ReportViewer.aspx?ReportType=PAREPORT&ClientID="+Model.ClientId+"&ReportName="+Model.ReportName + "")' width="100%" height="750px"></iframe>

                              </li>
                          </ul>
                   }


              </div>
            </div>
          </div>
            
          </div>
          <!--/.amgrcontentLeft--> 
          <!--END OF LEFTAREA-->
          <!-- end of right areaa--> 
            <!--/.treeMenuContent container-->
        </div>
        <!--/.treeMenuContent-->
    </div>
    <!--/.treeMenuArea-->
</div>








@section scripts
{
    <script>
        $(document).ready(function () {

            $('.treemenuOpen').click();
            $("#navigation").treeview({
                persist: "location",
                collapsed: false,
                unique: true
            });
        });
    </script>
}


<script>
    $(document).ready(function () {




        $('select#VariableCategoryId').change(function () {
            var clientId = $("select#VariableCategoryId").val().toString();
            alert(clientId);

        });
        

        $('#btnAddNewChain').click(function () {
            var clientId = $("select#ClientId").val().toString();
            if (clientId == "0" || clientId =="") {
                alert('Please select Client to create new value chain details');
                return false;
            }
            var SelectedclientId = $('#ClientId :selected').val();


            var href = window.location.href.split('/');
            //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
            var baseurl = '';

            var SelectedclientId = $('#ClientId :selected').val();

            if (href[3].toLowerCase() == 'alignmentmanager') {
                var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/AlignmentManager/AddVariable/?ClientId=' + SelectedclientId;
            }
            else {
                var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'AlignmentManager/AlignmentManager/AddVariable/?ClientId=' + SelectedclientId;
            }
            window.location = baseurl;
            return false;

            //var strUrl = window.Location.constructor("http://" + window.location.host + "/"+ window.location.pathname.split("/")[1]+    "/AlignmentManager/AlignmentManager/AddVariable/?ClientId=" + SelectedclientId);
            //window.location = strUrl;

        });

    });


    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (charCode != 46 && charCode != 44 && charCode > 31
          && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }


    $('select#ClientId').change(function () {
        var SelectedclientId = $('#ClientId :selected').val();

        if (SelectedclientId != 0) {
            var href = window.location.href.split('/');
            //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
            var baseurl = '';
            
            if (href[3].toLowerCase() == 'alignmentmanager')
            {
                var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/DataSet/DisplaySSRSReport/?ClientId={clientid}'
            }
            else
            {
                var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'AlignmentManager/DataSet/DisplaySSRSReport/?ClientId={clientid}'
            }

            baseurl = baseurl.replace("{clientid}", SelectedclientId);
            window.location = baseurl;
        }

    });



</script>

