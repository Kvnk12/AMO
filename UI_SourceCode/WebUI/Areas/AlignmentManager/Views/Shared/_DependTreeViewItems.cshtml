@model WebUI.Areas.AlignmentManager.Dto.PPTreeView

@foreach(PPTreeView ppitem in Model.TreeViewItems)
    {
<ul class="treeview" >
    @if (ppitem != null)
    {
        <li >@*<a href="@ppitem.variableId">@ppitem.VariableName</a>*@
            @*@Html.ActionLink(ppitem.VariableName, "DisplayHomePage", "AlignmentManager", new {ClientId=ppitem.ClientId, variableId=ppitem.variableId, variableTypeId=ppitem.varTypeId},null)*@

            @if(ppitem.IsDeleted == 0)
                {
            @Html.ActionLink(ppitem.VariableName, "DisplayHomePage", "AlignmentManager", new {ClientId=ppitem.ClientId, variableId=ppitem.variableId, variableTypeId=ppitem.varTypeId},null)
                }
            else
            {
                 @ppitem.VariableName
            }




        @*<li>@Html.ActionLink(Model.VariableName, "DisplayHomePage", "AlignmentManager", new {ClientId=Model.ClientId, variableId=Model.variableId},null) *@
            @if (ppitem.TreeViewItems.Count > 0)
