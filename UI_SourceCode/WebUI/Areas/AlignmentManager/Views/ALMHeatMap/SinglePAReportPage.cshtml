@using NTTData.AMOPortal.Domain.Entities
@using WebUI.Areas.AlignmentManager.Models
@using WebUI.Areas.AlignmentManager.Objects
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@model WebUI.Areas.AlignmentManager.Dto.PAReportsInput

@{
    ViewBag.Title = "Performance Predictor";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/performancePredLogo.png");
    Layout = "~/Views/Shared/_AppLayout.cshtml";

}

@section PPMenu {

    @Html.Partial("_PPTopMenu")

}



<div class="selectappArea">
    <!-- Wrap all page content here -->
    <div class="container">
        <div class="selectApp form-horizontal">
            <div class="form-group">
                <label for="clientName" class="col-sm-4 control-label" id=""><span class="mandate">*</span>Client Name</label>
                <div class="col-sm-5">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.DropDownListFor(m => m.ClientId, new SelectList(Model.ClientList, "value", "text", Model.ClientList), "", new { @class = "selectpicker", id = "ClientId", name = "ClientId", required = "required" })
                    }
                </div>
            </div>


        </div>
        <div class="selectApp form-horizontal">
            <div class="form-group">
                <label for="clientName" class="col-sm-7 control-label" id=""><span class="mandate">*</span>PA Reports</label>
                <div class="col-sm-5">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.DropDownListFor(m => m.ReportId, new SelectList(Model.PAReportList, "value", "text", Model.PAReportList), "", new { @class = "selectpicker", id = "HeatMapReportId", name = "HeatMapReportId", required = "required" })
                    }
                </div>
            </div>


        </div>

    </div>
    <!--/.container-->
</div>
<div class="clear">
</div>

<div class="container">

    <div class="treeMenuArea tab-pane opened" id="treeMenuArea">
        <div class="treemenuOpen"><a href="#"><span class="glyphicon glyphicon-chevron-right"></span></a></div>
        <div class="treemenu" style="height:683px">
            @if (Model.ClientId > 0)
            {

                <div class="hdr">

                    <h3>Performance Predictor</h3>

                    @*<a href="javascript:void(0)" class="treemenuClose"><span class="glyphicon glyphicon-chevron-left"></span></a>*@
                </div>
                <span class="" style="margin-left:10px;width:91%"></span>
                @*<button id="btnAddNewChain" class="btn btn-primary" style="margin-left:10px;width:91%" tabindex="">Create New Item</button>*@
            <!-- add the tree menu here-->@*
                    @{if (Model.ClientId > 0)
                          {
            *@
                @*<div style="margin-top:60px;margin-left:12px">@Html.Partial("_TreeView", Model.SetTreeMenu(Model.ClientId))</div>*@

                <div style="margin-top:-11px;margin-left:12px">@Html.Partial("_HeatMapTreeView", Model.PPTreeViewRoot)</div>
            }

        </div>
        <!-- treemenu ends-->
        <div class="treeMenuContent">
            <div class="container" style="padding:0;">
                <div class="slaleftpane">
                    <div class="well well-sm">PA Report: <b>@Model.PAReportName</b></div>
                    @{
                        IEnumerable<SelectListItem> paReports = Model.PAReportNames;
                        //var reportName = "NBA METRIC Report";
                    }



                    <ul style="margin-left:-34px!important">



                        @if (Model.SSRSTemplateFileId > 0)
                        {
                            <li style="margin-left:0">
                                @*<iframe src='@Url.Content("~/Reports/ReportViewer.aspx?ReportName="+@Model.ReportName+ "&ClientID="+Model.ClientId+"&PAReportName="+@Model.PAReportName + "")' width="100%" height="623px" style="border:0!important"></iframe>*@
                                <iframe src='@Url.Content("~/Reports/ReportViewer.aspx?"+@Model.SSRSReportURLString + "")' width="100%" height="623px" style="border:0!important"></iframe>

                            </li>
                        }
                    </ul>

                    <div class="clearfix"></div><!--This is to clear the floats-->

                </div>
                <!--END OF LEFTAREA-->
                <!--/.slarightpane -->
            </div><!--/.treeMenuContent container-->
        </div><!--/.treeMenuContent-->
    </div><!--/.treeMenuArea-->


</div>









@section scripts
{
    <script>
        $(document).ready(function () {
            $('.treemenuOpen').click();
            $("#navigation").treeview({
                //persist: "location",
                collapsed: false,
                unique: true
            });
        });
    </script>
}


<script>
    $(document).ready(function () {

@*        var rpname = "@Model.PAReportName";
        if(rpname != "")
            {
        $('select#HeatMapReportId').text(rpname);
            }*@

        $('select#VariableCategoryId').change(function () {
