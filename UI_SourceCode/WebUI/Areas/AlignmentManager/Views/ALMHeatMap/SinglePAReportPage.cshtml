            alert(clientId);

        });


        $('#btnAddNewChain').click(function () {
            var clientId = $("select#ClientId").val().toString();
            if (clientId == "0" || clientId == "") {
                alert('Please select Client to create new value chain details');
                return false;
            }

            var SelectedclientId = $('#ClientId :selected').val();

            var baseurl = '';
            if (href[3].toLowerCase() == 'alignmentmanager') {
                var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/AddVariable/?ClientId=' + SelectedclientId
            }
            else {
                var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'AlignmentManager/AlignmentManager/AddVariable/?ClientId=' + SelectedclientId
            }

            window.location = baseurl;



            //var SelectedclientId = $('#ClientId :selected').val();
            //var strUrl = window.Location.constructor("http://" + window.location.host + "/" + window.location.pathname.split("/")[1] + "/AlignmentManager/AlignmentManager/AddVariable/?ClientId=" + SelectedclientId);
            //window.location = strUrl;

        });

    });


    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (charCode != 46 && charCode != 44 && charCode > 31
          && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }


    $('select#ClientId').change(function () {
        var SelectedclientId = $('#ClientId :selected').val();

        if (SelectedclientId != 0) {
            var href = window.location.href.split('/');
            //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
            var baseurl = '';
            if (href[3].toLocaleLowerCase() == 'alignmentmanager') {
                //alert('local url');

                var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/ALMHeatMap/DisplayTrendReport/?ClientId={clientid}&cid={Client}'
            }
            else {
                //alert('server');
                var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'AlignmentManager/ALMHeatMap/DisplayTrendReport/?ClientId={clientid}&cid={Client}'
            }

            baseurl = baseurl.replace("{clientid}", SelectedclientId);
            baseurl = baseurl.replace("{Client}", SelectedclientId);
            window.location = baseurl;
        }



    });


    $('select#HeatMapReportId').change(function () {
        var pareportname = $('#HeatMapReportId :selected').text();
        var reportid = $('#HeatMapReportId :selected').val();
        var SelectedclientId = $('#ClientId :selected').val();
        if (SelectedclientId != 0 && reportid != 0) {
            var href = window.location.href.split('/');
            //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
            var baseurl = '';
            if (href[3].toLocaleLowerCase() == 'alignmentmanager') {
                //alert('local url');

                var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/ALMHeatMap/DisplayTrendReport/?ClientId={clientid}&PAReportName={pareportname}&ReportId={reportid}'
            }
            else {
                //alert('server');
                var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'AlignmentManager/ALMHeatMap/DisplayTrendReport/?ClientId={clientid}&PAReportName={pareportname}&ReportId={reportid}'
            }


            baseurl = baseurl.replace("{clientid}", SelectedclientId);
            baseurl = baseurl.replace("{pareportname}", pareportname);
            baseurl = baseurl.replace("{reportid}", reportid);




            window.location = baseurl;
        }

    });

</script>

