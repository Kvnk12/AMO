<script>


            @*var jsonHeatMap =  @Model.JsonHeatMapItems.ToString();*@

    function heatmapdataShow(e) {
        $("#modal-body").children().remove();
        $("#modal-body").append($("#" + e).attr("data-heatMapData"));
        //alert($("#" + e).text());
        $("#detailReport").text("Variable Data:" + $("#" + e).text());
        $("#detailReport").attr("visible", "true");
        $("#myModal").modal();
    }
    function htmapclick(e)
    {
        alert(jsonHeatMap);
        //alert(e);

    }

    function refreshtreemenu() {



        $("#navigation").treeview({
            collapsed: false
        });

    }


    $(document).ready(function () {

        //$('.treemenuOpen').click(function () { });
        $(document).ready(function () {
            $('.treemenuOpen').click();
            $("#navigation").treeview({
                //persist: "location",
                collapsed: false,
                unique: true
            });
        });



        $('select#VariableCategoryId').change(function () {
            var clientId = $("select#VariableCategoryId").val().toString();
            alert(clientId);

        });


        $('#btnAddNewChain').click(function () {
            var clientId = $("select#ClientId").val().toString();
            if (clientId == "0" || clientId == "") {
                alert('Please select Client to create new value chain details');
                return false;
            }

            var SelectedclientId = $('#ClientId :selected').val();

            var baseurl = '';
            if (href[3].toLowerCase() == 'alignmentmanager') {
                var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/AddVariable/?ClientId=' + SelectedclientId
            }
            else {
                var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'AlignmentManager/AlignmentManager/?ClientId=' + SelectedclientId
            }

            window.location = baseurl;


            //var strUrl = window.Location.constructor("http://" + window.location.host + "/" + window.location.pathname.split("/")[1] + "/AlignmentManager/AlignmentManager/AddVariable/?ClientId=" + SelectedclientId);
            //window.location = strUrl;

        });

    });


    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (charCode != 46 && charCode != 44 && charCode > 31
          && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }


    $('select#ClientId').change(function () {
        var SelectedclientId = $('#ClientId :selected').val();

        if (SelectedclientId != 0) {
            var href = window.location.href.split('/');
            //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
            var baseurl = '';
            if (href[3].toLowerCase() == 'alignmentmanager')
            {
                var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/HeatMapSetup/DisplayClientHeatMaps/?ClientId={clientid}&cid={Client}'
            }
            else
            {
                var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'AlignmentManager/HeatMapSetup/DisplayClientHeatMaps/?ClientId={clientid}&cid={Client}'
            }

            baseurl = baseurl.replace("{clientid}", SelectedclientId);
            baseurl = baseurl.replace("{Client}", SelectedclientId);
            window.location = baseurl;
        }

    });


    $('select#HeatMapReportId').change(function () {
        var SelectedHeatMapReportId = $('#HeatMapReportId :selected').val();
        var SelectedclientId = $('#ClientId :selected').val();
        if (SelectedclientId != 0 && SelectedHeatMapReportId != 0) {
            var href = window.location.href.split('/');
            var baseurl = '';
            if (href[3].toLocaleLowerCase() == 'alignmentmanager') {

                var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/ALMHeatMap/DisplayClientHeatMaps/?ClientId={clientid}&ReportId={reportid}&cid={Client}'
            }
            else {
                var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'AlignmentManager/ALMHeatMap/DisplayClientHeatMaps/?ClientId={clientid}&ReportId={reportid}&cid={Client}'
            }

            baseurl = baseurl.replace("{clientid}", SelectedclientId);
            baseurl = baseurl.replace("{Client}", SelectedclientId);
            baseurl = baseurl.replace("{reportid}", SelectedHeatMapReportId);

            window.location = baseurl;

        }

    });

</script>

