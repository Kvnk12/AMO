@model NTTData.AMOPortal.WebUI.Dto.mdmDataUploadTableInput
@using WebUI.Dto;
@using NTTData.AMOPortal.Domain.Entities;
@{
    ViewBag.Title = "Performance Predictor";
    Layout = "~/Views/Shared/_DataMaintenanceAppLayout.cshtml";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/logo.png");
   // Client client = (Client)Session["Client"];
    ClientDetail client = (ClientDetail)Session["SessionClient"];
    Model.ClientId = client.ClientId;
}



@using (Html.BeginForm())
{

        <!--.container-->

    <div class="selectappArea">
        <!-- Wrap all page content here -->
        <div class="container">
            <div class="selectApp form-horizontal">
                <div class="form-group">
                    <label for="clientName" class="col-sm-5 control-label"><span class="mandate">*</span> Client Name</label>
                    <div class="col-sm-5">
                        @Html.DropDownListFor(m => m.ClientId, new SelectList(Model.ClientList, "value", "text", Model.ClientId), "", new { @class = "selectpicker", id = "ddlClient", tabindex = "1", @disabled = "disabled" })
                    </div>
                </div>
            </div>
            <!--/.selectApp-->
            <!--/.selectyearArea-->
        </div>
        <!--/.container-->
    </div>

        <!--/.selectappArea-->
        <div class="clear"></div>
        <div>
            <ol class="breadcrumb container">
                <li class="active">Performance Predictor</li>
                <li class="active">Data Upload</li>
            </ol>
        </div>

        <!--end of breadcrumb container-->
    <div class="container" style="padding:0;">
        @*            @if (!ViewData.ModelState.IsValid)
            {
              @Html.ValidationSummary(false, "", new { @class = "alert alert-info container" })
            }*@
        <div class="treeMenuArea tab-pane opened" id="treeMenuArea">
            @*<div class="treemenuOpen"><a href="#"><span class="glyphicon glyphicon-chevron-right"></span></a></div>
                @Html.Partial("_DMCatelog")*@
            <!-- treemenu ends-->
            <div class="treeMenuContent">
                <div class="container" style="padding:0;">
                    <div style="min-height:700px">
                        <div class="timeZonearea">
                            <div class="left timeLeft">
                                <div class="form-group">
                                    <label class="col-sm-8 control-label" for="sametime">DataUpload</label>
                                    @Html.HiddenFor(m => m.ClientId)
                                    @if (Model.ClientId != 0)
                                    {
                                            <p>@Html.ActionLink("Upload Data", "DataUploadView", new { clientid = Model.ClientId })</p>
                                    }
                                </div>
                            </div>
                            <!--.left-->
                            <!--/.right-->
                        </div>
                        <!--/.well-->


                        <div>


                            @*<div class="form-horizontal" style="margin-right: 29px;">
                                <div class="form-group col-sm-4 pull-left">
                                    <label for="sladmonth" class="col-sm-3 control-label">Tablename</label>
                                    <div class="col-sm-3">
                                        @Html.DropDownListFor(m => m.DataTablename, new SelectList(Model.PPtablename, "value", "text", Model.DataTablename), "", new { @class = "selectpicker", tabindex = "6", id = "pptblname" })
                                    </div>
                                </div>

                            </div>end of form-horizontal*@ 










                            <div class="svccalhr">
                                @*@if (Model.DataTablename != null )
                                {*@
                                    <table class="table table-bordered table-striped">

                                        <thead>
                                            <tr>
                                                <th>UploadID</th>
                                                <th>ClientID</th>
                                                <th>Tablename</th>
                                                <th>Filename</th>
                                                <th>DateUploaded</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var item in Model.DataFileLists)
                                            {
                                                <tr>

                                                    <td>
                                                            @item.Id
                                                      
                                                    </td>
                                                    <td>@item.ClientId</td>
                                                    <td>@item.datatablename</td>
                                                    <td>@item.datafilename</td>
                                                   <td>@item.dateuploaded</td>
                                                    
                                                    <td>
                                                        @Html.Hidden("Id", item.Id)
                                                        <button type="submit" class="btn btn-default" tabindex="22" onclick="location.href='@Url.Action("DelJobIDData", "PPDataUpload", new { id = item.Id })'; return false;" @((User.IsInRole("User")) ? "disabled" : "")>Delete</button>

                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>

                                @* } *@

                            </div>
                        </div>
                    </div>
                    <!--END OF LEFTAREA-->
                </div>
                <!--/.treeMenuContent container-->
            </div>
            <!--/.treeMenuContent-->
        </div>
        <!--/.treeMenuArea-->
    </div>
        <!--/.container-->

}
