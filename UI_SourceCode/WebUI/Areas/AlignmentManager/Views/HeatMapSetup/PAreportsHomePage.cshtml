@using NTTData.AMOPortal.Domain.Entities
@using WebUI.Areas.AlignmentManager.Models
@using WebUI.Areas.AlignmentManager.Objects
@using NTTData.AMOPortal.WebUI.Dto
@using System.Data
@model WebUI.Areas.AlignmentManager.Dto.PAReportsInput

@{
    ViewBag.Title = "Performance Predictor";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/performancePredLogo.png");
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    
}

@section PPMenu {

    @Html.Partial("_PPTopMenu")
    
    }



<div class="selectappArea">
    <!-- Wrap all page content here -->
    <div class="container">
        <div class="selectApp form-horizontal">
            <div class="form-group">
                <label for="clientName" class="col-sm-4 control-label" id=""><span class="mandate">*</span>Client Name</label>
                <div class="col-sm-5">
                    @using (Html.BeginForm())
                        {
                        @Html.DropDownListFor(m => m.ClientId, new SelectList(Model.ClientList, "value", "text", Model.ClientList), "", new { @class = "selectpicker", id = "ClientId", name = "ClientId", required = "required" })  
                        }
                </div>
            </div>
        </div>
    </div>
    <!--/.container-->
</div>
<div class="clear">
</div>

        <div class="container">
        
            <div class="treeMenuArea tab-pane opened" id="treeMenuArea">
                <div class="treemenuOpen"><a href="#"><span class="glyphicon glyphicon-chevron-right"></span></a></div>
                        <div class="treemenu" style="height:683px">
            @if(Model.ClientId > 0)
                {
                
                <div class="hdr">

                    <h3>Performance Predictor</h3>

                    @*<a href="javascript:void(0)" class="treemenuClose"><span class="glyphicon glyphicon-chevron-left"></span></a>*@
                </div>
                <span  class="" style="margin-left:10px;width:91%" ></span>
                @*<button id="btnAddNewChain" class="btn btn-primary" style="margin-left:10px;width:91%" tabindex="">Create New Item</button>*@
            <!-- add the tree menu here-->@*
            @{if (Model.ClientId > 0)
                  {
                  *@
                @*<div style="margin-top:60px;margin-left:12px">@Html.Partial("_TreeView", Model.SetTreeMenu(Model.ClientId))</div>*@
                
                <div style="margin-top:-20px;margin-left:12px">@Html.Partial("_HeatMapTreeView", Model.PPTreeViewRoot)</div>
                  } 
                
        </div>
<!-- treemenu ends-->
                <div class="treeMenuContent">
                	<div class="container" style="padding:0;">
                        <div class="slaleftpane">
                          <div class="well well-sm">PA Reports Dashboard</div>
                               @{
                                   IEnumerable<SelectListItem> paReports = Model.PAReportNamesWithSSRSURL;
                      //var reportName = "NBA METRIC Report";
                      }

                      <ul>

                      @foreach(SelectListItem lstItem in paReports)
                          {
                                  
                          <li>
                               <span class="htamber" style="width:350px;height:50px" >@lstItem.Text</span>
                              @*<iframe src='@Url.Content("~/Reports/ReportViewer.aspx?ReportName="+@lstItem.Text+ "&ClientID="+Model.ClientId+"&PAReportName="+@lstItem.Value + "")' width="100%" height="623px" style="border:0!important"></iframe>*@
                              <iframe src='@Url.Content("~/Reports/ReportViewer.aspx?"+@lstItem.Value + "")' width="100%" height="623px" style="border:0!important"></iframe>
                              </li>
                          }
                          </ul>
                   
                         
                            <div class="clearfix"></div><!--This is to clear the floats-->
                         
                         </div>
                        <!--END OF LEFTAREA-->   

                  		<!--/.slarightpane -->
                    </div><!--/.treeMenuContent container-->
                </div><!--/.treeMenuContent-->
            </div><!--/.treeMenuArea-->
        
        
</div>









@section scripts
{
    <script>
        $(document).ready(function () {

            $('.treemenuOpen').click();
            $("#navigation").treeview({
                //persist: "location",
                collapsed: false,
                unique: true
            });
        });
    </script>
}


<script>
    $(document).ready(function () {




        $('select#VariableCategoryId').change(function () {
            var clientId = $("select#VariableCategoryId").val().toString();
            alert(clientId);

        });
        

        $('#btnAddNewChain').click(function () {


            var clientId = $("select#ClientId").val().toString();
            if (clientId == "0" || clientId =="") {
                alert('Please select Client to create new value chain details');
                return false;
            }

            var href = window.location.href.split('/');
            //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
            var baseurl = '';

            var SelectedclientId = $('#ClientId :selected').val();

            if (href[3].toLowerCase() == 'alignmentmanager') {
                var baseurl = href[0] + '//' + href[2] + '/' + '/AlignmentManager/AlignmentManager/AddVariable/?ClientId=' + SelectedclientId
            }
            else {
                var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'AlignmentManager/AlignmentManager/AddVariable/?ClientId=' + SelectedclientId
            }

            window.location = baseurl;
            return false;
            //var SelectedclientId = $('#ClientId :selected').val();
            //var strUrl = window.Location.constructor("http://" + window.location.host + "/"+ window.location.pathname.split("/")[1]+    "/AlignmentManager/AlignmentManager/AddVariable/?ClientId=" + SelectedclientId);
            //window.location = strUrl;

        });

    });


    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (charCode != 46 && charCode != 44 && charCode > 31
          && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }


    $('select#ClientId').change(function () {
        var SelectedclientId = $('#ClientId :selected').val();

        if (SelectedclientId != 0) {
            var href = window.location.href.split('/');
            //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
            var baseurl = '';
            
            if (href[3].toLowerCase() == 'alignmentmanager')
            {
                var baseurl = href[0] + '//' + href[2] + '/' + 'AlignmentManager/HeatMapSetup/DisplayClientsPAReports/?ClientId={clientid}'
            }
            else
            {
                var baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'AlignmentManager/HeatMapSetup/DisplayClientsPAReports/?ClientId={clientid}'
            }

            baseurl = baseurl.replace("{clientid}", SelectedclientId);
            window.location = baseurl;
        }

    });



</script>

