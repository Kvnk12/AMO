<script>
    $(document).ready(function () {
        $('#drpSerCat').change(function () {
            var list = this;
            var SelectedclientId = $('#drpSerCat :selected').val();
            var href = window.location.href.split('/');
            var baseurl = '';
            if (href[3] == 'SLAManager') {
                var baseurl = href[0] + '//' + href[2] + '/' + 'SLAManager/BindService'
            }
            else {
                var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'SLAManager/BindService'
            }
            if ($("#drpSerCat :selected").val() != "") {
                $.ajax({
                    url: baseurl,
                    type: 'GET',
                    data: { sercatId: SelectedclientId },
                    success: getClientsAccountsFunc,
                    failure: errorInClientAccountsunc
                });
            }
        });


        function getClientsAccountsFunc(data, status) {
            $("select#drpSer").empty();
            $("select#drpSer").selectpicker('refresh');
            $("select#drpSer").append("<option></option>");
            $.each(data, function (key, value) {
                $("select#drpSer").append("<option value='" + value.SerId + "'>" + value.SerName + "</option>");
            });
            $("select#drpSer").selectpicker('refresh');
        }

        function errorInClientAccountsunc() {
            alert('error');
        }
    })
</script>