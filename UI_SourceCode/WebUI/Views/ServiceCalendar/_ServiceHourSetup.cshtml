            .Name("weekStartTime")
            .Value("1:00")
            .ComponentType("modern")
            //.HtmlAttributes(new { style = "width: 100%", title = "timepicker" })
            .DateInput()
            .Enable(false)
        )
                </div>
                <div class="sla-time">
                    @(Html.Kendo().TimePicker()
            .Name("weekEndTime")
            .Value("23:59")
            .ComponentType("modern")
            //.HtmlAttributes(new { style = "width: 100%", title = "timepicker" })
            .DateInput()
            .Enable(false)
        )
