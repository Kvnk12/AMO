    function errorInDropdownPopulation(err) {
        alert(err.stringify())
    }
    function getContracts(data, status) {

        $("select#drpAccountContract").empty();
        $("select#drpAccountContract").selectpicker('refresh');
        $("select#drpAccountContract").append("<option value='0'></option>");
        $.each(data, function (key, value) {
            $("select#drpAccountContract").append("<option value='" + value.Value + "'>" + value.Text + "</option>");
        });
        $("select#drpAccountContract").selectpicker('refresh');
    }

    function holidaysave() {
        var desc = $("#Holidayname").data("kendoTextBox");
        var Holidayname = desc.value();
        var Calendardate = $("#Calendardate").data("kendoDatePicker").value();
       // console.log(Calendardate);
        //var starttimepicker = $("#StartTime").data("kendoTimePicker");
        //var StartTime = starttimepicker.value();
        var StartTime = $("#StartTime").val().toString();
       // var endtimepicker = $("#EndTime").data("kendoTimePicker");
        //var EndTime = endtimepicker.value();
        var EndTime = $("#EndTime").val().toString();
        var AccountId = $("#AccountId").data("kendoDropDownList").value();
        var ContractId = $("#ContractId").data("kendoDropDownList").value();
        var Calendaryear = $("#Calendaryear").data("kendoDropDownList").value();
        var caledate = Calendardate.toDateString();
        console.log(caledate);
        var mod = {
            Holidayname: Holidayname,
            Calendardatestr: caledate,
            StartTime: StartTime,
            EndTime: EndTime,
            AccountId : AccountId,
            ContractId: ContractId ,
            Calendaryear: Calendaryear
        };
        var data1 = JSON.stringify(mod);
        baseurl1 = '@Url.Content("~/ServiceCalendar/GenerateServiceHolidayCalendar")';
       // $('#loading').show();
        $.ajax(
        {
            url: baseurl1,
            type: 'post',
            data: data1,
            async: false,
            contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    console.log("saved");
                   // $('#loading').hide();
                    document.getElementById('alertmsg').innerHTML = "Holiday hours calendar created successfully";
                    $('#serviceCalendarAlertModal').modal('show');
                    $("#HolidayCalenderGrid").getKendoGrid().dataSource.read();
                    $("#CalenderServiceGrid").getKendoGrid().dataSource.read();
            }
       })
    }

    function deleteCalender(Id) {
        var Calendaryear = $("#Calendaryear").data("kendoDropDownList").value();
        console.log(Id);
        console.log(Calendaryear);
                baseurl1 = '@Url.Content("~/ServiceCalendar/DeleteHolidayCalender")';
        $.ajax({
            url: baseurl1,
            type: "Post",
            data: {
                scid: Id,
                scCalendaryear: Calendaryear
            },
            error: function (response) {
                alert('Error');
            },
            success: function (data) {

                document.getElementById('alertmsg').innerHTML = "Holiday Calendar deleted sucessfully";
                $('#serviceCalendarAlertModal').modal('show');
                $("#CalenderServiceGrid").getKendoGrid().dataSource.read();
                $("#HolidayCalenderGrid").getKendoGrid().dataSource.read();

            }
        })
    }

    function EditCalender(Daydate, Monthnumber, Calendaryear) {
        console.log("edit");
        console.log(Daydate);
        console.log(Monthnumber);
        console.log(Calendaryear);
        $("#edit_Daydate").val(Daydate);
        $("#edit_Monthnumber").val(Monthnumber);
        $("#edit_Calendaryear").val(Calendaryear);
        var date = Monthnumber + "/" + Daydate + "/" + Calendaryear;
        document.getElementById('edit_date').innerHTML = date;

        $('#editServiceCalendarModal').modal('show');

    }
   
    function saveServiceCalendar() {
        var StartTime = $("#edit_StartTime").val().toString();
        var EndTime = $("#edit_EndTime").val().toString();
       // console.log(StartTime);
        //console.log(EndTime);
        var AccountId = $("#AccountId").data("kendoDropDownList").value();
        var ContractId = $("#ContractId").data("kendoDropDownList").value();
        var Daydate = $("#edit_Daydate").val();
        var Monthnumber = $("#edit_Monthnumber").val();
        var Calendaryear = $("#edit_Calendaryear").val();

        var mod = {
            Daydate: Daydate,
            Monthnumber: Monthnumber,
            StartTime: StartTime,
            EndTime: EndTime,
            AccountId: AccountId,
            ContractId: ContractId,
            Calendaryear: Calendaryear
        };
        var data1 = JSON.stringify(mod);
        baseurl1 = '@Url.Content("~/ServiceCalendar/EditServiceCalender")';
        // $('#loading').show();
        $.ajax(
            {
                url: baseurl1,
                type: 'post',
                data: data1,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    console.log("saved");
                    // $('#loading').hide();
                    document.getElementById('alertmsg').innerHTML = "Service Calendar Updated successfully";
                    $('#serviceCalendarAlertModal').modal('show');
                    $("#HolidayCalenderGrid").getKendoGrid().dataSource.read();
                    $("#CalenderServiceGrid").getKendoGrid().dataSource.read();
                }
            })
    }

</script>