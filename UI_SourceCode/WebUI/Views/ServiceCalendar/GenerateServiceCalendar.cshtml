@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using Kendo.Mvc.UI;
@using System.Data;
@using WebUI.Dto;

@model NTTData.AMOPortal.WebUI.Dto.ServiceCalendarModel

@{
    ViewBag.Title = "SLA Manager";

    <link rel="stylesheet" href="~/Content/css/bootstrap-multiselect.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />
    <link rel="stylesheet" href="styles/kendo.common.min.css" />
    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/JScript/kendo.all.min.js"></script>
    <script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>
    <script src="~/Content/js/bootstrap-multiselect.js"></script>
    <script src="~/Scripts/JScript/jszip.min.js"></script>

    ViewBag.ImagePathOne = Url.Content("~/Content/images/home/sla_manager_white.svg");
    Layout = "~/Views/Shared/GenericLayOut.cshtml";
    ClientDetail client = (ClientDetail)Session["SessionClient"];
    Model.Clientid = client.ClientId;


}


@if (@User.IsInRole("User") == true || @User.IsInRole("CustomerUser") == true)
{
    <div class="alert alert-info container readonly">
        You are in <b>READ ONLY</b> mode.
    </div> } @*@Html.HiddenFor(@User.IsInRole("User"), new { id = "isRole"})*@

<div class="content-main custom-grid dark-bg">
    <div>
        <!--start of breadcrumb-->
        <ol class="breadcrumb ">
            <li>SLA Manager</li>
            <li class="active">Service Hours</li>
        </ol>
    </div>

    <div class="sla-service-calender">
        <div class="sla-servicecal-header">
            <div class="sla-header-fields">
                <label class="custom-white-label">Account</label>
                <div class="custom-dropdown">
                    @(Html.Kendo().DropDownListFor(e => e.AccountId)
        .Name("AccountId")
        .DataTextField("Text")
        .OptionLabel("Select Account...")
        .DataValueField("Value")
        .BindTo(Model.ClientAccounts)
        .Events(e =>
        {
            e.Change("onSelectAccount");
        })
        .AutoBind(true)
                    )
                </div>
            </div>
            <div class="sla-header-fields">
                <label class="custom-white-label">Account contract</label>
                <div class="custom-dropdown">
                    @(Html.Kendo().DropDownListFor(e => e.ContractId)
        .Name("ContractId")
        .DataTextField("Text")
        .OptionLabel("Select Contract...")
        .DataValueField("Value")
        .DataSource(d => d
            .Read(read => read.Action("getContractId", "ServiceCalendar").Data("GetAccId"))
            )
        .AutoBind(true)
                    )
                </div>
            </div>
            <div class="sla-header-fields">
                <label class="custom-white-label">Calendar Year</label>
                <div class="custom-dropdown">
                    @(Html.Kendo().DropDownListFor(e => e.Calendaryear)
        .Name("Calendaryear")
        .DataTextField("Text")
        .OptionLabel("Select Year...")
        .DataValueField("Value")
        .BindTo(Model.YearList)
        .Events(e =>
        {
            e.Change("onSelectYear");
        })
        .AutoBind(true)
                    )
                </div>
            </div>
        </div>
        @*<img id="loading" src="~/Content/images/reload.gif" alt="Saving ..." style="display: none;" />*@
        <div class="custom-kendo-tabstrip">
            @(Html.Kendo().TabStrip()
                      .Name("tabstrip")
                      .Items(tabstrip =>
                      {
                          tabstrip.Add().Text("Service Hours Setup")
                              .Selected(true)
                              .Content(m => Html.Partial("_ServiceHourSetup", Model));
                          tabstrip.Add().Text("Holiday Hours Setup")
                              .Content(m => Html.Partial("_HolidayHourSetup", Model));
                          tabstrip.Add().Text("Service Hours Calender")
                              .Content(m => Html.Partial("_ServiceHourCalender", Model));
                      })
                        .Events(ev =>
                        {
                            ev.Select("onSelectTab");
                        })
                        )
        </div>
    </div>

</div>
<div id="serviceCalendarAlertModal" class="modal fade serviceCalendar-alert" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <p> <span id="alertmsg"></span></p>
            </div>
        </div>
    </div>
</div>
<div class="modal fade editServiceCalendar-Modal" id="editServiceCalendarModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="kedbretireConfirmModalLabel">Edit <span id="edit_date"></span> Service Calendar</h5>

                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="edit-popup">
                    <div class="edit-popup-item">
                        @Html.Hidden("edit_Daydate")
                        @Html.Hidden("edit_Monthnumber")
                        @Html.Hidden("edit_Calendaryear")

                    </div>
                    <div class="edit-popup-item" style="width: 20em;">
                        <label>Start Time :</label>
                        <div class="sla-time">
                            @(Html.Kendo().TimePicker()
                              .Name("edit_StartTime")
                              .Value("1:00")
                              .ComponentType("modern")
                              .DateInput()
                            )
                        </div>
                    </div>
                    <div class="edit-popup-item" style="width: 20em;">
                        <label>End Time :</label>
                        <div class="sla-time">
                            @(Html.Kendo().TimePicker()
                              .Name("edit_EndTime")
                              .Value("23:59")
                              .ComponentType("modern")
                              .DateInput()
                            )
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" data-bs-dismiss="modal" class="btn btn-primary  saveServiceCalendar-modal" onclick="saveServiceCalendar()">Save</button>
            </div>
        </div>
    </div>
</div>


