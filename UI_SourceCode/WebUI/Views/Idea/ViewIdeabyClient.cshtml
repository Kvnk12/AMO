@model NTTData.AMOPortal.WebUI.Dto.IdeaInput
@using NTTData.AMOPortal.Domain.Entities;
@{
    ViewBag.Title = "SLA Manager";
    Layout = "~/Views/Shared/_DataMaintenanceAppLayout.cshtml";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/logo.png");
    Client client = (Client)Session["Client"];
    Model.ClientId = client.Id;
    }



 @using (Html.BeginForm())
 {

        <!--.container-->@*
        <div class="selectappArea">
        <!-- Wrap all page content here -->
          <div class="container">
            <div class="selectApp form-horizontal">
              <div class="form-group">
                <label for="clientName" class="col-sm-5 control-label"><span class="mandate">*</span> Client Name</label>
                <div class="col-sm-5">
                     Html.DropDownListFor(m => m.ClientId, new SelectList(Model.ClientsList, "value", "text", Model.ClientId),"", new { class = "selectpicker", id = "ddlClient", tabindex = "6" })
                </div>
              </div>
            </div>
            <!--/.selectApp-->
            <!--/.selectyearArea--> 
          </div>
          <!--/.container--> 
        </div>
        <!--/.selectappArea-->*@
        <div class="clear"></div>
        <div>
          <!--start of breadcrumb-->
          <ol class="breadcrumb container">
            <li><a href="#">SLA Manager</a></li>
             <li><a href="#">Data Administration</a></li>
            <li><a href="#">Data Maintanence</a></li>
            <li class="active">Idea</li>
          </ol>
        </div>
                
        <!--end of breadcrumb container-->
        <div class="container" style="padding:0;">
          <div class="treeMenuArea tab-pane opened" id="treeMenuArea">
            @if (!ViewData.ModelState.IsValid)
            {
              @Html.ValidationSummary(false, "", new { @class = "alert alert-info container" })
            }
            <div class="treemenuOpen"><a href="#"><span class="glyphicon glyphicon-chevron-right"></span></a></div>
            @Html.Partial("_DMCatelog")
            <!-- treemenu ends-->
            <div class="treeMenuContent">
              <div class="container" style="padding:0;">
                <div style="min-height:700px">
                  <div class="timeZonearea">
                    <div class="left timeLeft">
                      <div class="form-group">
                        <label class="col-sm-8 control-label" for="sametime">Idea Data Set </label>
                        @if(Model.ClientId !=0)
                        {
                        <p>@Html.ActionLink("Add New Idea", "CreateIdea", new {Id = Model.ClientId })</p>
                        }
                      </div>
                    </div>
                    <!--.left-->
                    
                    <!--/.right-->
                  </div>
                  <!--/.well-->
                  <div class="container_12">
                      @Html.Partial("_ViewIdeaByClient", Model)
                   
                    <div class="clear"></div>
                  </div>
                </div>
                <!--END OF LEFTAREA-->
              </div>
              <!--/.treeMenuContent container-->
            </div>
            <!--/.treeMenuContent-->
          </div>
          <!--/.treeMenuArea-->
        </div>
        <!--/.container-->
    
}

<script>
    $('select#ddlClient').change(function () {
        var SelectedclientId = $('#ddlClient :selected').val();
        var href = window.location.href.split('/');
        //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
        var baseurl = '';
        if (href[3] == 'Idea') {
            //alert('local url');

            var baseurl = href[0] + '//' + href[2] + '/' + 'Idea/ViewIdeabyClient/?ClientId='
        }
        else {
            //alert('server');
            var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'Idea/ViewIdeabyClient/?ClientId='
        }

        window.location = baseurl + SelectedclientId;

    });

    </script>


