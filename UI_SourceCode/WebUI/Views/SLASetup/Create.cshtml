@model NTTData.AMOPortal.WebUI.Dto.MetricSpecificationInput
@using NTTData.AMOPortal.Domain.Entities;
@using NTTData.AMOPortal.WebUI.Dto;
@{
    ViewBag.Title = "SLA Manager";
   // Layout = "~/Views/Shared/_AdminLayout.cshtml";
    Layout = "~/Views/Shared/GenericLayoutWithoutFooter.cshtml";
    //Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/slam.png");
    HomeInput menuItemsInput = (HomeInput)Session["MenuItemsInput"];
    var Userrole = menuItemsInput.UserRole;
}


@using (Html.BeginForm())
