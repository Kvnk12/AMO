<script>
    ////$(function () {
    ////    cbpHorizontalMenu.init();
    ////});

    ////$('.selectpicker').selectpicker();
    ////// $('.selectpicker').selectpicker('val', ['Ketchup', 'Relish']);

    ////$('#sandbox-container .input-append.date').datepicker({
    ////    keyboardNavigation: false,
    ////    autoclose: true,
