                                        <li>@Html.ActionLink(item.Name, "SetUpView", new { setupId = 0, mid = item.ID, clientid = Model.ClientId == null ? 0 : Model.ClientId, name = item.Name, priority = 1 })<input type="checkbox" checked="@item.Availability" disabled="disabled"></li>
