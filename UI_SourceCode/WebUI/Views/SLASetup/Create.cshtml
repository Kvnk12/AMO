            </div>
            <!-- treemenu ends-->

            <div class="treeMenuContent">
                <div class="container" style="padding: 0;">



                    <div class="leftarea form-horizontal">

                        <div class="metricsetupattrtab">
                            <div class="form-group">
                                <label for="metricStatus" class="col-sm-5 control-label" id="">Account</label>
                                <div class="col-sm-5">
                                    @Html.DropDownListFor(m => m.AccountId, new SelectList(Model.ClientAccounts, "value", "text", Model.AccountId), "", new { @class = "selectpicker", id = "drpAccount" })
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="metricStatus" class="col-sm-5 control-label" id="">Account contract</label>
                                <div class="col-sm-5">
                                    @Html.DropDownListFor(m => m.ContractId, new SelectList(Model.ClientAccountsContracts, "value", "text", Model.ContractId), "", new { @class = "selectpicker", id = "drpAccountContract" })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-5 control-label" for="slacu" id="slasetupPriority">Priority</label>
                                @*<label class="col-sm-5 control-label" for="" id="">Metric SLA Name</label>*@
                                <!--input and dropdown combo-->
                                <div class="col-sm-5">
                                    <div class="input-group">
                                        <div class="input-group-btn">
                                            @Html.HiddenFor(m => m.ClientId, new { @id = "hidclientid" })
                                            @Html.HiddenFor(m => m.Id, new { id = "itemid" })
                                            @Html.DropDownListFor(m => m.Priority, new List<SelectListItem>
                                     {
                                         new SelectListItem{ Text="1", Value = "1" },
                                         new SelectListItem{ Text="2", Value = "2" },
                                         new SelectListItem{ Text="3", Value = "3" },
                                         new SelectListItem{ Text="4", Value = "4" },
                                         new SelectListItem{ Text="5", Value = "5" },
                                         new SelectListItem{ Text="6", Value = "6" },
                                         new SelectListItem{ Text="7", Value = "7" },
                                         new SelectListItem{ Text="8", Value = "8" }
                                     }, new { @class = "selectpicker", id = "priority" }/*, new { setupId= , mid = Model.MetricId, clientid = Model.ClientId == null ? 0 : Model.ClientId, name = Model.MetricName  }*/)
                                        </div>


                                    </div>
                                    <!--ends here-->
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-5 control-label" for="" id="">Metric Name</label>
                                <div class="col-sm-5">
                                    @Html.TextBoxFor(m => m.MetricName, new { @class = "form-control", id = "metricName", tabindex = "" })
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-5 control-label" for="metricID" id="">Metric ID</label>
                                <div class="col-sm-5">
                                    @Html.TextBoxFor(m => m.MetricId, new { @class = "form-control", tabindex = "4", id = "MId", style = "text-align:right" })
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="metricStatus" class="col-sm-5 control-label" id=""><span class="mandate">*</span>Metric Status</label>
                                <div class="col-sm-5">
                                    @Html.DropDownListFor(m => m.MetricStatusId, new SelectList(Model.MetricStatusList, "value", "text", Model.MetricStatusId), "", new { @class = "selectpicker", id = "statusMetric", tabindex = "6" })
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-5 control-label" for="hasSLA" id=""><span class="mandate">*</span>Has SLA</label>
                                <div class="col-sm-1">
                                    @Html.CheckBoxFor(m => m.HasSLA, new { tabindex = "", id = "chkSLA" })
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="IndustrySub-Vertical" class="col-sm-5 control-label">Metric Start Date</label>
                                <div id="sandbox-container">
                                    <div class="input-append date col-sm-4">
                                        @Html.TextBoxFor(m => m.StartDate, String.Format("{0:d}", Model.StartDate), new { @class = "form-control", id = "StartDate", tabindex = "22", style = "text-align:center" })<span class="add-on"><i class="icon-th"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="IndustrySub-Vertical" class="col-sm-5 control-label">Metric End Date</label>
                                <div id="sandbox-container">
                                    <div class="input-append date col-sm-4">
                                        @Html.TextBoxFor(m => m.EndDate, String.Format("{0:d}", Model.EndDate), new { @class = "form-control", id = "EndDate", tabindex = "", style = "text-align:center" })<span class="add-on"><i class="icon-th"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-5 control-label" for="metricBase" id="">Metric Baseline</label>
                                <div class="col-sm-5">
                                    @Html.TextBoxFor(m => m.MetricBaseline, new { @class = "form-control", onkeypress = "return isNumberKey(event)", tabindex = "", style = "text-align:right;" })
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-5 control-label" for="metricTarget" id=""><span class="mandate">*</span>Metric Target</label>
                                <div class="col-sm-5">
                                    @Html.TextBoxFor(m => m.MetricTarget, new { @class = "form-control", onkeypress = "return isNumberKey(event)", id = "targetMetric", tabindex = "", style = "text-align:right;" })
                                    <!--<span>This field is Mandatory is "Has SLA" is selected</span>-->
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-5 control-label" for="metricUnit" id="">Metric Unit</label>
                                <div class="col-sm-5">
                                    @Html.TextBoxFor(m => m.MetricUnit, new { @class = "form-control", tabindex = "2", @readonly = "readonly" })
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-5 control-label" for="metownder" id="">Metric Owner</label>
                                <div class="col-sm-5">
                                    @Html.TextBoxFor(m => m.MetricOwner, new { @class = "form-control", tabindex = "4", id = "MetricOwner" })
                                </div>
                            </div>

                        </div><!--/.metricsetupattr-->
                    </div><!--/.leftarea-->

                    <div class="rightarea form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-4 control-label" for="metownder" id="">SLA Compliance Calculation</label>
                            <div class="col-sm-8">
                                @Html.TextAreaFor(m => m.CalculationData, new { @class = "form-control", rows = "10", placeholder = "Description", tabindex = "15" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label" for="slacu" id="">Clock Type</label>
                            <div class="col-sm-4">
                                @Html.DropDownListFor(m => m.Clocksetup, new SelectList(Model.SLAClockTypeList, "value", "text", Model.Clocksetup), "", new { @class = "selectpicker", id = "slaClockType", tabindex = "6" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label" for="slacu" id="">SLA Compliance Units</label>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(m => m.ComplianceUnits, new { @class = "form-control", tabindex = "" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label" for="slacb" id="">SLA Compliance Baseline</label>
                            <div class="col-sm-1">
                                &gt=
                            </div>
                            <div class="col-sm-2">
                                @Html.TextBoxFor(m => m.ComplianceBaseline, new { @class = "form-control", tabindex = "" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label" for="slact" id="">SLA Compliance Target</label>
                            <div class="col-sm-1">
                                &gt=
                            </div>
                            <div class="col-sm-2">
                                @Html.TextBoxFor(m => m.ComplianceTarget, new { @class = "form-control", tabindex = "" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label" for="exsla" id="">Exceeds SLA Expectations</label>
                            <div class="col-sm-1">
                                &gt
                            </div>
                            <div class="col-sm-2">
                                @Html.TextBoxFor(m => m.ExceedsExpectation, new { @class = "form-control", tabindex = "" })
                            </div>
                            <div class="col-sm-2">
                                <span class="greenblk">&nbsp;</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label" for="exmet" id="">Met SLA Expectations</label>
                            <div class="col-sm-1">
                                btw
                            </div>
                            <div class="col-sm-2">
                                @Html.TextBoxFor(m => m.MetExpectationlowerlimit, new { @class = "form-control", tabindex = "" })
                            </div>
                            <div class="col-sm-1">
                                and
                            </div>
                            <div class="col-sm-2">
                                @Html.TextBoxFor(m => m.MetExpectationhigherlimit, new { @class = "form-control", tabindex = "" })
                            </div>
                            <div class="col-sm-2">
                                <span class="blublk">&nbsp;</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-4 control-label" for="belowsla" id="">Below SLA Expectations</label>
                            <div class="col-sm-1">
                                &lt
                            </div>
                            <div class="col-sm-2">
                                @Html.TextBoxFor(m => m.BelowExpectation, new { @class = "form-control", tabindex = "" })
                            </div>
                            <div class="col-sm-2">
                                <span class="rdblk">&nbsp;</span>
                            </div>
                        </div>

                    </div>
                    <!--rightarea -->


                    <div class="metricaction">
                        <button class="btn btn-primary" tabindex="" value="Save" id="btnSave" type="submit" @((Userrole == "User" || Userrole == "CustomerUser") ? "disabled" : "")>Save</button>
                        <button id="btnaddnew" class="btn btn-default" onclick="location.href='@Url.Action("Cancel", "SLASetup", new { clientid = Model.ClientId })';return false;">Cancel</button>
                        <button class="btn btn-default" onclick="location.href='@Url.Action("DelSLASetup", "SLASetup", new { id = Model.Id, clientid = Model.ClientId })';return false;" @((Userrole == "User" || Userrole == "CustomerUser") ? "disabled" : "")>Delete</button>
                    </div>

                </div>
                <!--/.treeMenuContent container-->
            </div>

        </div>
        <!--/.treeMenuArea-->
    </div>

