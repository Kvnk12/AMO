    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (charCode != 46 && charCode > 31
          && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }

    $('#UpperLimit').focusout(function () {
        //to allow decimals,use/[^0-9\.]/g
        var upper = parseFloat(document.getElementById("UpperLimit").value);
        var target = parseFloat(document.getElementById("targetMetric").value);
        if (upper < target) {
            var upperlimit = document.getElementById("UpperLimit");
            alert("The Upper Limit must be above the Target value");
            upperlimit.focus();
            return true;
        }
        return false;
    });

    $('#LowerLimit').focusout(function () {
        //to allow decimals,use/[^0-9\.]/g
        var lower = parseFloat(document.getElementById("LowerLimit").value);
        var target = parseFloat(document.getElementById("targetMetric").value);
        if (lower > target) {
            var lowerlimit = document.getElementById("LowerLimit");
            alert("The Lower Limit must be below the Target value");
            lowerlimit.focus();
            return true;
        }
        return false;
    });

    $('#EndDate').focusout(function () {
        //to allow decimals,use/[^0-9\.]/g

        var startDate = new Date($('#StartDate').val());
        var endDate = new Date($('#EndDate').val());
        var todaysDate = new Date();
        var enddateId = document.getElementById("EndDate");
        if (startDate > endDate) {
            alert("The end date must fall after the start date");
            enddateId.focus();
            return true;

        }
        if (endDate == todaysDate) {
            alert("The metric end date has passed. Either extend the end date or change the Metric Status to Inactive");
            enddateId.focus();
            return true;

        }
        return false;
    });

    $(document).ready(function () {

        document.getElementById("metricName").readOnly = "readonly";
        document.getElementById("MId").readOnly = "readonly";
    });




    $("#btnSave").click(function () {
        var metricid = document.getElementById("MId").value;

        var metricstatus = document.getElementById("statusMetric").value;
        var startdate = new Date($('#StartDate').val());

        // Metric id field should always greter than zero.
        if (metricid == null || metricid == "" || metricid == 0) {
            alert("Metric Id is mandatory");
            return false;
        }


        // start date should not be empty
        if (startdate == null || startdate == "") {
            alert("Please select Start Date");
            return false;
        }

    });

    $("#btnAdd").on("click", function () {

        var href = window.location.href.split('/');
        var baseurl = '@Url.Content("~/SLASetup/SaveSLAcal")';;


        //var SelectedclientId = $('#ddlClientId :selected').val();
        var SelectedclientId = $('#hidclientid').val();

        var fldNm= $('#slafieldname :selected').val();
        var prty= $('#slaPriority :selected').val();
        var calTp= $('#slaCalcType :selected').val();

        if (calTp=='' || fldNm=='' || prty=='')
            return false;

        var dataToPost = {
            clientid: SelectedclientId,
            fieldname: fldNm,
            priority: prty,
            calType: calTp
        };
       // alert(baseurl)
        $.ajax(
        {
            url: baseurl,
            type: 'POST',
            data: JSON.stringify(dataToPost),
            contentType: 'application/json; charset=utf-8',
            success: function (data) {
                $("#partialDiv").html(data);
            },
            error: function () {

            }
        });
    });

    function FillMetricDetails(id, name) {
        document.getElementById("MId").value = id;
        document.getElementById("metricName").value = name;
    }

    $('#drpAccount').change(function () {
       // alert('account');
        var Id = $(this).find(":selected").val();
        //var href = window.location.href.split('/');
        var baseurl = '@Url.Content("~/SLASetup/ClientAccountsContract")';
       // alert(Id);
        //if ($("#drpAccount :selected").val() != "") {
            $.ajax({
                url: baseurl,
                type: 'GET',
                data: { accountid: Id },
                success: getContracts,
                failure: errorInDropdownPopulation
            })
       // }
    });

    $('#drpAccountContract').change(function () {
        callSetupView();
    });

    function errorInDropdownPopulation(err)
    {
        alert(err.stringify())
    }
    function getContracts(data, status) {

        $("select#drpAccountContract").empty();
        $("select#drpAccountContract").selectpicker('refresh');
        $("select#drpAccountContract").append("<option value='0'></option>");
        $.each(data, function (key, value) {
            $("select#drpAccountContract").append("<option value='" + value.Value + "'>" + value.Text + "</option>");
        });
        $("select#drpAccountContract").selectpicker('refresh');
        $("#drpAccountContract").css("display", "block");
        $("#drpAccountContract +.btn-group.bootstrap-select").css("display", "none");
       
    }

    function callSetupView()
    {
        var selectedpriority = $('#priority :selected').val();
        var selectedaccount = $('#drpAccount :selected').val();
        var selectedcontract = $('#drpAccountContract :selected').val();
        var selectedclientId = $('#hidclientid').val();
        var mid = $('#MId').val();
        if (mid == '') {
            alert('Please select metric name from the left menu.');
            return false;
        }
        var mname = $('#metricName').val();
        var path = '@Url.Content("~/SLASetup/SetUpView")';
        path = path + '?setupId=0&mid=' + mid + '&clientid=' + selectedclientId + '&name=' + mname + '&priority=' + selectedpriority + '&accountid=' + selectedaccount + '&contractid=' + selectedcontract;
        window.location = path;

    }

    $('#priority').change(function () {

        callSetupView();
    });


</script>
