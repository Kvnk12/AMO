        <!--start of breadcrumb-->
        <ol class="breadcrumb">
            <li>SLA Manager</li>
            <li>Metric Management</li>
            <li class="active">SLA Setup</li>
        </ol>
    </div>

    <ul class="nav nav-tabs">
        <li class="active"><a href="#metricSetupArea" data-toggle="tab">SLA Setup</a></li>
        <li class=""><a href="#metricresponse" data-toggle="tab">Response Time/Resolution Time</a></li>
    </ul>

    <div>

        @if (!ViewData.ModelState.IsValid && !ViewData.ModelState.ContainsKey("Success"))
        {
            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger container" })
        }

        @if (ViewData.ModelState.ContainsKey("Success"))
        {

            @Html.ValidationSummary(false, "", new { @class = "alert alert-success container" })
        }
