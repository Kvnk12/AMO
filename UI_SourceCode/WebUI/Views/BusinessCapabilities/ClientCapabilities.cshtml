    function BCChangeOrderInc(e) {
        var affectedid;
        var BusCap = $("#BusinessCapabilities").data("kendoTreeList");
        var rowIndex = BusCap.dataItem(BusCap.select());
        var selectedId = rowIndex.BCId;
        var data = BusCap.dataSource.data();
        for (var i = 0; i < data.length; i++) {
            var currentDataItem = data[i];
            if (currentDataItem.get("BCId") == selectedId) {
                affectedid = currentDataItem.get("BCId");
            }
