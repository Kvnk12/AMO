<script type="text/javascript">

    //$(document).ready(function () {
    //    console.log('In document ready');
    //    EnableDisableBCCheckBoxes();
    //});

    function onBCDataBound() {
        EnableDisableBCCheckBoxes();
    }

    function EnableDisableBCCheckBoxes() {

        var BusCap = $("#BusinessCapabilities").data("kendoTreeList");
        //BusCap.dataSource.read();
        var dataItems = BusCap.dataSource.view();
       // console.log('In document ready function');
        $.each(dataItems, function (i, item) {
            if (item.BCParentId) {
                var ParentCheckBoxctrl = '#CheckBoxId' + item.BCParentId;
                $(ParentCheckBoxctrl).prop("disabled", true);
            }
            else {
                var CheckBoxctrl = '#CheckBoxId' + item.BCId;
                $(CheckBoxctrl).prop("disabled", false);
            }
           // console.log('In loop');
        });

    }

    function apperrorhandler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }

    function getBCIds(e) {
        var dataItem = $("#Applicationlist").data("kendoGrid").dataItem(e.target.closest("tr"));
        var content = dataItem.BCNames;
        return content;
    }

    function ParameterData(e) {
        var mm = '@Model.SubVerticalId';
        $("#SubVerticalId").val(mm);
        return {

            SubVerticalId: mm,

            };
    }


    function toggleAll(e) {
        e.stopPropagation();

        if ($("#radioApp").hasClass("active")) {
            var treeList = $("#BusinessCapabilities").data("kendoTreeList");
            var dataItems = treeList.dataSource.view();//.data();
            $.each(dataItems, function (i, item) {
                var CheckBoxctrl = '#CheckBoxId' + item.BCId;
                if ($('#treeCheck').is(":checked")) {
                    $(CheckBoxctrl).prop("checked", true);
                }
                else {
                    $(CheckBoxctrl).prop("checked", false);
                }
            });
            //var gridnControl = $("#Applicationlist").data("kendoGrid");
            //gridnControl.dataSource.read();
        }
    }

    function toggleGridChks(e) {

        if ($("#radioBc").hasClass("active")) {

            var gridnControl = $("#Applicationlist").data("kendoGrid");
            var dataItems = gridnControl.dataSource.view();//.data();
            $.each(dataItems, function (i, item) {
                var CheckBoxctrl = '#CheckBoxgridId' + item.Appid;
                if ($('#gridCheck').is(":checked")) {

                    $(CheckBoxctrl).prop("checked", true);
                    item.set('SelectApp', true);
                }
                else {

                    $(CheckBoxctrl).prop("checked", false);
                    item.set('SelectApp', false);

                }
                //}
            });
        }

    }

    function SelectedBCIds(e) {
        //get all selected BCIds in comma seperated string
        var treeList = $("#BusinessCapabilities").data("kendoTreeList");
        var dataItems = treeList.dataSource.data();
        var mm = '';// '59,1';
        var str = '';//'59,1';
        if ($("#radioBc").hasClass("active")) {
            $.each(dataItems, function (i, item) {
                var CheckBoxctrl = 'CheckBoxId' + item.BCId;
                if ($('#' + CheckBoxctrl).is(":checked")) {
                    str += item.BCId + ',';
                }

            });
        }
        if (str.length > 1) {
            mm = str.substring(0, str.length - 1);
        }

        var PortfolioctrlSel = $('#drpPortfolio').val();

        var portfolioid = "";
        var count = 0;

        try {
            var count = PortfolioctrlSel.length;
            for (var i = 0; i < count; i++) {
                if (i > 0) { portfolioid += ","; }
                portfolioid += $('#drpPortfolio option:selected')[i].value;
            }
            var PortfolioSelId = portfolioid;
        }
        catch{

            var ddl = document.getElementById('drpPortfolio');
            for (i = 0; i < ddl.options.length; i++) {
                if (i > 0) { portfolioid += ","; }
                portfolioid += ddl.options[i].value;
            }
            var PortfolioSelId = portfolioid;
        }



        return {
            Bcids: mm,
            PortfolioSelId: PortfolioSelId
        };
    }



    function SelectedBCIdsUpdate(e) {

        //get all selected BCIds in comma seperated string
        var treeList = $("#BusinessCapabilities").data("kendoTreeList");
        var dataItems = treeList.dataSource.data();
        var mm = '';// '59,1';
        var str = '';//'59,1';
        $.each(dataItems, function (i, item) {
            var CheckBoxctrl = 'CheckBoxId' + item.BCId;
            if ($('#' + CheckBoxctrl).is(":checked")) {
                str += item.BCId + ',';
            }

        });
        if (str.length > 1) {
            mm = str.substring(0, str.length - 1);
        }

        var apps = '';
        var BusApp = $("#Applicationlist").data("kendoGrid");
        var appdataItems = BusApp.dataSource.view();
        $.each(appdataItems, function (i, item) {
            var CheckBoxctrl = '#CheckBoxgridId' + item.Appid;
            // console.log(CheckBoxctrl);
            if ($(CheckBoxctrl).is(":checked"))
                apps += item.Appid + ',';
        });

        if (apps.length > 1) {
            apps = apps.substring(0, apps.length - 1);
        }
        var bcToam = $("#radioBc").hasClass("active").toString();
        // alert(bcToam);
        var mod = {
            Bcids: mm,
            Apps: apps,
            bcToam: bcToam
        };
        // return mod;
        var BusCap = $("#BusinessCapabilities").data("kendoTreeList");
        var dataItems = BusCap.dataSource.view();//.data();
        //  if ($("#radioApp").hasClass("active")) {
        $.each(dataItems, function (i, item) {
            var CheckBoxctrl = '#CheckBoxId' + item.BCId;
            $(CheckBoxctrl).prop("checked", false);

        });
        //}
        var data = JSON.stringify(mod);
        var baseurl = '@Url.Content("~/BusinessCapabilities/UpdateBCApplications")';
        $.ajax(
            {
                url: baseurl,
                type: 'post',
                data: data,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    var gridnControl = $("#Applicationlist").data("kendoGrid");
                    gridnControl.dataSource.read();
                    $("#successmsg").fadeIn(1, "linear")
                    if (data.result == true) {

                        document.getElementById("successmsg").innerHTML = "<span style='font-weight:bold;padding:7px 15px' class='alert alert-success'>Mapping detail got saved.</span>";
                    }
                    else {
                        document.getElementById("successmsg").innerHTML = "<span style='font-weight:bold;padding:7px 15px' class='alert alert-success'>Mapping detail got saved.</span>";

                    }
                },
                error: function (data) {
                    alert('Error saving mapping detail.' + data);
                }
            })

        $("#successmsg").fadeOut(20000, "swing")

    }

    function ParameterSubVIdData() {
        return {
            SubVertId:'@Model.SubVerticalId'
        }
    }


    function ImportTemplate() {
        $("#importSuccess").hide();
        $("#importFailure").hide();
        if (confirm('Importing will overwrite existing Business capabilities and delete mappings with Applications as well. Are you sure you want to import standard Business capability model?'))
        {

            var mod = {
                SubVerticalId: '@Model.SubVerticalId'
            };
            var data = JSON.stringify(mod);
            var baseurl = '@Url.Content("~/BusinessCapabilities/ImportDefaultCapabilities")';
            $.ajax(
                {
                    url: baseurl,
                    type: 'post',
                    data: data,
                    async: false,
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {
                        if (data.result === true) {
                            $("#importSuccess").text(data.msg)
                            $("#importSuccess").show();
                            var treelist = $("#BusinessCapabilities").data("kendoTreeList");
                            treelist.dataSource.read();
                            var name = $("#Applicationlist").data("kendoGrid");
                            name.dataSource.read();
                        }
                        else {
                            $("#importFailure").text(data.msg);
                            $("#importFailure").show();
                        }
                    },
                    error: function (data) {
                        $("#importFailure").show();
                    }
                })
        }
        else {
            return false;
        }
