<script>
    $(".table").on('click', 'tr', function () {
        var tdValue = $(this).children('td').map(function (index, val) {
            return $(this).text();
        }).toArray();

        $("#idAppName").val(tdValue[1]);
        document.getElementById('hdnAppId').value = tdValue[0];
        document.getElementById('hdnAppName').value = tdValue[1];

        if (tdValue[2].toString() == "True") {
            $('#pnlchk').prop("checked", true);
        }
        else {
            $('#pnlchk').prop("checked", false);
        }

        $('#det').show();
        $('#addInvt').hide();
        $('#show_deleteusr_msg').hide();
    });

    $(document).ready(function (e) {
        $('#btncancel').click(function (e) {
            $('#det').hide();
            $('#show_deleteusr_msg').hide();
            $("#idAppName").val("");
            if ($('#pnlchk').prop('checked') == true) {
                $('#pnlchk').prop("checked", false);
            }
        });
    });

    $('#btnSaveAppInvt').click(function () {
        var Id = document.getElementById('hdnAppId').value;
        // var clientId = $('#ClientId :selected').val();
        var clientId = '0';
        var appName = $("#idAppName").val().toString();

        if ($('#pnlchk').prop('checked') == true) {
            active = true;
        }
        else {
            active = false;
        }

        if (Id == "0") {
            alert('Please select Application to Modify');
            return false;
        }

        var href = window.location.href.split('/');
        var baseurl = '';

        if (href[3] == 'LOBandApplications') {
            var baseurl = href[0] + '//' + href[2] + '/' + 'LOBandApplications/SaveInvApplication/?Id='
        }
        else {
            var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'LOBandApplications/SaveInvApplication/?Id='
        }

        var url = baseurl + Id + "&active=" + active + "&ClientId=" + clientId + "&AppName=" + appName;
        window.location = url;
    });

    $('#btnDelAppInvt').click(function () {
        var Id = document.getElementById('hdnAppId').value;
        //var clientId = $('#ClientId :selected').val();
        var cliientId = '0';
        var appName = $("#idAppName").val().toString();
        var confirm = window.confirm('Do you want to delete the Application?');

        if (Id == "0") {
            alert('Please Select Application to Delete');
            return false;
        }

        if (confirm) {
            var href = window.location.href.split('/');
            var baseurl = '';
            if (href[3] == 'LOBandApplications') {
                var baseurl = href[0] + '//' + href[2] + '/' + 'LOBandApplications/DeleteInvApplication/?Id='
            }
            else {
                var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'LOBandApplications/DeleteInvApplication/?Id='
            }
            //var url = baseurl + Id + "&ClientId=" + clientId;
            var url = baseurl + Id + "&ClientId=" + clientId + "&AppName=" + appName;
            window.location = url;
            return false;
        }
        else { return false; }
    });


    $('#btnAddAppInvt').click(function () {
        //var clientId = $('#ClientId :selected').val();
        var clientId = '0';
        var appName = $("#idAddAppName").val().toString();

        if ($('#addchk').prop('checked') == true) {
            active = true;
        }
        else {
            active = false;
        }

        ////if (clientId == "") {
        ////    alert('Please select the client name');
        ////    return false;
        ////}

        if (appName == "") {
            alert('Please enter Application Name');
            return false;
        }

        var href = window.location.href.split('/');
        var baseurl = '';
        if (href[3] == 'LOBandApplications') {
            var baseurl = href[0] + '//' + href[2] + '/' + 'LOBandApplications/AddInvApplication/?ClientId='
        }
        else {
            var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'LOBandApplications/AddInvApplication/?ClientId='
        }
        var url = baseurl + clientId + "&AppName=" + appName + "&active=" + active;
        window.location = url;
    });

    $(document).ready(function (e) {
        $('#btnAddAppInv').click(function (e) {
            $('#addInvt').show();
            $('#det').hide();
            $('#show_deleteusr_msg').hide();
            $("#idAddAppName").val("");
            $('#addchk').prop("checked", false);
        });
    });

    $(document).ready(function (e) {
        $('#btnAddInvtcancel').click(function (e) {
            $("#idAddAppName").val("");
            $('#show_deleteusr_msg').hide();
            $('#addchk').prop("checked", false);
        });
    });

    function ImportTemplate() {
        $("#importSuccess").hide();
        $("#importFailure").hide();
        if (confirm('Import will override existing Business capabilities and delete mappings with Applications as well. Are you sure you want to import it?'))
        {

            var mod = {
                SubVerticalId: '@Model.SubVerticalId'
            };
            var data = JSON.stringify(mod);
            var baseurl = '@Url.Content("~/BusinessCapabilities/ImportDefaultCapabilities")';
            $.ajax(
                {
                    url: baseurl,
                    type: 'post',
                    data: data,
                    async: false,
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {
                        if (data.result === true) {
                            $("#importSuccess").text(data.msg)
                            $("#importSuccess").show();
                            var treelist = $("#ClientBusinessCapabilities").data("kendoTreeList");
                            treelist.dataSource.read();
                        }
                        else {
                            $("#importFailure").text(data.msg);
                            $("#importFailure").show();
                        }
                    },
                    error: function (data) {
                        $("#importFailure").show();
                    }
                })
        }
        else {
            return false;
        }
    }


</script>
