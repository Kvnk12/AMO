<script>
    $('select#ddlClient').change(function () {
        var SelectedclientId = $('#ddlClient :selected').val();
        var href = window.location.href.split('/');
        //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
        var baseurl = '';
        if (href[3] == 'ServiceRequest') {
            //alert('local url');

            var baseurl = href[0] + '//' + href[2] + '/' + 'ServiceRequest/ViewSRbyClient/?ClientId='
        }
        else {
            //alert('server');
            var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'ServiceRequest/ViewSRbyClient/?ClientId='
        }

        window.location = baseurl + SelectedclientId;

    });

</script>