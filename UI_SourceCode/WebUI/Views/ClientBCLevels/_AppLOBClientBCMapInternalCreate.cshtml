@Html.DropDownListFor(m => m.junctionAppLOBClientBCInput.AppId, new SelectList(Model.AppLobList, "value", "text", Model.junctionAppLOBClientBCInput.AppId), "", new { @class = "selectpicker", id = "AppLobId", tabindex = "5", name = "AppLobId"})  

