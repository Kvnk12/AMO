  <input hidden id="level2Id" value="@Model.CLevel2Id.ToString()"  />
                            <input hidden id="level3Id" value="@Model.CLevel3Id.ToString()"  />
                            <input hidden id="level2Name" value="@Model.CLevel2Name.ToString()"   />
                            <input hidden id="level3Name" value="@Model.CLevel3Name.ToString()"   />
            
            <input hidden id="Cancel" value="CancelClick" />
                    <div class="form-group">
                      <label class="col-sm-2 control-label" for="grpID">Application Mapping</label>
                      <div class="col-sm-3">
                       
