    @*<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">*@
    @*<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
        <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>*@

HomeInput MenuItemsInput = (HomeInput)Session["MenuItemsInput"];
Db db = new Db();
int UserId = (int)Session["UserId"];
ViewBag.Title = "Optimization Tools";
ViewBag.ImagePathOne = Url.Content("~/Content/images/nttdata_logo.png");
// ViewBag.ImagePathTwo = Url.Content("~/Content/images/Ntt-logo.png");
Layout = "~/Views/Shared/HomeGenericLayOut .cshtml";

//Client client = (Client)Session["Client"];
ClientDetail client = (ClientDetail)Session["SessionClient"];
var clientId = 0;
if (client != null)
{
    clientId = client.ClientId;
}
//ViewBag.PPMaitaintUrlClientId = System.Configuration.ConfigurationManager.AppSettings["PPMaitaintUrlClientId"].ToString();
//ViewBag.PPMaitaintUrlReportId = System.Configuration.ConfigurationManager.AppSettings["PPMaitaintUrlReportId"].ToString();



var a3MMBoolValue = false;

var AssessmentManagerRoleid = 0;

AssessmentManagerRoleid = (from a in MenuItemsInput.UserApplications
                           where a.ApplicationId == 20 && a.ClientId == clientId && a.isDeleted == false && a.UserId == UserId
                           select a.RoleId).FirstOrDefault();

if (AssessmentManagerRoleid == 1 || AssessmentManagerRoleid == 2) //Admin oe User
{
    a3MMBoolValue = true;
}

}
<style>
    .styledTds {
        background-color: #F2BF96;
        border: 1px solid #D26D19;
        text-align: center;
        line-height: 1.65em;
    }

    .lookNiceTable {
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 4px;
        background-color: #F0F0F0;
    }

    td {
        padding-left: 2px;
        padding-right: 2px;
    }

    .tdcenter {
        text-align: right;
    }

    .home-tools .row .col a {
        color: #428bca;
        text-decoration: none;
    }

    .carousel-indicators [data-bs-target] {
        box-sizing: content-box;
        flex: 0 1 auto;
        width: 10px;
        height: 10px;
        border: 1px solid rgb(91,121,171);
        border-radius: 8px;
        cursor: pointer;
        background-color: #fff;
        transition: opacity .6s ease;
    }

    .carousel-indicators .active {
        background-color: rgb(91,121,171);
    }
</style>
