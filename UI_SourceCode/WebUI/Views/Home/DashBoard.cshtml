<style>
    .styledTds {
        background-color: #F2BF96;
        border: 1px solid #D26D19;
        text-align: center;
        line-height: 1.65em;
    }

    .lookNiceTable {
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 4px;
        background-color: #F0F0F0;
    }

    td {
        padding-left: 2px;
        padding-right: 2px;
    }

    .tdcenter {
        text-align: right;
    }

    .home-tools .row .col a {
        color: #428bca;
        text-decoration: none;
    }
</style>
<div class="home-container">
    <div class="home-tools">
        <div class="row">
            <div class="col">
               
            </div>
            <div class="col">
                @foreach (var cl in Model)
                {

                    <div class="home-tool-item">
                        <span class="tool-item-img idea-manager-icon"></span>
                        <p>@cl.Type</p>
                    </div>
                    <div class="home-tool-item">
                        <span class="tool-item-img idea-manager-icon"></span>
                        <p>@cl.Value</p>
                    </div>
                }

            </div>

        </div>

    </div>

</div><!--/.container-->