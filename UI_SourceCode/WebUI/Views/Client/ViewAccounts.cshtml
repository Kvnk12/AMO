        $('#drpSelRegion').change(function () {
            var Id = parseInt($(this).find(":selected").val());
            var href = window.location.href.split('/');
            var baseurl = '';
            if (href[3] == 'Client') {
                var baseurl = href[0] + '//' + href[2] + '/' + 'Client/GetCountry'
            }
            else {
                var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'Client/GetCountry'
            }

            if (Id != "") {
                $.ajax({
                    url: baseurl,
                    type: 'GET',
                    data: { region: Id },
                    success: getCountry,
                    failure: errorInDropdownPopulation
                })
            }
        });

        function getCountry(data, status) {
            $("select#drpSelCountry").empty();
            $("select#drpSelCountry").selectpicker('refresh');
            $("select#drpSelCountry").append("<option value='0'></option>");
            $.each(data, function (key, value) {
                $("select#drpSelCountry").append("<option value='" + value.Id + "'>" + value.Name + "</option>");
            });
            $("select#drpSelCountry").selectpicker('refresh');
        }

        function errorInDropdownPopulation() {
            alert('An error occurred. Please contact administrator');
        }



