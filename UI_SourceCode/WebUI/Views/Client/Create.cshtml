            var nearshoreVal = $("#AvgAnnualFTEsNearShore").val();
            if (OnshoreVal != 0 && OffshoreVal != 0 && nearshoreVal != 0) {
                var AverageVal = parseFloat(OnshoreVal) + parseFloat(OffshoreVal) + parseFloat(nearshoreVal);;
                $("#AvgAnnualFTEs").val(AverageVal).toString();
            }
        }
    });

