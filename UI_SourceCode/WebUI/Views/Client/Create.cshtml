     function isAlphNumKey(evt) {
         var charCode = (evt.which) ? evt.which : event.keyCode;
         if ((charCode > 32 && charCode < 48) ||
            (charCode > 57 && charCode < 65) ||
            (charCode > 90 && charCode < 95) ||
            (charCode > 95 && charCode < 97) ||
            (charCode > 123 && charCode < 127)) {
            return false;

         }
         return true;
    }

    function isNumbersKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (charCode != 46 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;
        return true;
    }

    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (charCode > 31 && (charCode < 48 || charCode > 57))
            return false;
        return true;
    }

    $(document).ready(function () {
        $('#txtcontractTD').number(true, 0);
        $('#txtAvgAnnlRev').number(true, 0);
        $('#txtcontractFY').number(true, 0);
        $('#txtStartDate').change(EngagementDiff);
        $("#txtDuration").prop('readonly', true);
        $('#txtEndDate').change(EngagementDiff);
        $('#showdate_error').hide();
    });

    function EngagementDiff() {
        if ($("#txtStartDate").val() == "") {
            $("#txtDuration").val("0.0");
            return false;
        }
        if ($("#txtEndDate").val() == "") {
            $("#txtDuration").val("0.0");
            return false;
        }

        if ($("#txtStartDate").val() != "" && $("#txtEndDate").val() != "") {
            var start_date = Date.parse($("#txtStartDate").val());
            var end_date = Date.parse($("#txtEndDate").val());
            var eDate = new Date(end_date);
            var sDate = new Date(start_date);

            if (sDate > eDate) {
                $('#showdate_error').show();
                $("#txtDuration").val("0.0");
                return false;
            }

            $('#showdate_error').hide();

            var date1 = new Date($("#txtStartDate").val());
            var date2 = new Date($("#txtEndDate").val());
            var t1 = date1.getTime();
            var t2 = date2.getTime();
            var dayDiff = parseInt((t2 - t1) / (24 * 3600 * 1000));

            if (dayDiff == 364) {
                var dayDiffRoundOff = parseInt(dayDiff) / 364;
                //dayDiffRoundOff = dayDiffRoundOff.toString().substring(0, 4);
                dayDiffRoundOff = dayDiffRoundOff.toFixed(2).toString();
            }
            else {
                var dayDiffRoundOff = parseInt(dayDiff) / 365;
                dayDiffRoundOff = dayDiffRoundOff.toFixed(2).toString();
            }

            $("#txtDuration").val("");
            $("#txtDuration").val(dayDiffRoundOff);
        }
        else {
            $("#txtDuration").val("0.0");
        }
    }

    $('#chkAverageAnnualFTE').change(function () {
        if ($("#chkAverageAnnualFTE").is(':checked')) {
            var OnshoreVal = $("#AvgAnnualFTEsOnShore").val();
