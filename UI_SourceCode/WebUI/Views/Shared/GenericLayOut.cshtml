@using WebUI.Dto;
@using NTTData.AMOPortal.Data;
@using System.Web.Configuration;
@{
    var client = "";
    var clientid = 0;
    Db db = new Db();
    if (Session["SessionClient"] != null)
    {
        ClientDetail objclient = (ClientDetail)Session["SessionClient"];
        client = objclient.ClientName;
        clientid = objclient.ClientId;
        //clientId = objclient.Id.ToString();
    }
    var jobDate = (from a in db.JobDetails
                   where a.ClientId == clientid && a.RunStatus == "Completed"
                   orderby a.JobEndTime descending
                   select a.JobEndTime
                   ).FirstOrDefault();
    var addedRecord = (from a in db.JobDetails
                       where a.ClientId == clientid && a.RunStatus == "Completed"
                       orderby a.JobEndTime descending
                       select a.TotalRecordRecieved
       ).FirstOrDefault();
    var area = ViewContext.RouteData.DataTokens["area"] != null ? ViewContext.RouteData.DataTokens["area"].ToString() : "";
    var ECOpassword = WebConfigurationManager.AppSettings["ECOpassword"];
    var ECOapiEndpoint = WebConfigurationManager.AppSettings["ECOapiEndpoint"];
    var ECOINemailId = WebConfigurationManager.AppSettings["ECOINemailId"];
    var ECOIMemailId = WebConfigurationManager.AppSettings["ECOIMemailId"];
    
}
