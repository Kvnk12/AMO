@{

    HomeInput MenuItemsInput = (HomeInput)Session["MenuItemsInput"];
    int UserId = (int)Session["UserId"];
    //  Client client = (Client)Session["Client"];
    Db db = new Db();
    ClientDetail client = (ClientDetail)Session["SessionClient"];
    var clientId = 0;
    if (client != null)
    {
        clientId = client.ClientId;
    }




    var roleid = (from a in db.UserRoles
                  where a.RoleName ==MenuItemsInput.UserRole
                  select a.Id).FirstOrDefault();

    var AssessmentManagerRoleid = 0;

    AssessmentManagerRoleid = (from a in MenuItemsInput.UserApplications
                               where a.ApplicationId == 20 && a.ClientId == clientId && a.isDeleted == false && a.UserId == UserId
                               select a.RoleId).FirstOrDefault();

    //if (AssessmentManagerRoleid == 6) //engagement user - 'Customer User' role
    //{
    //    AssessmentManagerRoleid = 0;
    //}

    if (AssessmentManagerRoleid == 1) //engagement user - 'User' role
    {
        AssessmentManagerRoleid = 0;
    }

}
<style>
    .disabled {
        pointer-events: none;
        cursor: default;
    }

    .Box-bundle-tag {
        border: 1px solid;
        color: #ee8151;
        padding: 0 3px;
        font-size: xx-small;
        align-self: center;
    }

    .Box-bundle-tagred {
        border: 1px solid;
        color: red;
        padding: 0 2px;
        font-size: xx-small;
        align-self: center;
    }

    .sidebarHeader {
        display: flex;
        justify-content: space-between;
    }

        .sidebarHeader h3 {
            width: 100%;
        }

        .sidebarHeader .close {
            border: none;
            background-color: #5876AA;
            width: 3em;
            height: 3.45em;
        }

        .sidebarHeader span {
            color: white;
            font-size: 30px;
            position: absolute;
            top: -0.1em;
            right: 0.3em;
        }

    .sidebar-submenu > ul {
        list-style-type: none;
    }

    .sidebar-wrapper .sidebar-menu > ul > li > a.show + .sidebar-main-submenu.show > ul {
        list-style-type: none;
    }
</style>


