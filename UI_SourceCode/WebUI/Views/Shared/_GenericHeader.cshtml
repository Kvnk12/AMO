<script type="text/javascript">
        $('.header-menu-icon').click(function () {
            $(this).toggleClass('open');
            $('.sidebar-wrapper').toggleClass('show');
            $('#sidenav-overlay').toggleClass('open');
        });


       function applyClient () {
           var indexurl = '@Url.Content("~/Account/")';
        var baseurl = '';
        baseurl = '@Url.Content("~/Account/SetUserWorkingClient")';
       // alert(baseurl);
        var dataToPost = {
            ClientId: $('#userWorkingClientId :selected').val(),
        };
        $.ajax(
        {
            url: baseurl,
            type: 'POST',
            data: JSON.stringify(dataToPost),
            contentType: 'application/json; charset=utf-8',
            success: function (data) {
                $('#myModal').hide();
                if (data) {
                    window.location.href = indexurl + data;
                } else {
                    $('#myModal').hide();
                    window.location.reload(true);
                }
            },
            error: function () {
              //  $('#myModal').hide();
            }
        });

    };

</script>
<!-- /.modal -->