                    <nav id="cbp-hrmenu" class="cbp-hrmenu">
                        <a href="#" title="" class="appNav appNavOpen"><span class="glyphicon glyphicon-th-list">&nbsp;</span> Navigate Optimization Applications&nbsp;<span class="glyphicon glyphicon-chevron-right"></span></a>
                        <a href="#" title="" class="appNav appNavClose"><span class="glyphicon glyphicon-th-list">&nbsp;</span> Close Sidebar Navigation&nbsp;<span class="glyphicon glyphicon-chevron-left"></span></a>
                        @RenderSection("PPMenu", false)
                        @RenderSection("IMTOPMenu", false)
                    </nav>
                    @*<h5 style="display:inline;font-weight:bold;">@client</h5>*@
                    <!-- end of nav-->
                </div>
                <!--.container-->
                @RenderSection("featured", required: false)
                <section class="content-wrapper main-content clear-fix">
                    @RenderBody()
                </section>

            </div><!--/.end of pushContainer1Content-->
        </div><!--end pushContainer1-->

    </div> <!--end wrap-->

