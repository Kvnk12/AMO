    </div>
    <div class="custom-kendo-grid ">
        @* ---------------------------------------------------------------------------------------------------------------------------------------*@
        @(Html.Kendo().Grid<MetricSpecificationModel>()
                         .Name("SLAGrid")
                         .Columns(columns =>
                         {
                             columns.Bound(p => p.Id).Hidden();
                             columns.Select().Width(50).Locked(true).Lockable(true);
                             columns.Bound(p => p.AccountId).Hidden();
                             columns.Bound(p => p.AccountName).Title("Account").Width(150).Locked(true).Lockable(true);
                             columns.Bound(p => p.ContractId).Hidden();
                             columns.Bound(p => p.ContractName).Title("Account Contract").Width(150).Locked(true).Lockable(true);
                             columns.Bound(p => p.Priority).Title("Priority").Width(150).Locked(true).Lockable(true);
                             columns.Bound(p => p.MetricName).Title("Metric Name").Width(150);
                             //columns.Bound(p => p.MetricId).Title("Metric Id").Width(150);
                             columns.Bound(p => p.Weightage).Title("Weightage").Width(150);
                             columns.Bound(p => p.MetricStatus).Title("Metric Status").Width(150);
                             columns.Bound(p => p.HasSLA).Title("Has SLA").Width(150);
                             columns.Bound(p => p.StartDate).Title("Metric Start Date").Width(150);
                             columns.Bound(p => p.EndDate).Title("Metric End Date").Width(150);
                             columns.Bound(p => p.MetricBaseline).Title("Metric Baseline").Width(150);
                             columns.Bound(p => p.MetricTarget).Title("Metric Target").Width(150);
                             columns.Bound(p => p.MetricUnit).Title("Metric Unit").Width(150);
                             columns.Bound(p => p.MetricOwner).Title(" Metric Owner").Width(150);
                             columns.Bound(p => p.Clocksetup).Title("Clock Type").Width(150);
                             columns.Bound(p => p.ComplianceUnits).Title("SLA Compliance Units").Width(150);
                             columns.Bound(p => p.ComplianceBaseline).Title("SLA Compliance Baseline >=").Width(150);
                             columns.Bound(p => p.ComplianceTarget).Title("SLA Compliance Target >=").Width(150);
                             columns.Bound(p => p.ExceedsExpectation).Title("Exceeds SLA Expectations > ").Width(150);
                             columns.Bound(p => p.MetSLAExpectationsBTW).Title("Met SLA Expectations btw ").Width(150).Locked(true).Lockable(false);
                             columns.Bound(p => p.BelowExpectation).Title("Below SLA Expectation").Width(150);
                             columns.Bound(p => p.ClientId).Filterable(false).Title("Action").Width(180).ClientTemplate("#if(data.ClientId!=null){#<div><div ><button class='bg-image edit' title='Edit Icon' style='background-image: url(" + @Url.Content("~/Content/images/edit_blue.svg") + ");' onclick='editSLA(#:Id#);' id='sla-edit#=Id#' ><button class='bg-image view' title='View' style='background-image: url(" + @Url.Content("~/Content/images/view_blue.svg") + ");' onclick='viewSLA(#:Id#);' id='sla-View#=Id#'></button><button class='bg-image delete' title='Delete' style='background-image: url(" + @Url.Content("~/Content/images/delete_icon_blue.svg") + ");' onclick='deleteSLA(#=Id#);' id='sla-delete#=Id#'></button></div></div>#}#");

                         })
                          //.HtmlAttributes(new { @style = "height:480px" })
                          .Filterable()
                           .Scrollable(e => e.Endless(false))
