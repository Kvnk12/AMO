</div>



<script>

    function editSLA(Id) {
         var MetricId = document.getElementById("tempID").innerHTML;
         console.log("MetricID getMU" + MetricId);

         $('#MetricStatus_alert').hide();
         $('#MetricOwner_alert').hide();
         $('#Account_alert').hide();
         $('#Contract_alert').hide();
         $('#Priority_alert').hide();

        var href = window.location.href.split('/');
        var baseurl = '';
        if (href[3].toLowerCase() == 'slasetupnew') {
            baseurl = href[0] + '//' + href[2] + '/SlaSetupNew/getSlaSetupDetailsForEdit';
        }
        else {
            baseurl = href[0] + '//' + href[2] + '/' + (href[3] == "" ? "" : href[3] + '/') + 'SlaSetupNew/getSlaSetupDetailsForEdit';
        }     

        var mod = {
            Id: Id,
            MetricId: MetricId
        }

        console.log(mod);
        console.log(baseurl);
        var data1 = JSON.stringify(mod);

        $.ajax(
            {
                url: baseurl,
                type: 'post',
                data: data1,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    var popup = $("#chartSLACreateWindow").data("kendoWindow");
                    popup.open();
                    document.getElementById('chartSLACreateWindow_wnd_title').innerHTML = "SLA Setup -Edit";
                    document.getElementById("chartSLACreateWindow_wnd_title").insertAdjacentHTML("beforeend",
                        "<label style='margin-left:10em'>Metric Name:</label>" + data.MetricName + "<label style='margin-left:2em'>Metric Id:</label>" + data.MetricId);
                   
                    $('#MetricStatus_alert').hide();
                    $('#MetricOwner_alert').hide();
                    document.getElementById("Id").value = data.Id;
                    $("#AccountId").data("kendoDropDownList").value(data.AccountId);
                    $("#ContractId").data("kendoDropDownList").value(data.ContractId);
                    $("#Priority").data("kendoDropDownList").value(data.Priority);
                    $("#MetricUnit").data("kendoTextBox").value(data.MetricUnit);
                    $("#MetricStatusId").data("kendoDropDownList").value(data.MetricStatusId);
                    $("#ClientPriority").data("kendoTextBox").value(data.ClientPriority);
                    $("#Weightage").data("kendoTextBox").value(data.Weightage);
                    $("#ComplianceUnits").data("kendoTextBox").value(data.ComplianceUnits);
                    $("#ComplianceBaseline").data("kendoTextBox").value(data.ComplianceBaseline);
                    $("#ComplianceTarget").data("kendoTextBox").value(data.ComplianceTarget);
                    $("#MetricBaseline").data("kendoTextBox").value(data.MetricBaseline);
                    $("#MetricOwner").data("kendoTextBox").value(data.MetricOwner);
                    $("#MetricTarget").data("kendoTextBox").value(data.MetricTarget);
                    $("#ExceedsExpectation").data("kendoTextBox").value(data.ExceedsExpectation);
                    $("#MetExpectationlowerlimit").data("kendoTextBox").value(data.MetExpectationlowerlimit);
                    $("#MetExpectationhigherlimit").data("kendoTextBox").value(data.MetExpectationhigherlimit);
                    $("#BelowExpectation").data("kendoTextBox").value(data.BelowExpectation);
                    $("#ComplianceTarget").data("kendoTextBox").value(data.ComplianceTarget);
                    $("#ComplianceBaseline").data("kendoTextBox").value(data.ComplianceBaseline);
                    $("#ComplianceUnits").data("kendoTextBox").value(data.ComplianceUnits);
                    $("#CalculationData").val(data.CalculationData);
                    $("#StartDate").data("kendoDatePicker").value(data.StartDate);
                    $("#EndDate").data("kendoDatePicker").value(data.EndDate);
                    if (data.Clocksetup) {
                        $('input[name=Clocksetup]').attr('checked', true);
                    } else {
                        $('input[name=Clocksetup]').attr('checked', false);
                    }
                    if (data.HasSLA) {
                        $('input[type="checkbox"]').prop('checked', true);
                    } else {
                        $('input[type="checkbox"]').prop('checked', false);
                    }



                },
                error: function (response) {

                    console.log(response.responseText);
                },


            })

    }

    function onSLACreate() {
        var popup = $("#chartSLACreateWindow").data("kendoWindow");
        document.getElementById('chartSLACreateWindow_wnd_title').innerHTML = "New SLA Setup";
        onCancelforms();
        popup.open();
        popup.center();
        $('#MetricStatus_alert').hide();
        $('#MetricOwner_alert').hide();
        $('#Account_alert').hide();
        $('#Contract_alert').hide();
        $('#Priority_alert').hide();

        var MetricId = document.getElementById("tempID").innerHTML;
        console.log("MetricID getMU" + MetricId);

          var mod = {
              Id1: MetricId
        }

        var data = JSON.stringify(mod);
         var RootUrl = '@Url.Content("~/")';
        $.ajax({
            url: RootUrl + 'SlaSetupNew/getMetricUnitName',
            type: "post",

            data: data,
            async: false,
            contentType: 'application/json; charset=utf-8',
            error: function (response) {

                alert(response);
            },
            success: function (data) {
                //console.log(data);
                //alert("success");

                $("#MetricUnit").val(data);



            }
        });


    }

    function GetAccId() {

        var app = $("#AccountId").data("kendoDropDownList");
        return {
            Accid: app.value()
        }
    }

    function onSelectAccount(e) {
        var app = $("#ContractId").data("kendoDropDownList");
        app.dataSource.read();
    }

    function onsubmitforms() {
        $('#MetricStatus_alert').hide();
        $('#MetricOwner_alert').hide();
        $('#Account_alert').hide();
        $('#Contract_alert').hide();
        $('#Priority_alert').hide();
        var AccountId = $("#AccountId").data("kendoDropDownList").value();
        if (AccountId == '') {
            $('#Account_alert').show();
            return false;
        }
        var ContractId = $("#ContractId").data("kendoDropDownList").value();
        if (ContractId == '') {
            $('#Contract_alert').show();
            return false;
        }
        var Priority = $("#Priority").data("kendoDropDownList").value();
        if (Priority == '') {
            $('#Priority_alert').show();
            return false;
        }
        var ClientPriority = $("#ClientPriority").data("kendoTextBox").value();
        var MetricUnit = $("#MetricUnit").data("kendoTextBox").value();
        var MetricStatusId = $("#MetricStatusId").data("kendoDropDownList").value();
        if (MetricStatusId == '') {
            $('#MetricStatus_alert').show();
            return false;
        }

        var Weightage = $("#Weightage").data("kendoTextBox").value();
        var ComplianceUnits = $("#ComplianceUnits").data("kendoTextBox").value();
        var ComplianceBaseline = $("#ComplianceBaseline").data("kendoTextBox").value();
        var ComplianceTarget = $("#ComplianceTarget").data("kendoTextBox").value();
        var MetricBaseline = $("#MetricBaseline").data("kendoTextBox").value();
        var MetricOwner = $("#MetricOwner").data("kendoTextBox").value();
        var MetricTarget = $("#MetricTarget").data("kendoTextBox").value();
        var ExceedsExpectation = $("#ExceedsExpectation").data("kendoTextBox").value();
        var MetExpectationlowerlimit = $("#MetExpectationlowerlimit").data("kendoTextBox").value();
        var MetExpectationhigherlimit = $("#MetExpectationhigherlimit").data("kendoTextBox").value();
        var BelowExpectation = $("#BelowExpectation").data("kendoTextBox").value();
        var ComplianceTarget = $("#ComplianceTarget").data("kendoTextBox").value();
        var ComplianceBaseline = $("#ComplianceBaseline").data("kendoTextBox").value();
        var ComplianceUnits = $("#ComplianceUnits").data("kendoTextBox").value();
        var CalculationData = $("#CalculationData").val();
        var StartDate = $("#StartDate").data("kendoDatePicker").value();
        var EndDate = $("#EndDate").data("kendoDatePicker").value();
        var Clocksetup = $('input[name=Clocksetup]:checked').val();
        var HasSLA = $('#HasSLA:checked').val() ? true : false;
        if (MetricOwner == '') {
            $('#MetricOwner_alert').show();
            return false;
        }
        var Id = document.getElementById("Id").value;
        var MetricId =  document.getElementById("tempID").innerHTML;
        console.log(HasSLA)



        var grid = $('#SLAGrid').data('kendoGrid').dataSource;
        /* console.log(grid._data.length);*/
        var recLength = grid._data.length;
        for (var i = 0; i < recLength; i++) {
            /* console.log(grid._data[i]);*/
            if (AccountId == grid._data[i].AccountId && ContractId == grid._data[i].ContractId && Priority == grid._data[i].Priority ) {

                alert("You can have Single metric specification detail for given 'Account', 'Contract' and 'Priority' values. (acc1 / Ctract1 / 1)");
                return false;
            }
        }

        var mod = {
            Id: Id,
            AccountId: AccountId,
            MetricId: MetricId,
            ContractId: ContractId,
            Priority: Priority,
            ClientPriority: ClientPriority,
            Weightage: Weightage,
            MetricStatusId: MetricStatusId,
            StartDate: StartDate,
            EndDate: EndDate,
            MetricBaseline: MetricBaseline,
            MetricTarget: MetricTarget,
            MetricOwner: MetricOwner,
            ComplianceUnits: ComplianceUnits,
            ComplianceBaseline: ComplianceBaseline,
            ComplianceTarget: ComplianceTarget,
            ExceedsExpectation: ExceedsExpectation,
            MetExpectationlowerlimit: MetExpectationlowerlimit,
            MetExpectationhigherlimit: MetExpectationhigherlimit,
            BelowExpectation: BelowExpectation,
            ComplianceTarget: ComplianceTarget,
            ComplianceBaseline: ComplianceBaseline,
            ComplianceUnits: ComplianceUnits,
            CalculationData: CalculationData,
            Clocksetup: Clocksetup,
            MetricUnit: MetricUnit,
            HasSLA: HasSLA

        }
        var data = JSON.stringify(mod);
            var RootUrl = '@Url.Content("~/")';
            $.ajax({

                type: 'post',
                url: RootUrl + 'SlaSetupNew/SaveSlaSetupDetails',
                data: data,
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                    var popup = $("#chartSLACreateWindow").data("kendoWindow");
                    popup.close();
                    onCancelforms();
                    $("#Id").val("");
                    var grid = $("#SLAGrid").data("kendoGrid");
                    grid.dataSource.read();

                },
                error: function (err, response) {

                }
            });
    }

    function deleteSLA(Id) {

        baseurl = '@Url.Content("~/SlaSetupNew/DeleteSlaSetup")';
        var mod = {
            Id: Id
        };
        var data1 = JSON.stringify(mod);
        $.ajax(
            {
                url: baseurl,
                type: 'post',
                data: data1,
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    //var report = data.ReportName;
                    //document.getElementById("addListP").innerHTML = "Selected Report Subscription for " + report +" has been deleted ";
/*                    $('#addSubcriptionListModal').modal('show');*/

                    var grid = $("#SLAGrid").data("kendoGrid");
                    grid.dataSource.read();


                }


            })
    }

    function viewSLA(Id) {
        var popup = $("#chartSLAViewWindow").data("kendoWindow");
        var mod = {
            Idv: Id
        }

        var data = JSON.stringify(mod);
        var RootUrl = '@Url.Content("~/")';
        $.ajax({
            url: RootUrl + 'SlaSetupNew/getSlaSetupDetails_View',
            type: "post",

            data: data,
            async: false,
            contentType: 'application/json; charset=utf-8',
            error: function (response) {

                //alert('Error');
            },
            success: function (data) {
                //console.log(data);
                //alert("success");
                $("#AccountName_View").val(data.AccountName);
                $("#ContractName_View").val(data.ContractName);
                $("#Priority_View").val(data.Priority);
                $("#Weightage_View").val(data.Weightage);
                $("#MetricStatus_View").val(data.MetricStatus);

                $("#StartDate_View").data("kendoDatePicker").value(data.StartDate);

                $("#EndDate_View").data("kendoDatePicker").value(data.EndDate);
                $("#MetricBaseline_View").val(data.MetricBaseline);
                $("#MetricTarget_View").val(data.MetricTarget);
                $("#MetricUnit_View").val(data.MetricUnit);
                $("#MetricOwner_View").val(data.MetricOwner);
                $("#CalculationData_View").val(data.CalculationData);
                //$("#Clocksetup").val(data.KEDBNumber);
                $("#ComplianceUnits_View").val(data.ComplianceUnits);
                $("#ComplianceBaseline_View").val(data.ComplianceBaseline);
                $("#ComplianceTarget_View").val(data.ComplianceTarget);
                $("#ExceedsExpectation_View").val(data.ExceedsExpectation);
                $("#MetExpectationlowerlimit_View").val(data.MetExpectationlowerlimit);
                $("#MetExpectationhigherlimit_View").val(data.MetExpectationhigherlimit);
                $("#BelowExpectation_View").val(data.BelowExpectation);
                if (data.Clocksetup) {
                    $('input[name=Clocksetup_View]').attr('checked', true);
                } else {
                    $('input[name=Clocksetup_View]').attr('checked', false);
                }
                if (data.HasSLA) {
                    $('input[type="checkbox"]').prop('checked', true);
                } else {
                    $('input[type="checkbox"]').prop('checked', false);
                }

                document.getElementById("chartSLAViewWindow_wnd_title").insertAdjacentHTML("beforeend",
                    "<label style='margin-left:10em'>Metric Name:</label>" + data.MetricName + "<label style='margin-left:2em'>Metric Id:</label>" + data.MetricId);
                popup.open();
                popup.center();


            }
        });
    }

    function onCancelforms() {

        $("#AccountId").data("kendoDropDownList").value("");
        $("#ContractId").data("kendoDropDownList").value("");
        $("#Priority").data("kendoDropDownList").value("");
        $("#MetricUnit").data("kendoTextBox").value("");
        $("#MetricStatusId").data("kendoDropDownList").value("");
        $("#ClientPriority").data("kendoTextBox").value("");
        $("#Weightage").data("kendoTextBox").value("");
        $("#ComplianceUnits").data("kendoTextBox").value("");
        $("#ComplianceBaseline").data("kendoTextBox").value("");
        $("#ComplianceTarget").data("kendoTextBox").value("");
        $("#MetricBaseline").data("kendoTextBox").value("");
        $("#MetricOwner").data("kendoTextBox").value("");
        $("#MetricTarget").data("kendoTextBox").value("");
        $("#ExceedsExpectation").data("kendoTextBox").value("");
        $("#MetExpectationlowerlimit").data("kendoTextBox").value("");
        $("#MetExpectationhigherlimit").data("kendoTextBox").value("");
        $("#BelowExpectation").data("kendoTextBox").value("");
        $("#ComplianceTarget").data("kendoTextBox").value("");
        $("#ComplianceBaseline").data("kendoTextBox").value("");
        $("#ComplianceUnits").data("kendoTextBox").value("");
        $("#CalculationData").val("");
        $("#StartDate").data("kendoDatePicker").value("");
        $("#EndDate").data("kendoDatePicker").value("");
        $('input[name=Clocksetup]').attr('checked', false);
        $('input[type="checkbox"]').prop('checked', false);

        var popup = $("#chartSLACreateWindow").data("kendoWindow");
        popup.close();
    }


    function onCancelClick() {
        var popup = $("#chartSLAViewWindow").data("kendoWindow");
