        var tempName = document.getElementById("tempName").innerHTML;
        console.log("getMetric ", Id);
        $('.arrowdownBG').removeClass('show');
        $('.arrowBG').removeClass('hide');
        $('.eye-icon').removeClass('hide');
        $('.hide-icon').removeClass('show');
        document.getElementById('metric-menu').innerHTML = "Show Menu";
        $('.menuListDiv').removeClass('show');


         var mod = {
            Id: Id
        }

        var data = JSON.stringify(mod);
