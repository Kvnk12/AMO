                          .Ajax()
                          .PageSize(100)
                          .Read(read => read.Action("GetSlaList", "SlaSetupNew").Data("getMetricId"))
                          .Destroy(destroy => destroy.Action("DeleteSlaSetup", "SlaSetupNew"))
                           )
        )


    </div>
    @Html.Partial("_NewSlaSetup", Model)
