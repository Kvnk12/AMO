@model NTTData.AMOPortal.WebUI.Dto.ClientAndAccountsInput 
<div class="accountCont">
    <div class="accContracthdr">
        <div class="left">
            Accounts 
                                      
        </div>
        <div class="right">
            <button class="btn btn-primary" tabindex="2900" type="button" id="btnAddAccount">Add</button>
        </div>
    </div>
    <div class="cptblacc">
        <table width="100%" border="1" cellspacing="10" cellpadding="10" class="table table-striped ">
            <tr>
                <th width="70%" scope="col">Account Name</th>
                <th width="30%" scope="col">Status</th>
            </tr>
            
            @{ 
                if (Model.ClientId > 0)
                    {
                foreach (var item in Model.ClientAccountsFilterList)
                    
                    {  
                    <tr>
                    <td>@Html.ActionLink(@item.AccountName,"DisplayClientAccountContracts","ClientAccountGrid", new {ClientId=item.ClientId, AccountId=item.Id, AccountName=@item.AccountName}, null)</td>
                        <td><a href="#" id="showaccdetail">@item.Status</a></td>
                    </tr>
                    }
            }
            }

        </table>
    </div>
</div>
