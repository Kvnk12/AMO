@model NTTData.AMOPortal.WebUI.Dto.ClientAndAccountsInput
@{
    ViewBag.Title = "Client Profile Manager";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/home/Client_Profile_manager_white.svg");
    //Layout = "~/Views/Shared/_AdminLayout.cshtml";
    //  Layout = "~/Views/Shared/_AppLayout.cshtml";
    Layout = "~/Views/Shared//GenericLayOutWithoutFooter.cshtml";
}

<div class="content-main dark-bg client-Acct-Grid">

        <ol class="breadcrumb">
            <li>Client Profile Manager</li>
            <li class="active">Account Demographics</li>
        </ol>
        <div style="margin-bottom:3em;">
            <div class="form-group" style="display:flex;margin:1em 0 3em;">
                <label for="clientName" class="control-label" style="color: white; margin-right: 1em;" id=""><span class="mandate">*</span>Client Name : </label>
                <div class="col-sm-5" style="margin-top:5px;">
                    @Html.Partial("_ClientList", Model)
                </div>
            </div>

            <div>

                <div class="row">
                    @Html.Partial("_ClientAccounts")
                    @Html.Partial("_ClientAccountContracts")
                    <!-- Optional: clear the XS cols if their content doesn't match in height -->
                    @*<div class="clearfix visible-xs"></div>*@
                    @Html.Partial("_ClientAccountServices")
                </div>
                <!--/.end of row-->

                <div style=" width: 1179px; margin-left: -1em;">
                    @{
                        if (Model.ClientId > 0 && Model.ContractId == 0 && Model.ContractCreate != "Contractcreate" && (Model.AccountId > 0 || Model.AccountCreate == "Accountcreate"))
                        {
                            @Html.Partial("_AcctCreate")
                        }
                    }
                </div>



                <div style=" width: 1179px; margin-left: -1em;">
                    @{
                        if (Model.ClientId > 0 && Model.AccountId > 0 && (Model.ContractId > 0 || Model.ContractCreate == "Contractcreate"))
                        {
                            @Html.Partial("_Create")
                        }
                    }
                </div>
            </div>
        </div>
</div>
<script>
    $(function () {
        cbpHorizontalMenu.init();
    });

    $(document).ready(function () {

        $('.selectpicker').selectpicker();
        //$('#sandbox-container .input-append.date').datepicker({ todayHighlight: true });

        $('#cancel').click(function () {
            var confirm = window.confirm('Do you want cancel the changes?');
            if (confirm) {

                //window.location.replace(window.location.href.slice(0, window.location.href.indexOf('?')));
                //alert(window.history(-1));

                window.location = window.location.href;
                return false;
            }
            else { return false; }

        });


        $('select#ClientId').change(function () {
            var SelectedclientId = $('#ClientId :selected').val();
            var href = window.location.href.split('/');
            //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
            var baseurl = '';
            if (href[3] == 'ClientAccountGrid') {
                //alert('local url');

                var baseurl = href[0] + '//' + href[2] + '/' + 'ClientAccountGrid/DisplayClientAccountContracts/?ClientId='
            }
            else {
                //alert('server');
                var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'ClientAccountGrid/DisplayClientAccountContracts/?ClientId='
            }

            window.location = baseurl + SelectedclientId;

        });



    })

    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (charCode != 46 && charCode != 44 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }
    function CalcFTE() {
        var OffshoreVal = $('#txtAvgFTEoffShore').val();
        var OnshoreVal = $('#txtAvgFTEOnShore').val();
        var re = /,/gi;
        //alert(OnshoreVal);
        OnshoreVal = OnshoreVal.replace(re, "");
        OffshoreVal = OffshoreVal.replace(re, "");
        //alert(OnshoreVal);
        //alert(OffshoreVal);
        var AverageVal = parseFloat(OnshoreVal) + parseFloat(OffshoreVal);
        if (isNaN(AverageVal))
            AverageVal = 0;
        //alert(AverageVal);
        $('#txtAvgFTE').val(AverageVal);
        $("#txtAvgFTE").prop('readonly', true);
    }
</script>

<script>
    $(document).ready(function () {

        if ($('#chkAvgFTE').prop('checked')) {
            $("#txtAvgFTE").prop('readonly', true);

        }

        //Check box  calculate implementation
        $('#chkAvgFTE').click(function () {

            if ($('#chkAvgFTE').prop('checked')) {
                //$("#txtAvgFTE").attr("readonly", true);
                CalcFTE();

            }
            else { $('#txtAvgFTE').prop('readonly', false); }
        });


        $('#txtAvgFTEOnShore, #txtAvgFTEoffShore').change(function () {

            //alert($('#chkAvgFTE').prop('checked'));
            //if ($('#chkAvgFTE').attr('checked')) {
            if ($('#chkAvgFTE').prop('checked')) {
                CalcFTE();

            }
        });

        //$('#txtAvgFTEoffShore').change(function () {

        //    if ($('#chkAvgFTE').attr('checked')) {
        //        CalcFTE();

        //    }
        //});

        $('#btnAddContract').click(function () {
            var clientId = $("#clientId").val().toString();
            var AccountId = $("#AccountId").val().toString();
            var AccountName = $("#AccountName").val().toString();

            if (clientId == "0" || AccountId == "0") {
                alert('Please select Client & Account to create New Contract');
                return false;
            }

            var href = window.location.href.split('/');
            //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';

            var baseurl = '';
            if (href[3] == 'ClientAccountGrid') {
                //alert('local url');

                var baseurl = href[0] + '//' + href[2] + '/' + 'ClientAccountGrid/DisplayClientAccountContracts/?ClientId='
            }
            else {
                //alert('server');
                var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'ClientAccountGrid/DisplayClientAccountContracts/?ClientId='
            }


            var url = baseurl + clientId + "&AccountId=" + AccountId + "&Contract=Contractcreate" + "&AccountName=" + AccountName;
            window.location = url;

        });

        $('#btnAddAccount').click(function () {
            var clientId = $("#clientId").val().toString();
            if (clientId == "0") {
                alert('Please select Client to create new Account');
                return false;
            }
            var href = window.location.href.split('/');

            var baseurl = '';
            if (href[3] == 'ClientAccountGrid') {
                //alert('local url');

                var baseurl = href[0] + '//' + href[2] + '/' + 'ClientAccountGrid/DisplayClientAccountContracts/?ClientId='
            }
            else {
                //alert('server');
                var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'ClientAccountGrid/DisplayClientAccountContracts/?ClientId='
            }

            var url = baseurl + clientId + "&AccountCreate=Accountcreate";
            window.location = url;

        });
    });

</script>

<script>

    function getUrlVars() {
        var vars = [], hash;
        var hashes = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');
        for (var i = 0; i < hashes.length; i++) {
            hash = hashes[i].split('=');
            vars.push(hash[0]);
            vars[hash[0]] = hash[1];
        }
        return vars;
    }

</script>