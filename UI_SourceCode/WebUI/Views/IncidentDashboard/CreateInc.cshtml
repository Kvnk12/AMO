<script>
    $('select#drpClientId').change(function () {
        var SelectedclientId = $('#drpClientId :selected').val();
        var reportname = $('#reportname').val();
        var href = window.location.href.split('/');
        //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
        var baseurl = '';
        if (href[3] == 'IncidentDashboard') {
            //alert('local url');

            var baseurl = href[0] + '//' + href[2] + '/' + 'IncidentDashboard/GetRptView/?cid={clientid}&rptname={reportid}'
        }
        else {
            //alert('server');
            var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'IncidentDashboard/GetRptView/?cid={clientid}&rptname={reportid}'
        }

        baseurl = baseurl.replace("{clientid}", SelectedclientId);
        baseurl = baseurl.replace("{reportid}", reportname);

        window.location = baseurl;

    });
    $('select#sladmonth').change(function () {
        var SelectedClient = $('#drpClientId :selected').val();
        var Selecteddataset = $('#sladmonth :selected').val();
        var reportname = $('#reportname').val();
        var href = window.location.href.split('/');

        if (SelectedClient == "0") {
            return false;
        }

        //var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/';
        var baseurl = '';
        if (href[3] == 'IncidentDashboard') {
            //alert('local url');

            var baseurl = href[0] + '//' + href[2] + '/' + 'IncidentDashboard/GetView/?cid={clientid}&rptname={reportid}&dataset={datasetid}'
        }
        else {
            //alert('server');
            var baseurl = href[0] + '//' + href[2] + '/' + href[3] + '/' + 'IncidentDashboard/GetView/?cid={clientid}&rptname={reportid}&dataset={datasetid}'
        }

        baseurl = baseurl.replace("{clientid}", SelectedClient);
        baseurl = baseurl.replace("{reportid}", reportname);
        baseurl = baseurl.replace("{datasetid}", Selecteddataset);

        window.location = baseurl;

    });
</script>
