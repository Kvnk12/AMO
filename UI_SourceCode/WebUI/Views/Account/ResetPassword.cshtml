@model NTTData.AMOPortal.WebUI.Dto.ResetPasswordModel


@*@{
        <title>@ViewBag.Title - NTT Data | Optimization Tool | Login</title>
        ViewBag.ImagePathOne = Url.Content("~/Content/images/Ntt-logo-icon.png");
        ViewBag.ImagePathTwo = Url.Content("~/Content/images/Ntt-logo.png");
        Layout = "~/Views/Shared/_MainLayout.cshtml";


    }*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>Reset Password - NTT Data | Optimization Tool</title>
    <!-- Bootstrap core CSS -->
    <link href="@Url.Content("~/Content/css/bootstrap.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/style.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/custom-styles.css")" rel="stylesheet">
<style type="text/css">
.navbar {
    margin-bottom: 0;
}
.custom-button:hover, .custom-button:focus, .custom-button:active, .custom-button.active, .open .dropdown-toggle.custom-button {
    color: #ffffff;
    background-color: rgb(91,121,171);
    border-color: rgb(91,121,171);
}
.passwordrestcontent {
    height: 77%;
    top: 1.3em;
    bottom: 0;
    left: 0;
    right: 0;
    margin: auto;
    width: 85%;
    position: absolute;
    background-color: white;
    border-top: 8px solid rgb(91,121,171);
}
    .passwordrestcontent .validation-summary-errors {
        color: #ffa600;
        font-size: 12px;
        left: 10em;
        top: 2em;
        position:absolute;
    }
.passwordrestcontent .reset-content {
    padding:2em;
}
.passwordrestcontent .reset-content .reset-pwd-title .reset-title {
    color: rgb(91,121,171);
    font-size:14px;
}
.passwordrestcontent .reset-content span{
    font-size:12.5px;
}
.passwordrestcontent .reset-content .reset-pwd-title {
    margin-bottom: 0.3em;
}
.passwordrestcontent .reset-content .reset-content-text .custom-group{
    margin-top:0.4em;
}
.passwordrestcontent .reset-content .reset-content-text .custom-group .reset-label {
    color: #05A2CC;
    font-size: 12px;
}
.passwordrestcontent .reset-content .reset-content-text .custom-group .reset-input input{
    width: 100%;
    height: 30px;
    border-radius: 3px;
    box-shadow: none;
    border:1px solid #ccc;
    padding-left:0.5em;
}
.passwordrestcontent .reset-content .reset-content-text .custom-group.reset-pwd-btn {
    direction: rtl;
    clear:both;
}
.passwordrestcontent .reset-content .reset-content-text {
    width: 30%;
    padding-left: 1em;
}
.passwordrestcontent .reset-content .reset-pwd-btn .custom-button {
    font-size: 11px;
    margin-left:0.5px;
    font-family: 'HelveticaNeue';
}
.passwordrestcontent .reset-content .reset-msg {
    font-size: 12px;
    color: rgb(91,121,171);
}
.passwordrestcontent .reset-content .reset-msg .list-group {                    
    font-style: italic;
    color:#333;
}

@@media only screen and (min-width: 1440px) {
.motto {
    font-size: 35px;
}

    .passwordrestcontent .reset-content {
        padding: 4em;
    }
    .passwordrestcontent .validation-summary-errors {
        font-size: 16px;
        left: 13em;
        top: 3em;
    }
    .passwordrestcontent .reset-content .reset-pwd-title .reset-title {
            font-size: 22px;
        }
    .passwordrestcontent .reset-content .reset-content-text .custom-group .reset-label {
            font-size: 17px;
        }
    .passwordrestcontent .reset-content span {
            font-size: 15.5px;
        }
    .passwordrestcontent .reset-content .reset-content-text .custom-group .reset-input input {
            height: 35px;
        }
    .passwordrestcontent .reset-content .reset-content-text .custom-group {
            margin-top: 1.4em;
        }
    .passwordrestcontent .reset-content .reset-msg {
            font-size: 18px;
            margin-top: 2.5em;
        }
}
    </style>
</head>
<body>
    <div class="navbar navbar-fixed-top custom-header" role="navigation">
        <div class="navbar-main">
            <div class="header-left">
                <a class="header-logo" href="#" style="border-right:unset">
                    <img alt="ntt logo" src='@Url.Content("~/Content/images/nttdata_logo.png")'>
                </a>
            </div>
        </div> <!--/.container -->
    </div>

 
    <div id="login-wrap">
        <div class="passwordrestcontent">
            @using (Html.BeginForm())
            {
               
                @*@Html.ValidationSummary()*@
            <div class="reset-content">
                <div class="reset-pwd-title">
                    <label class="reset-title">
                        Reset Password
                    </label>
                </div>
                @Html.AntiForgeryToken()
                @if (!ViewData.ModelState.IsValid)
                {
                    @Html.ValidationSummary()
                }

                <br />
                <div style="display:flex;margin-bottom: 0.5em;">
                    <img src="~/Content/images/info_yellow.svg" style="width: 16px; height: 16px; margin-right: 0.5em;" />
                    <span style="color:rgb(255 216 0)"><i>Password Requires alteast one upper and lower case alphanumeric and Special character and 8to 15 characters long.</i></span>
                </div>                
                <span>Your new Password must be different from previous used password</span>
                <br />
                <br />
                <div class="reset-content-text">
                    <div class="custom-group">
                        <div class="reset-label">
                            @Html.LabelFor(m => m.NewPassword)
                        </div>
                        <div class="reset-input">
                            @Html.PasswordFor(m => m.NewPassword)
                        </div>
                    </div>
                    <div class="custom-group">
                        <div class="reset-label">
                            @Html.LabelFor(m => m.ConfirmPassword)
                        </div>
                        <div class="reset-input">
                            @Html.PasswordFor(m => m.ConfirmPassword)
                        </div>
                    </div>
                    <div class="custom-group reset-pwd-btn">
                        <input type="submit" class="custom-button" value="SET PASSWORD" id="btnSave" />
                        <a href="@Url.Action("Login", "Account")" class="custom-button">CANCEL</a>

                    </div>
                </div>
                <br />
                <div class="reset-msg" style="margin-left:17px;">
                    <b>Please Note:- </b>
                    <ul class="list-group">
                        <li>
                            Password must contain at least:-
                            <ul style="padding:0px;">
                                <li>
                                    1 Lowercase letter
                                </li>
                                <li>
                                    1 Uppercase letter
                                </li>
                                <li>
                                    1 Number
                                </li>
                                <li>
                                    1 Symbol/Special character
                                </li>
                                <li>
                                    At least 8 Character long
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
            }
        </div>
    </div>

    <div id="footer">
        <div class="container">
            <p class="credit">&copy;@DateTime.Now.Year NTT DATA, Inc. All rights reserved.</p>
        </div>
    </div>

</body>
</html>
