@using Kendo.Mvc.UI;
@model NTTData.AMOPortal.WebUI.Dto.PasswordSuccessModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>@ViewBag.Title - NTT Data | Optimization Tool | Login</title>
    <!-- Bootstrap core CSS -->
    <link href="@Url.Content("~/Content/css/bootstrap.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/style.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/custom-styles.css")" rel="stylesheet">
    <style type="text/css">
        .navbar {
            margin-bottom: 0;
        }
        .passwordSuccessContent {
            height: 60%;
            top: 1em;
            bottom: 0;
            left: 0;
            right: 0;
            margin: auto;
            width: 85%;
            position: absolute;
            background-color: white;
            border-top: 8px solid rgb(91,121,171);
        }
    .successText { 
        font-size:14px;
        color:rgb(91,121,171);
    }

        .passwordText {
            font-size:13px;
        }
        @@media only screen and (min-width: 1440px) {
            .successText{
                font-size:18px;
            }
            .success-icon{
                background-size:26px;
            }
            .passwordText{
                font-size:16px;
            }
        }

    </style>
</head>
<body>

    <div class="navbar navbar-fixed-top custom-header" role="navigation">
        <div class="navbar-main">
            <div class="header-left">
                <a class="header-logo" href="#" style="border-right:unset">
                    <img alt="ntt logo" src='@Url.Content("~/Content/images/nttdata_logo.png")'>
                </a>
            </div>
        </div> <!--/.container -->
    </div>
    <div id="login-wrap">
        <div class="passwordSuccessContent">
            <div style="display:flex;margin:3em 3em 0em 3em;">
                <div class="success-icon">

                </div>
                <div style="margin-left: 0.5em;padding: 0.5em;">
                    <span class="successText">Email has been sent successfully!</span>
                    <span class="passwordText">We have sent a password recover instructions to your email</span>
                </div>
            </div>
            <div style="margin-left: 7em;">
                <span class="passwordText">Click here to</span>
                <i>@Html.ActionLink("SIGN IN", "Login", "Account", new { area = "" }, null)</i>
            </div>
        </div>

    </div>


    <div id="footer">
        <div class="container">
            <p class="credit">&copy;@DateTime.Now.Year NTT DATA, Inc. All rights reserved.</p>
        </div>
    </div>




</body>
</html>