@using Kendo.Mvc.UI;
@model NTTData.AMOPortal.WebUI.Dto.ForgotPasswordModel

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>@ViewBag.Title - NTT Data | Optimization Tool | Login</title>
    <!-- Bootstrap core CSS -->
    <link href="@Url.Content("~/Content/css/bootstrap.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/style.css")" rel="stylesheet">
    <link href="@Url.Content("~/Content/css/custom-styles.css")" rel="stylesheet">
    <style type="text/css">
        .navbar {
            margin-bottom: 0;
        }

        .alert-danger.login-alert {
            padding: 0px;
            width: fit-content;
            color: #ae0502;
            background-color: #fff;
            border-color: transparent;
        }

            .alert-danger.login-alert ul {
                margin: 0px;
                padding: 0.5em 1em;
            }

        .custom-button:hover, .custom-button:focus, .custom-button:active, .custom-button.active, .open .dropdown-toggle.custom-button {
            color: #ffffff;
            background-color: #05A2CC;
            border-color: #05A2CC;
        }

        .loginDetails {
            height: 60%;
            width: 30%;
            margin-top: 9.5em;
        }

            .loginDetails .loginForm {
                margin-top: 1em;
            }

        .signInContent {
            padding-right: 11em;
        }

        @@media only screen and (min-width: 1440px) {
            .motto {
                font-size: 35px;
            }

            #login-wrap .loginDetails {
                height: 60%;
                width: 30%;
                padding: 4em 0em 4em 0em;
                margin-top: 15.5em;
            }

            #login-wrap .graphic-image {
                width: 71.5%;
                margin-left: 7em;
                margin-top: 2.5em;
            }

            #login-wrap .loginPageContent {
                top: 8em;
                left: 8em;
            }

            .loginDetails .loginForm {
                text-align: center;
                margin-top: 4em;
            }

                .loginDetails .loginForm .signInContent {
                    font-size: 24px;
                    padding-right: 10.5em;
                }

                .loginDetails .loginForm .signIn {
                    font-family: 'HelveticaNeue-Light';
                    color: #05A2CC;
                    font-size: 19px;
                    padding-right: 0;
                }

                .loginDetails .loginForm .userDetails {
                    font-size: 17px;
                    padding-right: 15.5em;
                }

                .loginDetails .loginForm .loginIcons {
                    display: flex;
                    justify-content: flex-start;
                    margin-left: 5.5em;
                }

                .loginDetails .loginForm .login-textbox input {
                    width: 350px;
                    height: 36px;
                    font-size: 16px;
                }

                .loginDetails .loginForm .loginIcons .emailIcon {
                    background-size: 26px;
                    margin-left: 0;
                }

                .loginDetails .loginForm .sendEmail-button .custom-button {
                    width: 25%;
                    font-size: 17px;
                    height: 36px;
                    margin-left: 0;
                }

                .loginDetails .loginForm .sendEmail-button #btnAdd1 {
                    margin-right: 6.5em;
                }

            #footer .credit {
                font-size: 15px;
                right: 4em;
            }
        }
    </style>
</head>
<body>
    <div class="navbar navbar-fixed-top custom-header" role="navigation">
        <div class="navbar-main">
            <div class="header-left">
                <a class="header-logo" href="#" style="border-right:unset">
                    <img alt="ntt logo" src='@Url.Content("~/Content/images/nttdata_logo.png")'>
                </a>
            </div>
        </div> <!--/.container -->
    </div>
    <div id="login-wrap">
        <div style="width: 60%; float:left;height:100%;">
            <div class="loginPageContent">
                <h4 class="motto">Consolidate and quantify key benefits from <br /> NTT DATA Optimization Tools solution</h4>
            </div>
            <div style="position: relative;top: 10em;left:4em;">
                <img class="graphic-image" src='@Url.Content("~/Content/images/graphic_withtext.svg")'>
            </div>
        </div>
        <div style="width: 40%; float:right;height:100%;">
            <div class="loginDetails">
                <div class="loginForm">
                    <span class="signInContent">
                        Forgot Password
                    </span>
                    <span class="signIn" style="padding-right:0;padding-left: 0.4em;">
                        <i>Enter the Email Address associated with your Account</i>
                    </span>
                    <br />
                    <br />
                    <br />

                    <p style="color:red" class="message-success">@ViewBag.StatusMessage</p>
                    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @class = "form-horizontal", ReturnUrl = Request.QueryString["ReturnUrl"], @autocomplete = "off" }))
                    {
                        @Html.AntiForgeryToken()
                        if (!ViewData.ModelState.IsValid)
                        {
                            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger login-alert container" })
                        }
                        @*@Html.ValidationSummary()*@
                        <div style="padding-right: 1.5em;">
                            <span class="userDetails">Email ID</span>
                            <br />
                            <div class="loginIcons">
                                <div class="emailIcon"></div>
                                <div class="login-textbox" style="padding-left: 1.2em;">
                                    @Html.TextBoxFor(m => m.UserName, new { @id = "exampleInputPassword1", @placeholder = "Enter Email ID", @autocomplete = "off" })
                                </div>
                            </div>
                        </div>
                        <br />
                        <br />
                        <div class="sendEmail-button">
                            <a href="@Url.Action("Login", "Account")" class="custom-button" style="text-decoration:none;padding-top: 0.5em;">CANCEL</a>&nbsp;
                            @*<button class="custom-button" type="submit" id="btnAdd1">CANCEL</button>&nbsp;*@
                            <button class="custom-button" type="submit" id="btnAdd1">SEND EMAIL</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div id="footer">
        <div class="container">
            <p class="credit">&copy;@DateTime.Now.Year NTT DATA, Inc. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
<script type="text/javascript">
    function password_alert() {
        window.alert("Please contact the AMO Portal Administrator to reset your password")
    }
</script>

