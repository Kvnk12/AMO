<script>*@
    //VerifyUserCode
    function VerifyUserCodeFunc() {
        var rememberMe = $('#rememberDevice:checked').val() ? true : false;
        var indexurl = '@Url.Content("~/")';
        mod = {
            code: $("#otptextbox").val(),
            RememberThisDevice: rememberMe
        }
        var data = JSON.stringify(mod);
        var baseurl = '@Url.Content("~/Account/VerifyUserCode")';
        $.ajax(
        {
            url: baseurl,
            type: 'post',
            data:data,
            async: false,
            contentType: 'application/json; charset=utf-8',
            success: function (data) {
                if (data.success) {
                    window.location.href = indexurl+data.success;
                }
                else {
                    alert(data.failure);
                }
            },
            failure: function (err) {

            }
        });
    }


