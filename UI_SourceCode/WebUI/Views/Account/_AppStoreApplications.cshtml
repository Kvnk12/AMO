<div style="width:56%">
    <table>
        @foreach (var item in Model.Apps)
        {
            var checkBoxId = "chk" + item.Value;
            var blnchecked = false;
            if (Model.selectedAppIds != null)
            {
                foreach (var i in Model.selectedAppIds)
                {
                    if (i.ToString() == item.Value)
                    {
                        blnchecked = true;
                        break;
                    }
                }
            }
            <tr>
                <td>
                    <div>
                        @if (!blnchecked)
                        {
                            @*<input type="checkbox" class="childchkboxAllApp" value=@item.Value id="@checkBoxId">@item.Text*@
                            <input type="checkbox" class="childChckbx" value=@item.Value id="@checkBoxId" @*onchange="checkApp(@item.Value)"*@ style="opacity:0;width:0">
                            <label for="@checkBoxId" class="childChckbx">@item.Text &nbsp;&nbsp;</label>
                        }
                        else
                        {
                            @*<input type="checkbox" checked="checked" class="childchkboxAllApp" value=@item.Value id="@checkBoxId">@item.Text*@
                            <input type="checkbox" checked="checked" class="childChckbx" value=@item.Value id="@checkBoxId" @*onchange="checkApp(@item.Value)"*@ style="opacity:0;width:0">
                            <label for="@checkBoxId" class="childChckbx">@item.Text &nbsp;&nbsp;</label>
                        }

                    </div>
                </td>
            </tr>

        }
    </table>
</div>

