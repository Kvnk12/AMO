@model NTTData.AMOPortal.WebUI.Dto.VerticalAndSubVerticalInput 

<div class="col-xs-6 col-sm-4 " style=" border: 1px solid lightgrey; padding: 0;margin:0 1em">
                    <div class="accContracthdr">
                      <div class="left"> Industry Sub-Vertical<br>
                        <span>Group: @Model.VerticalName</span> </div>
                      <div class="right">
                        <button class="btn btn-primary" tabindex="29" type="button" id="btnAddSubVertical">Add</button>
                      </div>
                    </div>
    <form>
    <input hidden id="verticalId" value="@Model.VerticalId.ToString()"  />

     <input hidden id="verticalName" value="@Model.VerticalName.ToString()"   />

        
     </form>
                    <div class="tblacc">
                      <table width="100%" border="1" cellspacing="10" cellpadding="10" class="table table-striped ">
                         <tr>
                          <th scope="col">Industry Sub-Vertical</th>
                        </tr>
                        @{
                            if(Model.VerticalId >0)
                            {
                                foreach(var item in Model.SubVerticalsFilterList)
                                {
                                 <tr>
                                <td>@Html.ActionLink(@item.SubVerticalName,"DisplayVerticalSubVerticals",new {SubVerticalId=item.Id, VerticalId=item.VerticalId,VerticalName=@Model.VerticalName,tabs="Tab2"})</td>   

                                      
                                 </tr>   
                                }
                            }
                        }
                      </table>
                    </div>
                  </div>