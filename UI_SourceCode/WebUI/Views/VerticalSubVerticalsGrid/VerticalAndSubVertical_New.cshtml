@using NTTData.AMOPortal.Domain.Entities
@using NTTData.AMOPortal.WebUI.Dto
@using WebUI.Controllers;
@using WebUI.Dto;
@using WebUI.Models;
@using Kendo.Mvc.UI;
@using System.Data;
@using Kendo.Mvc.Infrastructure;
@using Kendo.Mvc.Resources
@using Kendo.Mvc.Extensions;
@using System.Data.Entity

@model VerticalAndSubVerticalInput

<link rel="stylesheet" href="~/Content/themes/styles/kendo.common-bootstrap.min.css" />
<link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.min.css" />
<link rel="stylesheet" href="~/Content/themes/styles/kendo.bootstrap.mobile.min.css" />
<link rel="stylesheet" href="~/Content/css/bootstrap-multiselect.css" />
<script src="~/Scripts/jquery-3.6.0.min.js"></script>
<script src="~/Scripts/JScript/jszip.min.js"></script>
<script src="~/Scripts/JScript/kendo.all.min.js"></script>
<script src="~/Scripts/JScript/kendo.aspnetmvc.min.js"></script>
<script src="~/Content/js/bootstrap-multiselect.js"></script>
<script src="~/Content/js/bootstrap.js"></script>

@{
    ViewBag.Title = "Business Alignment Manager";
    ViewBag.ImagePathOne = Url.Content("~/Content/images/home/business_alignment_white.svg");
    //Layout = "~/Views/Shared/_AdminLayout.cshtml";
    //  Layout = "~/Views/Shared/_AppLayout.cshtml";
    Layout = "~/Views/Shared//GenericLayOut.cshtml";
}

<style>
    .k-popup-edit-form.k-window-content {
        height: 21em;
    }

    .k-edit-form-container {
        width: 40em;
        overflow-wrap: inherit
    }
   
</style>
<div class="content-main dark-bg vert-subvert">
    <div>
        <ol class="breadcrumb">
            <li>Business Alignment Manager</li>
            <li class="active">View/Edit  - Industry Vertical Types</li>
        </ol>
    </div>
    <input type="hidden" id="SelectedSubVertIdBCC" name="SelectedSubVertIdBCC">
    <input hidden id="subVId" name="subVId">
    <input hidden id="VertId" name="VertId">

    <div class="acct-cont">
        <div class="acct-cont-eye">
            <div style="display: flex; margin-bottom: 0.5em;">
                <span class="acc-eye-icon"></span>
                <label class="custom-white-label">Industry Vertical & Sub Vertical Management</label>
                <div style="margin-left:2em;">
                    <span class="info-icon"></span>
                    <label class="custom-white-label" style="color: rgb(252, 214, 86); ">Select "Vertical" from the first table to view/edit related "Sub Vertical(s)" in second table </label>
                </div>
            </div>
        </div>
        <span id="alertmsg"></span>
        <div class="acct-cont-mapping">
            <div class="acct-cont-mapping-grid">
                <div class="acct-cont-mapping-head ">
                    <div class="acct-cont-mapping-label">
                        <label class="custom-white-label" style="font-size:13px">Vertical</label>
                    </div>
                </div>
                <div class="acct-cont-grid ">
                    <div class="custom-kendo-grid vert-subvert scrollbar-rail">
                        @(Html.Kendo().Grid<IndVerticalModel>
    ()
    .Name("VerticalGrid")
    .Columns(columns =>
    {
        columns.Bound(p => p.VerticalId).Hidden();
        columns.Bound(p => p.VerticalName).Title("Vertical").Width(450)
        .ClientTemplate("#if(data.VerticalName!=null){#<div style='display:flex;' ><input onclick='onVerticalselect();' id='VerticalId#=VerticalId#' value='#=VerticalId#' name='actradiobtn' type='radio' style='margin-top: 3px;' />&nbsp; <label for='VerticalId#=VerticalId#'>#=VerticalName#</label> </div>#}#");
        columns.Command(command => { command.Edit().Text(" "); /*command.Destroy().Text(" ");*/ }).Title("Action");
        columns.Bound(p => p.VerticalId).Title("Vertical")
        .ClientTemplate("#if(data.VerticalId!=null){#<div style = 'background-image: url(" + @Url.Content("~/Content/images/delete_icon_blue.svg") + ");background-repeat: no-repeat; width:1em;height:2em;margin-top: 9px;cursor:pointer;' onclick='deleteVertical(#:VerticalId#);' ></ div >#}#").HtmlAttributes(new { style = "padding-left:7px;" });

    })
    .AutoBind(true)
    .Scrollable()
    .ToolBar(tools =>
    {
        tools.Search().Text("Search Vertical...");
        tools.Create().Text("Add");
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).CreateAt(GridInsertRowPosition.Bottom)/*.DisplayDeleteConfirmation(" Are you sure to delete the selected Vertical? Please note that respective SubVerticals also would get deleted")*/)
    .Search(search => { search.Field(f => f.VerticalName);
    })
    .DataSource(dataSource => dataSource
    .Ajax()
    .Model(model =>
    {
        model.Id(f => f.VerticalId);
    })
    .Read(read => read.Action("GetIndVerticalList", "VerticalSubVerticalsGrid"))
    .Create(create => create.Action("CreateIndVertical", "VerticalSubVerticalsGrid"))
    .Update(update => update.Action("EditIndVertical", "VerticalSubVerticalsGrid"))
    //.Destroy(destroy => destroy.Action("DeleteIndVertical", "VerticalSubVerticalsGrid"))
    .Events(e=>e.RequestEnd("onRequestEnd1"))
    )
    .Events(e=>e.Edit("onVertEdit"))
    )
                    </div>
                </div>
            </div>
            <div class="acct-cont-mapping-grid">
                <div class="acct-cont-mapping-head">
                    <div class="acct-cont-mapping-label">
                        <label class="custom-white-label" style="font-size:13px">Sub Vertical <span id="VerticalName"> </span></label>
                    </div>
                </div>
                <div class="acct-cont-grid ">
                    <div class="custom-kendo-grid vert-subvert scrollbar-rail">
                        @(Html.Kendo().Grid<IndSubVerticalModel>()
                                 .Name("SubVerticalGrid")
                                 .Columns(columns =>
                                 {
                                     columns.Bound(p => p.SubVerticalId).Hidden();
                                     //columns.Bound(p => p.VerticalId).Hidden();
                                     columns.Bound(p => p.SubVerticalName).Title("Sub Vertical Name").Width(350);
                                     columns.Command(command => { command.Edit().Text(" "); /*command.Destroy().Text(" ");*/ }).Width(50).Title("Action");
                                     columns.Bound(p => p.SubVerticalId).Title("Vertical")
                                        .ClientTemplate("#if(data.SubVerticalId!=null){#<div style = 'background-image: url(" + @Url.Content("~/Content/images/delete_icon_blue.svg") + ");background-repeat: no-repeat; width:1em;height:2em;margin-top: 9px;cursor:pointer;' onclick='deleteSubVertical(#:SubVerticalId#);' ></ div >#}#").Width(60).HtmlAttributes(new { style = "padding-left:8px;padding-right: unset;" });
                                     columns.Bound(e => e.VerticalId).ClientTemplate(
                                      "<input type='button' value= 'V-BCC'id='#=SubVerticalId#' onclick=\"showBCC('#=SubVerticalId#')\" class='btn bcc-button'/>"
                                     ).Title("").HtmlAttributes(new { style = "padding-left:unset;" });
                                 })
                                 .AutoBind(true)
                                 .Scrollable()
                                 .ToolBar(tools => { tools.Search().Text("Search Sub Vertical...");
                                     tools.Create().Text("Add");
                                 })
                                 .Editable(editable => editable.Mode(GridEditMode.PopUp).CreateAt(GridInsertRowPosition.Bottom)/*.DisplayDeleteConfirmation(" Are you sure to delete the selected Sub Vertical?")*/)
                                 .Search(search => { search.Field(f => f.SubVerticalName);
                                 })
                                  .DataSource(dataSource => dataSource
                                  .Ajax()

                                  .Model(model =>
                                  {
                                      model.Id(f => f.SubVerticalId);
                                  })
                                      .Read(read => read.Action("GetSubVerticalList", "VerticalSubVerticalsGrid").Data("getVerticalId"))
                                      .Create(create => create.Action("CreateSubVertical", "VerticalSubVerticalsGrid").Data("getnewVerticalId"))
                                      .Update(update => update.Action("EditSubVertical", "VerticalSubVerticalsGrid"))
                                        //  .Destroy(destroy => destroy.Action("DeleteSubVertical", "VerticalSubVerticalsGrid"))
                                        .Events(e => e.RequestEnd("onRequestEnd2"))

                              )
                                      .Events(e => e.Edit("onSubVertEdit"))

                         )
                        @(Html.Kendo().Window().Name("WinBCC")
                    .Title("")
                    .Visible(false)
                    .Modal(true)
                    .Draggable(true)
                    .Content(@<text>
                @*//<label id="appname"></label>*@
                       <div class="bampanelrtbdy custom-tree-grid">
                        @* Tree View *@

                            @(Html.Kendo().TreeList<BusinessCapabilitiesModel>()
                                .Name("BCCGrid")
                    .Toolbar(toolbar => toolbar.Create().Text("Add New Capability"))
                    .Columns(columns =>
                    {

                        columns.Add().Field(e => e.BusinessCapName).Title("Business (Sub)Capability");
                        columns.Add().Title("Action").Width(250).Command(c =>
                        {
                            c.Edit().Text(" ");
                            c.Destroy().Text(" ");
                            c.CreateChild().Text("Add Sub Capability");
                        })
                        .HtmlAttributes(new
                        {
                            // style = "text-align: center;"
                        });
                    })
                    .Editable(e => e.Mode("inline"))
                    .DataSource(dataSource => dataSource
                        .Create(create => create.Action("CreateBcc", "VerticalSubVerticalsGrid").Data("ParameterSubVIdData"))
                        .Read(read => read.Action("GetAllTemplates", "VerticalSubVerticalsGrid").Data("ParameterData"))
                        .Update(update => update.Action("UpdateBcc", "VerticalSubVerticalsGrid"))
                        .Destroy(delete => delete.Action("DestroyBCC", "VerticalSubVerticalsGrid"))
                        .Model(m =>
                        {
                            m.Id(f => f.BCId);
                            m.ParentId(f => f.BCParentId);
                            m.Field(f => f.SubVerticalId);
                            m.Field(f => f.CreatedDate);
                            m.Expanded(false);
                            m.Field(f => f.BusinessCapName);

                        })
                    )
                    .Height(365)
                                    )

                        <!--/.bamtreemenu-->

                    </div>


</text>)
                    .Width(900)
                    .Height(435)
                )


                    </div>
                </div>

            </div>

        </div>
    </div>

    <div class="modal" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="commentModalLabel">Delete</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <span hidden id="selVerticalId"></span>
                    <span hidden id="selSubVerticalId"></span>
                    <span id="alertContent"></span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">CANCEL</button>
                    <button type="button" data-bs-dismiss="modal" class="btn btn-primary" onclick="deleteClick()" id="vertDel">DELETE</button>
                    <button type="button" data-bs-dismiss="modal" class="btn btn-primary" onclick="deleteClick1()"id="subvertDel">DELETE</button>

                </div>
            </div>
        </div>
    </div>
    <div id="alertModal" class="modal" role="dialog" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-body">
                <div id="lblErr">
                    <label id="lblErr1"></label>
                    <button type="button" class="close" data-bs-dismiss="modal" style="float:right">&times;</button>

                </div>
                <div id="lblSuccess">
                    <label id="lblSuccess1"></label>
                    <button type="button" class="close" data-bs-dismiss="modal" style="float:right">&times;</button>

                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function onRequestEnd1(e) {
        $("#SubVerticalGrid").data("kendoGrid").dataSource.read();
        if (e.type == "update" && !e.response.Errors) {
            document.getElementById("lblSuccess1").innerHTML = " Vertical Updated Successfully ";
            $('#lblErr').hide();
            $('#lblSuccess').show();
            $("#alertModal").modal('show');
            $("#VerticalGrid").data("kendoGrid").dataSource.read();
        }

        if (e.type == "create" && !e.response.Errors) {
            document.getElementById("lblSuccess1").innerHTML = " Vertical Created Successfully ";
            $('#lblErr').hide();
            $('#lblSuccess').show();
            $("#alertModal").modal('show');
            $("#VerticalGrid").data("kendoGrid").dataSource.read();
        }
    }
    function onRequestEnd2(e) {
        if (e.type == "update" && !e.response.Errors) {
            document.getElementById("lblSuccess1").innerHTML = " SubVertical Updated Successfully ";
            $('#lblErr').hide();
            $('#lblSuccess').show();
            $("#alertModal").modal('show');
            $("#SubVerticalGrid").data("kendoGrid").dataSource.read();
        }

        if (e.type == "create" && !e.response.Errors) {
            document.getElementById("lblSuccess1").innerHTML = " SubVertical Updated Successfully ";
            $('#lblErr').hide();
            $('#lblSuccess').show();
            $("#alertModal").modal('show');
            $("#SubVerticalGrid").data("kendoGrid").dataSource.read();
           }
    }
    function deleteVertical(VerticalId) {
        // console.log(VerticalId);
        document.getElementById("selVerticalId").innerHTML = VerticalId;
        document.getElementById("alertContent").innerHTML = "Are you sure to delete the selected Vertical? Please note that respective SubVerticals also would get deleted";
        $("#vertDel").css("display", "block");
        $("#subvertDel").css("display", "none");
        
        $("#deleteModal").modal('show');
    }
    function deleteClick() {
        var VerticalId=document.getElementById("selVerticalId").innerHTML;

         var mod = {
             VerticalId: VerticalId
        };
        console.log("mod", mod);
        var data1 = JSON.stringify(mod);
        baseurl1 = '@Url.Content("~/VerticalSubVerticalsGrid/DeleteIndVertical")';
        $.ajax(
        {
            url: baseurl1,
            type: 'post',
            data: data1,
            async: false,
            contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    $("#VerticalGrid").data("kendoGrid").dataSource.read();
                    document.getElementById("lblSuccess1").innerHTML = "  Vertical Deleted Successfully ";
                    $('#lblErr').hide();
                    $('#lblSuccess').show();
                    $("#alertModal").modal('show');
                    },
                error: function (response) {
                    document.getElementById("lblErr1").innerHTML = " Vertical cannot be deleted; It's being used in other places ";
                    $('#lblErr').show();
                    $('#lblSuccess').hide();
                    $("#alertModal").modal('show');
                }
       })
    }
    function deleteSubVertical(SubVerticalId) {
        // console.log(VerticalId);
        document.getElementById("selSubVerticalId").innerHTML = SubVerticalId;
        document.getElementById("alertContent").innerHTML = "Are you sure to delete the selected Sub Vertical? ";
        $("#vertDel").css("display", "none");
        $("#subvertDel").css("display", "block");
        $("#deleteModal").modal('show');
    }
    function deleteClick1() {
        var SubVerticalId=document.getElementById("selSubVerticalId").innerHTML;

         var mod = {
             SubVerticalId: SubVerticalId
        };
        console.log("mod", mod);
        var data1 = JSON.stringify(mod);
        baseurl1 = '@Url.Content("~/VerticalSubVerticalsGrid/DeleteSubVertical")';
        $.ajax(
        {
            url: baseurl1,
            type: 'post',
            data: data1,
            async: false,
            contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    $("#SubVerticalGrid").data("kendoGrid").dataSource.read();
                    document.getElementById("lblSuccess1").innerHTML = " SubVertical Deleted Successfully ";
                    $('#lblErr').hide();
                    $('#lblSuccess').show();
                    $("#alertModal").modal('show');
                },
                error: function (response) {
                    document.getElementById("lblErr1").innerHTML = " Sub-Vertical cannot be deleted; It's being used in other places ";
                    $('#lblErr').show();
                    $('#lblSuccess').hide();
                    $("#alertModal").modal('show');
                }
       })
    }
    function getVerticalId() {
        var str = '';
        var gridList = $("#VerticalGrid").data("kendoGrid");
        var dataItems = gridList.dataSource.view();
        $.each(dataItems, function (i, item) {
            var CheckBoxctrl = '#VerticalId' + item.VerticalId;
            if ($(CheckBoxctrl).is(":checked")) {
                str = item.VerticalId;
                console.log(str);
            }
        });
        return {
            VerticalId: str
        };
    }
    function getnewVerticalId(e) {
        var str = '';
        var gridList = $("#VerticalGrid").data("kendoGrid");
        var dataItems = gridList.dataSource.view();
        $.each(dataItems, function (i, item) {
            var CheckBoxctrl = '#VerticalId' + item.VerticalId;
            if ($(CheckBoxctrl).is(":checked")) {
                str = item.VerticalId;
                e.VerticalId = str;
                console.log(str);
            }
        });
        return {
            VerticalId: str
        };
    }
    function onVerticalselect() {
        var str = '';
        var VertId;
        var gridList = $("#VerticalGrid").data("kendoGrid");
        var dataItems = gridList.dataSource.view();
        $.each(dataItems, function (i, item) {
            var CheckBoxctrl = '#VerticalId' + item.VerticalId;
            if ($(CheckBoxctrl).is(":checked")) {
                str = item.VerticalName;
                VertId = item.VerticalId
            }
        });
        $("#SubVerticalGrid").data("kendoGrid").dataSource.read();
        $("#VerticalName").text(" - "+str);
        document.getElementById("VertId").value = VertId;
    }

    function onVertEdit(e) {
        var window = e.container.data('kendoWindow')
        if (e.model.isNew()) {
            window.title('Add Industry Vertical Details');
        } else {
            window.title('Edit Industry Vertical Details');
        }
    }
    function onSubVertEdit(e) {
        var window = e.container.data('kendoWindow')
        if (e.model.isNew()) {
            window.title('Add Sub Vertical Details');
        } else {
            window.title('Edit Sub Vertical Details');
        }
    }
    
    function showBCC(e) {
        var SubVertname;
        var SubVertId;
        var gridnControl = $("#SubVerticalGrid").data("kendoGrid");
        var dataItems = gridnControl.dataSource.view();
        $.each(dataItems, function (i, item) {
            if (item.SubVerticalId == e) {
                SubVertname = item.SubVerticalName;
                SubVertId = item.SubVerticalId;
            }
        });
        console.log(SubVertname)
        console.log(SubVertId)
        //  console.log(SubVertname);
        document.getElementById("SelectedSubVertIdBCC").value = e;
        document.getElementById("subVId").value = SubVertId;
        var popupGrid = $("#BCCGrid").data("kendoTreeList");
        popupGrid.dataSource.read();

        var popup = $("#WinBCC").data("kendoWindow");
        $('.k-window-title').text("Business Capability Catalog (BCC) SubVertical Name : " + SubVertname);
        popup.open();
        popup.center();
    }
    function ParameterSubVIdData() {
        var mm = $("#subVId").val();
        console.log(mm);
        return {
            SubVertId: mm
        }
    }
    function ParameterData(e) {
        var mm = $("#subVId").val();
        console.log(mm);

        return {
            SubVerticalId: mm
        };
    }
</script>
