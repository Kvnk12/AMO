<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="AnalysisMasterPage.master.cs" Inherits="WebUI.AnalysisMasterPage" %>

<!DOCTYPE html>

<html>
<%
    var client = "";
    string userName = "";
    int cid=0;
    if (Session["SessionClient"] != null)
    {
        WebUI.Dto.ClientDetail objclient = ( WebUI.Dto.ClientDetail)Session["SessionClient"];
        client = objclient.ClientName;
        cid = objclient.ClientId;
    }

    NTTData.AMOPortal.WebUI.Dto.HomeInput MenuItemsInput = (NTTData.AMOPortal.WebUI.Dto.HomeInput)Session["MenuItemsInput"];

    userName = MenuItemsInput.UserDisplayName;
    string imageDataURL = null;
    var Img = WebUI.Areas.ClientProfileManager.ClientProfileManagerHelper.getProfileClientDetail(cid);
    if (Img.CPMFile != null)
    {
        string imageBase64Data = Convert.ToBase64String(Img.CPMFile);
        imageDataURL = string.Format("data:image/png;base64,{0}", imageBase64Data);

    }
    var UserId = (int)Session["UserId"];
    var username = WebUI.Areas.ClientProfileManager.ClientProfileManagerHelper.getFullName(UserId);
    var area = HttpContext.Current.Request.Url.AbsoluteUri;
    bool IN=area.Contains("IncidentNavigator");
    bool IM = area.Contains("IdeaManager");
    var ECOpassword = System.Configuration.ConfigurationManager.AppSettings["ECOpassword"];
    var ECOapiEndpoint = System.Configuration.ConfigurationManager.AppSettings["ECOapiEndpoint"];
    var ECOINemailId = System.Configuration.ConfigurationManager.AppSettings["ECOINemailId"];
    var ECOIMemailId = System.Configuration.ConfigurationManager.AppSettings["ECOIMemailId"];
%>
    
