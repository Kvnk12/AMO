    <style type="text/css">
    .PivotGridWindow {
        width: 700px !important;
        height: 440px !important;
    }

    div.RadPivotGrid .rpgDataCell {
        text-align: right;
    }

    .reportlbl {
        font-size: small;
        font-family: Helvetica Neue, Helvetica, Arial, sans-serif;
        font-weight: bold;
    }

    div.RadPivotGrid .rpgFieldItem.aggregateCustom1, div.RadPivotGrid .rpgColumnHeader.aggregateCustom1 {
        color: #006699;
    }

    div.RadPivotGrid .rpgFieldItem.aggregateCustom2, div.RadPivotGrid .rpgColumnHeader.aggregateCustom2 {
        color: #006666;
    }


    #form1 .RadDropDownList .rddlEmptyMessage, #form1 .RadDropDownList .rddlDefaultMessage {
        opacity: 1;
        font-style: normal;
        z-index:9999;
        font-family: HelveticaNeue;
    }


    html body .RadInput_Default .riTextBox, html body .RadInputMgr_Default {
        border-color: rgb(204, 204, 204);
        color: #333;
        background-color: #FFF;
        font: 12px "segoe ui",arial,sans-serif;
        border-style: solid;
        border-radius: 5px;
        height: 2.5em;
        z-index:9999 !important;
    }

    .progressIndicatorStyle {
        width: 200px;
        height: 200px;
        top: 25%;
        left: 40%;
        z-index: 99999;
        position: absolute;
        display: block;
    }

    @media print {
        body * {
            visibility: hidden;
        }

        #exportSectionID, #exportSectionID * {
            visibility: visible;
        }

        #exportSectionID {
            position: absolute;
            left: 0;
            top: 0;
        }
    }
    .disabled {
        pointer-events: none;
        cursor: default;
    }

    .Box-bundle-tag {
        border: 1px solid;
        color: #ee8151;
        padding: 0 3px;
        font-size: xx-small;
        align-self: center;
    }

    .Box-bundle-tagred {
        border: 1px solid;
        color: red;
        padding: 0 2px;
        font-size: xx-small;
        align-self: center;
    }
    .sidebarHeader {
        display: flex;
        justify-content: space-between;
    }

        .sidebarHeader h3 {
            width: 100%;
        }

    .sidebarHeader .close {
        border: none;
        background-color: #5876AA;
        width: 3em;
        height: 3.7em;
    }

    .sidebarHeader span {
        color: white;
        font-size: 30px;
        position: absolute;
        top: -0.1em;
        right: 0.3em;
    }

    .sidebar-submenu > ul {
        list-style-type: none;
    }

    .sidebar-wrapper .sidebar-menu > ul > li > a.show + .sidebar-main-submenu.show > ul {
        list-style-type: none;
    }
</style>
</head>

<body class="analysisnew-body-container backlog-analysis-body-container">
    
