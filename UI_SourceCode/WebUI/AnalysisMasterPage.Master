  <% if(IN || IM )
          {%>
              <link rel="stylesheet" href="<%=ResolveClientUrl("https://cdnjs.cloudflare.com/ajax/libs/imgareaselect/0.9.10/css/imgareaselect-default.css")%>">
            <link rel="stylesheet" href="<%=ResolveClientUrl("https://ecolib.s3.us-west-2.amazonaws.com/css/eco-feedback-v1.2.min.css")%>">


            <script src="<%=ResolveClientUrl("https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js")%>"></script>
            <script src="<%=ResolveClientUrl("https://cdn.jsdelivr.net/npm/html2canvas@1.0.0-alpha.12/dist/html2canvas.js")%>"></script>
            <script src="<%=ResolveClientUrl("https://ecolib.appliediphub.com/js/jquery.imgareaselect.js")%>"></script>
            <script src="<%=ResolveClientUrl("https://ecolib.s3.us-west-2.amazonaws.com/js/eco-feedback-v1.2.min.js")%>"></script>

