            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
       
         <div id="footer" style="width:100%">
           <div class="container">
              <p class="credit">&copy;<%= DateTime.Now.Year %> NTT DATA, Inc. All rights reserved.</p>
           </div>
         </div>    
      </div>
    
   <script>
       //var url = window.location.href;
        $(document).ready(function () {
            var userNameAMO = '<%:username%>';
            console.log(userNameAMO);
           <%-- console.log('<%:area%>');
            console.log('<%:IN%>');
            console.log('<%:IM%>');--%>
            if ('<%:IN%>' == 'True' || '<%:IM%>' == 'True') {
                if ('<%:IN%>' == 'True') {
                    var options = {
                        enterpriseCode: 'nttdata',
                        applicationName: 'Incident Navigator',
                        emailId: '<%:ECOINemailId%>',
                        ecoapiEndpoint: '<%:ECOapiEndpoint%>',
                        userId: userNameAMO,
                        password: '<%:ECOpassword%>'
                    };
                    console.log(options);
                }
                else {
                    var options = {
                        enterpriseCode: 'nttdata',
                        applicationName: 'Idea Manager',
                        emailId: '<%:ECOIMemailId%>',
                        ecoapiEndpoint: '<%:ECOapiEndpoint%>',
                        userId: userNameAMO,
                        password: '<%:ECOpassword%>'
                    };
                    console.log(options);
                }
                /*var feedback = initializeFeedback(options);*/
                var ideaManagerUserJourney = {};
                ideaManagerUserJourney = new ECO.Component.UserJourneyMap({ numberOfEntries: 50 });
                //track the pages where user visited by tracking all a href clicks
                var $triggerButton = $('a');
                $triggerButton.on('click', function (e) {
                    ideaManagerUserJourney.setHistory(this);
                });

                var feedback = initializeFeedback(options);
                var udf = $('#ecoFeedbackBtn').data() || {};
                //add any additional information
                udf.Location = window.location.href;
                //store the user navigation folow
                udf.UserJourneyMap = ideaManagerUserJourney.getHistory();
                //get feedback Channel by looking at user agent
                if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
                    udf.Channel = 'Mobile';
                } else {
                    udf.Channel = 'Desktop';
                }
                udf.UserAgent = navigator.userAgent;
                //get the OS platform from where the feedback was given
                udf.Platform = navigator.platform;
                //add the application's user. Could be Portal ID or name
                if ($("#anonymousSubmission").is(":checked")) {
                    setECOUser("Anonymous");
                    udf.userId = "Anonymous";
                }
                feedback.setUdf(udf);
                feedback.resetUdf('view');
            }
        });

       <%--function getarea() {
           if (url.includes("IncidentNavigator")) {
               <%=area%>= "IN";
           }
           else if (url.includes("IdeaManager")) {
               <%=area%>= "IM";
           }
       }--%>
   </script>

    <script>

    


        $('.header-menu-icon').click(function () {
            $(this).toggleClass('open');
            $('.sidebar-wrapper').toggleClass('show');
            $('#sidenav-overlay').toggleClass('open');
        });

        $('#sidenav-overlay').click(function () {
            $('.header-menu-icon').toggleClass('open');
            $('.sidebar-wrapper').toggleClass('show');
            $('#sidenav-overlay').toggleClass('open');
        });
        $('.sidebar-wrapper').on('click', '.close', function () {
            $('.header-menu-icon').toggleClass('open');
            $('.sidebar-wrapper').toggleClass('show');
            $('#sidenav-overlay').toggleClass('open');
            $('.sidebar-link').removeClass('show');
            $('.sidebar-main-submenu').removeClass('show');
        });

        $(".sidebar-link")
          .mouseenter(function () {
              console.log('enter');
              $(this).addClass('show');
              $(this).siblings(".sidebar-main-submenu").addClass('show');
              $(this).parent('li').siblings().find('a').removeClass('show');
              $(this).parent('li').siblings().find('.sidebar-main-submenu').removeClass('show');
          });
    </script>
</body>
</html>
