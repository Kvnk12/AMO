                                <li style="margin-bottom:1.3em;"><a href="<%=ResolveClientUrl("~/Account/Logoff")%>" title="logout" class="logout-icon"></a></li>
                            </ul>
                        </div> <!--/.nav-collapse -->

                </div>
             </div>

             
