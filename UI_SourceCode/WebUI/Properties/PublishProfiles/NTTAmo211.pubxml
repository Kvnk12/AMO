<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>Package</WebPublishMethod>
    <SiteUrlToLaunchAfterPublish />
    <DesktopBuildPackageLocation>D:\Urvi\AMO-Package-21-JAN\WebUI.zip</DesktopBuildPackageLocation>
    <PackageAsSingleFile>true</PackageAsSingleFile>
    <DeployIisAppPath>default Web Site/NTTAmo211</DeployIisAppPath>
    <PublishDatabaseSettings>
      <Objects xmlns="">
        <ObjectGroup Name="Db" Order="1" Enabled="False">
          <Destination Path="Data Source=POCAMO;Initial Catalog=AMO_PORTAL_DEV;User ID=AMO_DEV;Password=Nttamo@dev" Name="" />
          <Object Type="DbCodeFirst">
            <Source Path="DBMigration" DbContext="NTTData.AMOPortal.Data.Db, Data" MigrationConfiguration="Data.Migrations.Configuration, Data" Origin="Configuration" />
          </Object>
        </ObjectGroup>
      </Objects>
    </PublishDatabaseSettings>
  </PropertyGroup>
  <ItemGroup>
    <MSDeployParameterValue Include="$(DeployParameterPrefix)Db-Web.config Connection String">
      <ParameterValue>Data Source=POCAMO;Initial Catalog=AMO_PORTAL_DEV;User ID=AMO_DEV;Password=Nttamo@dev</ParameterValue>
    </MSDeployParameterValue>
  </ItemGroup>
</Project>